<?php

/**
 * @file
 * EPG: the programme guide for the Solent's radio and TV stations.
 *
 * The model (agreed with Rob, 23 and 26 Nov 2026) reuses what the site has:
 * - A station is an Organisation that a Broadcaster node points at
 *   (field_organisation). The Broadcaster holds how to tune in: frequency,
 *   live stream, catch-up page, schedule page. The organisation carries
 *   nothing broadcast-specific, and readers never see the broadcaster:
 *   its page redirects to the organisation (Rabbit Hole, site config).
 * - A programme is an Event with the Broadcast format that names the
 *   station as organiser: repeating as the show does, with its changes
 *   to particular dates applying to it.
 * - The schedule is derived: a station's programmes for a day, worked
 *   out from the events' dates. Nothing is stored for it.
 * Programmes are left out of the ordinary events listings and the front
 * page, which are for things to go to; they are reached through the
 * guide, the station's page, the Broadcasts format page, topics and
 * series.
 */

use Drupal\node\NodeInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;

/**
 * The uuid of the Broadcast format term, the format every programme has.
 */
const EPG_FORMAT_UUID = '3c970a69-a632-476f-b4d0-ce9ce9823d84';

/**
 * The id of the Broadcast format term, or NULL when it does not exist.
 */
function epg_programme_format_tid(): ?int {
  $tid = &drupal_static(__FUNCTION__);
  if ($tid === NULL) {
    $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['uuid' => EPG_FORMAT_UUID]);
    $tid = $terms ? (int) reset($terms)->id() : 0;
  }
  return $tid ?: NULL;
}

/**
 * Whether an organisation is a station: a published Broadcaster points at it.
 *
 * The organisation carries nothing broadcast-specific; the Broadcaster node
 * (field_organisation) holds how to tune in, and readers never see it: its
 * page redirects to the organisation.
 */
function epg_is_station(NodeInterface $node): bool {
  return $node->bundle() === 'organisation' && isset(epg_stations()[(int) $node->id()]);
}

/**
 * The published Broadcaster for an organisation, or NULL.
 */
function epg_broadcaster_for(NodeInterface $organisation): ?NodeInterface {
  return epg_stations()[(int) $organisation->id()]['broadcaster'] ?? NULL;
}

/**
 * The stations, keyed by the ORGANISATION's nid: node (the organisation),
 * broadcaster (its Broadcaster node), nid, label, url, kind (radio), frequency,
 * stream (URL or ''), catchup (URL or ''), schedule (URL or ''). Published
 * broadcasters whose organisation is published and viewable, by title.
 *
 * @return array<int, array>
 */
function epg_stations(): array {
  $cache = &drupal_static(__FUNCTION__);
  if ($cache !== NULL) {
    return $cache;
  }
  $cache = [];
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  if (!\Drupal::entityTypeManager()->getStorage('node_type')->load('broadcaster')) {
    return $cache;
  }
  $nids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'broadcaster')
    ->condition('status', 1)
    ->exists('field_organisation')
    ->sort('title')
    ->execute();
  foreach ($storage->loadMultiple($nids) as $broadcaster) {
    $organisation = $broadcaster->get('field_organisation')->entity;
    if (!$organisation instanceof NodeInterface || !$organisation->isPublished() || !$organisation->access('view')) {
      continue;
    }
    $cache[(int) $organisation->id()] = epg_station_info($broadcaster);
  }
  return $cache;
}

/**
 * A station's details for the guide and its page (see epg_stations()).
 * Takes the Broadcaster node, or the organisation it points at (an
 * organisation without one gives an empty array).
 */
function epg_station_info(NodeInterface $node): array {
  if ($node->bundle() !== 'broadcaster') {
    return epg_stations()[(int) $node->id()] ?? [];
  }
  $organisation = $node->get('field_organisation')->entity;
  if (!$organisation instanceof NodeInterface) {
    return [];
  }
  $url = static function (string $field) use ($node): string {
    if (!$node->hasField($field) || $node->get($field)->isEmpty()) {
      return '';
    }
    try {
      return $node->get($field)->first()->getUrl()->toString();
    }
    catch (\Throwable) {
      return '';
    }
  };
  return [
    'node' => $organisation,
    'broadcaster' => $node,
    'nid' => (int) $organisation->id(),
    'label' => $organisation->label(),
    'url' => $organisation->toUrl()->toString(),
    'kind' => 'radio',
    'frequency' => $node->hasField('field_frequency') ? trim((string) $node->get('field_frequency')->value) : '',
    'stream' => $url('field_stream_url'),
    'catchup' => $url('field_catchup_url'),
    'schedule' => $url('field_schedule_url'),
  ];
}

/**
 * Implements hook_views_query_alter().
 *
 * Programmes (events with the Broadcast format) stay out of the events
 * listings and the front page unless the listing is narrowed to that
 * format: fifteen stations' daily shows would bury every gig. The
 * station's own page lists its programmes through the content relations
 * service, which this does not touch.
 */
function epg_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  if ($view->id() !== 'events_listing' || !$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }
  $format = epg_programme_format_tid();
  $stations = array_keys(epg_stations());
  // A topic's Local radio page (the strip's tab) is the same listing the
  // other way round: programmes only.
  $only = (bool) \Drupal::request()->attributes->get('epg_programmes_only');
  if (!$format || !$stations || (!$only && customsolent_helpers_active_format_tid() === $format)) {
    return;
  }
  // Programmes: the Broadcast format and a station as organiser.
  $programmes = \Drupal::database()->select('node__field_format', 'epg_f')->fields('epg_f', ['entity_id'])
    ->condition('epg_f.field_format_target_id', $format);
  $programmes->join('node__field_organisers', 'epg_o', 'epg_o.entity_id = epg_f.entity_id');
  $programmes->condition('epg_o.field_organisers_target_id', $stations, 'IN');
  // Its own AND group, never group 0 (the OR of the topic arguments).
  $query->setWhereGroup('AND', 'epg_programmes');
  $query->addWhere('epg_programmes', 'node_field_data.nid', $programmes, $only ? 'IN' : 'NOT IN');
}

/**
 * Implements hook_theme().
 */
function epg_theme(): array {
  return [
    'epg_guide' => [
      'variables' => [
        'day' => '',
        'day_label' => '',
        'is_today' => FALSE,
        'days' => [],
        'views' => [],
        'view' => 'timeline',
        'window_start' => 0,
        'window_end' => 0,
        'hours' => [],
        'day_note' => '',
        'stations' => [],
        'empty' => FALSE,
      ],
    ],
  ];
}

/**
 * Minutes in the guide's day: 6am to 6am.
 */
const EPG_WINDOW_MINUTES = 1440;

/**
 * The hour the guide's day starts at.
 */
const EPG_WINDOW_START_HOUR = 6;

/**
 * A station's programmes for the window, in order and never overlapping.
 *
 * One station cannot broadcast two things at once, so an overlap is a slip
 * on the station's page: most often an end of "12pm" where midnight was
 * meant (a show running fourteen hours), or a day's first row listed twice.
 * Each programme ends no later than the next one starts: when the end is
 * past it, an end twelve hours earlier is tried first (the am/pm slip),
 * else the next start; what is left with no time at all is dropped. The
 * same rule runs in the schedule import, so stored data is tidy too; this
 * keeps the guide right for anything imported before it was. (Until
 * 27 Nov 2026 overlaps took a second lane, which left a row-high gap in
 * the guide wherever the slip fell outside the hours on screen.)
 *
 * @param array $programmes
 *   Rows as built by epg_schedule(): start, end, duration_min, times,
 *   is_now, tz.
 */
function epg_without_overlaps(array $programmes, int $to, int $now): array {
  // Same start: the shorter first, so the rule drops it (a day's first row
  // listed twice) and keeps the real programme.
  usort($programmes, static fn($a, $b) => ($a['start'] <=> $b['start']) ?: ($a['end'] <=> $b['end']));
  $kept = [];
  $n = count($programmes);
  foreach ($programmes as $i => $p) {
    $next_start = $i + 1 < $n ? (int) $programmes[$i + 1]['start'] : PHP_INT_MAX;
    if ($p['end'] > $next_start) {
      $slip = $p['end'] - 12 * 3600;
      $p['end'] = ($slip > $p['start'] && $slip <= $next_start) ? $slip : $next_start;
    }
    if ($p['end'] <= $p['start']) {
      continue;
    }
    $p['duration_min'] = max(5, (int) round((min($p['end'], $to) - $p['start']) / 60));
    $p['is_now'] = $p['start'] <= $now && $now < $p['end'];
    $p['times'] = customsolent_helpers_times_text($p['start'], $p['end'], $p['tz']);
    $p['lane'] = 1;
    $kept[] = $p;
  }
  return $kept;
}

/**
 * The schedule for a day: every station with its programmes in the guide's
 * window (6am that day to 6am the next), in station order.
 *
 * Programmes are the published events with the Broadcast format that name
 * a station as organiser and have a date starting in the window. A date
 * in a closure Break or outside the event's season is not on (the same
 * rules as the listings), and a changed date carries its new times.
 *
 * Returns window_start/window_end (timestamps), hours (label per hour of
 * the window), stations (list of station info + 'programmes': list of
 * {nid, title, url, start, end, start_min, duration_min, time, times,
 * is_now, note, link}), tags, max_age (seconds to the next change).
 */
function epg_schedule(\DateTimeImmutable $day): array {
  $tz = $day->getTimezone();
  $window_start = $day->setTime(EPG_WINDOW_START_HOUR, 0);
  $window_end = $window_start->modify('+1 day');
  $from = $window_start->getTimestamp();
  $to = $window_end->getTimestamp();
  $now = \Drupal::time()->getRequestTime();
  $stations = epg_stations();
  $format = epg_programme_format_tid();
  $tags = ['node_list:event', 'node_list:organisation', 'node_list:broadcaster'];
  // The ruler: a mark every half hour; the hour marks carry the time, the
  // half hours a lighter one, and midnight names the new day.
  $hours = [];
  for ($m = 0; $m < EPG_WINDOW_MINUTES; $m += 30) {
    $at = $window_start->modify("+$m minutes");
    $hours[] = [
      'minute' => $m,
      'label' => $at->format('G:i'),
      'half' => $m % 60 !== 0,
      'day' => ($at->format('H:i') === '00:00') ? $at->format('D j M') : '',
    ];
  }
  $result = ['window_start' => $from, 'window_end' => $to, 'hours' => $hours, 'stations' => [], 'tags' => $tags, 'max_age' => 3600];
  if (!$stations || !$format) {
    return $result;
  }
  $rows = \Drupal::database()->query("SELECT w.entity_id AS nid, w.field_when_value AS start, w.field_when_end_value AS end_value, w.field_when_timezone AS tz, w.field_when_duration AS duration, o.field_organisers_target_id AS station
    FROM {node__field_when} w
    JOIN {node_field_data} n ON n.nid = w.entity_id AND n.default_langcode = 1 AND n.status = 1 AND n.type = 'event'
    JOIN {node__field_format} f ON f.entity_id = w.entity_id AND f.field_format_target_id = :format
    JOIN {node__field_organisers} o ON o.entity_id = w.entity_id AND o.field_organisers_target_id IN (:stations[])
    WHERE w.field_when_value >= :from AND w.field_when_value < :to
    ORDER BY w.field_when_value ASC", [':format' => $format, ':stations[]' => array_keys($stations), ':from' => $from, ':to' => $to])->fetchAll();
  $nids = array_unique(array_map(static fn($r) => (int) $r->nid, $rows));
  $nodes = $nids ? \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids) : [];
  $by_station = [];
  $boundaries = [];
  foreach ($rows as $row) {
    $node = $nodes[(int) $row->nid] ?? NULL;
    if (!$node) {
      continue;
    }
    $start = (int) $row->start;
    $item_tz = $row->tz ?: $tz->getName();
    $month = (int) (new \DateTimeImmutable('@' . $start))->setTimezone(new \DateTimeZone($item_tz))->format('n');
    $season_from = $node->hasField('field_season_from') ? (int) $node->get('field_season_from')->value : 0;
    $season_to = $node->hasField('field_season_to') ? (int) $node->get('field_season_to')->value : 0;
    if (!customsolent_helpers_in_season($month, $season_from ?: NULL, $season_to ?: NULL)) {
      continue;
    }
    $break = customsolent_helpers_break_for((int) $node->id(), $start);
    if ($break && $break['kind'] === 'closure') {
      continue;
    }
    $instance = ['start' => $start, 'end_entered' => (int) $row->end_value, 'duration' => (int) $row->duration, 'tz' => $item_tz];
    $exception = customsolent_helpers_exception_for($node, $start, $item_tz);
    $instance = customsolent_helpers_apply_exception($instance, $exception);
    $end = $instance['end_entered'] > $instance['start'] ? $instance['end_entered'] : $instance['start'] + 1800;
    $tags = array_merge($tags, $node->getCacheTags());
    $start_min = (int) floor(($instance['start'] - $from) / 60);
    $duration_min = max(5, (int) round((min($end, $to) - $instance['start']) / 60));
    $note = '';
    if ($exception) {
      $note = customsolent_helpers_exception_notice($exception, $instance);
    }
    elseif ($break) {
      $note = customsolent_helpers_break_notice($break);
    }
    $link = '';
    if ($node->hasField('field_urls') && !$node->get('field_urls')->isEmpty()) {
      try {
        $link = $node->get('field_urls')->first()->getUrl()->toString();
      }
      catch (\Throwable) {
        $link = '';
      }
    }
    $by_station[(int) $row->station][] = [
      'nid' => (int) $node->id(),
      'title' => $node->label(),
      'url' => $node->toUrl()->toString(),
      'start' => $instance['start'],
      'end' => $end,
      'start_min' => $start_min,
      'duration_min' => $duration_min,
      'time' => customsolent_helpers_time_text($instance['start'], $item_tz),
      'times' => customsolent_helpers_times_text($instance['start'], $end, $item_tz),
      'is_now' => $instance['start'] <= $now && $now < $end,
      'note' => $note,
      'link' => $link,
      'topics' => epg_programme_topics($node),
      'tz' => $item_tz,
    ];
    $boundaries[] = $instance['start'];
    $boundaries[] = $end;
  }
  // A station with nothing in the week either side of the day (one not
  // yet filled, one whose site is down) is left out of the guide rather
  // than shown as an empty row.
  $active = \Drupal::database()->query("SELECT DISTINCT o.field_organisers_target_id FROM {node__field_when} w
    JOIN {node_field_data} n ON n.nid = w.entity_id AND n.default_langcode = 1 AND n.status = 1 AND n.type = 'event'
    JOIN {node__field_format} f ON f.entity_id = w.entity_id AND f.field_format_target_id = :format
    JOIN {node__field_organisers} o ON o.entity_id = w.entity_id AND o.field_organisers_target_id IN (:stations[])
    WHERE w.field_when_value >= :from AND w.field_when_value < :to", [':format' => $format, ':stations[]' => array_keys($stations), ':from' => $from - 7 * 86400, ':to' => $to + 7 * 86400])->fetchCol();
  $active = array_map('intval', $active);
  foreach ($stations as $nid => $station) {
    if (!in_array($nid, $active, TRUE)) {
      continue;
    }
    $programmes = epg_without_overlaps($by_station[$nid] ?? [], $to, $now);
    $result['stations'][] = $station + ['programmes' => $programmes, 'lanes' => 1];
    $tags = array_merge($tags, $station['node']->getCacheTags());
  }
  // The page changes when a programme starts or ends, or at the next 6am.
  $next = $to > $now ? $to : $now + 3600;
  foreach ($boundaries as $b) {
    if ($b > $now && $b < $next) {
      $next = $b;
    }
  }
  $result['tags'] = array_values(array_unique($tags));
  $result['max_age'] = max(60, $next - $now);
  return $result;
}

/**
 * Whether a node is a programme: an event with the Broadcast format whose
 * organiser is a station. Both, and no flag: a station's roadshow has
 * another format and is an event; a one-off live stream from an
 * organisation that is not a station is an event; the topics are free for
 * discovery (a music show under Music) and never decide this.
 */
function epg_is_programme(NodeInterface $node): bool {
  if ($node->bundle() !== 'event' || !$node->hasField('field_format') || !$node->hasField('field_organisers') || !($format = epg_programme_format_tid())) {
    return FALSE;
  }
  $broadcast = FALSE;
  foreach ($node->get('field_format')->getValue() as $item) {
    if ((int) ($item['target_id'] ?? 0) === $format) {
      $broadcast = TRUE;
      break;
    }
  }
  if (!$broadcast) {
    return FALSE;
  }
  foreach ($node->get('field_organisers')->referencedEntities() as $organiser) {
    if ($organiser instanceof NodeInterface && epg_is_station($organiser)) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Which of the given event nids are programmes (Broadcast format, station
 * organiser), as nid => TRUE. For the section strip's counts.
 */
function epg_programme_nids(array $nids): array {
  $format = epg_programme_format_tid();
  $stations = array_keys(epg_stations());
  if (!$nids || !$format || !$stations) {
    return [];
  }
  $q = \Drupal::database()->select('node__field_format', 'f')->fields('f', ['entity_id'])
    ->condition('f.entity_id', $nids, 'IN')
    ->condition('f.field_format_target_id', $format);
  $q->join('node__field_organisers', 'o', 'o.entity_id = f.entity_id');
  $q->condition('o.field_organisers_target_id', $stations, 'IN');
  return array_fill_keys(array_map('intval', $q->distinct()->execute()->fetchCol()), TRUE);
}

/**
 * A programme's own topics for the guide: the names of its primary and
 * related topics, leaving out its station's own topic (Media & Publishing
 * says nothing about the show). An editor's Music or Business shows in the
 * schedule cell.
 *
 * @return string[]
 */
function epg_programme_topics(NodeInterface $node): array {
  $skip = [];
  if ($node->hasField('field_organisers')) {
    foreach ($node->get('field_organisers')->referencedEntities() as $organiser) {
      if ($organiser->hasField('field_primary_topic') && !$organiser->get('field_primary_topic')->isEmpty()) {
        $skip[(int) $organiser->get('field_primary_topic')->target_id] = TRUE;
      }
    }
  }
  $names = [];
  foreach (['field_primary_topic', 'field_related_topics'] as $field) {
    if (!$node->hasField($field)) {
      continue;
    }
    foreach ($node->get($field)->referencedEntities() as $term) {
      if (!isset($skip[(int) $term->id()]) && !isset($names[(int) $term->id()])) {
        // Topic names carry their path ("Culture / Music"): the leaf will do.
        $parts = preg_split('# / #', $term->label());
        $names[(int) $term->id()] = end($parts);
      }
    }
  }
  return array_values($names);
}

/**
 * What is on air now across the stations, for the front page: a list of
 * {station (label, url, stream, kind), programme (title, url, times,
 * end)} for every station with a programme on at this moment, in station
 * order; plus the moment the picture next changes.
 *
 * @return array{items: array[], next: int}
 */
function epg_on_air(): array {
  $tz = new \DateTimeZone(\Drupal::config('system.date')->get('timezone.default') ?: 'Europe/London');
  $now = \Drupal::time()->getRequestTime();
  $schedule = epg_schedule(epg_today($tz));
  $items = [];
  $next = $schedule['window_end'];
  foreach ($schedule['stations'] as $station) {
    foreach ($station['programmes'] as $p) {
      if ($p['start'] <= $now && $now < $p['end']) {
        $items[] = ['station' => $station, 'programme' => $p];
        $next = min($next, $p['end']);
      }
      elseif ($p['start'] > $now) {
        $next = min($next, $p['start']);
      }
    }
  }
  return ['items' => $items, 'next' => $next, 'tags' => $schedule['tags']];
}

/**
 * The guide's "today": the broadcast day, which runs 6am to 6am, so at
 * two in the morning it is still yesterday's.
 */
function epg_today(\DateTimeZone $tz): \DateTimeImmutable {
  $now = (new \DateTimeImmutable('@' . \Drupal::time()->getRequestTime()))->setTimezone($tz);
  $today = $now->setTime(0, 0);
  return (int) $now->format('G') < EPG_WINDOW_START_HOUR ? $today->modify('-1 day') : $today;
}

/**
 * The programmes of one station on a day: epg_schedule() narrowed.
 */
function epg_station_day(NodeInterface $station, \DateTimeImmutable $day): array {
  foreach (epg_schedule($day)['stations'] as $entry) {
    if ($entry['nid'] === (int) $station->id()) {
      return $entry['programmes'];
    }
  }
  return [];
}
