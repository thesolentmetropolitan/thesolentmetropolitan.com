<?php

declare(strict_types=1);

/**
 * @file
 * Customsolent Helpers module.
 *
 * Registers the in_kicker and from_kicker theme hooks used by the
 * KickerLazyBuilder. The templates live in the customsolent theme
 * (templates/components/) — Drupal's theme registry picks them up
 * because the theme's template paths override the module's defaults.
 */

/**
 * Implements hook_theme().
 *
 * The KickerLazyBuilder returns render arrays with #theme set to
 * these hooks. Templates are looked up by Drupal's theme registry —
 * the customsolent theme's templates/components/in-kicker.html.twig
 * and templates/components/primary-kicker.html.twig are used.
 */
function customsolent_helpers_theme($existing, $type, $theme, $path) {
  return [
    // The automated /{topic}/{events|articles|series|collaborations|organisations} listing page.
    'slnt_topic_listing' => [
      'variables' => [
        'node' => NULL,
        'listing_type' => NULL,
        'heading' => NULL,
        'listing' => NULL,
        'banner' => NULL,
      ],
    ],
    // The format landing page: /explore/events/{format} (festivals, talks …).
    'slnt_format_listing' => [
      'variables' => [
        'format' => NULL,
        'summary' => NULL,
        'banner' => NULL,
        'listing' => NULL,
        'section_key' => 'explore',
      ],
    ],
    // What is at a place (Location epic): the panel beside the map on
    // Explore / Locations, also served on its own for the map's script.
    'slnt_place_panel' => [
      'variables' => [
        'place' => NULL,
        'address' => NULL,
        'sections' => [],
        'empty' => FALSE,
      ],
    ],
    // Overview · Events · Organisations & links — built by the theme's
    // _customsolent_build_section_strip().
    'slnt_section_strip' => [
      'variables' => [
        'items' => [],
        'label' => NULL,
        'section_key' => NULL,
      ],
    ],
    'in_kicker' => [
      'variables' => [
        'show_in_kicker' => TRUE,
        'in_kicker_items' => [],
        'in_kicker_section' => '',
      ],
      // Default fallback template inside this module — overridden by
      // the customsolent theme's templates/components/in-kicker.html.twig.
      'template' => 'in-kicker',
    ],
    'from_kicker' => [
      'variables' => [
        'show_primary_kicker' => TRUE,
        'primary_kicker_ancestors' => [],
        'primary_kicker_also_in' => [],
        'primary_kicker_here_in' => [],
        'primary_kicker_section' => '',
      ],
      // The theme's existing file is primary-kicker.html.twig — name
      // the default template here to match, so theme override works
      // by simply having the file in the theme's templates/ tree.
      'template' => 'primary-kicker',
    ],
  ];
}

/**
 * Implements hook_views_pre_build().
 *
 * Fix: the core search results pager never appeared. Search results can
 * include composite/landing pages; SearchNode::prepareResults() renders each
 * result node, which executes any view_display paragraphs embedded in it.
 * Each such view's pager re-registers pager element 0 and overwrites the
 * search query's pager (e.g. 186 items -> 3 items, 1 page), so pager.html.twig
 * renders nothing — and the anonymous page cache then freezes the pagerless
 * page. (Warm render caches skip the node renders, which made this maddening
 * to reproduce: drush probes paged fine while the web page never did.)
 *
 * On the search results route those embedded views are only ever rendered
 * inside result nodes — they display a handful of teaser rows and never show
 * their own pager UI there — so give them a non-paginating pager at runtime.
 * Section pages are untouched and keep their normal view pagination.
 */
function customsolent_helpers_views_pre_build(\Drupal\views\ViewExecutable $view) {
  if (\Drupal::routeMatch()->getRouteName() !== 'search.view_node_search') {
    return;
  }
  $pager = $view->display_handler->getOption('pager') ?: [];
  if (($pager['type'] ?? 'none') === 'some' || ($pager['type'] ?? 'none') === 'none') {
    return;
  }
  $view->display_handler->setOption('pager', [
    'type' => 'some',
    'options' => [
      'items_per_page' => $pager['options']['items_per_page'] ?? 10,
      'offset' => $pager['options']['offset'] ?? 0,
    ],
  ]);
}

/**
 * TRUE when the given node is the site's front page.
 */
function _customsolent_helpers_is_front_page_node(\Drupal\node\NodeInterface $node): bool {
  if ($node->isNew()) {
    return FALSE;
  }
  $front = (string) \Drupal::config('system.site')->get('page.front');
  $internal = \Drupal::service('path_alias.manager')->getPathByAlias($front);
  return $internal === '/node/' . $node->id();
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 *
 * The home page is a Composite Page, but it must stay uncategorised:
 * a primary topic on it would switch on section behaviour that is
 * meant for section pages only — a topic breadcrumb trail, topic-scoped
 * listings and kickers, and the page being offered as the landing page
 * that topic terms link to. All of that logic is keyed on the topic
 * fields being non-empty, so keeping them empty keeps it off. Hide the
 * fields on the front page's edit form so they can't be set by accident.
 */
function customsolent_helpers_form_node_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id): void {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node instanceof \Drupal\node\NodeInterface) {
    return;
  }
  // Person: the title is "First Last", composed from the two name fields.
  // The title widget is left out of the form display; this builder fills
  // the title before entity validation so the NotNull constraint passes.
  if ($node->bundle() === 'person') {
    $form['#entity_builders'][] = 'customsolent_helpers_person_title_builder';
  }
  if (!_customsolent_helpers_is_front_page_node($node)) {
    return;
  }
  foreach (['field_primary_topic', 'field_related_topics'] as $field_name) {
    if (isset($form[$field_name])) {
      $form[$field_name]['#access'] = FALSE;
    }
  }
}

/**
 * URL words that have an automated listing page today.
 */
function customsolent_helpers_listing_route_words(): array {
  return ['events', 'articles', 'series', 'collaborations', 'organisations'];
}

/**
 * URL words a topic term may not use as its name.
 *
 * /{topic path}/{word} is the automated listing page for that topic, so a
 * child topic called "Events" would collide with its parent's events
 * listing. "links" is reserved ahead of being built.
 */
function customsolent_helpers_reserved_listing_words(): array {
  return ['events', 'organisations', 'links', 'articles', 'series', 'collaborations'];
}

/**
 * Implements hook_form_FORM_ID_alter() for the Topic term form.
 */
function customsolent_helpers_form_taxonomy_term_topic_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id): void {
  $form['#validate'][] = 'customsolent_helpers_topic_term_validate';
}

/**
 * Refuses a topic name whose last segment is a reserved listing word.
 *
 * Top-level terms are exempt: "Explore / Events" is a child of Explore and
 * is the all-events page itself, which predates the rule and is the one
 * place the word is wanted.
 */
function customsolent_helpers_topic_term_validate(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $name = (string) ($form_state->getValue(['name', 0, 'value']) ?? '');
  $parts = explode(' / ', $name);
  $last = trim((string) end($parts));
  $slug = trim((string) preg_replace('/[^a-z0-9]+/', '-', mb_strtolower($last)), '-');
  if (!in_array($slug, customsolent_helpers_reserved_listing_words(), TRUE)) {
    return;
  }
  if (str_starts_with($name, 'Explore / ')) {
    return;
  }
  $form_state->setErrorByName('name', t('"@word" cannot be used as a topic name: the address ending /@slug is the automatic @slug listing for the parent topic. Choose another name, such as "@word & …".', ['@word' => $last, '@slug' => $slug]));
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for paragraphs.
 *
 * Listings and the section filter change with ?topic= and
 * ?date_filter_id=, so their cached output must vary by them.
 *
 * This lived in customsolent.theme until 2026-09-20, where it never ran:
 * entity view-alter hooks are invoked on MODULES only, not themes. Nothing
 * showed, because every listing used to render a paged view, which brings
 * the broad "url" cache context with it. Preview blocks do not always
 * render a view (an empty block renders nothing), so /culture got cached
 * in whatever filter state was visited first.
 */
function customsolent_helpers_paragraph_view_alter(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display): void {
  if (in_array($entity->bundle(), ['view_display', 'section_filter', 'heading'], TRUE)) {
    $build['#cache']['contexts'][] = 'url.query_args:topic';
    $build['#cache']['contexts'][] = 'url.query_args:date_filter_id';
    foreach (customsolent_helpers_facet_query_args() as $ctx) {
      $build['#cache']['contexts'][] = $ctx;
    }
  }
}

/**
 * The URL slug of a Format term's plural: "Club Nights & Parties" ->
 * club-nights-parties, "Drop-ins" -> drop-ins. Same rule as the topic URLs.
 */
function customsolent_helpers_format_slug(string $name): string {
  $name = preg_replace('/(?<=\S)&(?=\S)/', '-and-', $name);
  return trim(preg_replace('/[^a-z0-9]+/', '-', strtolower($name)) ?? '', '-');
}

/**
 * The Format terms in vocabulary order, keyed by tid.
 *
 * Each: tid, name, plural (field_plural_label, else the name), slug,
 * summary (field_reader_summary), url (the landing page), term.
 */
function customsolent_helpers_format_terms(): array {
  $cache = &drupal_static(__FUNCTION__);
  if ($cache !== NULL) {
    return $cache;
  }
  $cache = [];
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach ($storage->loadTree('format', 0, 1, TRUE) as $term) {
    if (!$term->isPublished()) {
      continue;
    }
    $plural = ($term->hasField('field_plural_label') && !$term->get('field_plural_label')->isEmpty())
      ? (string) $term->get('field_plural_label')->value : $term->label();
    // The landing page is named in the plural: /events/festivals, /events/talks.
    $slug = customsolent_helpers_format_slug($plural);
    $cache[(int) $term->id()] = [
      'tid' => (int) $term->id(),
      'name' => $term->label(),
      'plural' => $plural,
      'slug' => $slug,
      'summary' => ($term->hasField('field_reader_summary') && !$term->get('field_reader_summary')->isEmpty())
        ? (string) $term->get('field_reader_summary')->value : '',
      'url' => customsolent_helpers_sitewide_listing_url('events') . '/' . $slug,
      'term' => $term,
    ];
  }
  return $cache;
}

/**
 * The Format term for a URL slug, or NULL.
 */
function customsolent_helpers_format_by_slug(string $slug): ?\Drupal\taxonomy\TermInterface {
  foreach (customsolent_helpers_format_terms() as $f) {
    if ($f['slug'] === $slug) {
      return $f['term'];
    }
  }
  return NULL;
}

/**
 * The format narrowing the current request, as a term id, or NULL.
 *
 * Set by the landing page (/explore/events/festivals puts it on the request) or
 * by ?format=<slug> on any listing. An unknown slug narrows nothing.
 */
function customsolent_helpers_active_format_tid(): ?int {
  $request = \Drupal::request();
  if ($request->attributes->has('slnt_format_tid')) {
    return (int) $request->attributes->get('slnt_format_tid') ?: NULL;
  }
  $slug = $request->query->get('format');
  if (is_string($slug) && $slug !== '') {
    $term = customsolent_helpers_format_by_slug($slug);
    return $term ? (int) $term->id() : NULL;
  }
  return NULL;
}

/**
 * Listing views whose results can be narrowed by a format.
 *
 * Links carry no format, so a format on a directory simply leaves them
 * out, which is right: a format is a shape of event.
 */
function customsolent_helpers_format_filtered_views(): array {
  return ['events_listing', 'organisations_listing', 'directory_listing', 'links_listing', 'series_listing'];
}

/**
 * The further facets beside Topic and Format (issues 422 and 463): what an
 * event costs and who it is for by age. Each is a vocabulary, a field on
 * events, a query parameter and a sidebar group, built the same way as
 * Format but without landing pages. Keyed by the query parameter.
 *
 * Each: vid, field (on node), label (group title), all_label ("Any cost"),
 * kind (the data-filter-toggle / panel word), types (node types that carry
 * it), views (listing views it narrows: only events).
 */
function customsolent_helpers_facets(): array {
  return [
    'cost' => [
      'vid' => 'event_cost',
      'field' => 'field_cost',
      'label' => t('Cost'),
      'all_label' => t('Any cost'),
      'kind' => 'costs',
      'types' => ['event'],
      'views' => ['events_listing'],
    ],
    'age' => [
      'vid' => 'age_group',
      'field' => 'field_age_group',
      'label' => t('Age group'),
      'all_label' => t('All ages'),
      'kind' => 'ages',
      'types' => ['event'],
      'views' => ['events_listing'],
    ],
  ];
}

/**
 * The terms of a facet's vocabulary in order, keyed by tid: tid, name,
 * slug, summary (description, plain), from, to (age bounds when present).
 */
function customsolent_helpers_facet_terms(string $facet): array {
  $cache = &drupal_static(__FUNCTION__, []);
  if (isset($cache[$facet])) {
    return $cache[$facet];
  }
  $cache[$facet] = [];
  $def = customsolent_helpers_facets()[$facet] ?? NULL;
  if (!$def) {
    return [];
  }
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach ($storage->loadTree($def['vid'], 0, 1, TRUE) as $term) {
    if (!$term->isPublished()) {
      continue;
    }
    $cache[$facet][(int) $term->id()] = [
      'tid' => (int) $term->id(),
      'name' => $term->label(),
      'slug' => customsolent_helpers_format_slug($term->label()),
      'summary' => trim(strip_tags((string) $term->getDescription())),
      'from' => $term->hasField('field_age_from') && !$term->get('field_age_from')->isEmpty() ? (int) $term->get('field_age_from')->value : NULL,
      'to' => $term->hasField('field_age_to') && !$term->get('field_age_to')->isEmpty() ? (int) $term->get('field_age_to')->value : NULL,
      'term' => $term,
    ];
  }
  return $cache[$facet];
}

/**
 * The term of a facet narrowing the current request (?cost=free,
 * ?age=ages-5-to-11), as a term id, or NULL. An unknown slug narrows nothing.
 */
function customsolent_helpers_active_facet_tid(string $facet): ?int {
  $slug = \Drupal::request()->query->get($facet);
  if (!is_string($slug) || $slug === '') {
    return NULL;
  }
  foreach (customsolent_helpers_facet_terms($facet) as $tid => $t) {
    if ($t['slug'] === $slug) {
      return $tid;
    }
  }
  return NULL;
}

/**
 * The query parameters of every facet (format, cost, age), for cache contexts.
 *
 * @return string[]
 */
function customsolent_helpers_facet_query_args(): array {
  return array_map(static fn($p) => 'url.query_args:' . $p, array_merge(['format', 'place'], array_keys(customsolent_helpers_facets())));
}

/**
 * Listing views whose results can be narrowed by ?topic=.
 */
function customsolent_helpers_topic_filtered_views(): array {
  return ['events_listing', 'articles_listing', 'organisations_listing', 'links_listing', 'directory_listing', 'series_listing', 'collaborations_listing'];
}

/**
 * The site-wide listing page for a content type, by listing URL word.
 *
 * Where a "Preview, all topics" block's "View more" goes, and where the
 * section strip and the by-topic listing route hand over for such a block.
 * These are Explore landing pages (nodes 92, 91, 338, 94 and 95) addressed by their
 * path aliases rather than their IDs, so the alias stays the single source
 * of truth. If one of those pages is ever moved, update it here.
 */
function customsolent_helpers_sitewide_listing_url(string $type_word): ?string {
  return [
    'articles' => '/explore/articles',
    'events' => '/explore/events',
    'organisations' => '/explore/organisations',
    'series' => '/explore/series',
    'collaborations' => '/explore/collaborations',
    // Explore / Locations: the map page, home of every place (Location epic).
    'places' => '/explore/locations',
  ][$type_word] ?? NULL;
}

/**
 * When a field_when item is over: its end, or, entered without one (end =
 * start), the end of that day in the event's timezone. The theme's
 * _customsolent_event_item_end() delegates here so the cards, the page and
 * the listings' query (which applies the same rule in SQL) never disagree.
 *
 * With $on_time (the event's Arrival is "Be there for the start") the item
 * is over the moment it starts: nobody can still go, so the listings drop
 * it, a regular event's "Next:" moves on, and the page says "Past event"
 * from then (Rob, 22 Nov 2026). The entered end still prints as the times.
 */
function customsolent_helpers_item_end(int $start, int $end, ?string $timezone = NULL, bool $on_time = FALSE): int {
  if ($start <= 0) {
    return $end;
  }
  if ($on_time) {
    return $start;
  }
  if ($end > $start) {
    return $end;
  }
  $tz = new \DateTimeZone($timezone ?: (\Drupal::config('system.date')->get('timezone.default') ?: 'Europe/London'));
  return (new \DateTimeImmutable('@' . $start))->setTimezone($tz)->modify('tomorrow')->getTimestamp();
}

/**
 * Whether an event asks people to be there for the start (field_arrival).
 *
 * Such an event is over for a reader once it has started; see
 * customsolent_helpers_item_end().
 */
function customsolent_helpers_event_on_time(\Drupal\Core\Entity\FieldableEntityInterface $node): bool {
  return $node->hasField('field_arrival') && (string) $node->get('field_arrival')->value === 'on_time';
}

/**
 * Whether every date of an event is over, by the listings' clock.
 *
 * A regular event holds one field_when item per instance, so this is TRUE
 * once its last instance has ended. The page's "Past event" badge, the
 * cards' missing button and the series page's "Past events" group all
 * read this; the listings' query applies the same rule in SQL
 * (_customsolent_helpers_one_row_per_recurring_event).
 */
function customsolent_helpers_event_has_ended(\Drupal\node\NodeInterface $node, ?int $now = NULL): bool {
  if (!$node->hasField('field_when') || $node->get('field_when')->isEmpty()) {
    return FALSE;
  }
  $now ??= \Drupal::time()->getRequestTime();
  $on_time = customsolent_helpers_event_on_time($node);
  $last_end = 0;
  foreach ($node->get('field_when') as $item) {
    $last_end = max($last_end, customsolent_helpers_item_end((int) $item->value, (int) $item->end_value, $item->timezone ?: NULL, $on_time));
  }
    return $last_end > 0 && $last_end < $now;
}

/**
 * The next date of an event that is still to come: start, end (by the
 * listings' clock), duration (minutes) and timezone, or NULL when every
 * date is over. A regular event's instance in a closure Break or outside
 * its season is skipped, as the listings and the cards' "Next:" skip it.
 *
 * @return array{start: int, end: int, duration: int, tz: string}|null
 */
function customsolent_helpers_event_next_instance(\Drupal\node\NodeInterface $node, ?int $now = NULL): ?array {
  if (!$node->hasField('field_when') || $node->get('field_when')->isEmpty()) {
    return NULL;
  }
  $now ??= \Drupal::time()->getRequestTime();
  $on_time = customsolent_helpers_event_on_time($node);
  $season_from = $node->hasField('field_season_from') ? (int) $node->get('field_season_from')->value : 0;
  $season_to = $node->hasField('field_season_to') ? (int) $node->get('field_season_to')->value : 0;
  $nid = (int) $node->id();
  $default_tz = \Drupal::config('system.date')->get('timezone.default') ?: 'Europe/London';
  $best = NULL;
  foreach ($node->get('field_when') as $item) {
    $start = (int) $item->value;
    if ($start <= 0 || ($best !== NULL && $start >= $best['start'])) {
      continue;
    }
    $end = customsolent_helpers_item_end($start, (int) $item->end_value, $item->timezone ?: NULL, $on_time);
    if ($end < $now) {
      continue;
    }
    $tz = $item->timezone ?: $default_tz;
    if (!empty($item->rrule)) {
      $month = (int) (new \DateTimeImmutable('@' . $start))->setTimezone(new \DateTimeZone($tz))->format('n');
      if (!customsolent_helpers_in_season($month, $season_from ?: NULL, $season_to ?: NULL)) {
        continue;
      }
      $break = customsolent_helpers_break_for($nid, $start);
      if ($break && $break['kind'] === 'closure') {
        continue;
      }
    }
    $best = ['start' => $start, 'end' => $end, 'duration' => (int) $item->duration, 'tz' => $tz];
  }
  return $best;
}

/**
 * A date as the Locations panel prints it: "23 Nov, 9pm" ("23 Nov" for an
 * all-day date; "9:30pm" when not on the hour).
 */
function customsolent_helpers_short_when(array $instance): string {
  $d = (new \DateTimeImmutable('@' . $instance['start']))->setTimezone(new \DateTimeZone($instance['tz']));
  $text = $d->format('j M');
  if ($instance['duration'] < 1439) {
    $text .= ', ' . ($d->format('i') === '00' ? $d->format('ga') : $d->format('g:ia'));
  }
  return $text;
}

/**
 * The published Breaks (holidays and closures regular events observe),
 * resolved to what they touch.
 *
 * Each: nid, title, kind (advisory|closure), note, ranges [[start, end]],
 * scope (all|organisations|events), nids (event nids when scoped; the
 * organisations' regular events are looked up here, once). Cached until a
 * Break, an event or an organisation is saved.
 *
 * @return array[]
 */
function customsolent_helpers_breaks(): array {
  $static = &drupal_static(__FUNCTION__);
  if ($static !== NULL) {
    return $static;
  }
  $cid = 'customsolent_helpers.breaks';
  if ($cached = \Drupal::cache()->get($cid)) {
    return $static = $cached->data;
  }
  $breaks = [];
  $etm = \Drupal::entityTypeManager();
  if ($etm->getStorage('node_type')->load('break')) {
    $nids = $etm->getStorage('node')->getQuery()->accessCheck(FALSE)->condition('type', 'break')->condition('status', 1)->execute();
    $db = \Drupal::database();
    foreach ($etm->getStorage('node')->loadMultiple($nids) as $node) {
      $ranges = [];
      if ($node->hasField('field_when')) {
        foreach ($node->get('field_when') as $item) {
          $start = (int) $item->value;
          if ($start > 0) {
            $ranges[] = [$start, customsolent_helpers_item_end($start, (int) $item->end_value, $item->timezone ?: NULL)];
          }
        }
      }
      if (!$ranges) {
        continue;
      }
      $scope = $node->hasField('field_break_scope') ? ((string) $node->get('field_break_scope')->value ?: 'all') : 'all';
      $event_nids = [];
      if ($scope === 'events' && $node->hasField('field_break_events')) {
        $event_nids = array_map(fn($i) => (int) $i['target_id'], $node->get('field_break_events')->getValue());
      }
      elseif ($scope === 'organisations' && $node->hasField('field_organisers')) {
        $org_nids = array_map(fn($i) => (int) $i['target_id'], $node->get('field_organisers')->getValue());
        if ($org_nids) {
          $event_nids = array_map('intval', $db->query('SELECT DISTINCT o.entity_id FROM {node__field_organisers} o WHERE o.bundle = :b AND o.field_organisers_target_id IN (:orgs[])', [':b' => 'event', ':orgs[]' => $org_nids])->fetchCol());
        }
      }
      if ($scope !== 'all' && !$event_nids) {
        // Scoped to nothing: touches nothing.
        continue;
      }
      $breaks[] = [
        'nid' => (int) $node->id(),
        'title' => $node->label(),
        'kind' => $node->hasField('field_break_kind') && $node->get('field_break_kind')->value === 'closure' ? 'closure' : 'advisory',
        'note' => $node->hasField('field_break_note') ? trim((string) $node->get('field_break_note')->value) : '',
        'ranges' => $ranges,
        'scope' => $scope,
        'nids' => array_values(array_unique($event_nids)),
      ];
    }
  }
  // Closures first, so the first match for an instance is the stronger one.
  usort($breaks, static fn($a, $b) => ($a['kind'] === 'closure' ? 0 : 1) <=> ($b['kind'] === 'closure' ? 0 : 1));
  \Drupal::cache()->set($cid, $breaks, \Drupal\Core\Cache\Cache::PERMANENT, ['node_list:break', 'node_list:event', 'node_list:organisation']);
  return $static = $breaks;
}

/**
 * The Break an instance of a regular event falls in, if any: a closure
 * before an advisory.
 */
function customsolent_helpers_break_for(int $event_nid, int $instance_start): ?array {
  foreach (customsolent_helpers_breaks() as $break) {
    if ($break['scope'] !== 'all' && !in_array($event_nid, $break['nids'], TRUE)) {
      continue;
    }
    foreach ($break['ranges'] as [$start, $end]) {
      if ($instance_start >= $start && $instance_start < $end) {
        return $break;
      }
    }
  }
  return NULL;
}

/**
 * The line by a date that falls in an advisory Break.
 */
function customsolent_helpers_break_notice(array $break): string {
  if ($break['note'] !== '') {
    return $break['note'];
  }
  return (string) t('Falls in the @break: check with the organiser', ['@break' => $break['title']]);
}

/**
 * TRUE when a month is inside a season (from..to, which may wrap the year:
 * October to March). No season (either end empty) is all year.
 */
function customsolent_helpers_in_season(int $month, ?int $from, ?int $to): bool {
  if (!$from || !$to) {
    return TRUE;
  }
  return $from <= $to ? ($month >= $from && $month <= $to) : ($month >= $from || $month <= $to);
}

/**
 * Implements hook_views_query_alter().
 *
 * Makes ?topic=<tid> work as a filter WITHIN a list, for the listings whose
 * own scope is not a Culture / Sectors / Living topic:
 *   - Explore → Directories & Networks is scoped to its own Explore term;
 *   - Explore → Organisations has no topic scope at all.
 * On those pages the section filter offers Culture / Sectors / Living, and
 * choosing one must AND with the list rather than replace its scope.
 *
 * Elsewhere ?topic= is "consumed": the paragraph preprocess narrows the
 * view's topic arguments to the chosen sub-tree. That case is detected by
 * the chosen term being among the view's arguments, and left alone.
 */
function customsolent_helpers_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if ($view->id() === 'events_listing' && $query instanceof \Drupal\views\Plugin\views\query\Sql) {
    _customsolent_helpers_one_row_per_recurring_event($query);
  }
  // A format (issue 485) narrows the listing to items carrying it: the
  // landing page /events/<format>, or ?format=<slug> on any listing. Its
  // own AND group, never group 0 (the OR of the topic arguments).
  $format_tid = customsolent_helpers_active_format_tid();
  if ($format_tid && in_array($view->id(), customsolent_helpers_format_filtered_views(), TRUE)
    && $view->current_display !== 'view_display_front_page'
    && $query instanceof \Drupal\views\Plugin\views\query\Sql) {
    $with_format = \Drupal::database()->select('node__field_format', 'slnt_f')->fields('slnt_f', ['entity_id'])
      ->condition('slnt_f.field_format_target_id', $format_tid);
    $query->setWhereGroup('AND', 'slnt_format');
    $query->addWhere('slnt_format', 'node_field_data.nid', $with_format, 'IN');
  }
  // A place (Location epic, issue 440) narrows a listing to what is at it
  // or anywhere beneath it: the place page, or ?place=<slug>.
  $place_tids = customsolent_helpers_active_place_tids();
  if ($place_tids && in_array($view->id(), customsolent_helpers_place_filtered_views(), TRUE)
    && $view->current_display !== 'view_display_front_page'
    && $query instanceof \Drupal\views\Plugin\views\query\Sql) {
    $at_place = \Drupal::database()->select('node__field_where', 'slnt_w')->fields('slnt_w', ['entity_id'])
      ->condition('slnt_w.field_where_target_id', $place_tids, 'IN');
    $query->setWhereGroup('AND', 'slnt_place');
    $query->addWhere('slnt_place', 'node_field_data.nid', $at_place, 'IN');
  }
  // Cost and age group (issues 422, 463) narrow the same way, by their own
  // field, on the listings of the types that carry them.
  if ($view->current_display !== 'view_display_front_page' && $query instanceof \Drupal\views\Plugin\views\query\Sql) {
    foreach (customsolent_helpers_facets() as $param => $def) {
      $tid = customsolent_helpers_active_facet_tid($param);
      if (!$tid || !in_array($view->id(), $def['views'], TRUE)) {
        continue;
      }
      $table = 'node__' . $def['field'];
      $with = \Drupal::database()->select($table, 'slnt_' . $param)->fields('slnt_' . $param, ['entity_id'])
        ->condition('slnt_' . $param . '.' . $def['field'] . '_target_id', $tid);
      $query->setWhereGroup('AND', 'slnt_' . $param);
      $query->addWhere('slnt_' . $param, 'node_field_data.nid', $with, 'IN');
    }
  }
  if (!in_array($view->id(), customsolent_helpers_topic_filtered_views(), TRUE)
    || $view->current_display === 'view_display_front_page'
    || !$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }
  $topic = \Drupal::request()->query->get('topic');
  if (!is_numeric($topic) || (int) $topic <= 0) {
    return;
  }
  $tid = (int) $topic;
  $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid);
  if (!$term || $term->bundle() !== 'topic') {
    return;
  }
  // Already consumed as the view's topic scope? Only a display that HAS
  // contextual filters can consume it — the paragraph template passes the
  // scope as arguments to every display, and one without argument handlers
  // (Explore → Organisations) silently ignores them.
  if (!empty($view->argument)) {
    foreach ($view->args as $arg) {
      if (in_array((string) $tid, preg_split('/[+,\s]+/', (string) $arg), TRUE)) {
        return;
      }
    }
  }
  // The chosen term and everything beneath it.
  $tids = [$tid];
  foreach (\Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('topic', $tid) as $child) {
    $tids[] = (int) $child->tid;
  }
  $db = \Drupal::database();
  $primary = $db->select('node__field_primary_topic', 'slnt_p')->fields('slnt_p', ['entity_id'])
    ->condition('slnt_p.field_primary_topic_target_id', $tids, 'IN');
  $related = $db->select('node__field_related_topics', 'slnt_r')->fields('slnt_r', ['entity_id'])
    ->condition('slnt_r.field_related_topics_target_id', $tids, 'IN');
  $query->setWhereGroup('OR', 'slnt_topic_within');
  $query->addWhere('slnt_topic_within', 'node_field_data.nid', $primary, 'IN');
  $query->addWhere('slnt_topic_within', 'node_field_data.nid', $related, 'IN');
}

/**
 * The display name of a Person: first name, a space, last name.
 */
function customsolent_helpers_person_title(\Drupal\node\NodeInterface $node): string {
  $first = trim((string) ($node->get('field_first_name')->value ?? ''));
  $last = trim((string) ($node->get('field_last_name')->value ?? ''));
  return trim(preg_replace('/\s+/u', ' ', "$first $last") ?? '');
}

/**
 * Entity builder for the Person form: compose the title from the names.
 */
function customsolent_helpers_person_title_builder(string $entity_type, \Drupal\node\NodeInterface $node, array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $title = customsolent_helpers_person_title($node);
  if ($title !== '') {
    $node->setTitle($title);
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for node.
 *
 * Programmatic saves (scripts, migrations) get the same composed title as
 * the form; a Person is never saved with a title that disagrees with its
 * name fields.
 */
function customsolent_helpers_node_presave(\Drupal\node\NodeInterface $node): void {
  if ($node->bundle() === 'person') {
    $title = customsolent_helpers_person_title($node);
    if ($title !== '') {
      $node->setTitle($title);
    }
  }
  // A new node that arrives already carrying a recurrence rule id (an
  // import, a clone made some other way than quick_node_clone) must not
  // share that rule with the node it came from — see
  // customsolent_helpers_cloned_node_alter().
  if ($node->isNew()) {
    customsolent_helpers_own_recurrence_rules($node, TRUE);
  }
}

/**
 * Implements hook_cloned_node_alter() (quick_node_clone).
 *
 * Smart Date Recur keeps a recurring event's rule ("every Wednesday and
 * Thursday") in its own smart_date_rule entity and stores only that rule's
 * id on each field_when item. A clone copies the field values, id
 * included, so the clone and the original point at ONE rule; saving either
 * then rewrites that rule in place and the other event's days change too
 * (issue 462: nodes 914, 916, 918). Give the clone its own copy of every
 * rule before its form is shown, so the save updates the copy.
 */
function customsolent_helpers_cloned_node_alter(\Drupal\node\NodeInterface &$node, \Drupal\node\NodeInterface $original): void {
  customsolent_helpers_own_recurrence_rules($node, FALSE);
}

/**
 * Implements hook_cron().
 *
 * Deletes recurrence-rule copies made by
 * customsolent_helpers_own_recurrence_rules() that no node references a
 * day later: the clone form makes a copy each time it is built, so an
 * abandoned clone, and the GET before a POST, each leave one behind.
 * Smart Date Recur itself only skips such rules.
 */
function customsolent_helpers_cron(): void {
  customsolent_helpers_unpublish_ended_series();
  $state = \Drupal::state();
  $made = $state->get('customsolent_helpers.recurrence_rule_copies', []);
  if (!$made || !\Drupal::moduleHandler()->moduleExists('smart_date_recur')) {
    return;
  }
  $cutoff = \Drupal::time()->getRequestTime() - 86400;
  $db = \Drupal::database();
  foreach ($made as $rid => $when) {
    if ($when > $cutoff) {
      continue;
    }
    $rule = \Drupal\smart_date_recur\Entity\SmartDateRule::load($rid);
    if ($rule) {
      $table = $rule->entity_type->getString() . '__' . $rule->field_name->getString();
      $column = $rule->field_name->getString() . '_rrule';
      $referenced = $db->schema()->tableExists($table)
        && $db->query("SELECT 1 FROM {{$table}} WHERE $column = :rid LIMIT 1", [':rid' => $rid])->fetchField();
      if (!$referenced) {
        $rule->delete();
        \Drupal::logger('customsolent_helpers')->notice('Deleted unused recurrence rule copy @rid.', ['@rid' => $rid]);
      }
    }
    unset($made[$rid]);
  }
  $state->set('customsolent_helpers.recurrence_rule_copies', $made);
}

/**
 * Unpublishes every published series that has ended and is marked
 * "Unpublish when it ends" (field_unpublish_at_end).
 *
 * A throwaway series (Halloween, Bonfire Night) is a label for a week or
 * two; once it is over, an event's page saying it was "part of a past
 * series: Halloween" and the series listing still offering it are noise.
 * A series worth keeping (Black History Month) is left unticked and stays
 * as a past series. "Ended" is the series' own rule (ContentRelations::
 * seriesStatus): the day after its end date, in the site's timezone. Run
 * by cron (hook_cron, above), so a series goes the morning after; with
 * $dry_run nothing is saved. Returns the titles handled, keyed by nid.
 *
 * @return array<int, string>
 */
function customsolent_helpers_unpublish_ended_series(bool $dry_run = FALSE): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  if (!isset(\Drupal::service('entity_field.manager')->getFieldDefinitions('node', 'series')['field_unpublish_at_end'])) {
    return [];
  }
  $nids = $storage->getQuery()->accessCheck(FALSE)
    ->condition('type', 'series')
    ->condition('status', 1)
    ->condition('field_unpublish_at_end', 1)
    ->execute();
  if (!$nids) {
    return [];
  }
  /** @var \Drupal\customsolent_helpers\ContentRelations $relations */
  $relations = \Drupal::service('customsolent_helpers.content_relations');
  $done = [];
  foreach ($storage->loadMultiple($nids) as $series) {
    if ($relations->seriesStatus($series) !== $relations::STATUS_PAST) {
      continue;
    }
    $done[(int) $series->id()] = $series->label();
    if ($dry_run) {
      continue;
    }
    [, $end] = $relations->seriesDates($series);
    $series->setUnpublished();
    $series->setNewRevision();
    $series->setRevisionCreationTime(\Drupal::time()->getRequestTime());
    $series->setRevisionLogMessage(sprintf('Unpublished automatically: the series ended on %s and is marked "Unpublish when it ends".', $end));
    $series->save();
    \Drupal::logger('customsolent_helpers')->notice('Unpublished series @title (@nid): it ended on @end and is marked to be unpublished when it ends.', ['@title' => $series->label(), '@nid' => $series->id(), '@end' => $end]);
  }
  return $done;
}

/**
 * Replaces the recurrence rules referenced by $node with copies of its own.
 *
 * Every Smart Date field on the node is covered. With $only_if_shared a
 * rule is copied only when some other node already references it (one
 * query per rule); without it every rule is copied (the clone case, where
 * the original certainly still references them). Returns the number of
 * rules copied.
 */
function customsolent_helpers_own_recurrence_rules(\Drupal\node\NodeInterface $node, bool $only_if_shared): int {
  if (!\Drupal::moduleHandler()->moduleExists('smart_date_recur')) {
    return 0;
  }
  $copies = [];
  foreach ($node->getFieldDefinitions() as $field_name => $definition) {
    if ($definition->getType() !== 'smartdate' || !$node->hasField($field_name)) {
      continue;
    }
    foreach ($node->get($field_name) as $item) {
      $rid = (int) ($item->rrule ?? 0);
      if (!$rid) {
        continue;
      }
      if (!array_key_exists($rid, $copies)) {
        $copies[$rid] = NULL;
        $shared = TRUE;
        if ($only_if_shared) {
          $query = \Drupal::entityQuery('node')->accessCheck(FALSE)->condition("$field_name.rrule", $rid);
          if (!$node->isNew()) {
            $query->condition('nid', $node->id(), '<>');
          }
          $shared = (bool) $query->range(0, 1)->count()->execute();
        }
        if ($shared) {
          $rule = \Drupal\smart_date_recur\Entity\SmartDateRule::load($rid);
          if ($rule) {
            $copy = $rule->createDuplicate();
            $copy->save();
            $copies[$rid] = (int) $copy->id();
            // Remember the copy so cron can sweep it if the form it was made
            // for is never saved (the clone form copies on every request).
            $state = \Drupal::state();
            $made = $state->get('customsolent_helpers.recurrence_rule_copies', []);
            $made[(int) $copy->id()] = \Drupal::time()->getRequestTime();
            $state->set('customsolent_helpers.recurrence_rule_copies', $made);
          }
        }
      }
      if ($copies[$rid]) {
        $item->rrule = $copies[$rid];
      }
    }
  }
  return count(array_filter($copies));
}


/**
 * Keeps a recurring event to one row in the events listings.
 *
 * Smart Date Recur stores one field_when item per instance (a weekly event
 * holds a year of Mondays), and the listings join that table and sort by
 * it, so without this every instance would be its own card. For items that
 * belong to a rule, keep only the rule's earliest instance that has not yet
 * ended; items without a rule must not have ended either. "Not yet ended" is measured
 * against the clock, not against today: the card's "Next: …" line
 * (customsolent.theme) moves on the moment an instance ends, and the row
 * the event sorts by has to move with it, or a regular event whose 7pm
 * instance has finished still sorts among this evening's events while its
 * card already names next week (issue 465). A finished event, regular or
 * one-off, therefore has no row in any listing, which the upcoming-only
 * displays already imply.
 *
 * An item entered without an end time (stored as end = start) has no
 * known finish, so it is taken to run to the end of its day: the row stays
 * until the site's local midnight, and the page's "Past event" badge
 * (customsolent.theme, _customsolent_event_item_end()) appears at the same
 * moment. Before 14 Nov 2026 the page called such an event past from its
 * start time while the listing kept it until midnight (private issue 17:
 * a page marked past still listed on the front page).
 *
 * The clock is the database's (UNIX_TIMESTAMP()), not a query argument:
 * the Views results cache is keyed on the query and its arguments, and a
 * per-request timestamp would make every execution a cache miss that
 * leaves a permanent entry behind. With a stable query the results are
 * cached once and expired by the view's cache plugin (EventsTag) at the
 * first moment they can change; the end and rule columns added here are
 * what it reads to find that moment.
 */
function _customsolent_helpers_one_row_per_recurring_event(\Drupal\views\Plugin\views\query\Sql $query): void {
  $alias = $query->ensureTable('node__field_when');
  if (!$alias) {
    return;
  }
  // The event's Arrival ("Be there for the start"): one row per event, so
  // the outer join serves the correlated subquery below as well.
  $arrival = $query->ensureTable('node__field_arrival');
  $on_time = $arrival ? "$arrival.field_arrival_value = 'on_time'" : '0';
  // Its own AND group. Group 0 holds the topic contextual filters, which
  // views_contextual_filters_or turns into an OR group — a condition added
  // there would be OR-ed with the topic match and let every one-off event
  // through on every section page (regression seen 2026-10-18).
  $group = $query->setWhereGroup('AND');
  $args = [];
  if (\Drupal::database()->databaseType() === 'mysql') {
    $now = 'UNIX_TIMESTAMP()';
  }
  else {
    // Other engines: a request-time argument (correct, but every execution
    // is then a results-cache miss, see above).
    $now = ':slnt_now';
    $args[':slnt_now'] = \Drupal::time()->getRequestTime();
  }
  // Local midnight this morning, as a literal like the view's own "today"
  // filter: the query text changes once a day, so the cached results do
  // too, and the cache plugin expires them at midnight regardless.
  $today = (new \DateTimeImmutable('today', new \DateTimeZone(date_default_timezone_get())))->getTimestamp();
  // "Not yet ended" for a row of field_when: an event people must be there
  // at the start of has not started; otherwise an item with an end time
  // has not reached it; one without (end = start) is still on its day.
  // One-off events follow the same clock as instances: a 7-10pm event
  // leaves the listings at 10pm, not at midnight (the same rule as
  // customsolent_helpers_item_end()).
  $not_ended = static fn(string $t): string =>
    "(CASE WHEN $on_time THEN $t.field_when_value >= $now
           WHEN $t.field_when_end_value > $t.field_when_value
           THEN $t.field_when_end_value >= $now
           ELSE $t.field_when_value >= $today END)";
  // A regular event's instance that falls in a closure Break, or outside the
  // event's season, is not a candidate for "the next one": the listing moves
  // on to the first open date, and leaves the event out while none is open.
  // (The theme applies the same rule to "Next:".) Literal timestamps, so the
  // query text, and with it the results cache key, changes with the Breaks.
  $closed = '';
  $i = 0;
  foreach (customsolent_helpers_breaks() as $break) {
    if ($break['kind'] !== 'closure') {
      continue;
    }
    foreach ($break['ranges'] as [$b_start, $b_end]) {
      $cond = "slnt_w.field_when_value >= " . (int) $b_start . " AND slnt_w.field_when_value < " . (int) $b_end;
      if ($break['scope'] !== 'all') {
        $cond .= " AND slnt_w.entity_id IN (" . implode(',', array_map('intval', $break['nids'])) . ")";
      }
      $closed .= " AND NOT ($cond)";
      $i++;
    }
  }
  if (\Drupal::database()->databaseType() === 'mysql' && \Drupal::database()->schema()->tableExists('node__field_season_from')) {
    $month = "MONTH(FROM_UNIXTIME(slnt_w.field_when_value))";
    $closed .= " AND NOT EXISTS (
      SELECT 1 FROM {node__field_season_from} slnt_sf JOIN {node__field_season_to} slnt_st ON slnt_st.entity_id = slnt_sf.entity_id
      WHERE slnt_sf.entity_id = slnt_w.entity_id
        AND NOT (CASE WHEN slnt_sf.field_season_from_value <= slnt_st.field_season_to_value
                      THEN $month BETWEEN slnt_sf.field_season_from_value AND slnt_st.field_season_to_value
                      ELSE ($month >= slnt_sf.field_season_from_value OR $month <= slnt_st.field_season_to_value) END))";
  }
  $query->addWhereExpression($group,
    "($alias.field_when_rrule IS NULL AND " . $not_ended($alias) . ")
     OR $alias.field_when_end_value = (
      SELECT MIN(slnt_w.field_when_end_value) FROM {node__field_when} slnt_w
      WHERE slnt_w.entity_id = $alias.entity_id
        AND slnt_w.field_when_rrule = $alias.field_when_rrule
        AND " . $not_ended('slnt_w') . $closed . "
    )",
    $args
  );
  // For the cache plugin: when does the listed row end?
  $query->addField($alias, 'field_when_end_value', 'slnt_when_end');
  $query->addField($alias, 'field_when_value', 'slnt_when_start');
  $query->addField($alias, 'field_when_rrule', 'slnt_when_rrule');
  if ($arrival) {
    $query->addField($arrival, 'field_arrival_value', 'slnt_when_arrival');
  }
}

/**
 * A reader-facing phrase for a recurrence rule: "Every Monday", "Every
 * Wednesday and Thursday", "Every other Wednesday", "Every day",
 * "Monthly", "Every year".
 *
 * Smart Date Recur's own text ("Weekly on Monday, 7 - 9pm") includes the
 * times and theme-debug markup; the cards add the times themselves, so
 * build the phrase from the rule's frequency and interval instead. Falls
 * back to the module's text, stripped, for anything unusual.
 *
 * Lives in this module (moved from the theme on 1 Nov 2026) so the same
 * words drive the cards, the event page and the regular events' URLs.
 *
 * A weekly rule may repeat on several days (BYDAY=WE,TH): every day in the
 * rule is named, in the rule's order, Monday first. With no BYDAY the day
 * is the first instance's weekday.
 */
function customsolent_helpers_recurrence_phrase($rule, int $first_start, \DateTimeZone $tz): string {
  $freq = (string) $rule->get('freq')->getString();
  $interval = 1;
  $params = $rule->getParametersArray();
  if (!empty($params['interval'])) {
    $interval = (int) $params['interval'];
  }
  $weekday = (new \DateTimeImmutable('@' . $first_start))->setTimezone($tz)->format('l');
  switch ($freq) {
    case 'DAILY':
      return $interval > 1 ? (string) t('Every @n days', ['@n' => $interval]) : (string) t('Every day');

    case 'WEEKLY':
      $days = customsolent_helpers_recurrence_day_names($params['byday'] ?? []) ?: [$weekday];
      $last = array_pop($days);
      $day_list = $days ? implode(', ', $days) . ' ' . t('and') . ' ' . $last : $last;
      if ($interval === 1) {
        return (string) t('Every @day', ['@day' => $day_list]);
      }
      if ($interval === 2) {
        return (string) t('Every other @day', ['@day' => $day_list]);
      }
      return (string) t('Every @n weeks on @day', ['@n' => $interval, '@day' => $day_list]);

    case 'MONTHLY':
      return $interval > 1 ? (string) t('Every @n months', ['@n' => $interval]) : (string) t('Monthly');

    case 'YEARLY':
      return (string) t('Every year');
  }
  $text = $rule->getTextRule();
  $rendered = is_array($text) ? (string) \Drupal::service('renderer')->renderInIsolation($text) : (string) $text;
  $rendered = preg_replace('/<!--.*?-->/s', '', $rendered) ?? $rendered;
  return trim(preg_replace('/\s+/', ' ', strip_tags($rendered)) ?? '');
}

/**
 * Weekday names for an RRULE BYDAY list (["WE", "TH"] -> ["Wednesday",
 * "Thursday"]), sorted Monday first. Unknown codes are dropped.
 */
function customsolent_helpers_recurrence_day_names(array $byday): array {
  $names = ['MO' => 'Monday', 'TU' => 'Tuesday', 'WE' => 'Wednesday', 'TH' => 'Thursday', 'FR' => 'Friday', 'SA' => 'Saturday', 'SU' => 'Sunday'];
  $found = [];
  foreach ($byday as $code) {
    $code = strtoupper(trim((string) $code));
    if (isset($names[$code])) {
      $found[$code] = (string) t($names[$code]);
    }
  }
  // Monday-first order regardless of how the rule lists them.
  $ordered = [];
  foreach (array_keys($names) as $code) {
    if (isset($found[$code])) {
      $ordered[] = $found[$code];
    }
  }
  return $ordered;
}

/**
 * What kind of address a link is, from its host: tickets, a social media
 * page, or a plain web page.
 *
 * Drives the icon and the standard wording on link buttons (event pages
 * and cards, organisation pages). Decided at render time from the URL —
 * the platform names are in the address, the check is a string match on
 * a handful of links, and the page is render-cached anyway — so editors
 * enter nothing extra and a new platform is one line here.
 *
 * @return array{kind: string, icon: string, platform: string}
 *   kind: 'tickets' | 'social' | 'web'. icon: a name the link-icon
 *   component knows. platform: "Facebook" etc. for social, '' otherwise.
 */
function customsolent_helpers_link_kind(string $url): array {
  $host = strtolower((string) parse_url($url, PHP_URL_HOST));
  $host = preg_replace('/^(www|m|mobile|en-gb|en)\./', '', $host) ?? $host;
  static $social = [
    'facebook.com' => ['Facebook', 'facebook'], 'fb.com' => ['Facebook', 'facebook'], 'fb.me' => ['Facebook', 'facebook'],
    'instagram.com' => ['Instagram', 'instagram'],
    'linkedin.com' => ['LinkedIn', 'linkedin'],
    'x.com' => ['X', 'x'], 'twitter.com' => ['X', 'x'],
    'tiktok.com' => ['TikTok', 'tiktok'],
    'youtube.com' => ['YouTube', 'youtube'], 'youtu.be' => ['YouTube', 'youtube'],
    'whatsapp.com' => ['WhatsApp', 'whatsapp'], 'wa.me' => ['WhatsApp', 'whatsapp'],
    'threads.net' => ['Threads', 'threads'], 'threads.com' => ['Threads', 'threads'],
    'bsky.app' => ['Bluesky', 'bluesky'],
    'discord.gg' => ['Discord', 'discord'], 'discord.com' => ['Discord', 'discord'],
    't.me' => ['Telegram', 'telegram'], 'telegram.me' => ['Telegram', 'telegram'],
    'mastodon.social' => ['Mastodon', 'mastodon'], 'mastodon.online' => ['Mastodon', 'mastodon'], 'mastodon.org.uk' => ['Mastodon', 'mastodon'], 'mstdn.social' => ['Mastodon', 'mastodon'],
    'pinterest.com' => ['Pinterest', 'pinterest'], 'pinterest.co.uk' => ['Pinterest', 'pinterest'],
    'snapchat.com' => ['Snapchat', 'snapchat'],
    'spotify.com' => ['Spotify', 'spotify'],
    'soundcloud.com' => ['SoundCloud', 'soundcloud'],
    'twitch.tv' => ['Twitch', 'twitch'],
    'reddit.com' => ['Reddit', 'reddit'],
    'nextdoor.co.uk' => ['Nextdoor', 'web'], 'nextdoor.com' => ['Nextdoor', 'web'],
  ];
  static $tickets = [
    'eventbrite.co.uk', 'eventbrite.com', 'tickettailor.com', 'universe.com', 'ticketmaster.co.uk', 'ticketmaster.com',
    'meetup.com', 'fatsoma.com', 'skiddle.com', 'seetickets.com', 'gigantic.com', 'eventcube.io', 'bookwhen.com',
    'headfirstbristol.co.uk', 'dice.fm', 'wegottickets.com', 'ticketsource.co.uk', 'ticketsolve.com', 'ents24.com',
    'billetto.co.uk', 'eventim.co.uk', 'axs.com', 'ticketweb.uk', 'ticketweb.co.uk', 'ra.co', 'outsavvy.com',
    'trybooking.com', 'ticketlab.co.uk', 'fixr.co', 'eventcreate.com', 'lu.ma', 'hopin.com', 'ticketpass.org',
    'alttickets.com', 'theticketsellers.co.uk', 'stagedoorapp.com', 'ticketsignup.io',
  ];
  foreach ($social as $domain => [$name, $icon]) {
    if ($host === $domain || str_ends_with($host, '.' . $domain)) {
      return ['kind' => 'social', 'icon' => $icon, 'platform' => $name];
    }
  }
  foreach ($tickets as $domain) {
    if ($host === $domain || str_ends_with($host, '.' . $domain)) {
      return ['kind' => 'tickets', 'icon' => 'ticket', 'platform' => ''];
    }
  }
  return ['kind' => 'web', 'icon' => 'globe', 'platform' => ''];
}

/**
 * A node's outward links (field_urls, or field_url on a Link), ready for
 * buttons: one entry per link, in editor order.
 *
 * Each entry: href, external, kind/icon/platform (see
 * customsolent_helpers_link_kind()), title (the editor's link text, or
 * ''). A link whose text mentions tickets or booking counts as tickets
 * whatever its host ("Book now" on the organiser's own site).
 *
 * @return array<int, array{href: string, external: bool, kind: string, icon: string, platform: string, title: string}>
 */
function customsolent_helpers_node_links(\Drupal\node\NodeInterface $node): array {
  $field = $node->hasField('field_urls') ? 'field_urls' : ($node->hasField('field_url') ? 'field_url' : NULL);
  if ($field === NULL || $node->get($field)->isEmpty()) {
    return [];
  }
  $links = [];
  foreach ($node->get($field) as $item) {
    try {
      $url = $item->getUrl();
      $href = $url->toString();
    }
    catch (\Throwable) {
      continue;
    }
    $title = trim((string) $item->title);
    $kind = customsolent_helpers_link_kind($item->uri ?? $href);
    if ($kind['kind'] === 'web' && preg_match('/ticket|book|reserve|register|rsvp|sign.?up/i', $title)) {
      $kind = ['kind' => 'tickets', 'icon' => 'ticket', 'platform' => ''];
    }
    $links[] = $kind + ['href' => $href, 'external' => $url->isExternal(), 'title' => $title];
  }
  return $links;
}

/**
 * The URL fragment that says how a regular event repeats, for its alias:
 * "regular-every-mon-1930", "regular-every-wed-fri-2000",
 * "regular-every-other-wed-1930", "regular-monthly-1900". No time for an
 * all-day rule; several rules are joined with "and".
 *
 * Built from the same rule data as the cards' phrase (see
 * customsolent_helpers_recurrence_phrase()) so the address says what the
 * card says. A one-off event (no rule) gives ''.
 */
function customsolent_helpers_recurrence_slug(\Drupal\node\NodeInterface $node): string {
  if (!$node->hasField('field_when') || $node->get('field_when')->isEmpty()
    || !\Drupal::moduleHandler()->moduleExists('smart_date_recur')) {
    return '';
  }
  $first_by_rule = [];
  foreach ($node->get('field_when') as $item) {
    if (!empty($item->rrule) && !isset($first_by_rule[(int) $item->rrule])) {
      $first_by_rule[(int) $item->rrule] = $item;
    }
  }
  if (!$first_by_rule) {
    return '';
  }
  $tz = new \DateTimeZone(\Drupal::config('system.date')->get('timezone.default') ?: 'Europe/London');
  $short = ['MO' => 'mon', 'TU' => 'tue', 'WE' => 'wed', 'TH' => 'thu', 'FR' => 'fri', 'SA' => 'sat', 'SU' => 'sun'];
  $parts = [];
  foreach ($first_by_rule as $rid => $item) {
    $rule = \Drupal\smart_date_recur\Entity\SmartDateRule::load($rid);
    if (!$rule) {
      continue;
    }
    $start = (new \DateTimeImmutable('@' . (int) $item->value))->setTimezone($tz);
    $params = $rule->getParametersArray();
    $interval = max(1, (int) ($params['interval'] ?? 1));
    $words = [];
    switch ((string) $rule->get('freq')->getString()) {
      case 'DAILY':
        $words = $interval > 1 ? ['every', $interval, 'days'] : ['every', 'day'];
        break;

      case 'WEEKLY':
        $days = [];
        foreach ($params['byday'] ?? [] as $code) {
          $code = strtoupper(trim((string) $code));
          if (isset($short[$code])) {
            $days[$code] = $short[$code];
          }
        }
        // Monday-first, as the phrase.
        $days = array_values(array_intersect_key($short, $days)) ?: [strtolower($start->format('D'))];
        $words = $interval === 1 ? ['every'] : ($interval === 2 ? ['every', 'other'] : ['every', $interval, 'weeks']);
        $words = array_merge($words, $days);
        break;

      case 'MONTHLY':
        $words = $interval > 1 ? ['every', $interval, 'months'] : ['monthly'];
        break;

      case 'YEARLY':
        $words = ['every', 'year'];
        break;

      default:
        $words = ['repeats'];
    }
    if ((int) $item->duration < 1439) {
      $words[] = $start->format('Hi');
    }
    $parts[] = implode('-', $words);
  }
  return $parts ? 'regular-' . implode('-and-', $parts) : '';
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 *
 * A Location term created inline from an event or organisation form (the
 * where field's Inline Entity Form widget) needs its parent: core's term
 * form adds the parent chooser itself, outside the form display, so the
 * inline form has none. Adds a required select of every Location term,
 * indented by depth, and a submit callback that sets the parent.
 */
function customsolent_helpers_inline_entity_form_entity_form_alter(array &$entity_form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  if (($entity_form['#entity_type'] ?? '') !== 'taxonomy_term' || ($entity_form['#bundle'] ?? '') !== 'location') {
    return;
  }
  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $entity_form['#entity'];
  $options = [];
  foreach (\Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('location') as $row) {
    if ($term->id() && (int) $row->tid === (int) $term->id()) {
      continue;
    }
    $options[$row->tid] = str_repeat('– ', $row->depth) . $row->name;
  }
  $current = NULL;
  if (!$term->get('parent')->isEmpty()) {
    $current = (int) $term->get('parent')->target_id ?: NULL;
  }
  $entity_form['parent'] = [
    '#type' => 'select',
    '#title' => t('Part of'),
    '#description' => t('The place this one is in: a city or town for a venue, or a district such as Hilsea. Only a city or area goes at the top level.'),
    '#options' => $options,
    '#empty_option' => t('- Top level (a city or area) -'),
    '#empty_value' => 0,
    '#default_value' => $current,
    '#weight' => -5,
  ];
  $entity_form['#ief_element_submit'][] = '_customsolent_helpers_inline_location_parent_submit';
}

/**
 * #ief_element_submit: sets the parent chosen on an inline Location form.
 */
function _customsolent_helpers_inline_location_parent_submit(array &$entity_form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  if (!isset($entity_form['parent']['#parents'])) {
    return;
  }
  $parent = (int) $form_state->getValue($entity_form['parent']['#parents']);
  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $entity_form['#entity'];
  $term->set('parent', $parent ?: 0);
}

/**
 * Implements hook_entity_reference_selection_alter().
 *
 * The "views" selection handler cannot accept an entity created inline (see
 * ViewsSelectionWithNew); the where field uses a View for its autocomplete
 * and Inline Entity Form to create a Location on the spot.
 */
function customsolent_helpers_entity_reference_selection_alter(array &$definitions): void {
  if (isset($definitions['views'])) {
    $definitions['views']['class'] = \Drupal\customsolent_helpers\Plugin\EntityReferenceSelection\ViewsSelectionWithNew::class;
  }
}

/**
 * Finds the point for a Location term (Location epic).
 *
 * Asks, in order, the most specific question that can be asked and stops
 * at the first answer:
 *   1. Ordnance Survey Names for the name itself, when the term has no
 *      street address: an area ("Southsea", "Wickham", "Isle of Wight")
 *      gets the gazetteer's centroid, marked approximate;
 *   2. OpenStreetMap (Nominatim) for the place's name with its town
 *      ("God's House Tower, Southampton"), kept inside the Solent box so
 *      a "The Loft" in London never wins, and spelling variants of it;
 *   3. OpenStreetMap for the first address line with the town;
 *   4. Ordnance Survey Names for the postcode (a centroid, marked
 *      approximate), then OpenStreetMap for it.
 * Nominatim's free-text search is strict, so the full formatted address is
 * not one of the questions: "Town Quay Road, SOUTHAMPTON, SO14 2NY GB"
 * finds nothing while "God's House Tower, Southampton" finds the building.
 *
 * Returns NULL, or ['lat', 'lon', 'approximate' => bool, 'source' =>
 * "building (God's House Tower, Town Quay, …)", 'query' => the question
 * that worked]. Nothing is saved; see customsolent_helpers_taxonomy_term_presave().
 */
function customsolent_helpers_geocode_location(\Drupal\taxonomy\TermInterface $term): ?array {
  $provider = \Drupal\geocoder\Entity\GeocoderProvider::load('nominatim');
  if (!$provider) {
    return NULL;
  }
  $plugin = $provider->getPlugin();
  // Roots that add nothing to a question ("Portsmouth, Solent").
  $silent = ['Solent', 'Hampshire', 'England', 'UK', 'TBC', 'Various'];
  $town = NULL;
  // Every named ancestor (Hampshire included): a name answer must mention
  // one of them, or "Planet Sounds, Southampton" is a shop in Haslemere.
  $ancestors = [];
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $current = $term;
  for ($i = 0; $i < 4; $i++) {
    $parents = $term_storage->loadParents($current->id());
    $parent = $parents ? reset($parents) : NULL;
    if (!$parent) {
      break;
    }
    if (!in_array($parent->getName(), $silent, TRUE)) {
      $town = $parent->getName();
    }
    if (!in_array($parent->getName(), ['Solent', 'England', 'UK', 'TBC', 'Various'], TRUE)) {
      $ancestors[] = $parent->getName();
    }
    $current = $parent;
  }
  // The Solent and its county: Bournemouth to Chichester, the Island to
  // Hampshire's northern edge (Hook, Fleet). Name questions must land inside it.
  // (The provider sends them only as an array and a real boolean.)
  $box = ['viewbox' => [-1.95, 50.55, -0.65, 51.40], 'bounded' => TRUE];
  $in_box = fn(float $lat, float $lon) => $lon >= -1.95 && $lon <= -0.65 && $lat >= 50.55 && $lat <= 51.40;

  $name = trim($term->getName());
  $line1 = $locality = $postcode = '';
  if ($term->hasField('field_address') && !$term->get('field_address')->isEmpty()) {
    $a = $term->get('field_address')->first();
    $line1 = trim((string) $a->get('address_line1')->getValue());
    $locality = trim((string) $a->get('locality')->getValue());
    $postcode = trim((string) $a->get('postal_code')->getValue());
  }
  // A term named after its address ("124 Millbank St, SO14 5QN") carries
  // its own postcode.
  $postcode_in_name = FALSE;
  if ($postcode === '' && preg_match('/\b([A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2})\b/i', $name, $m)) {
    $postcode = strtoupper(preg_replace('/\s+/', ' ', $m[1]));
    $postcode_in_name = TRUE;
  }

  // 1. An area by name, from the gazetteer.
  if ($name !== '' && $line1 === '' && !in_array($name, $silent, TRUE)) {
    $area = customsolent_helpers_os_names($name, ['City', 'Town', 'Suburban Area', 'Village', 'Hamlet', 'Other Settlement', 'Island']);
    if ($area) {
      return [
        'lat' => $area['lat'],
        'lon' => $area['lon'],
        'approximate' => TRUE,
        'source' => 'os_names/' . $area['type'] . ' (' . implode(', ', array_filter([$area['name'], $area['place']])) . ')',
        'query' => $name,
      ];
    }
  }

  $questions = [];
  if ($postcode_in_name) {
    // "London Road, PO2 9DU" wants the postcode, not the whole of London Road.
    $questions[] = ['q' => $postcode, 'os_postcode' => TRUE, 'data' => [], 'approx' => TRUE];
  }
  if ($name !== '' && !in_array($name, $silent, TRUE)) {
    $questions[] = ['q' => $town ? "$name, $town" : $name, 'data' => $box, 'approx' => FALSE, 'expect' => $name];
    // The map may spell the name differently: "and" for "&", no leading
    // "The", or only the part before a comma, dash or "&" ("Southsea
    // Cinema & Arts Centre" is "Southsea Cinema"). Try those too.
    $variants = [];
    $variants[] = str_replace('&', 'and', $name);
    $variants[] = (string) preg_replace('/^The\s+/iu', '', $name);
    $variants[] = (string) preg_replace('/\s*(&|,|\s-\s|\/).*$/u', '', $name);
    $variants[] = (string) preg_replace('/^The\s+/iu', '', $variants[2]);
    // A name that carries its own place ("Victoria Hall, Hartley Wintney")
    // keeps it as the town for the shortened variants, or "Victoria Hall"
    // alone finds any Victoria Hall in the county.
    $where = preg_match('/,\s*([^,]+)/u', $name, $lm) ? trim($lm[1]) : $town;
    foreach (array_unique(array_map('trim', $variants)) as $variant) {
      if ($variant !== '' && $variant !== $name && mb_strlen($variant) > 3) {
        $questions[] = ['q' => $where ? "$variant, $where" : $variant, 'data' => $box, 'approx' => FALSE, 'expect' => $variant];
        if ($town && $where !== $town) {
          // "Cenotaph, Watts Park" is "Cenotaph, Southampton" to the map.
          $questions[] = ['q' => "$variant, $town", 'data' => $box, 'approx' => FALSE, 'expect' => $variant];
        }
      }
    }
    // The full name on its own, inside the box: "Beaulieu Inn, Brockenhurst"
    // already says where it is, and a town the tree got wrong hides it.
    if ($town) {
      $questions[] = ['q' => $name, 'data' => $box, 'approx' => FALSE, 'expect' => $name];
    }
  }
  if ($line1 !== '') {
    $questions[] = ['q' => implode(', ', array_filter([$line1, $locality ?: $town])), 'data' => $box, 'approx' => FALSE, 'expect' => $line1];
  }
  if ($postcode !== '') {
    // The gazetteer's postcode centroid, then OpenStreetMap's.
    $questions[] = ['q' => $postcode, 'os_postcode' => TRUE, 'data' => [], 'approx' => TRUE];
    $questions[] = ['q' => $postcode, 'data' => [], 'approx' => TRUE];
  }

  foreach ($questions as $question) {
    if (!empty($question['os_postcode'])) {
      $hit = customsolent_helpers_os_names($question['q'], ['Postcode']);
      if ($hit) {
        return [
          'lat' => $hit['lat'],
          'lon' => $hit['lon'],
          'approximate' => TRUE,
          'source' => 'os_names/Postcode (' . implode(', ', array_filter([$hit['name'], $hit['place']])) . ')',
          'query' => $question['q'],
        ];
      }
      continue;
    }
    $query = \Geocoder\Query\GeocodeQuery::create($question['q'])->withLimit(5)->withData('countrycodes', 'gb');
    foreach ($question['data'] as $key => $value) {
      $query = $query->withData($key, $value);
    }
    try {
      $result = $plugin->geocodeQuery($query);
    }
    catch (\Throwable $e) {
      \Drupal::logger('customsolent_helpers')->warning('Nominatim failed for "@q": @m', ['@q' => $question['q'], '@m' => $e->getMessage()]);
      continue;
    }
    if ($result->isEmpty()) {
      continue;
    }
    // Prefer a thing with a door (a building, a pub, a theatre) over a
    // signboard about it or the street it stands on.
    $hit = NULL;
    foreach ($result as $candidate) {
      $c = method_exists($candidate, 'getCategory') ? (string) $candidate->getCategory() : '';
      if (in_array($c, ['building', 'amenity', 'tourism', 'leisure', 'shop', 'historic', 'office', 'craft', 'club'], TRUE)) {
        $hit = $candidate;
        break;
      }
    }
    /** @var \Geocoder\Provider\Nominatim\Model\NominatimAddress $hit */
    $hit = $hit ?? $result->first();
    $coordinates = $hit->getCoordinates();
    if (!$coordinates || !$in_box($coordinates->getLatitude(), $coordinates->getLongitude())) {
      continue;
    }
    $category = method_exists($hit, 'getCategory') ? (string) $hit->getCategory() : '';
    $type = method_exists($hit, 'getType') ? (string) $hit->getType() : '';
    $display = method_exists($hit, 'getDisplayName') ? (string) $hit->getDisplayName() : '';
    // Nominatim answers fuzzily ("Test Place" finds a place called Test),
    // so a name or street question is only believed when the answer names
    // what was asked for: every significant word of it, in order. A generic
    // word the map spells differently may be missing ("Jubilee Sports
    // Complex" for "Jubilee Sports Centre") as long as two real words match.
    if (!empty($question['expect'])) {
      $fold = fn(string $t) => trim((string) preg_replace('/[^a-z0-9]+/', ' ', str_replace('&', ' and ', mb_strtolower(\Drupal::transliteration()->transliterate($t)))));
      $wanted = array_values(array_filter(explode(' ', $fold($question['expect'])), fn($w) => !in_array($w, ['the', 'and', 'of', 'at', 'st', 'saint'], TRUE)));
      $generic = ['centre', 'center', 'complex', 'hall', 'halls', 'building', 'house', 'theatre', 'theater', 'studio', 'studios', 'rooms', 'room', 'club', 'cafe', 'bar', 'pub', 'inn', 'hotel', 'church', 'park', 'arts', 'venue', 'ltd', 'limited'];
      $answer = ' ' . $fold($display) . ' ';
      $position = 0;
      $found = 0;
      $missed_real = FALSE;
      foreach ($wanted as $word) {
        $at = strpos($answer, " $word", $position);
        if ($at === FALSE) {
          if (!in_array($word, $generic, TRUE)) {
            $missed_real = TRUE;
          }
          continue;
        }
        $found++;
        $position = $at + 1;
      }
      if (!$wanted || $missed_real || $found < min(2, count($wanted))) {
        continue;
      }
      $in_tree = !$ancestors;
      foreach ($ancestors as $ancestor) {
        if (str_contains($answer, ' ' . $fold($ancestor) . ' ')) {
          $in_tree = TRUE;
          break;
        }
      }
      if (!$in_tree) {
        continue;
      }
    }
    // An area answer (a suburb, a postcode, a town, a street) is a centroid,
    // not a door.
    $area_answer = in_array($category, ['place', 'boundary', 'highway', 'railway'], TRUE) || in_array($type, ['postcode', 'suburb', 'city', 'town', 'village', 'administrative'], TRUE);
    return [
      'lat' => $coordinates->getLatitude(),
      'lon' => $coordinates->getLongitude(),
      'approximate' => $question['approx'] || $area_answer,
      'source' => trim("$category/$type", '/') . ($display ? " ($display)" : ''),
      'query' => $question['q'],
    ];
  }
  return NULL;
}

/**
 * Implements hook_ENTITY_TYPE_presave() for taxonomy terms.
 *
 * Location terms: a term saved without a point gets one from Ordnance
 * Survey or OpenStreetMap when the lookup finds its name or address
 * (customsolent_helpers_geocode_location()). An editor can always overwrite
 * the point by hand; it is only filled when empty.
 */
function customsolent_helpers_taxonomy_term_presave(\Drupal\taxonomy\TermInterface $term): void {
  if ($term->bundle() !== 'location') {
    return;
  }
  if ($term->hasField('field_point') && $term->get('field_point')->isEmpty() && empty($term->customsolent_skip_geocode)) {
    $found = customsolent_helpers_geocode_location($term);
    if ($found) {
      $term->set('field_point', ['value' => \Drupal::service('geofield.wkt_generator')->WktBuildPoint([$found['lon'], $found['lat']])]);
    }
  }
}

/**
 * Asks Ordnance Survey Names for a named place or postcode (Location epic).
 *
 * OS Names is the gazetteer behind OS maps: every settlement, suburb,
 * island and postcode with a centroid, Crown copyright under the Open
 * Government Licence. It answers in British National Grid, so the hit is
 * converted to latitude and longitude here. Needs the project key from the
 * OS Data Hub in $settings['os_data_hub_key'] (settings.local.php, never the
 * repository); without one it answers NULL and the caller falls back to
 * OpenStreetMap.
 *
 * Only an answer whose name is the question (case and punctuation aside)
 * and that lies inside the Solent box is believed; "Southsea" must not
 * come back as the Southsea near Wrexham.
 *
 * Returns NULL or ['lat', 'lon', 'type' => 'Suburban Area', 'name',
 * 'place' => "City of Portsmouth", 'bbox' => [w, s, e, n] or NULL].
 */
function customsolent_helpers_os_names(string $query, array $local_types): ?array {
  $key = \Drupal\Core\Site\Settings::get('os_data_hub_key');
  $query = trim($query);
  if (!$key || $query === '') {
    return NULL;
  }
  try {
    $response = \Drupal::httpClient()->get('https://api.os.uk/search/names/v1/find', [
      'query' => [
        'query' => $query,
        'maxresults' => 10,
        'fq' => implode(' ', array_map(fn($t) => 'LOCAL_TYPE:' . str_replace(' ', '_', $t), $local_types)),
        'key' => $key,
      ],
      'timeout' => 10,
    ]);
    $data = json_decode((string) $response->getBody(), TRUE);
  }
  catch (\Throwable $e) {
    \Drupal::logger('customsolent_helpers')->warning('OS Names failed for "@q": @m', ['@q' => $query, '@m' => $e->getMessage()]);
    return NULL;
  }
  $fold = fn(string $t) => trim((string) preg_replace('/[^a-z0-9]+/', ' ', mb_strtolower(\Drupal::transliteration()->transliterate($t))));
  $wanted = $fold($query);
  foreach ($data['results'] ?? [] as $result) {
    $entry = $result['GAZETTEER_ENTRY'] ?? [];
    if (!in_array($entry['LOCAL_TYPE'] ?? '', $local_types, TRUE)) {
      continue;
    }
    $names = array_filter([$entry['NAME1'] ?? '', $entry['NAME2'] ?? '']);
    if (!in_array($wanted, array_map($fold, $names), TRUE)) {
      continue;
    }
    if (!isset($entry['GEOMETRY_X'], $entry['GEOMETRY_Y'])) {
      continue;
    }
    [$lat, $lon] = _customsolent_helpers_bng_to_wgs84((float) $entry['GEOMETRY_X'], (float) $entry['GEOMETRY_Y']);
    // The Solent and its county, as for the OpenStreetMap questions.
    if ($lon < -1.95 || $lon > -0.65 || $lat < 50.55 || $lat > 51.40) {
      continue;
    }
    $bbox = NULL;
    if (isset($entry['MBR_XMIN'], $entry['MBR_YMIN'], $entry['MBR_XMAX'], $entry['MBR_YMAX'])) {
      [$s, $w] = _customsolent_helpers_bng_to_wgs84((float) $entry['MBR_XMIN'], (float) $entry['MBR_YMIN']);
      [$n, $e] = _customsolent_helpers_bng_to_wgs84((float) $entry['MBR_XMAX'], (float) $entry['MBR_YMAX']);
      $bbox = [$w, $s, $e, $n];
    }
    return [
      'lat' => round($lat, 6),
      'lon' => round($lon, 6),
      'type' => $entry['LOCAL_TYPE'],
      'name' => $entry['NAME1'],
      'place' => implode(', ', array_filter([$entry['POPULATED_PLACE'] ?? NULL, $entry['DISTRICT_BOROUGH'] ?? NULL, $entry['COUNTY_UNITARY'] ?? NULL])),
      'bbox' => $bbox,
    ];
  }
  return NULL;
}

/**
 * British National Grid easting/northing to WGS84 [latitude, longitude].
 *
 * The inverse Transverse Mercator projection on the Airy 1830 ellipsoid,
 * then the standard seven-parameter Helmert shift from OSGB36 to WGS84, as
 * in Ordnance Survey's "A guide to coordinate systems in Great Britain".
 * Good to about five metres, which is what a centroid deserves.
 */
function _customsolent_helpers_bng_to_wgs84(float $E, float $N): array {
  // Airy 1830 and the National Grid's true origin, scale and false origin.
  $a = 6377563.396; $b = 6356256.909;
  $F0 = 0.9996012717; $lat0 = deg2rad(49); $lon0 = deg2rad(-2);
  $N0 = -100000; $E0 = 400000;
  $e2 = 1 - ($b * $b) / ($a * $a);
  $n = ($a - $b) / ($a + $b);

  $lat = $lat0; $M = 0;
  do {
    $lat = ($N - $N0 - $M) / ($a * $F0) + $lat;
    $Ma = (1 + $n + (5 / 4) * $n ** 2 + (5 / 4) * $n ** 3) * ($lat - $lat0);
    $Mb = (3 * $n + 3 * $n ** 2 + (21 / 8) * $n ** 3) * sin($lat - $lat0) * cos($lat + $lat0);
    $Mc = ((15 / 8) * $n ** 2 + (15 / 8) * $n ** 3) * sin(2 * ($lat - $lat0)) * cos(2 * ($lat + $lat0));
    $Md = (35 / 24) * $n ** 3 * sin(3 * ($lat - $lat0)) * cos(3 * ($lat + $lat0));
    $M = $b * $F0 * ($Ma - $Mb + $Mc - $Md);
  } while ($N - $N0 - $M >= 0.00001);

  $sin = sin($lat); $cos = cos($lat); $tan = tan($lat); $sec = 1 / $cos;
  $nu = $a * $F0 / sqrt(1 - $e2 * $sin * $sin);
  $rho = $a * $F0 * (1 - $e2) / (1 - $e2 * $sin * $sin) ** 1.5;
  $eta2 = $nu / $rho - 1;
  $VII = $tan / (2 * $rho * $nu);
  $VIII = $tan / (24 * $rho * $nu ** 3) * (5 + 3 * $tan ** 2 + $eta2 - 9 * $tan ** 2 * $eta2);
  $IX = $tan / (720 * $rho * $nu ** 5) * (61 + 90 * $tan ** 2 + 45 * $tan ** 4);
  $X = $sec / $nu;
  $XI = $sec / (6 * $nu ** 3) * ($nu / $rho + 2 * $tan ** 2);
  $XII = $sec / (120 * $nu ** 5) * (5 + 28 * $tan ** 2 + 24 * $tan ** 4);
  $XIIA = $sec / (5040 * $nu ** 7) * (61 + 662 * $tan ** 2 + 1320 * $tan ** 4 + 720 * $tan ** 6);
  $dE = $E - $E0;
  $lat = $lat - $VII * $dE ** 2 + $VIII * $dE ** 4 - $IX * $dE ** 6;
  $lon = $lon0 + $X * $dE - $XI * $dE ** 3 + $XII * $dE ** 5 - $XIIA * $dE ** 7;

  // OSGB36 latitude/longitude to Cartesian, Helmert shift, back to WGS84.
  $sin = sin($lat); $cos = cos($lat);
  $nu = $a / sqrt(1 - $e2 * $sin * $sin);
  $x = $nu * $cos * cos($lon);
  $y = $nu * $cos * sin($lon);
  $z = (1 - $e2) * $nu * $sin;
  $tx = 446.448; $ty = -125.157; $tz = 542.060; $s = -20.4894e-6;
  $rx = deg2rad(0.1502 / 3600); $ry = deg2rad(0.2470 / 3600); $rz = deg2rad(0.8421 / 3600);
  $x2 = $tx + (1 + $s) * $x - $rz * $y + $ry * $z;
  $y2 = $ty + $rz * $x + (1 + $s) * $y - $rx * $z;
  $z2 = $tz - $ry * $x + $rx * $y + (1 + $s) * $z;

  $a = 6378137.0; $b = 6356752.3142;
  $e2 = 1 - ($b * $b) / ($a * $a);
  $p = sqrt($x2 * $x2 + $y2 * $y2);
  $lat = atan2($z2, $p * (1 - $e2));
  for ($i = 0; $i < 10; $i++) {
    $sin = sin($lat);
    $nu = $a / sqrt(1 - $e2 * $sin * $sin);
    $lat = atan2($z2 + $e2 * $nu * $sin, $p);
  }
  return [rad2deg($lat), rad2deg(atan2($y2, $x2))];
}

/**
 * Location terms that are not places: the tree's placeholders.
 */
function customsolent_helpers_place_placeholders(): array {
  return ['TBC', 'Various', 'UK', 'England'];
}

/**
 * The regions a place is never said to be "in": too broad to orient a
 * reader (the Isle of Wight is not among them: it does orient).
 */
function customsolent_helpers_place_silent_regions(): array {
  return ['Solent', 'Hampshire', 'England', 'UK', 'TBC'];
}

/**
 * A place's name with the places it is in after it, for a reader who may
 * not know the area: "Bobby's Lounge, Southsea, Portsmouth" (Location
 * epic, 22 Nov 2026). One rule, no per-term settings:
 *   - ancestors follow the name, nearest first, separated by commas;
 *   - the broad regions and placeholders are never printed
 *     (customsolent_helpers_place_silent_regions());
 *   - an ancestor whose name is already in what has been printed is
 *     skipped: Fratton Community Centre loses Fratton, The Old Pay Office
 *     keeps Portsmouth Historic Quarter and drops Portsmouth;
 *   - the walk stops after the first town-level ancestor, one whose own
 *     parent is a silent region or nothing (Portsmouth, Winchester, the
 *     Isle of Wight);
 *   - at most two ancestors, so a card stays one line.
 *
 * Returns ['name' => "Bobby's Lounge", 'within' => ['Southsea', 'Portsmouth'],
 * 'label' => "Bobby's Lounge, Southsea, Portsmouth"]. The parts are
 * returned as well as the label so a template can mark them up.
 */
function customsolent_helpers_place_label(\Drupal\taxonomy\TermInterface $term): array {
  $cache = &drupal_static(__FUNCTION__, []);
  if (isset($cache[$term->id()])) {
    return $cache[$term->id()];
  }
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $fold = static fn(string $t) => preg_replace('/[^a-z0-9]+/', '', str_replace('&', 'and', mb_strtolower(\Drupal::transliteration()->transliterate($t))));
  $silent = customsolent_helpers_place_silent_regions();
  $name = trim($term->getName());
  $printed = $fold($name);
  $within = [];
  $current = $term;
  for ($i = 0; $i < 8; $i++) {
    $parents = $storage->loadParents($current->id());
    $parent = $parents ? reset($parents) : NULL;
    if (!$parent) {
      break;
    }
    $parent_name = trim($parent->getName());
    if (in_array($parent_name, $silent, TRUE)) {
      // A placeholder straight under a region says the region: "Various,
      // Hampshire" rather than a bare "Various".
      if (!$within && in_array($name, customsolent_helpers_place_placeholders(), TRUE) && !in_array($parent_name, ['TBC', 'UK', 'England'], TRUE)) {
        $within[] = $parent_name;
      }
      break;
    }
    $grandparents = $storage->loadParents($parent->id());
    $grandparent = $grandparents ? reset($grandparents) : NULL;
    $town_level = !$grandparent || in_array(trim($grandparent->getName()), $silent, TRUE);
    if (!str_contains($printed, $fold($parent_name))) {
      $within[] = $parent_name;
      $printed .= $fold($parent_name);
    }
    if ($town_level || count($within) >= 2) {
      break;
    }
    $current = $parent;
  }
  return $cache[$term->id()] = [
    'name' => $name,
    'within' => $within,
    'label' => implode(', ', array_merge([$name], $within)),
  ];
}

/**
 * Every Location term with a page (Location epic, issue 440), keyed by tid:
 * tid, name, slug, url (/explore/locations/<slug>), parent (tid or NULL),
 * depth, area (TRUE for a town or district: not pegged on the map), lat,
 * lon (NULL without a point), bounds ([[south, west], [north, east]] of the
 * area's extent, or NULL: the map fits an area to it), term.
 *
 * The slug is the name; a second term with the same name takes its
 * parent's slug as a suffix (…/locations/new-forest-hampshire), a third
 * its id. Placeholders (TBC, Various …) and unpublished terms have no page.
 */
function customsolent_helpers_place_terms(): array {
  $cache = &drupal_static(__FUNCTION__);
  if ($cache !== NULL) {
    return $cache;
  }
  $cache = [];
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $terms = [];
  foreach ($storage->loadTree('location', 0, NULL, TRUE) as $term) {
    if (!$term->isPublished() || in_array($term->getName(), customsolent_helpers_place_placeholders(), TRUE)) {
      continue;
    }
    $terms[(int) $term->id()] = $term;
  }
  $used = [];
  $base = customsolent_helpers_sitewide_listing_url('places') . '/';
  foreach ($terms as $tid => $term) {
    $parent = !empty($term->parents) && (int) $term->parents[0] ? (int) $term->parents[0] : NULL;
    // "God's House Tower" is /explore/locations/gods-house-tower, not god-s-house-tower.
    $slug = customsolent_helpers_format_slug(str_replace(["'", "\u{2019}"], '', $term->getName()));
    if (isset($used[$slug]) && $parent && isset($terms[$parent])) {
      $slug .= '-' . customsolent_helpers_format_slug($terms[$parent]->getName());
    }
    if (isset($used[$slug])) {
      $slug .= '-' . $tid;
    }
    $used[$slug] = TRUE;
    $lat = $lon = NULL;
    if ($term->hasField('field_point') && !$term->get('field_point')->isEmpty()) {
      $point = $term->get('field_point')->first();
      $lat = $point->get('lat')->getValue() !== NULL ? round((float) $point->get('lat')->getValue(), 6) : NULL;
      $lon = $point->get('lon')->getValue() !== NULL ? round((float) $point->get('lon')->getValue(), 6) : NULL;
    }
    // The extent's bounding box, which geofield works out for any shape.
    $bounds = NULL;
    if ($term->hasField('field_extent') && !$term->get('field_extent')->isEmpty()) {
      $extent = $term->get('field_extent')->first();
      $box = [$extent->get('bottom')->getValue(), $extent->get('left')->getValue(), $extent->get('top')->getValue(), $extent->get('right')->getValue()];
      if (!in_array(NULL, $box, TRUE) && ($box[2] > $box[0] || $box[3] > $box[1])) {
        $bounds = [[round((float) $box[0], 5), round((float) $box[1], 5)], [round((float) $box[2], 5), round((float) $box[3], 5)]];
      }
    }
    $cache[$tid] = [
      'tid' => $tid,
      'name' => $term->getName(),
      'slug' => $slug,
      'url' => $base . $slug,
      'parent' => $parent,
      'depth' => (int) $term->depth,
      'area' => $term->hasField('field_area') && (bool) $term->get('field_area')->value,
      'lat' => $lat,
      'lon' => $lon,
      'bounds' => $bounds,
      'term' => $term,
    ];
  }
  return $cache;
}

/**
 * The place for a URL slug, or NULL.
 */
function customsolent_helpers_place_by_slug(string $slug): ?array {
  foreach (customsolent_helpers_place_terms() as $place) {
    if ($place['slug'] === $slug) {
      return $place;
    }
  }
  return NULL;
}

/**
 * The page of a Location term (/explore/locations/<slug>), or NULL for a placeholder.
 */
function customsolent_helpers_place_url(\Drupal\taxonomy\TermInterface $term): ?string {
  return customsolent_helpers_place_terms()[(int) $term->id()]['url'] ?? NULL;
}

/**
 * The place narrowing the current request, as the ids of its term and
 * every term beneath it (an area is its venues, a venue its rooms), or [].
 *
 * Set by the place page (/explore/locations/southsea puts it on the request)
 * or by ?place=<slug> on any listing. An unknown slug narrows nothing.
 */
function customsolent_helpers_active_place_tids(): array {
  $request = \Drupal::request();
  $tid = NULL;
  if ($request->attributes->has('slnt_place_tid')) {
    $tid = (int) $request->attributes->get('slnt_place_tid') ?: NULL;
  }
  else {
    $slug = $request->query->get('place');
    if (is_string($slug) && $slug !== '') {
      $place = customsolent_helpers_place_by_slug($slug);
      $tid = $place ? $place['tid'] : NULL;
    }
  }
  if (!$tid) {
    return [];
  }
  $cache = &drupal_static(__FUNCTION__, []);
  if (!isset($cache[$tid])) {
    $cache[$tid] = [$tid];
    foreach (\Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('location', $tid) as $child) {
      $cache[$tid][] = (int) $child->tid;
    }
  }
  return $cache[$tid];
}

/**
 * Listing views whose results can be narrowed by a place: the types that
 * carry a where field (events, organisations, series, articles). Links
 * carry none and drop out of a directory.
 */
function customsolent_helpers_place_filtered_views(): array {
  return ['events_listing', 'organisations_listing', 'directory_listing', 'series_listing', 'articles_listing'];
}

/**
 * What is at a place: the panel beside the map (Location epic).
 *
 * For the place and everything beneath it (an area is its venues, a venue
 * its rooms): the events still to come, the organisations based there,
 * the series with a home there and the articles about it, each with its
  * count, up to three items and a link to the full listing narrowed to the
 * place (?place=<slug>): "All 12 events" when there are more than shown,
 * "Events listing" when the three are all of them. Events are the three
 * soonest, each with its next date ("23 Nov, 9pm"); series the three
 * latest to start; organisations are a count only, the heading itself the
 * link (a preview of three names says nothing about what is there; Rob,
 * 23 Nov 2026). Nothing is printed for a kind with nothing. The places
 * within are not listed: the tree beside the map already does that.
 *
 * @param array $place
 *   One entry of customsolent_helpers_place_terms().
 */
function customsolent_helpers_place_panel(array $place): array {
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $place['term'];
  $tids = [$place['tid']];
  foreach ($term_storage->loadTree('location', $place['tid']) as $child) {
    $tids[] = (int) $child->tid;
  }
  $tags = ['taxonomy_term:' . $place['tid'], 'taxonomy_term_list:location'];

  $address = NULL;
  if ($term->hasField('field_address') && !$term->get('field_address')->isEmpty()) {
    $a = $term->get('field_address')->first();
    $street = implode(', ', array_filter([$a->get('address_line1')->getValue(), $a->get('address_line2')->getValue()]));
    $town = trim(implode(' ', array_filter([$a->get('locality')->getValue(), $a->get('postal_code')->getValue()])));
    $address = implode(', ', array_filter([$street, $town])) ?: NULL;
  }
  // (Until 22 Nov 2026 the panel also offered an OpenStreetMap link to the
  // point and an "In Southsea, Portsmouth" line: neither earned its place
  // beside the map and the tree, so both went.)
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $now = \Drupal::time()->getRequestTime();
  $kinds = [
    'events' => ['type' => 'event', 'label' => t('Events'), 'all' => 'All @count events', 'listing' => t('Events listing')],
    'organisations' => ['type' => 'organisation', 'label' => t('Organisations'), 'all' => 'All @count organisations', 'listing' => t('Organisations listing'), 'preview' => FALSE],
    'series' => ['type' => 'series', 'label' => t('Series'), 'all' => 'All @count series', 'listing' => t('Series listing'), 'sort' => ['field_series_start.value', 'DESC']],
    'articles' => ['type' => 'article', 'label' => t('Articles'), 'all' => 'All @count articles', 'listing' => t('Articles listing'), 'sort' => ['created', 'DESC']],
  ];
  $sections = [];
  foreach ($kinds as $key => $kind) {
    $tags[] = 'node_list:' . $kind['type'];
    $items = [];
    if ($key === 'events') {
      // One row per event still to come, by its earliest date not yet
      // over (an entity query joined to field_when would give a regular
      // event one row per instance). The exact next date, by every rule
      // (end of day, arrival, Breaks, seasons), is worked out for the
      // three shown.
      $rows = \Drupal::database()->query("SELECT w.entity_id, MIN(w.field_when_value) AS next_start
        FROM {node__field_when} w
        JOIN {node_field_data} n ON n.nid = w.entity_id AND n.default_langcode = 1
        WHERE n.status = 1 AND n.type = 'event'
          AND w.entity_id IN (SELECT entity_id FROM {node__field_where} WHERE field_where_target_id IN (:tids[]))
          AND w.field_when_end_value > :now
        GROUP BY w.entity_id ORDER BY next_start ASC", [':tids[]' => $tids, ':now' => $now])->fetchAllKeyed();
      $count = count($rows);
      $nids = array_slice(array_keys($rows), 0, 3);
    }
    else {
      $base = $node_storage->getQuery()->accessCheck(TRUE)
        ->condition('type', $kind['type'])
        ->condition('status', 1)
        ->condition('field_where', $tids, 'IN');
      $count = (int) (clone $base)->count()->execute();
      $nids = ($count && ($kind['preview'] ?? TRUE))
        ? $base->sort($kind['sort'][0], $kind['sort'][1])->range(0, 3)->execute()
        : [];
    }
    if (!$count) {
      continue;
    }
    foreach ($node_storage->loadMultiple($nids) as $node) {
      $item = ['title' => $node->label(), 'url' => $node->toUrl()->toString()];
      if ($key === 'events') {
        $next = customsolent_helpers_event_next_instance($node, $now)
          ?? ['start' => (int) $rows[$node->id()], 'end' => 0, 'duration' => 0, 'tz' => \Drupal::config('system.date')->get('timezone.default') ?: 'Europe/London'];
        $item['date'] = customsolent_helpers_short_when($next);
        $item['datetime'] = (new \DateTimeImmutable('@' . $next['start']))->setTimezone(new \DateTimeZone($next['tz']))->format('Y-m-d\\TH:i');
      }
      $items[] = $item;
      $tags = array_merge($tags, $node->getCacheTags());
    }
    $listing = customsolent_helpers_sitewide_listing_url($key);
    $sections[] = [
      'key' => $key,
      'label' => $kind['label'],
      'count' => $count,
      // phpcs:ignore Drupal.Semantics.FunctionT.NotLiteralString
      'link_label' => $count > count($items) ? t($kind['all'], ['@count' => $count]) : $kind['listing'],
      'items' => $items,
      'url' => $listing ? $listing . '?place=' . $place['slug'] : NULL,
    ];
  }
  return [
    '#theme' => 'slnt_place_panel',
    '#place' => $place,
    '#address' => $address,
    '#sections' => $sections,
    '#empty' => !$sections,
    '#cache' => ['tags' => array_values(array_unique($tags)), 'max-age' => 3600],
  ];
}

/**
 * The places with something on (Location epic): the ids of every Location
 * term that an event still to come, an organisation, a series or an
 * article is at, plus every ancestor of those (an area with a busy venue
 * is busy). Everything else is a place we know but have nothing at yet.
 *
 * @return array<int, true>
 */
function customsolent_helpers_places_with_content(): array {
  $cache = &drupal_static(__FUNCTION__);
  if ($cache !== NULL) {
    return $cache;
  }
  $db = \Drupal::database();
  $now = \Drupal::time()->getRequestTime();
  $tids = $db->query("SELECT DISTINCT w.field_where_target_id FROM {node__field_where} w
    JOIN {node_field_data} n ON n.nid = w.entity_id
    WHERE n.status = 1 AND (
      n.type IN (:types[])
      OR (n.type = :event AND w.entity_id IN (SELECT entity_id FROM {node__field_when} WHERE field_when_end_value > :now))
    )", [':types[]' => ['organisation', 'series', 'article'], ':event' => 'event', ':now' => $now])->fetchCol();
  $cache = [];
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach ($tids as $tid) {
    $cache[(int) $tid] = TRUE;
    foreach ($storage->loadAllParents($tid) as $ancestor) {
      $cache[(int) $ancestor->id()] = TRUE;
    }
  }
  return $cache;
}
