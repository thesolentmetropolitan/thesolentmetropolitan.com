<?php

declare(strict_types=1);

/**
 * @file
 * Customsolent Helpers module.
 *
 * Registers the in_kicker and from_kicker theme hooks used by the
 * KickerLazyBuilder. The templates live in the customsolent theme
 * (templates/components/) — Drupal's theme registry picks them up
 * because the theme's template paths override the module's defaults.
 */

/**
 * Implements hook_theme().
 *
 * The KickerLazyBuilder returns render arrays with #theme set to
 * these hooks. Templates are looked up by Drupal's theme registry —
 * the customsolent theme's templates/components/in-kicker.html.twig
 * and templates/components/primary-kicker.html.twig are used.
 */
function customsolent_helpers_theme($existing, $type, $theme, $path) {
  return [
    'in_kicker' => [
      'variables' => [
        'show_in_kicker' => TRUE,
        'in_kicker_items' => [],
        'in_kicker_section' => '',
      ],
      // Default fallback template inside this module — overridden by
      // the customsolent theme's templates/components/in-kicker.html.twig.
      'template' => 'in-kicker',
    ],
    'from_kicker' => [
      'variables' => [
        'show_primary_kicker' => TRUE,
        'primary_kicker_ancestors' => [],
        'primary_kicker_section' => '',
      ],
      // The theme's existing file is primary-kicker.html.twig — name
      // the default template here to match, so theme override works
      // by simply having the file in the theme's templates/ tree.
      'template' => 'primary-kicker',
    ],
  ];
}

/**
 * Implements hook_views_query_alter().
 *
 * Cross-display dedup for the "primary + related" composition.
 *
 * The virtual view_display_primary_and_related (handled in
 * templates/content/paragraph--view-display.html.twig) renders two
 * displays back to back: view_display_primary_topic (filtered by
 * field_primary_topic IN args) and view_display_related_topics
 * (filtered by field_related_topics IN args). A node with BOTH a
 * primary topic AND a related topic inside the page's scope is
 * matched by BOTH queries, so the same node appears twice on the
 * rendered page. Most visible on /explore/events where the scope
 * is "all topics" — every event with both fields populated double-
 * renders.
 *
 * Single-display Distinct doesn't help: it dedupes within a query,
 * not across two separately-executed queries.
 *
 * This alter adds a "NOT IN" filter to the related-topics display:
 * any node whose field_primary_topic is in the page's scope is
 * excluded from the related view (because the primary view will
 * already render it). Done at query time so pagination counts the
 * deduped result.
 */
function customsolent_helpers_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query) {
  // Displays this dedup applies to. Add other listing views here
  // if the same primary+related composition is wired up for them.
  $deduped_displays = [
    'events_listing.view_display_related_topics',
  ];
  $key = $view->id() . '.' . $view->current_display;
  if (!in_array($key, $deduped_displays, TRUE)) {
    return;
  }
  if (!$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }
  if (empty($view->args)) {
    return;
  }
  // The contextual filter argument is a "+"-separated list of term
  // IDs (set by the view_display paragraph preprocess as the scope
  // of the page). Multi-value AND would be "," — we expect "+"
  // (OR) here because the view's contextual filter is set to
  // "Allow multiple values" with break_phrase: true.
  $arg = (string) $view->args[0];
  $tids = (strpos($arg, '+') !== FALSE) ? explode('+', $arg) : [$arg];
  $tids = array_filter(array_map('intval', $tids));
  if (empty($tids)) {
    return;
  }

  // Resolve which node IDs the primary display would show — every
  // node whose field_primary_topic is in the same scope. Done as a
  // separate quick indexed lookup rather than a SQL subquery so
  // the Views query stays simple and portable across backends.
  $exclude_nids = \Drupal::database()->select('node__field_primary_topic', 'p')
    ->fields('p', ['entity_id'])
    ->condition('p.field_primary_topic_target_id', $tids, 'IN')
    ->execute()
    ->fetchCol();

  if (empty($exclude_nids)) {
    return;
  }

  $query->addWhere(0, 'node_field_data.nid', $exclude_nids, 'NOT IN');
}
