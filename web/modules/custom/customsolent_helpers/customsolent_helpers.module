<?php

declare(strict_types=1);

/**
 * @file
 * Customsolent Helpers module.
 *
 * Registers the in_kicker and from_kicker theme hooks used by the
 * KickerLazyBuilder. The templates live in the customsolent theme
 * (templates/components/) — Drupal's theme registry picks them up
 * because the theme's template paths override the module's defaults.
 */

/**
 * Implements hook_theme().
 *
 * The KickerLazyBuilder returns render arrays with #theme set to
 * these hooks. Templates are looked up by Drupal's theme registry —
 * the customsolent theme's templates/components/in-kicker.html.twig
 * and templates/components/primary-kicker.html.twig are used.
 */
function customsolent_helpers_theme($existing, $type, $theme, $path) {
  return [
    // The automated /{topic}/{events|organisations} listing page.
    'slnt_topic_listing' => [
      'variables' => [
        'node' => NULL,
        'listing_type' => NULL,
        'heading' => NULL,
        'listing' => NULL,
        'banner' => NULL,
      ],
    ],
    // Overview · Events · Organisations & links — built by the theme's
    // _customsolent_build_section_strip().
    'slnt_section_strip' => [
      'variables' => [
        'items' => [],
        'label' => NULL,
        'section_key' => NULL,
      ],
    ],
    'in_kicker' => [
      'variables' => [
        'show_in_kicker' => TRUE,
        'in_kicker_items' => [],
        'in_kicker_section' => '',
      ],
      // Default fallback template inside this module — overridden by
      // the customsolent theme's templates/components/in-kicker.html.twig.
      'template' => 'in-kicker',
    ],
    'from_kicker' => [
      'variables' => [
        'show_primary_kicker' => TRUE,
        'primary_kicker_ancestors' => [],
        'primary_kicker_section' => '',
      ],
      // The theme's existing file is primary-kicker.html.twig — name
      // the default template here to match, so theme override works
      // by simply having the file in the theme's templates/ tree.
      'template' => 'primary-kicker',
    ],
  ];
}

/**
 * Implements hook_views_pre_build().
 *
 * Fix: the core search results pager never appeared. Search results can
 * include composite/landing pages; SearchNode::prepareResults() renders each
 * result node, which executes any view_display paragraphs embedded in it.
 * Each such view's pager re-registers pager element 0 and overwrites the
 * search query's pager (e.g. 186 items -> 3 items, 1 page), so pager.html.twig
 * renders nothing — and the anonymous page cache then freezes the pagerless
 * page. (Warm render caches skip the node renders, which made this maddening
 * to reproduce: drush probes paged fine while the web page never did.)
 *
 * On the search results route those embedded views are only ever rendered
 * inside result nodes — they display a handful of teaser rows and never show
 * their own pager UI there — so give them a non-paginating pager at runtime.
 * Section pages are untouched and keep their normal view pagination.
 */
function customsolent_helpers_views_pre_build(\Drupal\views\ViewExecutable $view) {
  if (\Drupal::routeMatch()->getRouteName() !== 'search.view_node_search') {
    return;
  }
  $pager = $view->display_handler->getOption('pager') ?: [];
  if (($pager['type'] ?? 'none') === 'some' || ($pager['type'] ?? 'none') === 'none') {
    return;
  }
  $view->display_handler->setOption('pager', [
    'type' => 'some',
    'options' => [
      'items_per_page' => $pager['options']['items_per_page'] ?? 10,
      'offset' => $pager['options']['offset'] ?? 0,
    ],
  ]);
}

/**
 * TRUE when the given node is the site's front page.
 */
function _customsolent_helpers_is_front_page_node(\Drupal\node\NodeInterface $node): bool {
  if ($node->isNew()) {
    return FALSE;
  }
  $front = (string) \Drupal::config('system.site')->get('page.front');
  $internal = \Drupal::service('path_alias.manager')->getPathByAlias($front);
  return $internal === '/node/' . $node->id();
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 *
 * The home page is a Composite Page, but it must stay uncategorised:
 * a primary topic on it would switch on section behaviour that is
 * meant for section pages only — a topic breadcrumb trail, topic-scoped
 * listings and kickers, and the page being offered as the landing page
 * that topic terms link to. All of that logic is keyed on the topic
 * fields being non-empty, so keeping them empty keeps it off. Hide the
 * fields on the front page's edit form so they can't be set by accident.
 */
function customsolent_helpers_form_node_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id): void {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node instanceof \Drupal\node\NodeInterface || !_customsolent_helpers_is_front_page_node($node)) {
    return;
  }
  foreach (['field_primary_topic', 'field_related_topics'] as $field_name) {
    if (isset($form[$field_name])) {
      $form[$field_name]['#access'] = FALSE;
    }
  }
}

/**
 * URL words that have an automated listing page today.
 */
function customsolent_helpers_listing_route_words(): array {
  return ['events', 'organisations'];
}

/**
 * URL words a topic term may not use as its name.
 *
 * /{topic path}/{word} is the automated listing page for that topic, so a
 * child topic called "Events" would collide with its parent's events
 * listing. "links" and "articles" are reserved ahead of being built.
 */
function customsolent_helpers_reserved_listing_words(): array {
  return ['events', 'organisations', 'links', 'articles'];
}

/**
 * Implements hook_form_FORM_ID_alter() for the Topic term form.
 */
function customsolent_helpers_form_taxonomy_term_topic_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id): void {
  $form['#validate'][] = 'customsolent_helpers_topic_term_validate';
}

/**
 * Refuses a topic name whose last segment is a reserved listing word.
 *
 * Top-level terms are exempt: "Explore / Events" is a child of Explore and
 * is the all-events page itself, which predates the rule and is the one
 * place the word is wanted.
 */
function customsolent_helpers_topic_term_validate(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $name = (string) ($form_state->getValue(['name', 0, 'value']) ?? '');
  $parts = explode(' / ', $name);
  $last = trim((string) end($parts));
  $slug = trim((string) preg_replace('/[^a-z0-9]+/', '-', mb_strtolower($last)), '-');
  if (!in_array($slug, customsolent_helpers_reserved_listing_words(), TRUE)) {
    return;
  }
  if (str_starts_with($name, 'Explore / ')) {
    return;
  }
  $form_state->setErrorByName('name', t('"@word" cannot be used as a topic name: the address ending /@slug is the automatic @slug listing for the parent topic. Choose another name, such as "@word & …".', ['@word' => $last, '@slug' => $slug]));
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for paragraphs.
 *
 * Listings and the section filter change with ?topic= and
 * ?date_filter_id=, so their cached output must vary by them.
 *
 * This lived in customsolent.theme until 2026-09-20, where it never ran:
 * entity view-alter hooks are invoked on MODULES only, not themes. Nothing
 * showed, because every listing used to render a paged view, which brings
 * the broad "url" cache context with it. Preview blocks do not always
 * render a view (an empty block renders nothing), so /culture got cached
 * in whatever filter state was visited first.
 */
function customsolent_helpers_paragraph_view_alter(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display): void {
  if (in_array($entity->bundle(), ['view_display', 'section_filter', 'heading'], TRUE)) {
    $build['#cache']['contexts'][] = 'url.query_args:topic';
    $build['#cache']['contexts'][] = 'url.query_args:date_filter_id';
  }
}

/**
 * Listing views whose results can be narrowed by ?topic=.
 */
function customsolent_helpers_topic_filtered_views(): array {
  return ['events_listing', 'organisations_listing', 'links_listing', 'directory_listing'];
}

/**
 * Implements hook_views_query_alter().
 *
 * Makes ?topic=<tid> work as a filter WITHIN a list, for the listings whose
 * own scope is not a Culture / Sectors / Living topic:
 *   - Explore → Directories & Networks is scoped to its own Explore term;
 *   - Explore → Organisations has no topic scope at all.
 * On those pages the section filter offers Culture / Sectors / Living, and
 * choosing one must AND with the list rather than replace its scope.
 *
 * Elsewhere ?topic= is "consumed": the paragraph preprocess narrows the
 * view's topic arguments to the chosen sub-tree. That case is detected by
 * the chosen term being among the view's arguments, and left alone.
 */
function customsolent_helpers_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if (!in_array($view->id(), customsolent_helpers_topic_filtered_views(), TRUE)
    || $view->current_display === 'view_display_front_page'
    || !$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }
  $topic = \Drupal::request()->query->get('topic');
  if (!is_numeric($topic) || (int) $topic <= 0) {
    return;
  }
  $tid = (int) $topic;
  $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid);
  if (!$term || $term->bundle() !== 'topic') {
    return;
  }
  // Already consumed as the view's topic scope? Only a display that HAS
  // contextual filters can consume it — the paragraph template passes the
  // scope as arguments to every display, and one without argument handlers
  // (Explore → Organisations) silently ignores them.
  if (!empty($view->argument)) {
    foreach ($view->args as $arg) {
      if (in_array((string) $tid, preg_split('/[+,\s]+/', (string) $arg), TRUE)) {
        return;
      }
    }
  }
  // The chosen term and everything beneath it.
  $tids = [$tid];
  foreach (\Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('topic', $tid) as $child) {
    $tids[] = (int) $child->tid;
  }
  $db = \Drupal::database();
  $primary = $db->select('node__field_primary_topic', 'slnt_p')->fields('slnt_p', ['entity_id'])
    ->condition('slnt_p.field_primary_topic_target_id', $tids, 'IN');
  $related = $db->select('node__field_related_topics', 'slnt_r')->fields('slnt_r', ['entity_id'])
    ->condition('slnt_r.field_related_topics_target_id', $tids, 'IN');
  $query->setWhereGroup('OR', 'slnt_topic_within');
  $query->addWhere('slnt_topic_within', 'node_field_data.nid', $primary, 'IN');
  $query->addWhere('slnt_topic_within', 'node_field_data.nid', $related, 'IN');
}

