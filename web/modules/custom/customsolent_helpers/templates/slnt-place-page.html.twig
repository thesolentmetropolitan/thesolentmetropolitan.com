{#
/**
 * @file
 * A place's page (/places/<slug>), Location epic, issue 440.
 *
 * Variables:
 *   - banner: the hero; its big title is the page's h1
 *   - address: the place's own address line, or empty
 *   - map_url: a map link to its point, or empty
 *   - within: the places it is in, nearest first: list of {label, url}
 *   - contains: the places inside it: list of {label, url}
 *   - events: the site-wide events listing narrowed to the place, in
 *     listing_page mode (topic sidebar, date pills, one pager)
 *   - organisations: the organisations based here (cards), when any
 *   - organisations_count
 *   - section_key: explore
 */
#}
{{ banner }}
<div class="slnt-topic-listing slnt-place-page"{% if section_key %} data-section="{{ section_key }}"{% endif %}>
  {% if address or map_url or within or contains %}
    <div class="slnt-place-page__about">
      {% if address or map_url %}
        <p class="slnt-place-page__address">
          {%- if address %}{{ address }}{% endif -%}
          {%- if map_url %}{% if address %} {% endif %}<a class="slnt-place-page__map" href="{{ map_url }}" rel="noopener">{{ 'Map'|t }}</a>{% endif -%}
        </p>
      {% endif %}
      {% if within %}
        <p class="slnt-place-page__within">{{ 'In'|t }}
          {% for p in within %}{% if not loop.first %}, {% endif %}{% if p.url %}<a href="{{ p.url }}">{{ p.label }}</a>{% else %}{{ p.label }}{% endif %}{% endfor %}</p>
      {% endif %}
      {% if contains %}
        <p class="slnt-place-page__contains">{{ 'Includes'|t }}
          {% for p in contains %}{% if not loop.first %}, {% endif %}<a href="{{ p.url }}">{{ p.label }}</a>{% endfor %}</p>
      {% endif %}
    </div>
  {% endif %}
  {{ events }}
  {% if organisations_count %}
    <section class="slnt-place-page__organisations">
      <h2 class="slnt-place-page__heading">{{ 'Based here'|t }}</h2>
      {{ organisations }}
    </section>
  {% endif %}
</div>
