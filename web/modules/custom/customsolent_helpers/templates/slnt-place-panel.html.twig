{#
/**
 * @file
 * What is at a place: the panel beside the map on Explore / Locations.
 *
 * Variables:
 *   - place: {name, url, slug, area}
 *   - address: the place's own address line, or empty
 *   - sections: list of {key, label, count, link_label, items: [{title,
 *     url}], url}: the events to come, organisations, series and
 *     articles there, each with a link to the full listing at the place
 *   - empty: TRUE when nothing is there yet
 */
#}
<div class="slnt-place-panel" data-place="{{ place.slug }}">
  <h2 class="slnt-place-panel__name"><a href="{{ place.url }}">{{ place.name }}</a></h2>
  {% if address %}
    <p class="slnt-place-panel__address">{{ address }}</p>
  {% endif %}
  {% if empty %}
    <p class="slnt-place-panel__empty">{{ 'Nothing listed here yet.'|t }}</p>
  {% endif %}
  {% for section in sections %}
    <section class="slnt-place-panel__section slnt-place-panel__section--{{ section.key }}">
      <h3 class="slnt-place-panel__heading">{{ section.label }} <span class="slnt-place-panel__count">{{ section.count }}</span></h3>
      <ul class="slnt-place-panel__items">
        {% for item in section.items %}
          <li><a href="{{ item.url }}">{{ item.title }}</a></li>
        {% endfor %}
      </ul>
      {% if section.url %}
        <a class="slnt-place-panel__all" href="{{ section.url }}">{{ section.link_label }} <span aria-hidden="true">→</span></a>
      {% endif %}
    </section>
  {% endfor %}
</div>
