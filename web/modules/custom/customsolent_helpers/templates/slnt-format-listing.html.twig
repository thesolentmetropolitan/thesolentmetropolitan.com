{#
/**
 * @file
 * The format landing page (/explore/events/festivals …), issue 485.
 *
 * Variables:
 *   - banner: the format's hero banner; its big title is the page's h1
 *   - summary: the format's reader summary
 *   - listing: the site-wide events listing, narrowed to the format, in
 *     listing_page mode (topic sidebar with the Format group, date pills,
 *     one pager)
 *   - section_key: explore
 */
#}
{{ banner }}
<div class="slnt-topic-listing slnt-format-listing"{% if section_key %} data-section="{{ section_key }}"{% endif %}>
  {% if summary %}
    <p class="slnt-format-listing__summary">{{ summary }}</p>
  {% endif %}
  {{ listing }}
</div>
