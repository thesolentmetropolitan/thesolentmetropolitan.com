<?php

declare(strict_types=1);

/**
 * @file
 * Functions to support theming in the customsolent theme.
 */

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function customsolent_preprocess_html(array &$variables): void {
  // Body class for the content type of the node being viewed, e.g.
  // page-node-type-composite-page. CSS uses it to give section pages and
  // the front page (all Composite Pages) the off-white page background
  // without touching the site-wide colour — see css/elements.css.
  $node = \Drupal::routeMatch()->getParameter('node');
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($node instanceof \Drupal\node\NodeInterface && $route_name === 'entity.node.canonical') {
    $variables['attributes']['class'][] = 'page-node-type-' . \Drupal\Component\Utility\Html::getClass($node->bundle());
  }
  // Drupal's usual front-page class (the template prints its own
  // attributes, so core's body_classes never reach the page). CSS uses it
  // for Home-only layout, e.g. the phones' pulled-out event/article grids.
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['attributes']['class'][] = 'path-frontpage';
  }
  // The automated /{topic}/{type} listing pages belong to the section they
  // list, so they share its off-white page background.
  if ($route_name === 'customsolent_helpers.topic_listing') {
    $variables['attributes']['class'][] = 'page-node-type-composite-page';
    $variables['attributes']['class'][] = 'page-topic-listing';
  }
  // Log in / reset password / 404 / 403: see _customsolent_system_page().
  if ($system_page = _customsolent_system_page()) {
    $variables['attributes']['class'][] = 'page-system';
    $variables['attributes']['class'][] = 'page-system--' . $system_page['key'];
  }
}

/**
 * Describes the current route if it is one of Drupal's own bare pages.
 *
 * These pages have no node, no banner and (in this theme) no page title
 * block, so they rendered as unstyled form fields or a lone sentence hard
 * against the header. page.html.twig gives them a heading, an intro and a
 * white box on the off-white ground; css/system-pages.css styles the forms
 * to match the contact form.
 *
 * @return array|null
 *   key, title, intro, links (label => path), replace_content (bool).
 */
function _customsolent_system_page(): ?array {
  $pages = [
    'user.login' => [
      'key' => 'login',
      'title' => t('Log in'),
      'intro' => t('For editors and contributors of The Solent Metropolitan.'),
      'links' => [(string) t('Forgotten your password?') => '/user/password'],
    ],
    'user.pass' => [
      'key' => 'password',
      'title' => t('Reset your password'),
      'intro' => t('Enter your username or email address and we will send you a link to set a new password.'),
      'links' => [(string) t('Back to log in') => '/user/login'],
    ],
    'system.404' => [
      'key' => '404',
      'title' => t('Page not found'),
      'intro' => t('Sorry, there is no page at this address. It may have moved, or the link may be out of date.'),
      'links' => [
        (string) t("What's on: events") => '/explore/events',
        (string) t('Articles') => '/explore/articles',
        (string) t('Organisations') => '/explore/organisations',
        (string) t('Culture') => '/culture',
        (string) t('Sectors') => '/sectors',
        (string) t('Living') => '/living',
        (string) t('Home') => '/',
      ],
      'replace_content' => TRUE,
    ],
    'system.403' => [
      'key' => '403',
      'title' => t('You need to log in to see this page'),
      'intro' => t('This page is not public. If you are an editor or contributor, log in and try again.'),
      'links' => [(string) t('Log in') => '/user/login', (string) t('Home') => '/'],
      'replace_content' => TRUE,
    ],
  ];
  $route = \Drupal::routeMatch()->getRouteName();
  return $pages[$route] ?? NULL;
}

/**
 * Implements hook_preprocess_HOOK() for slnt-topic-listing.html.twig.
 *
 * The automated listing page: topic trail (every term clickable, the last
 * one leading back to the section page), a plain h1, then the listing.
 */
function customsolent_preprocess_slnt_topic_listing(array &$variables): void {
  $node = $variables['node'];
  $variables['trail_ancestors'] = [];
  if ($node && $node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term) {
      $trail = _customsolent_build_topic_trail($term, FALSE);
      $variables['trail_ancestors'] = $trail['ancestors'];
      $top = _customsolent_topic_top_level($term);
      $variables['section_key'] = $top ? strtolower($top->getName()) : NULL;
    }
  }
  $variables['strip'] = $node ? _customsolent_build_section_strip($node, (string) $variables['listing_type']) : NULL;
  $variables['back_url'] = $node ? $node->toUrl()->toString() : NULL;
  $variables['back_label'] = $node ? $node->label() : NULL;
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Favicon (issue 148). Drupal itself links favicon.ico from the theme root
 * (a file there replaces core's default). This adds the SVG mark, which
 * modern browsers prefer at any size, and the Apple touch icon. All three
 * are the square "SLNT" social mark (logo202604g_social).
 */
function customsolent_page_attachments_alter(array &$attachments): void {
  $base = base_path() . \Drupal::service('extension.list.theme')->getPath('customsolent');
  $attachments['#attached']['html_head_link'][] = [
    ['rel' => 'icon', 'href' => $base . '/favicon.svg', 'type' => 'image/svg+xml'],
    FALSE,
  ];
  $attachments['#attached']['html_head_link'][] = [
    ['rel' => 'apple-touch-icon', 'href' => $base . '/apple-touch-icon.png', 'sizes' => '180x180'],
    FALSE,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function customsolent_preprocess_page(array &$variables): void {
  $variables['system_page'] = _customsolent_system_page();
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 *
 * Builds the topic trail (clickable ancestor terms + leaf term)
 * from the node's field_primary_topic. Composite pages use the
 * leaf term as the page h1; content pages (article, etc.) keep
 * the entire chain as a clickable kicker above their own title.
 *
 * Also exposes event-teaser-specific data (section_color,
 * field_url_external/href/text, where_name) so the event teaser
 * template can render the When/Where rows with icons and a
 * section-coloured CTA from field_url.
 */
function customsolent_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node) {
    return;
  }

  // Topic trail (any node with a primary topic).
  if ($node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term) {
      $is_composite = ($node->bundle() === 'composite_page');
      $trail = _customsolent_build_topic_trail($term, $is_composite);
      $variables['topic_trail_ancestors'] = $trail['ancestors'];
      $variables['topic_trail_current'] = $trail['current_label'];
      $variables['topic_trail_as_heading'] = $is_composite;
    }
  }

  // Event: venues (one or several), organiser, recurrence — every surface.
  if ($node->bundle() === 'event'
    && in_array(($variables['view_mode'] ?? ''), ['teaser', 'compact', 'full'], TRUE)) {
    _customsolent_preprocess_event_shared_extras($node, $variables);
  }

  // Format and setting (the second axis to Topic, issue 485) on the cards
  // and pages of the three types that carry them.
  if (in_array($node->bundle(), ['event', 'series', 'organisation'], TRUE)
    && in_array(($variables['view_mode'] ?? ''), ['teaser', 'compact', 'full'], TRUE)) {
    _customsolent_preprocess_format_extras($node, $variables);
  }

  // Every topic, the primary first, each as its full chain, at the foot of
  // a page: on a long page the kicker is far above by then.
  if (in_array($node->bundle(), ['event', 'organisation', 'article', 'series', 'collaboration'], TRUE)
    && ($variables['view_mode'] ?? '') === 'full') {
    _customsolent_preprocess_related_topics($node, $variables);
  }

  // Event teaser extras.
  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'teaser') {
    _customsolent_preprocess_event_teaser_extras($node, $variables);
  }

  // Event compact (front-page card) extras.
  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'compact') {
    _customsolent_preprocess_event_compact_extras($node, $variables);
  }

  // Article compact (front-page card) extras.
  if ($node->bundle() === 'article' && ($variables['view_mode'] ?? '') === 'compact') {
    _customsolent_preprocess_article_compact_extras($node, $variables);
  }

  // Collaboration card and page; collaborator row.
  if ($node->bundle() === 'collaboration'
    && in_array(($variables['view_mode'] ?? ''), ['teaser', 'compact', 'full'], TRUE)) {
    _customsolent_preprocess_collaboration_extras($node, $variables);
  }
  if ($node->bundle() === 'collaborator'
    && in_array(($variables['view_mode'] ?? ''), ['teaser', 'compact', 'full'], TRUE)) {
    _customsolent_preprocess_collaborator_extras($node, $variables);
  }

  // Organisation page: where it is based — every Location term as one
  // phrase ("Southampton and Portsmouth"; field_where is multi-value,
  // issue 460) — and the events it organises that are still to come.
  if ($node->bundle() === 'organisation' && ($variables['view_mode'] ?? '') === 'full') {
    $variables['organisation_where'] = '';
    if ($node->hasField('field_where') && !$node->get('field_where')->isEmpty()) {
      $names = [];
      foreach ($node->get('field_where')->referencedEntities() as $where) {
        $names[] = $where->getName();
      }
      $variables['organisation_where'] = _customsolent_join_names($names);
    }
    /** @var \Drupal\customsolent_helpers\ContentRelations $relations */
    $relations = \Drupal::service('customsolent_helpers.content_relations');
    $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
    $variables['organiser_events'] = [];
    foreach ($relations->upcomingEventsOrganisedBy($node) as $event) {
      $variables['organiser_events'][] = $view_builder->view($event, 'compact');
    }
    // Refresh when events change, and at midnight when "today" moves on.
    $variables['organiser_events_cache'] = ['#cache' => ['tags' => $relations->eventsCacheTags(), 'max-age' => $relations->maxAgeUntilMidnight()]];

    // Outward links: website, social pages — one button each.
    $variables['node_links'] = _customsolent_node_link_buttons($node);

    // Part of a larger organisation (reverse lookup: the parent lists its
    // subsidiaries), and the organisations that are part of this one. Both
    // as the directory cards used for organisations everywhere else.
    $variables['parent_organisations'] = [];
    foreach ($relations->parentOrganisationsOf($node) as $parent) {
      $variables['parent_organisations'][] = $view_builder->view($parent, 'compact');
    }
    $variables['subsidiary_organisations'] = [];
    if ($node->hasField('field_subsidiary_organisations')) {
      foreach ($node->get('field_subsidiary_organisations')->referencedEntities() as $child) {
        if ($child->isPublished() && $child->access('view')) {
          $variables['subsidiary_organisations'][] = $view_builder->view($child, 'compact');
        }
      }
    }
    $variables['organisation_links_cache'] = ['#cache' => ['tags' => $relations->parentOrganisationsCacheTags()]];
  }

  // Event page: the organiser's other upcoming events at the foot — the
  // same list as the organisation page's "Coming up", minus this event.
  // (A topic-overlap "related events" list was tried on 18 Oct and
  // dropped the same day as too loosely connected.)
  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'full') {
    /** @var \Drupal\customsolent_helpers\ContentRelations $relations */
    $relations = \Drupal::service('customsolent_helpers.content_relations');
    $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
    $variables['organiser_other_events'] = [];
    $seen = [(int) $node->id() => TRUE];
    $organisers = $node->hasField('field_organisers') ? $node->get('field_organisers')->referencedEntities() : [];
    foreach ($organisers as $organiser) {
      foreach ($relations->upcomingEventsOrganisedBy($organiser) as $event) {
        if (empty($seen[(int) $event->id()])) {
          $seen[(int) $event->id()] = TRUE;
          $variables['organiser_other_events'][] = $view_builder->view($event, 'compact');
        }
      }
    }
    $variables['organiser_events_cache'] = ['#cache' => ['tags' => $relations->eventsCacheTags(), 'max-age' => $relations->maxAgeUntilMidnight()]];
  }

  // Series and Collaboration pages: the kicker that names the kind of
  // page and links back to its listing (/explore/series, /explore/collaborations).
  if (($variables['view_mode'] ?? '') === 'full'
    && in_array($node->bundle(), ['series', 'collaboration'], TRUE)) {
    $home = $node->bundle() === 'series' ? '/explore/series' : '/explore/collaborations';
    $variables['type_home_url'] = \Drupal\Core\Url::fromUserInput($home)->toString();
  }

  // "Part of a collaboration" on full pages: outcomes (event, article,
  // series — directly or via a series) and participants (person,
  // organisation — via collaborator nodes).
  if (($variables['view_mode'] ?? '') === 'full'
    && in_array($node->bundle(), ['event', 'article', 'series', 'link', 'person', 'organisation'], TRUE)) {
    _customsolent_preprocess_collaboration_membership($node, $variables);
  }

  // Person chip, team card and page: initials, location, their articles.
  if ($node->bundle() === 'person'
    && in_array(($variables['view_mode'] ?? ''), ['teaser', 'compact', 'full'], TRUE)) {
    _customsolent_preprocess_person_extras($node, $variables);
  }

  // Article cards and page: plain author names for the byline.
  if ($node->bundle() === 'article'
    && in_array(($variables['view_mode'] ?? ''), ['teaser', 'compact', 'full'], TRUE)) {
    _customsolent_preprocess_article_byline($node, $variables);
  }

  // Series card and full page: status word, date range, counts, members.
  if ($node->bundle() === 'series'
    && in_array(($variables['view_mode'] ?? ''), ['teaser', 'compact', 'full'], TRUE)) {
    _customsolent_preprocess_series_extras($node, $variables);
  }

  // Events: the series they belong to (reverse lookup), on every surface.
  if ($node->bundle() === 'event'
    && in_array(($variables['view_mode'] ?? ''), ['teaser', 'compact', 'full'], TRUE)) {
    _customsolent_preprocess_series_membership($node, $variables);
  }

  // Link / Organisation teaser — both render field_url as a primary
  // link with a trailing arrow-square-out icon for external URLs.
  // Same field_url meta extraction works for both.
  if (in_array($node->bundle(), ['link', 'organisation'], TRUE)
    && ($variables['view_mode'] ?? '') === 'teaser') {
    _customsolent_extract_field_url_meta($node, $variables);
  }

  // Link / Organisation compact card — one shared card design. Same
  // field_url extraction, plus a type label so the two content types can
  // share one list and still be told apart.
  if (in_array($node->bundle(), ['link', 'organisation'], TRUE)
    && ($variables['view_mode'] ?? '') === 'compact') {
    _customsolent_extract_field_url_meta($node, $variables);
    $variables['card_type_label'] = $node->bundle() === 'link' ? t('Link') : t('Organisation');
  }

  // Full node views for event / organisation / link (destination pages
  // reachable directly and from search). The template renders field_url as a
  // CTA button, so extract its href/text/external flag here; and for events,
  // flag whether the event has already finished (past-event badge).
  if (($variables['view_mode'] ?? '') === 'full'
    && in_array($node->bundle(), ['event', 'link', 'organisation'], TRUE)) {
    _customsolent_extract_field_url_meta($node, $variables);
    // (is_past_event for events is set in _customsolent_preprocess_event_shared_extras.)
  }

  // Full node views for content types (article, event, organisation, link):
  // expose the primary topic's menu path (e.g. "/culture/music") so the desktop
  // menu can indicate the topic's section rather than the URL path — content
  // lives at /articles, /events, /organisations, which don't match any menu
  // item. Read by js/menu-state.js via the data-primary-topic-path attribute.
  if (($variables['view_mode'] ?? '') === 'full'
    && in_array($node->bundle(), ['article', 'event', 'organisation', 'link', 'series', 'collaboration'], TRUE)
    && $node->hasField('field_primary_topic')
    && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term) {
      // Build the root-to-leaf term chain, then the lowercase/hyphenated path
      // via the shared helper (e.g. "Culture / Music" => "/culture/music").
      $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
      $chain = [];
      $current = $term;
      while ($current) {
        array_unshift($chain, $current);
        $parents = $term_storage->loadParents($current->id());
        $current = !empty($parents) ? reset($parents) : NULL;
      }
      $variables['primary_topic_menu_path'] = _customsolent_build_term_url($chain, count($chain) - 1);
    }
  }

  // Topic kickers on teasers and compact cards. Rendered via
  // #lazy_builder placeholders so they're recomputed per request,
  // bypassing the teaser entity render cache (which is shared across
  // pages and would otherwise bake the wrong kicker into other
  // section pages — issue #279).
  //
  // The lazy-builder callbacks resolve the current page's topic
  // scope from the request URL — not from request attributes, which
  // may be overwritten by other paragraphs by the time the
  // placeholder is resolved.
  if (in_array(($variables['view_mode'] ?? ''), ['teaser', 'compact'], TRUE)
    && $node->hasField('field_primary_topic')
    && !$node->get('field_primary_topic')->isEmpty()) {
    $nid = (int) $node->id();
    $variables['in_kicker_lazy'] = [
      '#lazy_builder' => [
        'Drupal\customsolent_helpers\Render\KickerLazyBuilder::inKicker',
        [$nid],
      ],
      '#create_placeholder' => TRUE,
    ];
    $variables['from_kicker_lazy'] = [
      '#lazy_builder' => [
        'Drupal\customsolent_helpers\Render\KickerLazyBuilder::fromKicker',
        [$nid],
      ],
      '#create_placeholder' => TRUE,
    ];
    // Compact cards: the primary topic's full trail, dropped on that
    // topic's own page. White on the filled article card.
    $variables['trail_kicker_lazy'] = [
      '#lazy_builder' => [
        'Drupal\customsolent_helpers\Render\KickerLazyBuilder::trailKicker',
        [$nid, $node->bundle() === 'article' ? '#ffffff' : ''],
      ],
      '#create_placeholder' => TRUE,
    ];
  }
}

/**
 * Adds section colour, field_url metadata, and the plain Location
 * term name to event-teaser variables.
 */
function _customsolent_preprocess_event_teaser_extras($node, array &$variables): void {
  if ($node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term) {
      $top = _customsolent_topic_top_level($term);
      if ($top) {
        $variables['section_key'] = strtolower($top->getName());
        $variables['section_color'] = _customsolent_topic_section_colors()[$top->getName()] ?? NULL;
      }
    }
  }

  // Venue(s): where_list from the shared extras; where_name = the first.
  if (!empty($variables['where_list'])) {
    $variables['where_name'] = $variables['where_list'][0]['name'];
  }

  _customsolent_extract_field_url_meta($node, $variables);
}

/**
 * Adds field_url metadata, the venue term name (where_name) and the
 * venue's parent term name (location_area) to the compact event card.
 *
 * The compact card lays venue and area on two lines, e.g.
 *   God's House Tower
 *   Southampton
 * If the venue term has no parent, location_area is left null and the
 * template renders only the venue name.
 */
function _customsolent_preprocess_event_compact_extras($node, array &$variables): void {
  // Section colour from the top-level Topic — drives the card's top
  // border and the kicker text colour.
  if ($node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term) {
      $top = _customsolent_topic_top_level($term);
      if ($top) {
        $variables['section_key'] = strtolower($top->getName());
        $variables['section_color'] = _customsolent_topic_section_colors()[$top->getName()] ?? NULL;
      }
    }
  }

  // Venue(s): where_list from the shared extras; where_name / location_area
  // describe the first venue, for the single-venue layout.
  if (!empty($variables['where_list'])) {
    $variables['where_name'] = $variables['where_list'][0]['name'];
    $variables['location_area'] = $variables['where_list'][0]['area'];
  }

  _customsolent_extract_field_url_meta($node, $variables);
}

/**
 * A reader-facing phrase for a recurrence rule ("Every Monday").
 *
 * The phrase is built in customsolent_helpers so the event URL pattern
 * can use the same words; see customsolent_helpers_recurrence_phrase().
 */
function _customsolent_recurrence_phrase($rule, int $first_start, \DateTimeZone $tz): string {
  return customsolent_helpers_recurrence_phrase($rule, $first_start, $tz);
}

/**
 * Joins names for reading: "A", "A and B", "A, B and C". '' for none.
 */
function _customsolent_join_names(array $names): string {
  $names = array_values(array_filter(array_map('strval', $names), 'strlen'));
  if (!$names) {
    return '';
  }
  $last = array_pop($names);
  return $names ? implode(', ', $names) . ' ' . t('and') . ' ' . $last : $last;
}

/**
 * Event variables shared by the compact card, the teaser and the full page.
 *
 * Sets:
 *   - where_list      — list of {name, area, url}: every venue with its
 *                       parent term (the town). One entry for a normal
 *                       event; several when the event runs at more than one
 *                       place at once (field_where is multi-value).
 *   - where_areas     — the distinct towns, in venue order ("Southampton,
 *                       Fareham and Portsmouth"), for the compact card's
 *                       "4 venues" line.
 *   - organisers        — list of {label, url}: field_organisers (one or
 *                       several Organisations); organiser_label joins the
 *                       names ("A and B"), organiser_url is the first.
 *   - node_links        — outward links as buttons (field_urls), see
 *                       _customsolent_node_link_buttons().
 *   - event_arrival     — "Be there for the start" / "Join at the start of
 *                       a session", or '' (drop in any time).
 *   - is_past_event   — TRUE once the last date has ended.
 *   - event_is_recurring   — TRUE when any date item carries a rule.
 *   - event_recurrence_lines — one phrase per rule, "Every Monday,
 *                       7pm - 8:30pm"; several when the event's sessions
 *                       differ by day.
 *   - event_recurrence_text — the first rule's "Every Monday".
 *   - event_recurrence_times — "7:00pm - 8:30pm" from the first rule's
 *                       first instance, or '' for all-day.
 *   - event_next_dates — the next instances after now as "Mon 20 Oct"
 *                       strings (up to three; the first is the one cards
 *                       show), and event_next_count how many were found.
 *   - event_when_cache — cache metadata: a max-age to the next instance's
 *                       start (so "Next" moves on) plus the rule's tag.
 */
function _customsolent_preprocess_event_shared_extras($node, array &$variables): void {
  // Venues.
  $variables['where_list'] = [];
  $variables['where_areas'] = '';
  if ($node->hasField('field_where') && !$node->get('field_where')->isEmpty()) {
    /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $areas = [];
    foreach ($node->get('field_where')->referencedEntities() as $where) {
      $parents = $term_storage->loadParents($where->id());
      $parent = $parents ? reset($parents) : NULL;
      $variables['where_list'][] = [
        'name' => $where->getName(),
        'area' => $parent ? $parent->getName() : NULL,
      ];
      if ($parent && !in_array($parent->getName(), $areas, TRUE)) {
        $areas[] = $parent->getName();
      }
    }
    $variables['where_areas'] = _customsolent_join_names($areas);
  }

  // Outward links as buttons: tickets, the event page, or social pages.
  $variables['node_links'] = _customsolent_node_link_buttons($node);
  $variables['event_cta_text'] = $variables['node_links'][0]['label'] ?? (string) t('Event details');

  // Organisers — one or several (two clubs putting on one all-dayer).
  // organisers: list of {label, url}; organiser_label: "A and B" for the
  // "Coming up from …" heading; organiser_url: the first, for anything
  // that wants a single link.
  $variables['organisers'] = [];
  if ($node->hasField('field_organisers') && !$node->get('field_organisers')->isEmpty()) {
    foreach ($node->get('field_organisers')->referencedEntities() as $org) {
      if ($org->access('view')) {
        $variables['organisers'][] = ['label' => $org->label(), 'url' => $org->toUrl()->toString()];
      }
    }
  }
  if ($variables['organisers']) {
    $variables['organiser_label'] = _customsolent_join_names(array_column($variables['organisers'], 'label'));
    $variables['organiser_url'] = $variables['organisers'][0]['url'];
  }

  // Arrival: whether it matters when people turn up. "Drop in any time" is
  // the default and prints nothing; the other two print a short line by
  // the date (a walk sets off on time; a class evening has sessions).
  $variables['event_arrival'] = '';
  if ($node->hasField('field_arrival') && !$node->get('field_arrival')->isEmpty()) {
    $variables['event_arrival'] = match ((string) $node->get('field_arrival')->value) {
      'on_time' => (string) t('Be there for the start'),
      'sessions' => (string) t('Join at the start of a session'),
      default => '',
    };
  }

  // Recurrence.
  $variables['event_is_recurring'] = FALSE;
  $variables['event_next_dates'] = [];
  $variables['event_break_notice'] = NULL;
  $variables['event_break_notices'] = [];
  $variables['event_next_count'] = 0;
  $variables['event_when_cache'] = ['#cache' => []];
  // The date a card shows for this event: its own date, or for a regular
  // event the next instance (set below). Read by the series membership
  // preprocess to decide whether a seasonal series' label applies to it.
  $variables['event_card_date'] = NULL;
  if (!$node->hasField('field_when') || $node->get('field_when')->isEmpty()) {
    return;
  }
  $variables['event_card_date'] = (int) $node->get('field_when')->first()->value;
  $now = \Drupal::time()->getRequestTime();
  // Over once its LAST date has ended (a regular event holds one item per
  // instance). Read by the page (badge by the date, no outward link) and
  // by the cards (no button). An item with no end time runs to the end of
  // its day, the same rule the listings' query applies
  // (_customsolent_helpers_one_row_per_recurring_event).
  $last_end = 0;
  foreach ($node->get('field_when') as $item) {
    $last_end = max($last_end, _customsolent_event_item_end((int) $item->value, (int) $item->end_value, $item->timezone ?: NULL));
  }
  $variables['is_past_event'] = $last_end > 0 && $last_end < $now;
  $rule_id = NULL;
  $instances = [];
  foreach ($node->get('field_when') as $item) {
    if (!empty($item->rrule)) {
      $rule_id ??= (int) $item->rrule;
      // 'end' is the moment the instance is over for "Next:" and the card's
      // expiry: the entered end, or the end of the day when none was.
      // 'end_entered' keeps the stored value for the printed times.
      $instances[] = [
        'rule' => (int) $item->rrule,
        'start' => (int) $item->value,
        'end' => _customsolent_event_item_end((int) $item->value, (int) $item->end_value, $item->timezone ?: NULL),
        'end_entered' => (int) $item->end_value,
        'duration' => (int) $item->duration,
        'tz' => $item->timezone ?: 'Europe/London',
      ];
    }
  }
  if ($rule_id === NULL || !$instances) {
    // A one-off event leaves the listings when it ends (the events query
    // alter applies the same clock), so its rendered card must expire then
    // too, or the cached listing keeps showing it. No end time (end =
    // start) means no known finish: the listing keeps it until midnight.
    $first = $node->get('field_when')->first();
    $end = _customsolent_event_item_end((int) $first->value, (int) $first->end_value, $first->timezone ?: NULL);
    if ($end >= $now) {
      $variables['event_when_cache']['#cache']['max-age'] = max(60, $end - $now + 1);
    }
    return;
  }
  $variables['event_is_recurring'] = TRUE;
  usort($instances, static fn($a, $b) => $a['start'] <=> $b['start']);
  $tz = new \DateTimeZone($instances[0]['tz']);
  $fmt = static fn(int $ts, string $f) => (new \DateTimeImmutable('@' . $ts))->setTimezone($tz)->format($f);
  // Breaks and seasons: an instance in a closure Break, or outside the
  // event's season, does not run (the listings' query agrees); one in an
  // advisory Break runs with a note by its date. Cards and pages change
  // when a Break is saved.
  $variables['event_when_cache']['#cache']['tags'][] = 'node_list:break';
  $season_from = $node->hasField('field_season_from') ? (int) $node->get('field_season_from')->value : 0;
  $season_to = $node->hasField('field_season_to') ? (int) $node->get('field_season_to')->value : 0;
  $nid = (int) $node->id();
  $advisories = [];
  $instances = array_values(array_filter($instances, static function (array $i) use ($nid, $fmt, $season_from, $season_to, &$advisories): bool {
    if (!customsolent_helpers_in_season((int) $fmt($i['start'], 'n'), $season_from ?: NULL, $season_to ?: NULL)) {
      return FALSE;
    }
    $break = customsolent_helpers_break_for($nid, $i['start']);
    if ($break && $break['kind'] === 'closure') {
      return FALSE;
    }
    if ($break) {
      $advisories[$i['start']] = $break;
    }
    return TRUE;
  }));
  $variables['event_break_notice'] = NULL;
  $variables['event_break_notices'] = [];
  if (!$instances) {
    return;
  }
  // On a series page a regular event is there for the instance(s) that fell
  // within the series' dates (the Halloween edition), so "Next" is the next
  // instance inside that window and, once they have all passed, the card
  // shows the last one as a date, like any past member. Elsewhere the card
  // shows the next instance overall.
  $variables['event_next_prefix'] = (string) t('Next');
  $pool = $instances;
  if ($series_id = _customsolent_rendering_members_of_series()) {
    $series_node = \Drupal\node\Entity\Node::load($series_id);
    if ($series_node) {
      [$w_start, $w_end] = \Drupal::service('customsolent_helpers.content_relations')->seriesDates($series_node);
      if ($w_start !== NULL || $w_end !== NULL) {
        $pool = array_values(array_filter($instances, static function ($i) use ($fmt, $w_start, $w_end) {
          $day = $fmt($i['start'], 'Y-m-d');
          return ($w_start === NULL || $day >= $w_start) && ($w_end === NULL || $day <= $w_end);
        }));
      }
      $variables['event_when_cache']['#cache']['tags'][] = 'node:' . $series_id;
    }
  }
  $time_fmt = static function (int $ts) use ($fmt): string {
    // "7pm" when on the hour, "7:30pm" otherwise — as the cards do.
    return $fmt($ts, 'i') === '00' ? $fmt($ts, 'ga') : $fmt($ts, 'g:ia');
  };
  // One line per rule: "Every Monday and Wednesday, 2 - 3:30pm". An event
  // whose sessions differ by day carries several rules in field_when (a
  // drop-in on Mon/Wed afternoons and Tue/Thu mornings); every rule is
  // named, in order of first instance, or the card tells only half the
  // story. event_recurrence_text / _times keep the first rule's words for
  // anything that wants a single phrase.
  // No end time is entered as end = start (the same convention as one-off
  // events, whose formatter then prints one time): show "7:30pm", never
  // "7:30pm - 7:30pm".
  $times_of = static function (array $first) use ($time_fmt): string {
    if ($first['duration'] >= 1439) {
      return '';
    }
    if ($first['end_entered'] <= $first['start']) {
      return $time_fmt($first['start']);
    }
    return $time_fmt($first['start']) . ' - ' . $time_fmt($first['end_entered']);
  };
  $first_by_rule = [];
  foreach ($instances as $instance) {
    $first_by_rule[$instance['rule']] ??= $instance;
  }
  $has_recur = \Drupal::moduleHandler()->moduleExists('smart_date_recur');
  $variables['event_recurrence_lines'] = [];
  $variables['event_recurrence_text'] = '';
  $variables['event_recurrence_times'] = '';
  $variables['event_when_cache']['#cache']['tags'] = $variables['event_when_cache']['#cache']['tags'] ?? [];
  foreach ($first_by_rule as $rid => $first) {
    $text = '';
    if ($has_recur && ($rule = \Drupal\smart_date_recur\Entity\SmartDateRule::load($rid))) {
      $text = _customsolent_recurrence_phrase($rule, $first['start'], $tz);
      $variables['event_when_cache']['#cache']['tags'] = array_merge($variables['event_when_cache']['#cache']['tags'], $rule->getCacheTags());
    }
    $times = $times_of($first);
    if ($variables['event_recurrence_text'] === '' && $variables['event_recurrence_times'] === '') {
      $variables['event_recurrence_text'] = $text;
      $variables['event_recurrence_times'] = $times;
    }
    $line = trim($text . ($text !== '' && $times !== '' ? ', ' : '') . $times);
    if ($line !== '') {
      $variables['event_recurrence_lines'][] = $line;
    }
  }
  $first = $instances[0];
  $next_start = NULL;
  foreach ($pool as $instance) {
    if ($instance['end'] >= $now) {
      $variables['event_next_dates'][] = $fmt($instance['start'], 'D j M');
      $next_start ??= $instance['start'];
      // "Falls in the Christmas break: check with the organiser" by the
      // date: the card carries it for its one date, the page for each of
      // the dates it shows.
      if (isset($advisories[$instance['start']])) {
        $notice = customsolent_helpers_break_notice($advisories[$instance['start']]);
        $variables['event_break_notice'] ??= $notice;
        $variables['event_break_notices'][] = $fmt($instance['start'], 'D j M') . ': ' . $notice;
      }
      if (count($variables['event_next_dates']) === 3) {
        break;
      }
    }
  }
  $variables['event_next_count'] = count(array_filter($pool, static fn($i) => $i['end'] >= $now));
  if ($next_start === NULL && $pool && $pool !== $instances) {
    // Every instance in the series' window has passed: show the last one.
    $last = end($pool);
    $variables['event_next_dates'] = [$fmt($last['start'], 'D j M')];
    $variables['event_next_prefix'] = '';
    $variables['event_card_date'] = $last['start'];
  }
  if ($next_start !== NULL) {
    $variables['event_card_date'] = $next_start;
    // Move "Next" on when the current instance ends (its start may already
    // be in the past while it is running).
    $current_end = NULL;
    foreach ($instances as $instance) {
      if ($instance['end'] >= $now) {
        $current_end = $instance['end'];
        break;
      }
    }
    $variables['event_when_cache']['#cache']['max-age'] = max(60, ($current_end ?? $next_start) - $now + 1);
  }
}

/**
 * When a field_when item is over: its end, or, entered without one (end =
 * start), the end of its day in its own timezone.
 *
 * The listings' query uses the same rule
 * (_customsolent_helpers_one_row_per_recurring_event), so a page never
 * says "Past event" while a listing still shows the event, or the reverse.
 */
function _customsolent_event_item_end(int $start, int $end, ?string $timezone = NULL): int {
  return customsolent_helpers_item_end($start, $end, $timezone);
}

/**
 * Adds section key, topic tile and a one-line summary to the compact
 * article card.
 *
 * card_summary is the standfirst when one is written. Otherwise it is
 * the body with markup stripped, whitespace collapsed and truncated to
 * ~120 characters on a word boundary with an ellipsis. When both are
 * empty it is left unset so the template omits the paragraph.
 *
 * The fallback is computed here rather than in Twig so the truncation
 * is testable and field_body can stay hidden in the compact display
 * without ever being rendered in full.
 */
function _customsolent_preprocess_article_compact_extras($node, array &$variables): void {
  // Section key from the top-level Topic — drives the card's fill
  // colour (css/article-compact.css maps data-section to a colour that
  // passes AA contrast with white text). Also pick the hero tile SVG
  // for the article's own topic, falling back to the section's
  // "view all" tile, then to the generic articles tile.
  $tile_candidates = [];
  if ($node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term) {
      $top = _customsolent_topic_top_level($term);
      if ($top) {
        $variables['section_key'] = strtolower($top->getName());
        $variables['section_color'] = _customsolent_topic_section_colors()[$top->getName()] ?? NULL;
        $slug = static fn(string $name): string => trim(preg_replace('/[^a-z0-9]+/', '_', strtolower($name)) ?? '', '_');
        // Topic term names carry their path ("Culture / Identity"), so
        // take the last segment for the tile filename.
        $name_parts = explode(' / ', $term->getName());
        $tile_candidates[] = $slug($top->getName()) . '_' . $slug(end($name_parts));
        // A third-level term without a tile of its own (Stage / Comedy)
        // uses its parent's, before the section's "view all" tile.
        foreach (\Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadAllParents($term->id()) as $ancestor) {
          if ($ancestor->id() === $term->id() || $ancestor->id() === $top->id()) {
            continue;
          }
          $ancestor_parts = explode(' / ', $ancestor->getName());
          $tile_candidates[] = $slug($top->getName()) . '_' . $slug(end($ancestor_parts));
        }
        $tile_candidates[] = $slug($top->getName()) . '_' . $slug($top->getName());
      }
    }
  }
  $tile_candidates[] = 'explore_articles';
  $tile_dir = \Drupal::service('extension.list.theme')->getPath('customsolent') . '/images/hero-tiles';
  foreach ($tile_candidates as $candidate) {
    $tile_file = DRUPAL_ROOT . "/$tile_dir/$candidate.svg";
    if (is_file($tile_file)) {
      // The file's mtime as a cache-buster: the tiles are served with a
      // ten-year cache lifetime, so a reworked tile would otherwise be
      // drawn from the browser's old copy.
      $variables['card_tile_url'] = \Drupal::service('file_url_generator')->generateString("$tile_dir/$candidate.svg")
        . '?v=' . filemtime($tile_file);
      // The card draws the tile at 70% of its hero size. Most tiles are
      // 120px wide, but a composite tile (every icon once, e.g.
      // culture_culture) is much wider, so read the width from the file
      // and pass it on; css/article-compact.css falls back to 84px.
      $head = (string) file_get_contents($tile_file, FALSE, NULL, 0, 300);
      if (preg_match('/<svg[^>]*\swidth="([\d.]+)"/', $head, $wm) && (float) $wm[1] > 0) {
        $variables['card_tile_width'] = round((float) $wm[1] * 0.7, 2);
      }
      break;
    }
  }

  // 1. Standfirst wins when written.
  if ($node->hasField('field_standfirst') && !$node->get('field_standfirst')->isEmpty()) {
    $standfirst = trim((string) $node->get('field_standfirst')->value);
    if ($standfirst !== '') {
      $variables['card_summary'] = $standfirst;
      return;
    }
  }

  // 2. Otherwise a trimmed plain-text excerpt of the body.
  if ($node->hasField('field_body') && !$node->get('field_body')->isEmpty()) {
    // Replace tags with a space before stripping so adjacent block
    // elements (</p><p>) don't run their words together.
    $text = preg_replace('/<[^>]+>/', ' ', (string) $node->get('field_body')->value) ?? '';
    $text = html_entity_decode($text, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    $text = trim(preg_replace('/\s+/u', ' ', $text) ?? '');
    if ($text !== '') {
      $variables['card_summary'] = \Drupal\Component\Utility\Unicode::truncate($text, 120, TRUE, TRUE);
    }
  }
}

/**
 * A node's outward links as buttons: {href, external, icon, label, platform}.
 *
 * Standard wording, so every button in a listing reads the same and no
 * long event title ends up inside one: "Tickets" for a ticketing site
 * (or a link whose text mentions booking), the platform's name for a
 * social media page ("Facebook"), and otherwise "Event details" on an
 * event or the editor's link text (or "Website") on an organisation. The
 * icon says the same thing at a glance — ticket, platform logo, globe —
 * and the template adds a visually hidden "(opens in a new tab)".
 *
 * Kinds are decided from the address at render time
 * (customsolent_helpers_link_kind()).
 */
function _customsolent_node_link_buttons($node): array {
  $buttons = [];
  foreach (customsolent_helpers_node_links($node) as $link) {
    $label = match ($link['kind']) {
      'tickets' => (string) t('Tickets'),
      'social' => $link['platform'],
      default => $node->bundle() === 'event' ? (string) t('Event details') : ($link['title'] !== '' ? $link['title'] : (string) t('Website')),
    };
    $buttons[] = ['href' => $link['href'], 'external' => $link['external'], 'icon' => $link['icon'], 'kind' => $link['kind'], 'label' => $label, 'platform' => $link['platform']];
  }
  return $buttons;
}

/**
 * Extracts field_url metadata into preprocess $variables.
 *
 * Sets field_url_href, field_url_text (link title or URL fallback),
 * and field_url_external on the variables array. Skips silently if
 * the URL is malformed or absent.
 */
function _customsolent_extract_field_url_meta($node, array &$variables): void {
  // Events and organisations carry several links (field_urls); the first
  // is the main one. Links keep their single field_url.
  $field = $node->hasField('field_urls') ? 'field_urls' : 'field_url';
  if (!$node->hasField($field) || $node->get($field)->isEmpty()) {
    return;
  }
  $item = $node->get($field)->first();
  try {
    $url = $item->getUrl();
    $variables['field_url_external'] = $url->isExternal();
    $variables['field_url_href'] = $url->toString();
    $variables['field_url_text'] = $item->title ?: $url->toString();
  }
  catch (\Throwable) {
    // Malformed URI — leave variables unset; template falls back.
  }
}

/**
 * Adds the series a node belongs to, for event cards and full pages.
 *
 * Sets:
 *   - series_links  — list of {label, url, range, status, status_label};
 *                     empty when the node is in no published series.
 *   - series_cache  — a render array carrying the cache tags (and max-age)
 *                     of the lookup. The template MUST print it in every
 *                     branch, including "no series", so that creating a
 *                     series later refreshes cards cached as series-less.
 *
 * Series membership is stored on the Series (field_series_items), so this
 * is a reverse lookup via the content_relations service.
 */
function _customsolent_preprocess_series_membership($node, array &$variables): void {
  /** @var \Drupal\customsolent_helpers\ContentRelations $relations */
  $relations = \Drupal::service('customsolent_helpers.content_relations');
  $series = $relations->seriesContaining($node);
  // On a series' own page its name on every member card would only repeat
  // the h1. The series page renders its members with a distinct cache key
  // (see _customsolent_preprocess_series_extras), so dropping it here does
  // not leak into the cards cached for other pages.
  // The seasonal label under the date is still wanted there (the title may
  // not say it), so only the name line is dropped, below.
  $on_series_page = _customsolent_rendering_members_of_series();
  $variables['series_links'] = [];
  $variables['series_specials'] = [];
  $is_card = ($variables['view_mode'] ?? '') !== 'full';
  $date_bound = FALSE;
  // The date this card shows, Y-m-d in the site timezone (NULL when unknown).
  $card_date = NULL;
  if (!empty($variables['event_card_date'])) {
    $card_date = (new \DateTimeImmutable('@' . $variables['event_card_date']))
      ->setTimezone(new \DateTimeZone(\Drupal::config('system.date')->get('timezone.default') ?: 'Europe/London'))
      ->format('Y-m-d');
  }
  foreach ($series as $s) {
    $status = $relations->seriesStatus($s);
    [$s_start, $s_end] = $relations->seriesDates($s);
    if ($s_end !== NULL) {
      $date_bound = TRUE;
    }
    // Cards: a series that has ended is not mentioned at all. An exhibition
    // that ran on past Black History Month is no longer "part of" it on its
    // card (Rob, 14 Nov 2026); the series' own page still lists every
    // member, and the full page says "Part of a past series". Before that,
    // a series is shown for an event only while the date the card shows
    // falls on or before the series' end: a weekly event whose next
    // instance is 4 Nov is not "part of" a Halloween series that ended on
    // the 2nd, even though its 30 Oct instance was. (On the series' own page
    // the card shows the instance inside the window, so it still counts.)
    if ($is_card && $status === $relations::STATUS_PAST) {
      continue;
    }
    if ($is_card && $s_end !== NULL && $card_date !== NULL && $card_date > $s_end) {
      continue;
    }
    // A series can carry a short label ("Halloween special"). On event cards,
    // while the series is coming up or on, that label is printed directly
    // under the date it applies to (plain text: the date sits inside the
    // card's link, and a link inside a link is invalid HTML) and the series
    // drops out of the "Part of the series" line so it is not said twice. A
    // regular event added to a seasonal series therefore reads as the
    // special for that week and goes back to normal with no edit. The full
    // page keeps the name, its link and its status word.
    $short = $s->hasField('field_short_label') ? trim((string) $s->get('field_short_label')->value) : '';
    if ($is_card && $short !== '') {
      $date_bound = TRUE;
      // The label belongs to the date it sits under: before the series starts
      // the card shows the series name below instead (after the end the
      // series is not shown at all, above).
      $in_window = $card_date === NULL || $s_start === NULL || $card_date >= $s_start;
      if ($status !== $relations::STATUS_PAST && $in_window) {
        // Do not say what the title already says: "Halloween Market" needs
        // no "Halloween special" under its date, and the series line would
        // repeat it too, so the series is left off the card altogether. Only
        // the label's own words count, not the series name's, so a series
        // called "Cost of Living" never silences an event with "living" in
        // its title.
        if (!_customsolent_title_already_says($node->getTitle(), [$short])) {
          $variables['series_specials'][] = $short;
        }
        continue;
      }
    }
    if ($on_series_page && (int) $s->id() === $on_series_page) {
      continue;
    }
    $variables['series_links'][] = [
      'label' => $s->label(),
      'url' => $s->toUrl()->toString(),
      'range' => $relations->seriesDateRange($s),
      'status' => $status,
      'status_label' => $relations->statusLabel($status),
    ];
  }
  // The full page's label: "Part of a past series" once every series the
  // event is in has ended (the meta then needs no status word).
  $variables['series_all_past'] = $variables['series_links'] !== []
    && array_filter($variables['series_links'], static fn(array $s) => $s['status'] !== $relations::STATUS_PAST) === [];
  $variables['series_cache'] = [
    '#cache' => [
      'tags' => $relations->seriesCacheTags($series),
      // The full page prints a status word, and a card whose series has a
      // short label or an end date depends on the series dates: both expire
      // at midnight. Other cards print just the name and keep for good.
      'max-age' => (!$is_card || $date_bound) ? $relations->maxAgeUntilMidnight() : \Drupal\Core\Cache\Cache::PERMANENT,
    ],
  ];
}

/**
 * Whether a title already contains a distinctive word from the given phrases.
 *
 * Words of four or more letters count, except generic ones ("special",
 * "edition", "night"…), so "Halloween Market" already says "Halloween
 * Special 🎃" but "Christmas Special" does not say "Halloween Special".
 * Callers pass the short label only: it is written to be said on a card,
 * so its words are the ones worth not repeating.
 * Case-insensitive, whole words, emoji and punctuation ignored.
 */
function _customsolent_title_already_says(string $title, array $phrases): bool {
  static $generic = ['special', 'specials', 'edition', 'editions', 'event', 'events', 'series', 'night', 'nights', 'week', 'weekend', 'month', 'festival', 'season', 'party', 'with', 'from', 'this', 'that', 'year'];
  $words = [];
  foreach ($phrases as $phrase) {
    preg_match_all('/\p{L}{4,}/u', mb_strtolower($phrase), $m);
    foreach ($m[0] as $word) {
      if (!in_array($word, $generic, TRUE) && !preg_match('/^\d+$/', $word)) {
        $words[$word] = TRUE;
      }
    }
  }
  if (!$words) {
    return FALSE;
  }
  $haystack = mb_strtolower($title);
  foreach (array_keys($words) as $word) {
    if (preg_match('/(?<!\p{L})' . preg_quote($word, '/') . '(?!\p{L})/u', $haystack)) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * The series whose member cards are being rendered right now, or 0.
 *
 * Set by the SeriesMemberContext callbacks around each member card on a
 * series page, read by _customsolent_preprocess_series_membership().
 */
function _customsolent_rendering_members_of_series(?int $set = NULL): int {
  $current = &drupal_static(__FUNCTION__, 0);
  if ($set !== NULL) {
    $current = $set;
  }
  return $current;
}

/**
 * The trusted callback class that brackets a member card's render.
 */
function _customsolent_series_member_pre_render_class(): string {
  return \Drupal\customsolent_helpers\Render\SeriesMemberContext::class;
}

/**
 * Collaboration variables for the card (teaser) and the page (full).
 *
 * Sets:
 *   - collab_who          — "A, B and C" / "A, B and 3 more" (card).
 *   - collab_count_parts  — non-zero outcome counts as phrases (card).
 *   - section_key / section_color.
 *   - collab_collaborators — (full) collaborator nodes rendered as teaser
 *     rows, published only, editor order.
 *   - collab_groups        — (full) outcomes grouped by bundle as compact
 *     cards: {key, label, items[], grid_class}.
 *   - collab_cache         — cache metadata to print in every branch.
 */
function _customsolent_preprocess_collaboration_extras($node, array &$variables): void {
  $view_mode = $variables['view_mode'] ?? '';
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');

  if ($node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term && ($top = _customsolent_topic_top_level($term))) {
      $variables['section_key'] = strtolower($top->getName());
      $variables['section_color'] = _customsolent_topic_section_colors()[$top->getName()] ?? NULL;
    }
  }

  // Collaborators: published collaborator nodes whose organisation/person
  // is itself viewable. Name = the organisation's / person's label.
  $collaborators = [];
  foreach ($node->get('field_collaborators')->referencedEntities() as $c) {
    if (!$c->isPublished() || !$c->access('view')) {
      continue;
    }
    $collaborators[] = $c;
  }
  $names = [];
  foreach ($collaborators as $c) {
    $who = $c->get('field_collaborator')->entity;
    $names[] = $who ? $who->label() : $c->label();
  }
  $shown = array_slice($names, 0, 3);
  $more = count($names) - count($shown);
  if ($more > 0) {
    $variables['collab_who'] = implode(', ', $shown) . ' ' . t('and @count more', ['@count' => $more]);
  }
  elseif (count($shown) > 1) {
    $last = array_pop($shown);
    $variables['collab_who'] = implode(', ', $shown) . ' ' . t('and') . ' ' . $last;
  }
  else {
    $variables['collab_who'] = $shown[0] ?? '';
  }

  // Outcomes grouped by bundle.
  $group_defs = [
    'event' => ['label' => t('Events'), 'grid_class' => 'slnt-series-items__grid--events', 'one' => '1 event', 'many' => '@count events'],
    'article' => ['label' => t('Articles'), 'grid_class' => 'slnt-series-items__grid--articles', 'one' => '1 article', 'many' => '@count articles'],
    'series' => ['label' => t('Series'), 'grid_class' => 'slnt-series-items__grid--links', 'one' => '1 series', 'many' => '@count series'],
    'link' => ['label' => t('Links'), 'grid_class' => 'slnt-series-items__grid--links', 'one' => '1 link', 'many' => '@count links'],
  ];
  $outcomes = [];
  foreach ($node->get('field_outcomes')->referencedEntities() as $o) {
    if ($o->isPublished() && $o->access('view') && isset($group_defs[$o->bundle()])) {
      $outcomes[$o->bundle()][] = $o;
    }
  }
  $parts = [];
  foreach ($group_defs as $bundle => $def) {
    if (!empty($outcomes[$bundle])) {
      $parts[] = \Drupal::translation()->formatPlural(count($outcomes[$bundle]), $def['one'], $def['many']);
    }
  }
  $variables['collab_count_parts'] = $parts;

  $variables['collab_cache'] = [
    '#cache' => [
      'tags' => ['node_list:collaborator', 'node_list:event', 'node_list:article', 'node_list:series', 'node_list:link'],
    ],
  ];

  if ($view_mode !== 'full') {
    return;
  }

  $variables['collab_collaborators'] = [];
  foreach ($collaborators as $c) {
    $variables['collab_collaborators'][] = $view_builder->view($c, 'teaser');
  }
  $groups = [];
  foreach ($group_defs as $bundle => $def) {
    foreach ($outcomes[$bundle] ?? [] as $o) {
      // Series are shown as their teaser card (status, dates, counts); the
      // rest as compact cards, as on a series page.
      $groups[$bundle] ??= ['key' => $bundle, 'label' => $def['label'], 'grid_class' => $def['grid_class'], 'items' => []];
      $groups[$bundle]['items'][] = $view_builder->view($o, $bundle === 'series' ? 'teaser' : 'compact');
    }
  }
  $variables['collab_groups'] = array_values($groups);
}

/**
 * Collaborator row variables: who, where they link to, their role terms.
 *
 * A collaborator is an organisation or person (field_collaborator) plus
 * how they take part (field_collaborator_type) and a description. Sets
 * who_label, who_url, who_kind, who_types and, for a person, who_chip
 * (the Person chip render array).
 */
function _customsolent_preprocess_collaborator_extras($node, array &$variables): void {
  $variables['who_label'] = NULL;
  $variables['who_url'] = NULL;
  $variables['who_kind'] = NULL;
  $variables['who_chip'] = NULL;
  $variables['who_types'] = [];
  $who = $node->get('field_collaborator')->entity;
  if ($who && $who->access('view')) {
    $variables['who_label'] = $who->label();
    $variables['who_url'] = $who->toUrl()->toString();
    $variables['who_kind'] = $who->bundle();
    if ($who->bundle() === 'person') {
      $variables['who_chip'] = \Drupal::entityTypeManager()->getViewBuilder('node')->view($who, 'compact');
    }
  }
  foreach ($node->get('field_collaborator_type')->referencedEntities() as $term) {
    $variables['who_types'][] = $term->getName();
  }
}

/**
 * "Part of a collaboration" for full pages.
 *
 * Outcomes (event, article, series, link) ask collaborationsFor(); people
 * and organisations ask collaborationsInvolving(). Sets collaboration_items
 * (teaser cards) and collaborations_cache (print in every branch).
 */
function _customsolent_preprocess_collaboration_membership($node, array &$variables): void {
  /** @var \Drupal\customsolent_helpers\ContentRelations $relations */
  $relations = \Drupal::service('customsolent_helpers.content_relations');
  $collaborations = in_array($node->bundle(), ['person', 'organisation'], TRUE)
    ? $relations->collaborationsInvolving($node)
    : $relations->collaborationsFor($node);
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
  $variables['collaboration_items'] = [];
  foreach ($collaborations as $c) {
    $variables['collaboration_items'][] = $view_builder->view($c, 'teaser');
  }
  $variables['collaborations_cache'] = ['#cache' => ['tags' => $relations->collaborationsCacheTags($collaborations)]];
}

/**
 * Person variables for the chip (compact), team card (teaser) and page.
 *
 * Sets:
 *   - person_initials — up to two letters for the no-photo avatar.
 *   - person_where    — the Location term's name, plain.
 *   - person_articles / person_articles_cache — (full only) the articles
 *     this person wrote, as compact cards, and the cache metadata to print.
 */
function _customsolent_preprocess_person_extras($node, array &$variables): void {
  $first = trim((string) ($node->get('field_first_name')->value ?? ''));
  $last = trim((string) ($node->get('field_last_name')->value ?? ''));
  $initials = mb_strtoupper(mb_substr($first, 0, 1) . mb_substr($last, 0, 1));
  $variables['person_initials'] = $initials !== '' ? $initials : mb_strtoupper(mb_substr($node->label(), 0, 1));

  if ($node->hasField('field_where') && !$node->get('field_where')->isEmpty()) {
    $where = $node->get('field_where')->entity;
    if ($where) {
      $variables['person_where'] = $where->getName();
    }
  }

  if (($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  /** @var \Drupal\customsolent_helpers\ContentRelations $relations */
  $relations = \Drupal::service('customsolent_helpers.content_relations');
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
  $variables['person_articles'] = [];
  foreach ($relations->articlesBy($node) as $article) {
    $variables['person_articles'][] = $view_builder->view($article, 'compact');
  }
  $variables['person_articles_cache'] = ['#cache' => ['tags' => $relations->articlesByCacheTags()]];
}

/**
 * Article byline: the authors' names as plain text.
 *
 * Sets byline_names (list of strings, published persons only) and
 * byline_text ("Rob Davis", "Rob Davis and Jo Bloggs", "A, B and C").
 * The teaser card is one big link and the compact card has a stretched
 * link, so neither can hold the author as its own link; they print the
 * text. The full page renders content.field_author (Person chips) instead.
 */
function _customsolent_preprocess_article_byline($node, array &$variables): void {
  $variables['byline_names'] = [];
  $variables['byline_text'] = '';
  if (!$node->hasField('field_author') || $node->get('field_author')->isEmpty()) {
    return;
  }
  foreach ($node->get('field_author')->referencedEntities() as $person) {
    if ($person->isPublished() || \Drupal::currentUser()->hasPermission('view own unpublished content')) {
      $variables['byline_names'][] = $person->label();
    }
  }
  $names = $variables['byline_names'];
  if (!$names) {
    return;
  }
  $last = array_pop($names);
  $variables['byline_text'] = $names
    ? implode(', ', $names) . ' ' . t('and') . ' ' . $last
    : $last;
}

/**
 * Series card and full-page variables.
 *
 * Sets:
 *   - series_status / series_status_label — upcoming|current|ongoing|past
 *     and its reader-facing word ("Now on"). Changes at midnight, so
 *     series_cache carries a max-age to the next local midnight.
 *   - series_range, series_start_iso, series_end_iso — "1–31 October 2026"
 *     and the ISO dates for <time>.
 *   - series_counts — {event, article, link} published members; and
 *     series_count_parts — the non-zero counts as phrases ("7 events").
 *   - series_groups — (full only) members rendered in the compact view
 *     mode, grouped by bundle: list of {key, label, items[], grid_class}.
 *   - related_organisations — (full only) field_related_organisations
 *     rendered as compact cards: organisations that were not part of the
 *     series but are relevant to it, shown under their own heading after
 *     the members.
 *   - section_key / section_color — from the primary topic's section.
 *   - series_cache — render array with the cache metadata of the above.
 */
function _customsolent_preprocess_series_extras($node, array &$variables): void {
  /** @var \Drupal\customsolent_helpers\ContentRelations $relations */
  $relations = \Drupal::service('customsolent_helpers.content_relations');
  $view_mode = $variables['view_mode'] ?? '';

  $status = $relations->seriesStatus($node);
  $variables['series_status'] = $status;
  $variables['series_status_label'] = $relations->statusLabel($status);
  $variables['series_range'] = $relations->seriesDateRange($node);
  [$variables['series_start_iso'], $variables['series_end_iso']] = $relations->seriesDates($node);

  // Organiser — the organisation curating the series, when one is named
  // (issue 436). Same variables as the event page, so the template line
  // is the same; empty means the line is not printed.
  $variables['organiser_label'] = '';
  $variables['organiser_url'] = '';
  $variables['organisers'] = [];
  if ($node->hasField('field_organisers') && !$node->get('field_organisers')->isEmpty()) {
    foreach ($node->get('field_organisers')->referencedEntities() as $org) {
      if ($org->access('view')) {
        $variables['organisers'][] = ['label' => $org->label(), 'url' => $org->toUrl()->toString()];
      }
    }
  }
  if ($variables['organisers']) {
    $variables['organiser_label'] = _customsolent_join_names(array_column($variables['organisers'], 'label'));
    $variables['organiser_url'] = $variables['organisers'][0]['url'];
  }

  $counts = $relations->seriesCounts($node);
  $variables['series_counts'] = $counts;
  $parts = [];
  if ($counts['event']) {
    $parts[] = \Drupal::translation()->formatPlural($counts['event'], '1 event', '@count events');
  }
  if ($counts['article']) {
    $parts[] = \Drupal::translation()->formatPlural($counts['article'], '1 article', '@count articles');
  }
  if ($counts['link']) {
    $parts[] = \Drupal::translation()->formatPlural($counts['link'], '1 link', '@count links');
  }
  if ($counts['organisation']) {
    $parts[] = \Drupal::translation()->formatPlural($counts['organisation'], '1 organisation', '@count organisations');
  }
  $variables['series_count_parts'] = $parts;

  if ($node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term && ($top = _customsolent_topic_top_level($term))) {
      $variables['section_key'] = strtolower($top->getName());
      $variables['section_color'] = _customsolent_topic_section_colors()[$top->getName()] ?? NULL;
    }
  }

  // Cache: the members' own tags come with their render arrays; the status
  // word is the only time-dependent part.
  $tags = ['node_list:event', 'node_list:article', 'node_list:link', 'node_list:organisation'];
  $variables['series_cache'] = [
    '#cache' => [
      'tags' => $tags,
      'max-age' => $relations->maxAgeUntilMidnight(),
    ],
  ];

  if ($view_mode !== 'full') {
    return;
  }

  // Members, grouped by kind, each as its compact card. Editor order within
  // a group is kept (field_series_items is a sortable multi-value field).
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
  $group_defs = [
    'event' => ['label' => t('Events'), 'grid_class' => 'slnt-series-items__grid--events'],
    'article' => ['label' => t('Articles'), 'grid_class' => 'slnt-series-items__grid--articles'],
    'link' => ['label' => t('Links'), 'grid_class' => 'slnt-series-items__grid--links'],
    'organisation' => ['label' => t('Organisations'), 'grid_class' => 'slnt-series-items__grid--links'],
  ];
  $groups = [];
  foreach ($relations->seriesMembers($node) as $member) {
    $bundle = $member->bundle();
    if (!isset($group_defs[$bundle])) {
      continue;
    }
    $groups[$bundle] ??= ['key' => $bundle, 'items' => []] + $group_defs[$bundle];
    $build = $view_builder->view($member, 'compact');
    // A member card on its own series' page leaves that series' name out
    // (see _customsolent_preprocess_series_membership). That variant must
    // not share a render-cache entry with the card as shown elsewhere.
    $build['#cache']['keys'][] = 'in_series_' . $node->id();
    $build['#pre_render'][] = [_customsolent_series_member_pre_render_class(), 'enter'];
    $build['#post_render'][] = [_customsolent_series_member_pre_render_class(), 'leave'];
    $groups[$bundle]['items'][] = $build;
  }
  $variables['series_groups'] = array_values($groups);

  // Related organisations: not members, so plain compact cards (no
  // "part of this series" variant), in the editor's order.
  $variables['related_organisations'] = [];
  if ($node->hasField('field_related_organisations')) {
    foreach ($node->get('field_related_organisations')->referencedEntities() as $org) {
      if ($org->access('view')) {
        $variables['related_organisations'][] = $view_builder->view($org, 'compact');
      }
    }
  }
}



/**
 * Implements hook_preprocess_HOOK() for paragraph--link.html.twig.
 *
 * Sets link_context to the text of the nearest heading paragraph that
 * comes before this link in the same parent field. The template adds it
 * as visually-hidden text, so several "View more" links on one page are
 * distinguishable in a screen-reader's list of links.
 */
function customsolent_preprocess_paragraph__link(&$variables) {
  $paragraph = $variables['paragraph'];
  $parent = $paragraph->getParentEntity();
  $field_name = $paragraph->get('parent_field_name')->value;
  if (!$parent || !$field_name || !$parent->hasField($field_name)) {
    return;
  }
  $context = NULL;
  foreach ($parent->get($field_name)->referencedEntities() as $sibling) {
    if ((int) $sibling->id() === (int) $paragraph->id()) {
      break;
    }
    if ($sibling->bundle() === 'heading' && !$sibling->get('field_heading')->isEmpty()) {
      $context = trim(preg_replace('/\s+/', ' ', (string) $sibling->get('field_heading')->value));
    }
  }
  if ($context) {
    $variables['link_context'] = $context;
  }
  // A bare "View more" / "Read more" needs the heading to say more of what.
  // "View more Events" already says it; appending the heading would just be
  // noise for a screen-reader user.
  $title = trim((string) $paragraph->get('field_link')->title);
  $variables['link_needs_context'] = (bool) preg_match('/^(view|read|see|browse)\s+(more|all)$/i', $title);
}

function customsolent_preprocess_paragraph__hero_with_art_style(&$variables) {
  $paragraph = $variables['paragraph'];
  if ($paragraph->hasField('field_classy') && !$paragraph->get('field_classy')->isEmpty()) {
    $classy_style = $paragraph->get('field_classy')->entity;
    if ($classy_style) {
      $variables['attributes']['class'][] = $classy_style->get('classes');
    }
  }

  // Look up the parent composite_page node and pull its primary topic
  // so the hero can render the topic trail in place of the plain title.
  $parent = $paragraph->getParentEntity();

  // The front page has no topic, so its banner shows field_title - and
  // that title ("Welcome to The Solent Metropolitan") is the page's h1.
  $front = (string) \Drupal::config('system.site')->get('page.front');
  if ($parent && $parent->getEntityTypeId() === 'node' && $front === '/node/' . $parent->id()) {
    $variables['hero_title_tag'] = 'h1';
    $variables['#cache']['tags'][] = 'config:system.site';
  }
  // A banner built on the fly by a landing page (/events/<format>) has no
  // node; the controller says what its title tag is.
  if (!$parent && $paragraph->isNew() && \Drupal::request()->attributes->has('slnt_hero_title_tag')) {
    $variables['hero_title_tag'] = (string) \Drupal::request()->attributes->get('slnt_hero_title_tag');
    // … and its trail: the landing page's place in Explore (small), its
    // own name (big), as on a section page.
    $trail_term = \Drupal::request()->attributes->get('slnt_hero_trail_term');
    $current = \Drupal::request()->attributes->get('slnt_hero_trail_current');
    if ($trail_term && is_array($current)) {
      $trail = _customsolent_build_topic_trail($trail_term, FALSE);
      $variables['topic_trail_ancestors'] = $trail['ancestors'];
      $variables['topic_trail_current'] = $current['label'] ?? NULL;
      $variables['topic_trail_current_url'] = $current['url'] ?? NULL;
      $variables['topic_trail_as_heading'] = TRUE;
    }
  }
  if ($parent
    && $parent->getEntityTypeId() === 'node'
    && $parent->bundle() === 'composite_page'
    && $parent->hasField('field_primary_topic')
    && !$parent->get('field_primary_topic')->isEmpty()) {
    $term = $parent->get('field_primary_topic')->entity;
    if ($term) {
      $trail = _customsolent_build_topic_trail($term, TRUE);
      $variables['topic_trail_ancestors'] = $trail['ancestors'];
      $variables['topic_trail_current'] = $trail['current_label'];
      // The big title links to the topic's own page: from a filtered
      // view (?topic=…) or a listing page it is the way back to the
      // unfiltered page, the same escape the small ancestors give.
      $variables['topic_trail_current_url'] = $trail['current_url'];
      // On an automated listing page (/culture/music/events) the same
      // banner is shown, but that page's h1 is "Events": the topic name
      // renders as a span with the same look, so there is one h1.
      $variables['topic_trail_as_heading'] = (($variables['view_mode'] ?? '') !== 'listing_page');
    }
  }
}

/**
 * Section colour map — top-level Topic term name → hex colour.
 */
function _customsolent_topic_section_colors() {
  return [
    'Culture' => '#7C3AED',
    'Sectors' => '#2563EB',
    // Living and Explore were #059669 / #D97706 until 2026-09-19. Those
    // failed WCAG AA both as text on the page background (3.6 / 3.0:1)
    // and under white text (3.8 / 3.2:1). Deepened, same hue family.
    'Living'  => '#047857',
    'About'   => '#475569',
    'Explore' => '#BC4A08',
  ];
}

/**
 * Build a topic trail from a taxonomy term.
 *
 * @param \Drupal\taxonomy\TermInterface $term
 *   The primary topic term (the leaf).
 * @param bool $leaf_as_title
 *   TRUE on composite pages — leaf becomes current_label (h1) and is
 *   excluded from ancestors. FALSE on content pages — entire chain
 *   is returned as ancestors (kicker), current_label is null.
 *
 * @return array
 *   ['ancestors' => array<{label, url, color}>, 'current_label' => ?string,
 *   'current_url' => ?string] — current_url is the leaf's own page, so a
 *   banner can make the big title a link back to the unfiltered page.
 */
function _customsolent_build_topic_trail($term, $leaf_as_title = TRUE) {
  // Walk from the leaf up to the top-level parent.
  $chain = [];
  $current = $term;
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  while ($current) {
    array_unshift($chain, $current);
    $parents = $term_storage->loadParents($current->id());
    $current = !empty($parents) ? reset($parents) : NULL;
  }

  if (empty($chain)) {
    return ['ancestors' => [], 'current_label' => NULL];
  }

  $section_colors = _customsolent_topic_section_colors();
  $top_level_name = $chain[0]->getName();
  $color = $section_colors[$top_level_name] ?? '#475569';

  $ancestor_count = $leaf_as_title ? count($chain) - 1 : count($chain);
  $ancestors = [];
  for ($i = 0; $i < $ancestor_count; $i++) {
    $ancestors[] = [
      'label' => _customsolent_strip_term_prefix($chain[$i]->getName()),
      'url'   => _customsolent_build_term_url($chain, $i),
      'color' => $color,
    ];
  }

  $current_label = NULL;
  $current_url = NULL;
  if ($leaf_as_title) {
    $leaf = end($chain);
    $current_label = _customsolent_strip_term_prefix($leaf->getName());
    $current_url = _customsolent_build_term_url($chain, count($chain) - 1);
  }

  return [
    'ancestors' => $ancestors,
    'current_label' => $current_label,
    'current_url' => $current_url,
  ];
}

/**
 * Strip the parent prefix from a Topic term name.
 *
 * Topic terms are stored as "Parent / Child" (e.g. "Culture / Screen").
 * Top-level terms have no slash so they pass through unchanged.
 */
function _customsolent_strip_term_prefix($name) {
  $parts = explode(' / ', $name);
  return end($parts);
}

/**
 * Build the composite-page URL path for a term in the chain.
 *
 * Uses the same lowercase / hyphenate convention the menu structure
 * follows (e.g. "Culture / Art & Design" → "/culture/art-design").
 * Verified against config/sync/structure_sync.data.yml.
 */
function _customsolent_build_term_url($chain, $index) {
  $path_parts = [];
  for ($i = 0; $i <= $index; $i++) {
    $part = _customsolent_strip_term_prefix($chain[$i]->getName());
    // Lower-case; an ampersand inside a word is spelt out ("R&B" ->
    // r-and-b) while one between words is dropped ("Art & Design" ->
    // art-design); every other run of anything but a letter or digit
    // becomes one hyphen ("Non-profit" -> non-profit). The aliases the
    // topic scripts create use the same rule.
    $part = preg_replace('/(?<=\S)&(?=\S)/', '-and-', $part);
    $path_parts[] = trim(preg_replace('/[^a-z0-9]+/', '-', strtolower($part)) ?? '', '-');
  }
  return '/' . implode('/', $path_parts);
}


/**
 * Implements hook_preprocess_HOOK() for paragraph--menu.html.twig.
 *
 * Builds the menu tree, filters out the search item, and passes
 * the remaining items to the template for rendering.
 */
function customsolent_preprocess_paragraph__menu(&$variables) {
  $paragraph = $variables['paragraph'];

  $menu_name = 'main';
  if ($paragraph->hasField('field_menu_name') && !$paragraph->get('field_menu_name')->isEmpty()) {
    $menu_name = $paragraph->get('field_menu_name')->value;
  }

  $menu_tree_service = \Drupal::menuTree();
  $parameters = new \Drupal\Core\Menu\MenuTreeParameters();
  $parameters->setMinDepth(1);
  $parameters->setMaxDepth(1);
  $tree = $menu_tree_service->load($menu_name, $parameters);

  $manipulators = [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ];
  $tree = $menu_tree_service->transform($tree, $manipulators);

  // Filter out the search menu item (identified by menu-link-attributes-search class).
  $filtered_items = [];
  foreach ($tree as $element) {
    $url = $element->link->getUrlObject();
    $options = $url->getOptions();
    $classes = $options['attributes']['class'] ?? [];
    if (in_array('menu-link-attributes-search', $classes)) {
      continue;
    }
    $filtered_items[] = [
      'title' => $element->link->getTitle(),
      'url' => $url,
    ];
  }

  $variables['menu_items'] = $filtered_items;
}

function customsolent_theme_suggestions_form_alter(array &$suggestions, array $variables) {
  if (isset($variables['element']['#form_id'])) {
    $suggestions[] = 'form__' . $variables['element']['#form_id'];
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for views_exposed_form.
 *
 * Relabels the grouped date-filter's "- Any -" option to "All" on every
 * exposed form for the events_listing View. Scoped to events_listing
 * via the storage view id so other Views' exposed forms elsewhere on
 * the site are untouched.
 *
 * Iterates every select element in the form rather than hard-coding
 * the date filter's identifier, so the same hook keeps working if the
 * editor renames the filter or adds further grouped filters with the
 * same "- Any -" empty-state label.
 *
 * Implemented as hook_form_BASE_FORM_ID_alter (not the generic
 * hook_form_alter) because Drupal's FormBuilder invokes the
 * base-form-id alter through the theme system reliably, whereas the
 * generic form_alter from a theme can be missed depending on alter
 * caching state.
 */
function customsolent_form_views_exposed_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $view = $form_state->getStorage()['view'] ?? NULL;
  if (!$view || $view->id() !== 'events_listing') {
    return;
  }
  foreach ($form as &$element) {
    if (!is_array($element)
      || !in_array(($element['#type'] ?? ''), ['select', 'radios', 'checkboxes'], TRUE)
      || empty($element['#options'])
      || !is_array($element['#options'])) {
      continue;
    }
    foreach ($element['#options'] as $opt_key => $opt_label) {
      if ((string) $opt_label === '- Any -') {
        $element['#options'][$opt_key] = t('all dates');
      }
    }
  }
  unset($element);

  // Preserve the current ?topic= across date-filter submissions so the
  // page-level topic filter and the events date filter compose cleanly
  // (e.g. /culture/music?topic=35&date_filter_id=4 stays intact when
  // the user clicks a date pill). Without this hidden field, the form
  // submits with only its own fields and the topic param is dropped.
  $topic = \Drupal::request()->query->get('topic');
  if ($topic !== NULL && $topic !== '' && !isset($form['topic'])) {
    $form['topic'] = [
      '#type'  => 'hidden',
      '#value' => $topic,
    ];
  }
  // Likewise the format (issue 485) and the other facets (cost, age).
  foreach (array_merge(['format'], array_keys(customsolent_helpers_facets())) as $param) {
    $value = \Drupal::request()->query->get($param);
    if (is_string($value) && $value !== '' && !isset($form[$param])) {
      $form[$param] = [
        '#type'  => 'hidden',
        '#value' => $value,
      ];
    }
  }
}


/**
 * Implements hook_preprocess_HOOK() for paragraph--view-display.html.twig.
 *
 * Topic scoping:
 *  - Priority 1: field_topic on the paragraph itself.
 *  - Priority 2: host node's field_primary_topic.
 *  - Fallback (no term, or term under Explore/About): all content topics
 *    (Culture + Sectors + Living and their descendants), with Culture /
 *    Sectors / Living as the filter options.
 *
 * When ?topic=<tid> is set in the URL and that term is within the scope,
 * the View contextual argument is narrowed to that sub-tree.
 *
 * Filter UI rendering: the paragraph renders its own sidebar / mobile bar
 * only when (a) this is the primary-topic display and (b) the host page
 * does not contain a dedicated section_filter paragraph. When a
 * section_filter paragraph is present, it owns the filter UI for the page.
 *
 * Also stashes the effective topic IDs on the request so node-teaser
 * preprocess can render a primary-topic kicker on related content.
 */
function customsolent_preprocess_paragraph__view_display(&$variables) {
  $paragraph = $variables['paragraph'];

  $host = $paragraph->getParentEntity();
  while ($host && $host->getEntityTypeId() === 'paragraph') {
    $host = $host->getParentEntity();
  }

  // Topic-anchor inheritance: if the view_display paragraph has no
  // field_topic of its own AND the host page has a section_filter
  // paragraph, defer to the section_filter's resolution so they
  // agree on the page's topic scope. Editors set field_topic once
  // (on the section_filter) and the listings follow automatically.
  $anchor_paragraph = $paragraph;
  $has_own_topic = $paragraph->hasField('field_topic')
    && !$paragraph->get('field_topic')->isEmpty();
  if (!$has_own_topic && $host) {
    $sf = _customsolent_find_section_filter_on_host($host);
    if ($sf && $sf->id() !== $paragraph->id()) {
      $anchor_paragraph = $sf;
    }
  }

  // "Preview, all topics" ignores the page's topic anchor entirely: the
  // block is a window on the whole site, not on this page's subject. Doing
  // this here rather than in the listing-mode helper keeps primary_topic_tid,
  // the page_topic_tids request attribute and the card kickers consistent
  // with what the block actually shows.
  if (_customsolent_listing_mode($paragraph, $variables['view_mode'] ?? 'default') === 'preview_all') {
    $context = _customsolent_topic_context_all();
  }
  else {
    $context = _customsolent_resolve_topic_context($anchor_paragraph, $host);
  }

  $variables['section_key']   = $context['section_key'];
  $variables['section_color'] = $context['section_color'];

  // Expose view name + display id to the template (it handles the
  // virtual view_display_primary_and_related display by rendering both
  // underlying displays).
  $view_name  = '';
  $display_id = '';
  if (!$paragraph->get('field_view')->isEmpty()) {
    $view_name  = $paragraph->get('field_view')->target_id ?? '';
    $display_id = $paragraph->get('field_view')->display_id ?? '';
  }
  $variables['view_name']  = $view_name;
  $variables['display_id'] = $display_id;

  // Resolve effective scope IDs, narrowing to the ?topic= candidate
  // when it is valid (i.e. within the paragraph's topic scope).
  $effective_ids = $context['scope_ids'];
  $active_filter_tid = NULL;
  $query_topic = \Drupal::request()->query->get('topic');
  if ($query_topic !== NULL && is_numeric($query_topic) && (int) $query_topic > 0) {
    $candidate_tid = (int) $query_topic;
    if (in_array($candidate_tid, $context['scope_ids'], TRUE)) {
      $effective_ids = _customsolent_get_term_with_descendants($candidate_tid);
      $active_filter_tid = $candidate_tid;
    }
  }

  $variables['primary_topic_tid'] = implode('+', $effective_ids);

  // Stash the effective scope IDs so node-teaser preprocess can decide
  // whether to render the primary-topic kicker (content from outside
  // this scope shows the "from" kicker; in-scope content shows the
  // "in" kicker with ancestors stripped to the page's depth).
  \Drupal::request()->attributes->set('page_topic_tids', $effective_ids);

  // Depth of the page's resolved term in the Topic hierarchy. Used by
  // the "in" kicker to strip ancestors already represented by the
  // page itself (so on /culture, "Culture / Music" displays as
  // "MUSIC" not "CULTURE / MUSIC"). -1 in all-topics mode (e.g.
  // /explore/events landing): show the full ancestor chain.
  $page_term_depth = -1;
  $page_term_tid   = NULL;
  if (($context['mode'] ?? '') === 'term' && !empty($context['term'])) {
    $page_term_depth = _customsolent_get_term_depth($context['term']);
    $page_term_tid   = (int) $context['term']->id();
  }
  \Drupal::request()->attributes->set('page_term_depth', $page_term_depth);
  // Also stash the exact term tid so the teaser preprocess can do a
  // belt-and-braces exact-match check (no kicker when content's
  // primary topic IS the page's term) independently of the depth
  // arithmetic — defensive against any unexpected request-attribute
  // state.
  \Drupal::request()->attributes->set('page_term_tid', $page_term_tid);

  // Render this paragraph's own filter UI only when:
  //   (a) the display is the primary-topic display, AND
  //   (b) no section_filter paragraph exists on the host page.
  $is_primary_display = ($display_id === 'view_display_primary_topic');
  $has_section_filter = $host ? _customsolent_section_filter_exists_on_host($host) : FALSE;
  if ($is_primary_display && !$has_section_filter && _customsolent_topic_sidebar_has_options($context)) {
    _customsolent_apply_filter_options_to_variables($variables, $context, $active_filter_tid);
  }
  else {
    $variables['filter_has_options'] = FALSE;
  }

  // Preview / full-listing behaviour for the by-topic listings.
  _customsolent_preprocess_listing_mode($variables, $paragraph, $host, $context, $active_filter_tid);

  // The Format group under the topics: on a listing of one kind that takes
  // a format (a listing page, or an Explore page with only such listings).
  if (!empty($variables['filter_has_options'])) {
    $applies = in_array($view_name, customsolent_helpers_format_filtered_views(), TRUE)
      && (($variables['view_mode'] ?? '') === 'listing_page' || _customsolent_host_lists_only_formattable($host));
    _customsolent_apply_format_options_to_variables($variables, $applies, $context, _customsolent_format_types_for_views([$view_name]));
    _customsolent_apply_facet_options_to_variables($variables, [$view_name], $context, ($variables['view_mode'] ?? '') === 'listing_page' ? NULL : $host);
  }
  else {
    $variables['facet_groups'] = [];
  }
}

/**
 * The sidebar's Format group (issue 485).
 *
 * Topics are the first-class filter: every sub-topic of a section is listed
 * because it belongs there. Formats cut across the three pillars, so under a
 * topic only the formats its content actually carries are offered (Sectors
 * shows Exhibitions and Talks, not Club Nights & Parties); where the scope
 * is everything (Explore pages, a format landing page) every format shows.
 * Each links to a ?format= filter of this page, or, on a landing page, to
 * the sibling landing pages. Nothing when the page's listings take no format.
 *
 * @param array $context
 *   The topic context (mode, scope_ids).
 * @param string[] $types
 *   The node types the page lists (event, organisation, series).
 */
function _customsolent_apply_format_options_to_variables(array &$variables, bool $applies, array $context = [], array $types = []): void {
  $variables['format_has_options'] = FALSE;
  $variables['format_options'] = [];
  $variables['format_all_url'] = NULL;
  $variables['format_all_active'] = TRUE;
  $variables['format_active_label'] = NULL;
  if (!$applies) {
    return;
  }
  $formats = customsolent_helpers_format_terms();
  if (!$formats) {
    return;
  }
  $variables['#cache']['tags'][] = 'taxonomy_term_list:format';
  $variables['#cache']['tags'][] = 'node_list';
  $variables['#cache']['contexts'][] = 'url.query_args:format';
  $variables['#cache']['contexts'][] = 'route';
  $active = customsolent_helpers_active_format_tid();
  // Under a topic, only the formats in use there.
  if (($context['mode'] ?? '') === 'term' && !empty($context['scope_ids'])) {
    $used = _customsolent_formats_used_in_scope($context['scope_ids'], $types ?: ['event', 'organisation', 'series']);
    $formats = array_intersect_key($formats, array_flip($used) + ($active ? [$active => TRUE] : []));
    if (!$formats) {
      return;
    }
  }
  $on_landing = \Drupal::routeMatch()->getRouteName() === 'customsolent_helpers.format_listing';
  foreach ($formats as $tid => $f) {
    $variables['format_options'][] = [
      'tid' => $tid,
      'label' => $f['plural'],
      'url' => $on_landing ? $f['url'] : _customsolent_build_filter_url(['format' => $f['slug']]),
      'active' => $active === $tid,
    ];
    if ($active === $tid) {
      $variables['format_active_label'] = $f['plural'];
    }
  }
  $variables['format_has_options'] = TRUE;
  $variables['format_all_active'] = ($active === NULL);
  $variables['format_all_url'] = $on_landing
    ? (customsolent_helpers_sitewide_listing_url('events') ?? '/')
    : _customsolent_build_filter_url(['format' => NULL]);
}

/**
 * Format term ids carried by published nodes of the given types whose
 * primary or related topic is within the scope.
 *
 * @return int[]
 */
function _customsolent_formats_used_in_scope(array $scope_ids, array $types): array {
  $scope_ids = array_values(array_filter(array_map('intval', $scope_ids)));
  if (!$scope_ids || !$types) {
    return [];
  }
  $cache = &drupal_static(__FUNCTION__, []);
  $key = md5(implode(',', $scope_ids) . '|' . implode(',', $types));
  if (!isset($cache[$key])) {
    $cache[$key] = array_map('intval', \Drupal::database()->query(
      'SELECT DISTINCT f.field_format_target_id FROM {node__field_format} f
       JOIN {node_field_data} n ON n.nid = f.entity_id
       WHERE n.status = 1 AND n.type IN (:types[]) AND f.entity_id IN (
         SELECT entity_id FROM {node__field_primary_topic} WHERE field_primary_topic_target_id IN (:scope[])
         UNION SELECT entity_id FROM {node__field_related_topics} WHERE field_related_topics_target_id IN (:scope[])
       )', [':types[]' => $types, ':scope[]' => $scope_ids])->fetchCol());
  }
  return $cache[$key];
}

/**
 * The sidebar groups for the further facets, cost and age group (issues 422
 * and 463): one group per facet, after Format, on a page whose listings are
 * all of the kinds that carry the facet (events). Always content-driven:
 * only the values that published events in the page's scope actually carry
 * are offered (plus the one chosen), so a new vocabulary with little tagged
 * shows little, and nothing until something is tagged.
 *
 * Sets facet_groups: list of {param, kind, label, all_label, options
 * [{label, url, active}], all_url, all_active, active_label}.
 *
 * @param string[] $view_ids
 *   The listing views the group would narrow (this paragraph's view, or
 *   every listing on the host page).
 * @param array $context
 *   The topic context (mode, scope_ids).
 * @param object|null $host
 *   The host node when its other listings must be checked too (a section
 *   overview that also lists articles gets no group); NULL on a listing page.
 */
function _customsolent_apply_facet_options_to_variables(array &$variables, array $view_ids, array $context = [], $host = NULL): void {
  $variables['facet_groups'] = [];
  if (!$view_ids) {
    return;
  }
  $host_views = $host ? _customsolent_host_listing_views($host) : $view_ids;
  foreach (customsolent_helpers_facets() as $param => $def) {
    if (array_diff($view_ids, $def['views']) || array_diff($host_views, $def['views'])) {
      continue;
    }
    foreach (customsolent_helpers_facet_query_args() as $ctx) {
      $variables['#cache']['contexts'][] = $ctx;
    }
    $variables['#cache']['tags'][] = 'taxonomy_term_list:' . $def['vid'];
    $variables['#cache']['tags'][] = 'node_list';
    $terms = customsolent_helpers_facet_terms($param);
    if (!$terms) {
      continue;
    }
    $active = customsolent_helpers_active_facet_tid($param);
    $scope = (($context['mode'] ?? '') === 'term' && !empty($context['scope_ids'])) ? $context['scope_ids'] : [];
    $used = _customsolent_facet_values_used($def['field'], $def['types'], $scope);
    $terms = array_intersect_key($terms, array_flip($used) + ($active ? [$active => TRUE] : []));
    if (!$terms) {
      continue;
    }
    $group = [
      'param' => $param,
      'kind' => $def['kind'],
      'label' => $def['label'],
      'all_label' => $def['all_label'],
      'options' => [],
      'all_url' => _customsolent_build_filter_url([$param => NULL]),
      'all_active' => ($active === NULL),
      'active_label' => NULL,
    ];
    foreach ($terms as $tid => $t) {
      $group['options'][] = [
        'tid' => $tid,
        'label' => $t['name'],
        'url' => _customsolent_build_filter_url([$param => $t['slug']]),
        'active' => $active === $tid,
      ];
      if ($active === $tid) {
        $group['active_label'] = $t['name'];
      }
    }
    $variables['facet_groups'][] = $group;
  }
}

/**
 * Term ids a facet field carries on published nodes of the given types,
 * within a topic scope when one is given (primary or related topic in it).
 *
 * @return int[]
 */
function _customsolent_facet_values_used(string $field, array $types, array $scope_ids = []): array {
  $scope_ids = array_values(array_filter(array_map('intval', $scope_ids)));
  $cache = &drupal_static(__FUNCTION__, []);
  $key = md5($field . '|' . implode(',', $types) . '|' . implode(',', $scope_ids));
  if (!isset($cache[$key])) {
    $sql = "SELECT DISTINCT f.{$field}_target_id FROM {node__{$field}} f
       JOIN {node_field_data} n ON n.nid = f.entity_id
       WHERE n.status = 1 AND n.type IN (:types[])";
    $args = [':types[]' => $types];
    if ($scope_ids) {
      $sql .= " AND f.entity_id IN (
         SELECT entity_id FROM {node__field_primary_topic} WHERE field_primary_topic_target_id IN (:scope[])
         UNION SELECT entity_id FROM {node__field_related_topics} WHERE field_related_topics_target_id IN (:scope[])
       )";
      $args[':scope[]'] = $scope_ids;
    }
    $cache[$key] = array_map('intval', \Drupal::database()->query($sql, $args)->fetchCol());
  }
  return $cache[$key];
}

/**
 * The node types a set of listing views show, for the formats-in-use check.
 *
 * @return string[]
 */
function _customsolent_format_types_for_views(array $view_ids): array {
  $map = ['events_listing' => 'event', 'organisations_listing' => 'organisation', 'directory_listing' => 'organisation', 'series_listing' => 'series'];
  return array_values(array_unique(array_filter(array_map(fn($v) => $map[$v] ?? NULL, $view_ids))));
}

/**
 * TRUE when a page lists only things a format can narrow (events,
 * organisations, series) — an Explore listing page, a topic's listing page.
 * A section overview that also lists articles says nothing about formats:
 * a filter there would look as if it applied to the articles too.
 */
function _customsolent_host_lists_only_formattable($host): bool {
  $views = _customsolent_host_listing_views($host);
  if (!$views) {
    return FALSE;
  }
  return !array_diff($views, customsolent_helpers_format_filtered_views());
}

/**
 * The listing views a page places, by view id: every View Display
 * paragraph, whatever its display (the Explore → Organisations directory
 * and the Series page use displays that are not by-topic).
 *
 * @return string[]
 */
function _customsolent_host_listing_views($host): array {
  if (!$host || $host->getEntityTypeId() !== 'node') {
    return [];
  }
  $views = [];
  $walk = function ($entity, int $depth) use (&$walk, &$views) {
    if ($depth <= 0) {
      return;
    }
    foreach ($entity->getFields(FALSE) as $field) {
      if ($field->getFieldDefinition()->getType() !== 'entity_reference_revisions') {
        continue;
      }
      foreach ($field->referencedEntities() as $p) {
        if ($p->bundle() === 'view_display' && $p->hasField('field_view') && !$p->get('field_view')->isEmpty()) {
          $views[] = $p->get('field_view')->target_id;
        }
        $walk($p, $depth - 1);
      }
    }
  };
  $walk($host, 6);
  return array_values(array_unique($views));
}

/**
 * The three displays that list content by topic.
 */
function _customsolent_topic_listing_displays(): array {
  return ['view_display_primary_and_related', 'view_display_primary_topic', 'view_display_related_topics'];
}

/**
 * Listing views by topic => the URL word of their listing page.
 *
 * Organisations and links share one combined listing, so both map to
 * "organisations". These words are reserved: see
 * customsolent_helpers_reserved_listing_words().
 */
function _customsolent_topic_listing_types(): array {
  return [
    'events_listing' => 'events',
    'articles_listing' => 'articles',
    'organisations_listing' => 'organisations',
    'links_listing' => 'organisations',
    'series_listing' => 'series',
    'collaborations_listing' => 'collaborations',
  ];
}

/**
 * What each kind of by-topic listing needs, keyed by its URL word.
 *
 * - label:     the heading a preview falls back to, and the strip label.
 * - tags:      node_list cache tags — an empty block must reappear when
 *              the first item is tagged with the topic.
 * - grid:      the card grid class for a preview.
 * - full:      [view, display] rendered in Full mode (the listing page),
 *              and the grid class that goes with it. Events keep their
 *              date pills on a separate cards display; articles' by-topic
 *              display is already the card grid.
 * - stat:      the key in _customsolent_topic_scope_stats().
 */
function _customsolent_listing_kinds(): array {
  return [
    'events' => [
      'label' => t('Events'),
      'tags' => ['node_list:event'],
      'grid' => 'slnt-events-compact-grid',
      'full' => ['events_listing', 'view_display_listing_cards'],
      'full_grid' => 'slnt-events-compact-grid slnt-events-compact-grid--listing',
      'stat' => 'events',
    ],
    'articles' => [
      'label' => t('Articles'),
      'tags' => ['node_list:article'],
      'grid' => 'slnt-articles-compact-grid',
      'full' => ['articles_listing', 'view_display_primary_and_related'],
      'full_grid' => 'slnt-articles-compact-grid',
      'stat' => 'articles',
    ],
    // Series and Collaborations joined the strip on 2026-10-18 (afternoon).
    // Their cards are teasers; the same classy grid as /explore/series and
    // /explore/collaborations.
    'series' => [
      'label' => t('Series'),
      'tags' => ['node_list:series'],
      'grid' => 'slnt-series-grid',
      'full' => ['series_listing', 'view_display_primary_and_related'],
      'full_grid' => 'slnt-series-grid',
      'stat' => 'series',
    ],
    'collaborations' => [
      'label' => t('Collaborations'),
      'tags' => ['node_list:collaboration'],
      'grid' => 'slnt-collaborations-grid',
      'full' => ['collaborations_listing', 'view_display_primary_and_related'],
      'full_grid' => 'slnt-collaborations-grid',
      'stat' => 'collaborations',
    ],
    'organisations' => [
      'label' => t('Organisations & links'),
      'tags' => ['node_list:organisation', 'node_list:link'],
      'grid' => 'slnt-directory-compact-grid slnt-directory-compact-grid--preview',
      'full' => ['directory_listing', 'view_display_primary_and_related'],
      'full_grid' => 'slnt-directory-compact-grid',
      'stat' => 'directory',
    ],
  ];
}

/**
 * Resolves how a View Display paragraph should behave.
 *
 * @return string
 *   - 'plain':   not a by-topic listing (front page grids etc.) — untouched.
 *   - 'full':    filter + pager on this page. The paragraph's Listing mode
 *                field says so, or it is being rendered on its automated
 *                listing page (paragraph view mode "listing_page").
 *   - 'preview': up to 8 cards and a "View more" link. Automatic for
 *                events; for organisations only when the editor picks it
 *                (a sponsors row, "who has joined the cause").
 *   - 'preview_all': as 'preview', but deliberately NOT scoped to the
 *                page's topic — the newest cards from across the whole
 *                site, with "View more" pointing at the site-wide
 *                listing page rather than this page's own sub-listing.
 *                For pages whose subject IS the content type (e.g.
 *                /culture/writing listing all articles).
 *   - 'signpost': a box with a count and a link to the full list, no
 *                cards. Automatic for organisations and links: the first
 *                eight of an A–Z list mean nothing, a count does.
 */
function _customsolent_listing_mode($paragraph, string $view_mode = 'default'): string {
  if ($paragraph->bundle() !== 'view_display' || $paragraph->get('field_view')->isEmpty()) {
    return 'plain';
  }
  $view = $paragraph->get('field_view')->target_id;
  $display = $paragraph->get('field_view')->display_id;
  if (!isset(_customsolent_topic_listing_types()[$view])
    || !in_array($display, _customsolent_topic_listing_displays(), TRUE)) {
    return 'plain';
  }
  if ($view_mode === 'listing_page') {
    return 'full';
  }
  $chosen = $paragraph->hasField('field_listing_mode') ? $paragraph->get('field_listing_mode')->value : NULL;
  if ($chosen === 'full') {
    return 'full';
  }
  // All-topics preview is an explicit editor choice for any listing type;
  // unlike 'preview' it is never inferred.
  if ($chosen === 'preview_all') {
    return 'preview_all';
  }
  $is_directory = (_customsolent_topic_listing_types()[$view] === 'organisations');
  if (!$is_directory) {
    return 'preview';
  }
  return $chosen === 'preview' ? 'preview' : 'signpost';
}

/**
 * TRUE for the two modes in which a listing renders its own heading row.
 */
function _customsolent_listing_owns_heading(string $mode): bool {
  return in_array($mode, ['preview', 'preview_all', 'signpost'], TRUE);
}

/**
 * Counts of what a topic scope holds, for the section strip and signpost.
 *
 * One query per kind, cached for the request.
 *
 * @param int[] $tids
 *   The topic scope: a term and all its descendants.
 *
 * @return array{events:int, articles:int, series:int, collaborations:int, organisation:int, link:int, directory:int, directory_tids:array<int,int[]>}
 *   directory_tids maps topic tid => node ids tagged with it (primary or
 *   related), for working out which sub-topics have anything in them.
 */
function _customsolent_topic_scope_stats(array $tids): array {
  $cache = &drupal_static(__FUNCTION__, []);
  sort($tids);
  $key = implode(',', $tids);
  if (isset($cache[$key])) {
    return $cache[$key];
  }
  $stats = ['events' => 0, 'articles' => 0, 'series' => 0, 'collaborations' => 0, 'organisation' => 0, 'link' => 0, 'directory' => 0, 'directory_tids' => []];
  if (!$tids) {
    return $cache[$key] = $stats;
  }
  $db = \Drupal::database();
  $tagged = function (array $types) use ($db, $tids) {
    $primary = $db->select('node__field_primary_topic', 'p');
    $primary->join('node_field_data', 'n', 'n.nid = p.entity_id AND n.status = 1');
    $primary->addField('n', 'nid'); $primary->addField('n', 'type');
    $primary->addField('p', 'field_primary_topic_target_id', 'tid');
    $primary->condition('n.type', $types, 'IN')->condition('p.field_primary_topic_target_id', $tids, 'IN');
    $related = $db->select('node__field_related_topics', 'r');
    $related->join('node_field_data', 'n', 'n.nid = r.entity_id AND n.status = 1');
    $related->addField('n', 'nid'); $related->addField('n', 'type');
    $related->addField('r', 'field_related_topics_target_id', 'tid');
    $related->condition('n.type', $types, 'IN')->condition('r.field_related_topics_target_id', $tids, 'IN');
    return array_merge($primary->execute()->fetchAll(), $related->execute()->fetchAll());
  };

  // Organisations + links.
  $seen = [];
  foreach ($tagged(['organisation', 'link']) as $row) {
    $stats['directory_tids'][(int) $row->tid][(int) $row->nid] = (int) $row->nid;
    if (!isset($seen[$row->nid])) {
      $seen[$row->nid] = TRUE;
      $stats[$row->type]++;
    }
  }
  $stats['directory'] = count($seen);

  // Events that have not ended — the same rule as the listing views.
  $event_nids = array_unique(array_map(fn($r) => (int) $r->nid, $tagged(['event'])));
  if ($event_nids) {
    $today = (new \DateTimeImmutable('today', new \DateTimeZone(date_default_timezone_get())))->getTimestamp();
    // The same clock as the listings (events query alter): an event has not
    // ended, or has no end time (end = start) and is today's or later.
    $events_q = $db->select('node__field_when', 'w')
      ->condition('w.entity_id', $event_nids, 'IN');
    $not_ended = $events_q->orConditionGroup()
      ->condition('w.field_when_end_value', \Drupal::time()->getRequestTime(), '>=')
      ->condition($events_q->andConditionGroup()
        ->where('w.field_when_end_value <= w.field_when_value')
        ->condition('w.field_when_end_value', $today, '>='));
    $stats['events'] = (int) $events_q->condition($not_ended)
      ->distinct()->fields('w', ['entity_id'])->countQuery()->execute()->fetchField();
  }

  // Published articles tagged with the topic, primary or related.
  $stats['articles'] = count(array_unique(array_map(fn($r) => (int) $r->nid, $tagged(['article']))));
  // Series and collaborations likewise — past ones included: a series page
  // keeps its "Past series" badge and stays worth finding.
  $stats['series'] = count(array_unique(array_map(fn($r) => (int) $r->nid, $tagged(['series']))));
  $stats['collaborations'] = count(array_unique(array_map(fn($r) => (int) $r->nid, $tagged(['collaboration']))));
  return $cache[$key] = $stats;
}

/**
 * The topic scope a section page works in: term, scope ids, section key.
 *
 * Mirrors _customsolent_resolve_topic_context(): an explicit topic on the
 * page's section filter wins, otherwise the node's primary topic.
 */
function _customsolent_node_topic_context($node): ?array {
  if (!$node || !$node->hasField('field_primary_topic') || $node->get('field_primary_topic')->isEmpty()) {
    return NULL;
  }
  $term = NULL;
  $section_filter = _customsolent_find_section_filter_on_host($node);
  if ($section_filter && !$section_filter->get('field_topic')->isEmpty()) {
    $term = $section_filter->get('field_topic')->entity;
  }
  $term = $term ?: $node->get('field_primary_topic')->entity;
  return $term ? _customsolent_topic_context_for_term($term) : NULL;
}

/**
 * The section strip: Overview · Events 12 · Articles 3 · Organisations & links 38.
 *
 * Navigation between a topic's own page and its per-type listing pages —
 * real links to real addresses, with the current one marked; not an ARIA
 * tab widget. Shown on Culture, Sectors and Living section pages and on
 * their listing pages. A type with nothing in it is left out, and if only
 * "Overview" would remain there is no strip at all.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The section page.
 * @param string $current
 *   'overview', 'events', 'articles', 'series', 'collaborations' or
 *   'organisations'.
 */
function _customsolent_build_section_strip($node, string $current): ?array {
  if (!$node || $node->bundle() !== 'composite_page') {
    return NULL;
  }
  $context = _customsolent_node_topic_context($node);
  if (!$context || !in_array($context['section_key'], ['culture', 'sectors', 'living'], TRUE)) {
    return NULL;
  }
  $stats = _customsolent_topic_scope_stats($context['scope_ids']);
  $base = rtrim($node->toUrl()->toString(), '/');
  $items = [[
    'key' => 'overview',
    'label' => t('Overview'),
    'url' => $base,
    'count' => NULL,
  ]];
  $tags = $node->getCacheTags();
  // A kind whose placed listing is "Preview, all topics" (Writing's
  // articles) is a window on the whole site, so its strip item must say
  // the same thing: the site-wide count, linking to the site-wide page.
  $sitewide = _customsolent_sitewide_listing_kinds($node);
  $all_stats = $sitewide ? _customsolent_topic_scope_stats(_customsolent_topic_context_all()['scope_ids']) : [];
  foreach (_customsolent_listing_kinds() as $key => $kind) {
    $tags = array_merge($tags, $kind['tags']);
    if (isset($sitewide[$key])) {
      if ($all_stats[$kind['stat']] > 0 && ($url = _customsolent_sitewide_listing_url($key))) {
        $items[] = ['key' => $key, 'label' => $kind['label'], 'url' => $url, 'count' => $all_stats[$kind['stat']]];
      }
    }
    elseif ($stats[$kind['stat']] > 0) {
      $items[] = ['key' => $key, 'label' => $kind['label'], 'url' => $base . '/' . $key, 'count' => $stats[$kind['stat']]];
    }
  }
  if (count($items) < 2) {
    return NULL;
  }
  foreach ($items as &$item) {
    $item['current'] = ($item['key'] === $current);
  }
  unset($item);

  // The events count drops as dates pass: do not keep it beyond today.
  $midnight = (new \DateTimeImmutable('tomorrow', new \DateTimeZone(date_default_timezone_get())))->getTimestamp();
  return [
    '#theme' => 'slnt_section_strip',
    '#items' => $items,
    '#label' => t('@topic section', ['@topic' => $node->label()]),
    '#section_key' => $context['section_key'],
    '#cache' => [
      'tags' => $tags,
      'max-age' => max(60, $midnight - \Drupal::time()->getRequestTime()),
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for field.html.twig.
 *
 * Puts the section strip directly under the banner on section pages, with
 * no content edits: on a Composite Page's full view, if the first content
 * component is the hero, the strip becomes the second item.
 */
function customsolent_preprocess_field(array &$variables): void {
  $element = $variables['element'];
  if (($element['#field_name'] ?? '') !== 'field_content_component'
    || ($element['#entity_type'] ?? '') !== 'node'
    || ($element['#bundle'] ?? '') !== 'composite_page'
    || ($element['#view_mode'] ?? '') !== 'full') {
    return;
  }
  $node = $element['#object'];
  $first = $node->get('field_content_component')->first();
  if (!$first || !$first->entity || $first->entity->bundle() !== 'hero_with_art_style') {
    return;
  }
  $strip = _customsolent_build_section_strip($node, 'overview');
  if (!$strip) {
    return;
  }
  array_splice($variables['items'], 1, 0, [[
    'content' => $strip,
    'attributes' => new \Drupal\Core\Template\Attribute(['class' => ['field__item', 'field__item--section-strip']]),
  ]]);
}

/**
 * All by-topic listing paragraphs on a host node, in page order.
 */
function _customsolent_topic_listing_paragraphs($host): array {
  $cache = &drupal_static(__FUNCTION__, []);
  if (!$host || $host->getEntityTypeId() !== 'node') {
    return [];
  }
  if (!isset($cache[$host->id()])) {
    $found = [];
    $walk = function ($entity, int $depth) use (&$walk, &$found) {
      if ($depth <= 0) {
        return;
      }
      foreach ($entity->getFields(FALSE) as $field) {
        if ($field->getFieldDefinition()->getType() !== 'entity_reference_revisions') {
          continue;
        }
        foreach ($field->referencedEntities() as $p) {
          if (_customsolent_listing_mode($p) !== 'plain') {
            $found[] = $p;
          }
          $walk($p, $depth - 1);
        }
      }
    };
    $walk($host, 6);
    $cache[$host->id()] = $found;
  }
  return $cache[$host->id()];
}

/**
 * The listing kinds a section page shows ONLY site-wide, keyed by URL word.
 *
 * TRUE for each kind whose placed View Display paragraphs are all in the
 * "Preview, all topics" mode. The section strip defers to this: it counts
 * and links site-wide for such a kind. A page that places both — a
 * topic-scoped block and an all-topics block, as Writing does for
 * articles — is not site-wide for that kind: its strip item and its
 * listing page belong to the topic-scoped block, exactly as on every
 * other section page. The listing route applies the same rule through
 * TopicListingController::findListingParagraph().
 *
 * @return array<string, true>
 */
function _customsolent_sitewide_listing_kinds($node): array {
  $kinds = [];
  foreach (_customsolent_topic_listing_paragraphs($node) as $paragraph) {
    $word = _customsolent_topic_listing_types()[$paragraph->get('field_view')->target_id] ?? NULL;
    if (!$word) {
      continue;
    }
    if (_customsolent_listing_mode($paragraph) === 'preview_all') {
      $kinds[$word] = $kinds[$word] ?? TRUE;
    }
    else {
      $kinds[$word] = FALSE;
    }
  }
  return array_filter($kinds);
}

/**
 * The heading paragraph immediately before $paragraph in its parent, if any.
 */
function _customsolent_preceding_heading_paragraph($paragraph) {
  $parent = $paragraph->getParentEntity();
  $field_name = $paragraph->get('parent_field_name')->value;
  if (!$parent || !$field_name || !$parent->hasField($field_name)) {
    return NULL;
  }
  $previous = NULL;
  foreach ($parent->get($field_name)->referencedEntities() as $sibling) {
    if ((int) $sibling->id() === (int) $paragraph->id()) {
      return ($previous && $previous->bundle() === 'heading') ? $previous : NULL;
    }
    $previous = $sibling;
  }
  return NULL;
}

/**
 * Preview / full-listing variables for paragraph--view-display.html.twig.
 *
 * Preview mode (section pages):
 *  - Renders the view's view_display_preview display: compact cards, no
 *    pager. That display fetches 9 rows; a 9th means there is more than the
 *    8 shown, which is what switches the "View more" link on.
 *  - Organisations and links are one combined list (view directory_listing).
 *    Where a page has both an organisations block and a links block, the
 *    first renders the combined preview and the later one renders nothing.
 *  - The block owns its heading: the editor's own field_heading, else the
 *    text of the heading paragraph just before it (which then does not
 *    render itself — see customsolent_preprocess_paragraph__heading). That
 *    is what lets "View more" sit on the heading's line without editing 74
 *    pages, and it means an empty block takes its heading away with it.
 *  - "View more" goes to {this page's path}/{events|organisations}, the
 *    automated listing page served by customsolent_helpers.
 *
 * Full mode swaps organisations/links to the combined view only on the
 * automated listing page; a page an editor has marked "Full listing" keeps
 * exactly the view they chose.
 */
function _customsolent_preprocess_listing_mode(array &$variables, $paragraph, $host, array $context, $active_filter_tid): void {
  $mode = _customsolent_listing_mode($paragraph, $variables['view_mode'] ?? 'default');
  $variables['listing_mode'] = $mode;
  if ($mode === 'plain') {
    return;
  }

  // Cache metadata that must bubble from EVERY branch below — including the
  // ones that render nothing. A block that is empty today must reappear
  // when an event is added (node_list tags), and must not be cached as
  // "empty" for a different ?topic= (contexts). The template prints this
  // in all branches; it renders as nothing.
  $view_name = $paragraph->get('field_view')->target_id;
  $type_word = _customsolent_topic_listing_types()[$view_name];
  $kind = _customsolent_listing_kinds()[$type_word];
  $is_directory = ($type_word === 'organisations');
  $variables['listing_cache'] = [
    '#cache' => [
      'contexts' => array_merge(['url.path', 'url.query_args:topic', 'url.query_args:date_filter_id'], customsolent_helpers_facet_query_args()),
      'tags' => $kind['tags'],
    ],
  ];
  $is_listing_page = (($variables['view_mode'] ?? '') === 'listing_page');

  // Cards need their grid wherever they appear — no classy style to remember.
  $variables['listing_grid_class'] = NULL;
  if ($is_directory) {
    $variables['listing_grid_class'] = 'slnt-directory-compact-grid';
  }

  if ($mode === 'full') {
    // Full listings are card grids: events swap to view_display_listing_cards
    // (the front-page event card, date pills, one pager); the articles
    // by-topic display is already the card grid.
    if (!$is_directory) {
      [$variables['view_name'], $variables['display_id']] = $kind['full'];
      $variables['listing_grid_class'] = $kind['full_grid'];
    }
    if ($is_listing_page) {
      if ($is_directory) {
        $variables['view_name'] = 'directory_listing';
        $variables['display_id'] = 'view_display_primary_and_related';
      }
      // The listing page has no section_filter paragraph, so the listing
      // carries the topic filter itself; and the page supplies the h1.
      if (_customsolent_topic_sidebar_has_options($context)) {
        _customsolent_apply_filter_options_to_variables($variables, $context, $active_filter_tid);
      }
      $variables['listing_hide_heading'] = TRUE;
    }
    return;
  }

  // ── Preview ──
  $variables['filter_has_options'] = FALSE;
  $variables['listing_suppressed'] = FALSE;

  if ($is_directory) {
    foreach (_customsolent_topic_listing_paragraphs($host) as $other) {
      if ((int) $other->id() === (int) $paragraph->id()) {
        break;
      }
      if (_customsolent_topic_listing_types()[$other->get('field_view')->target_id] === 'organisations'
        && _customsolent_listing_owns_heading(_customsolent_listing_mode($other))) {
        // An earlier block on this page already shows the combined list.
        $variables['listing_suppressed'] = TRUE;
        return;
      }
    }
  }

  // ── Signpost: a count and a link, no cards ──
  if ($mode === 'signpost') {
    $scope = $variables['primary_topic_tid'] ?? '';
    $scope_tids = array_values(array_filter(array_map('intval', explode('+', (string) $scope))));
    $stats = _customsolent_topic_scope_stats($scope_tids);
    if ($stats['directory'] === 0) {
      $variables['listing_suppressed'] = TRUE;
      return;
    }
    $variables['listing_grid_class'] = NULL;
    $variables['signpost'] = [
      'heading' => t('Organisations & links'),
      'organisations' => $stats['organisation'],
      'links' => $stats['link'],
      'total' => $stats['directory'],
      'topic' => ($context['mode'] ?? '') === 'term' && !empty($context['term'])
        ? _customsolent_strip_term_prefix($context['term']->getName()) : NULL,
      'url' => NULL,
      'children' => [],
    ];
    if ($host && $host->getEntityTypeId() === 'node') {
      $base = rtrim($host->toUrl()->toString(), '/') . '/organisations';
      $variables['signpost']['url'] = $base . ($active_filter_tid ? '?topic=' . (int) $active_filter_tid : '');
      // "Browse by": sub-topics that actually hold something. Only where
      // the page has no section filter doing that job already.
      if (!_customsolent_section_filter_exists_on_host($host) && ($context['mode'] ?? '') === 'term' && !empty($context['term'])) {
        foreach (_customsolent_load_topic_children_sorted($context['term']->id()) as $child) {
          $nids = [];
          foreach (_customsolent_get_term_with_descendants($child->id()) as $tid) {
            $nids += $stats['directory_tids'][$tid] ?? [];
          }
          if ($nids) {
            $variables['signpost']['children'][] = [
              'label' => _customsolent_strip_term_prefix($child->getName()),
              'url' => (!empty($context['nav']) ? _customsolent_topic_nav_url((int) $child->id(), 'organisations') : NULL)
                ?? $base . '?topic=' . (int) $child->id(),
              'count' => count($nids),
            ];
          }
        }
      }
    }
    return;
  }

  $preview_view = $is_directory ? 'directory_listing' : $view_name;
  $tids = $variables['primary_topic_tid'] ?? '';
  $build = NULL;
  $has_more = FALSE;
  $view = \Drupal\views\Views::getView($preview_view);
  if ($view && $tids !== '' && $view->access('view_display_preview')) {
    $view->setDisplay('view_display_preview');
    $view->setArguments([$tids, $tids]);
    $view->preExecute();
    $view->execute();
    if (count($view->result) > 8) {
      $has_more = TRUE;
      $view->result = array_slice($view->result, 0, 8);
    }
    if ($view->result) {
      $build = $view->render();
      $build['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($build['#cache']['tags'] ?? [], $kind['tags']);
    }
  }
  if (!$build && !$active_filter_tid) {
    // Nothing to show: no heading, no block.
    $variables['listing_suppressed'] = TRUE;
    return;
  }
  if (!$build) {
    // The visitor has chosen a topic filter and this block has no matches.
    // Keep the block and say so — a heading that silently disappears
    // right after a click looks like a fault.
    $build = [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#attributes' => ['class' => ['slnt-view-empty']],
      '#value' => t('Nothing here matches the current filter.'),
    ];
  }
  $variables['preview_build'] = $build;
  $variables['listing_grid_class'] = $kind['grid'];

  // Heading.
  $heading = '';
  if (!$paragraph->get('field_heading')->isEmpty()) {
    $heading = trim((string) $paragraph->get('field_heading')->value);
  }
  elseif ($sibling = _customsolent_preceding_heading_paragraph($paragraph)) {
    $heading = trim(preg_replace('/\s+/', ' ', (string) $sibling->get('field_heading')->value));
  }
  if ($is_directory && in_array(mb_strtolower($heading), ['organisations', 'links'], TRUE)) {
    $heading = '';
  }
  if ($heading === '') {
    $heading = (string) $kind['label'];
  }
  $variables['preview_heading'] = $heading;
  // "View more Events" rather than a bare "View more": several can share a
  // page, and the label should say what there is more of.
  $variables['more_label'] = t('View more @kind', ['@kind' => $kind['label']]);

  // View more.
  $variables['more_url'] = NULL;
  if ($mode === 'preview_all') {
    // Always linked, even with eight or fewer cards: the destination is a
    // richer page (filter, pager) rather than merely "the rest of them", so
    // the link earns its place whatever the count.
    $variables['more_url'] = _customsolent_sitewide_listing_url($type_word);
  }
  elseif ($has_more && $host && $host->getEntityTypeId() === 'node') {
    $base = rtrim($host->toUrl()->toString(), '/');
    $query = $active_filter_tid ? '?topic=' . (int) $active_filter_tid : '';
    $variables['more_url'] = $base . '/' . $type_word . $query;
  }
}

/**
 * The site-wide listing page for a content type, as used by the
 * "Preview, all topics" listing mode.
 *
 * The map itself lives in customsolent_helpers_sitewide_listing_url(), in
 * the module, because the listing route controller needs it too and a
 * controller cannot rely on the theme being loaded.
 */
function _customsolent_sitewide_listing_url(string $type_word): ?string {
  return customsolent_helpers_sitewide_listing_url($type_word);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--heading.html.twig.
 *
 * A heading paragraph that sits directly above a listing in Preview mode
 * hands its text to that listing, which renders heading + "View more" as
 * one row (and drops both when the listing is empty). So it must not also
 * render itself.
 */
function customsolent_preprocess_paragraph__heading(&$variables) {
  $paragraph = $variables['paragraph'];
  $variables['heading_handed_over'] = FALSE;
  $parent = $paragraph->getParentEntity();
  $field_name = $paragraph->get('parent_field_name')->value;
  if (!$parent || !$field_name || !$parent->hasField($field_name)) {
    return;
  }
  $take_next = FALSE;
  $variables['heading_url'] = NULL;
  foreach ($parent->get($field_name)->referencedEntities() as $sibling) {
    if ($take_next) {
      if (_customsolent_listing_owns_heading(_customsolent_listing_mode($sibling)) && $sibling->get('field_heading')->isEmpty()) {
        $variables['heading_handed_over'] = TRUE;
      }
      // A heading directly followed by a Link paragraph ("View more …")
      // is itself a link to the same place — the section heading and its
      // View more go together (Section Heading Row). No field needed: the
      // editor builds the pair, the heading follows the link.
      if ($sibling->bundle() === 'link' && !$sibling->get('field_link')->isEmpty()) {
        try {
          $variables['heading_url'] = $sibling->get('field_link')->first()->getUrl()->toString();
        }
        catch (\Throwable) {
          // Malformed link: leave the heading plain.
        }
      }
      // Re-render this heading when the listing below it is edited.
      $variables['content']['field_heading']['#cache']['tags'][] = 'paragraph:' . $sibling->id();
      return;
    }
    if ((int) $sibling->id() === (int) $paragraph->id()) {
      $take_next = TRUE;
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--section-filter.html.twig.
 *
 * Mirrors the topic-resolution logic in customsolent_preprocess_paragraph__view_display
 * but exposes only the filter sidebar / mobile bar data — there is no
 * embedded View. The paragraph is intended to sit once on a page above
 * the View Display paragraphs it filters.
 */
function customsolent_preprocess_paragraph__section_filter(&$variables) {
  $paragraph = $variables['paragraph'];

  $host = $paragraph->getParentEntity();
  while ($host && $host->getEntityTypeId() === 'paragraph') {
    $host = $host->getParentEntity();
  }

  // field_show_subterms (boolean) controls whether each top-level
  // option in the filter sidebar reveals its immediate sub-topics
  // inline when the active filter lies within that branch.
  $with_children = FALSE;
  if ($paragraph->hasField('field_show_subterms')
    && !$paragraph->get('field_show_subterms')->isEmpty()) {
    $with_children = (bool) $paragraph->get('field_show_subterms')->value;
  }

  $context = _customsolent_resolve_topic_context($paragraph, $host, $with_children);

  $active_filter_tid = NULL;
  $query_topic = \Drupal::request()->query->get('topic');
  if ($query_topic !== NULL && is_numeric($query_topic) && (int) $query_topic > 0) {
    $candidate_tid = (int) $query_topic;
    if (in_array($candidate_tid, $context['scope_ids'], TRUE)) {
      $active_filter_tid = $candidate_tid;
    }
  }

  $variables['section_key']   = $context['section_key'];
  $variables['section_color'] = $context['section_color'];
  $variables['has_children']  = $with_children;
  _customsolent_apply_filter_options_to_variables($variables, $context, $active_filter_tid);
  _customsolent_apply_format_options_to_variables($variables, _customsolent_host_lists_only_formattable($host), $context, _customsolent_format_types_for_views(_customsolent_host_listing_views($host)));
  _customsolent_apply_facet_options_to_variables($variables, _customsolent_host_listing_views($host), $context, $host);
}

/**
 * Resolve a paragraph's topic context (the term to filter on, plus the
 * sidebar filter options) by checking field_topic on the paragraph, then
 * field_primary_topic on the host node, then falling back to all content
 * topics. Returns scope_ids (the term + descendants, or all content
 * topics + descendants) for the View contextual argument.
 */
function _customsolent_resolve_topic_context($paragraph, $host, $with_children = FALSE) {
  // Priority 1: field_topic on the paragraph itself. An explicit
  // editor choice — use it unconditionally, even if its top-level
  // parent is Explore/About. This lets editors use Explore children
  // (e.g. "Explore / Data", "Explore / Ideas & Opinion") as real content tags
  // for /explore/data, /explore/ideas-opinion etc.
  if ($paragraph->hasField('field_topic') && !$paragraph->get('field_topic')->isEmpty()) {
    $term = $paragraph->get('field_topic')->entity;
    if ($term) {
      return _customsolent_topic_context_for_term($term, $with_children);
    }
  }

  // Priority 2: host node's field_primary_topic. The Explore/About
  // guard still applies here — pages under those roots are typically
  // structural landings (e.g. /explore/events aggregates all events
  // across Culture/Sectors/Living), so we fall back to all-topics.
  // Editors who want term-scoped behaviour on an Explore landing
  // override via field_topic on the paragraph (handled above).
  if ($host && $host->getEntityTypeId() === 'node'
    && $host->hasField('field_primary_topic')
    && !$host->get('field_primary_topic')->isEmpty()) {
    $term = $host->get('field_primary_topic')->entity;
    if ($term) {
      $top = _customsolent_topic_top_level($term);
      $top_name = $top ? $top->getName() : '';
      if ($top && !in_array($top_name, ['Explore', 'About'], TRUE)) {
        return _customsolent_topic_context_for_term($term, $with_children);
      }
    }
  }

  return _customsolent_topic_context_all($with_children);
}

/**
 * Build a topic context for a specific term — scope is the term and its
 * descendants; filter options are the term's direct children. When
 * $with_children is TRUE, each child option also carries its own
 * grandchildren list (one level deeper) for the auto-expand pattern.
 */
function _customsolent_topic_context_for_term($term, $with_children = FALSE) {
  $scope_ids = _customsolent_get_term_with_descendants($term->id());
  $top = _customsolent_topic_top_level($term);
  $top_name = $top ? $top->getName() : '';
  $section_key = $top_name !== '' ? strtolower($top_name) : NULL;
  $nav = _customsolent_topic_nav_enabled($section_key);
  $children = _customsolent_load_topic_children_sorted($term->id());
  $filter_options = [];
  foreach ($children as $child) {
    $option = _customsolent_build_filter_option($child, $with_children, $nav);
    $filter_options[] = $option;
  }
  return [
    'mode'           => 'term',
    'term'           => $term,
    'root'           => $top,
    'nav'            => $nav,
    'scope_ids'      => $scope_ids,
    'filter_options' => $filter_options,
    'section_key'    => $section_key,
    'section_color'  => _customsolent_topic_section_colors()[$top_name] ?? NULL,
  ];
}

/**
 * Whether the topic sidebar on this section is navigation between pages
 * rather than a ?topic= filter of the page it is on.
 *
 * Culture, Sectors and Living: every topic has its own page, and that
 * page (or its /events, /articles … listing) is the right place for a
 * topic's content — the strip counts, the intro and the banner all
 * belong to the topic, where a ?topic= filter leaves the parent's in
 * place and, on a phone, hardly looks like a change at all. So there
 * the sidebar links to the topic's page: /culture/art-design, and on a
 * listing page /culture/art-design/events. A term without a page of its
 * own falls back to the ?topic= filter. Explore pages keep the filter:
 * they are windows across every section, and clicking "Culture" there
 * means "narrow this", not "go to Culture".
 */
function _customsolent_topic_nav_enabled(?string $section_key): bool {
  return in_array($section_key, ['culture', 'sectors', 'living'], TRUE);
}

/**
 * The listing kind of the current page ('events', 'articles' …) when it
 * is an automated topic listing page, else NULL (a topic's own page).
 */
function _customsolent_current_listing_kind(): ?string {
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() === 'customsolent_helpers.topic_listing') {
    $kind = $route_match->getParameter('listing_type');
    return is_string($kind) && $kind !== '' ? $kind : NULL;
  }
  return NULL;
}

/**
 * The address the sidebar sends a reader to for a topic: the topic's own
 * page, or its listing of the kind this page is (/culture/art-design on
 * /culture, /culture/art-design/events on /culture/events), keeping the
 * date filter and any other query parameters but never ?topic= or the
 * page number. NULL when the topic has no page of its own.
 *
 * @param int $tid
 *   The topic term.
 * @param string|null $kind
 *   A listing kind to go to, or NULL for the kind of the current page.
 */
function _customsolent_topic_nav_url(int $tid, ?string $kind = NULL): ?string {
  $nid = _customsolent_term_landing_nid($tid);
  if (!$nid) {
    return NULL;
  }
  $cache = &drupal_static(__FUNCTION__, []);
  if (!isset($cache[$nid])) {
    $cache[$nid] = rtrim(\Drupal\Core\Url::fromRoute('entity.node.canonical', ['node' => $nid])->toString(), '/');
  }
  $path = $cache[$nid];
  $kind ??= _customsolent_current_listing_kind();
  if ($kind !== NULL) {
    $path .= '/' . $kind;
  }
  $query = \Drupal::request()->query->all();
  unset($query['topic'], $query['page']);
  return $path . (empty($query) ? '' : '?' . http_build_query($query));
}

/**
 * A topic's link in the sidebar: its page when the section navigates
 * between pages and the page exists, else the ?topic= filter.
 */
function _customsolent_topic_option_url(int $tid, bool $nav): string {
  if ($nav && ($url = _customsolent_topic_nav_url($tid))) {
    return $url;
  }
  return _customsolent_build_filter_url(['topic' => $tid]);
}

/**
 * Build one filter option for a term, optionally including its
 * immediate sub-topics (one level only) and the term-plus-descendants
 * scope so the template can determine "branch active" state.
 */
function _customsolent_build_filter_option($term, $with_children = FALSE, bool $nav = FALSE) {
  $tid = (int) $term->id();
  $option = [
    'tid'   => $tid,
    'label' => _customsolent_strip_term_prefix($term->getName()),
    'url'   => _customsolent_topic_option_url($tid, $nav),
  ];
  if ($with_children) {
    $option['scope_tids'] = _customsolent_get_term_with_descendants($tid);
    $option['children'] = _customsolent_build_filter_option_children($term, $nav);
  }
  return $option;
}

/**
 * Build the children list for an expanded filter option. The first entry
 * is "All in <Section>" pointing at the parent term itself, so users
 * can stay scoped to the parent without picking a leaf. The rest are
 * the parent term's direct children, alphabetical-by-weight as
 * _customsolent_load_topic_children_sorted defines.
 */
function _customsolent_build_filter_option_children($parent_term, bool $nav = FALSE) {
  $parent_tid = (int) $parent_term->id();
  $parent_label = _customsolent_strip_term_prefix($parent_term->getName());

  $children = [];
  $children[] = [
    'tid'    => $parent_tid,
    'label'  => 'All in ' . $parent_label,
    'url'    => _customsolent_topic_option_url($parent_tid, $nav),
    'is_all' => TRUE,
  ];
  foreach (_customsolent_load_topic_children_sorted($parent_tid) as $child) {
    $child_tid = (int) $child->id();
    $children[] = [
      'tid'   => $child_tid,
      'label' => _customsolent_strip_term_prefix($child->getName()),
      'url'   => _customsolent_topic_option_url($child_tid, $nav),
    ];
  }
  return $children;
}

/**
 * Build the all-topics fallback context — scope is Culture + Sectors +
 * Living and their descendants; filter options are those three roots.
 *
 * Avoids needing an "All" parent term in the taxonomy (which would break
 * breadcrumbs, URL aliases, and menu-state detection).
 */
function _customsolent_topic_context_all($with_children = FALSE) {
  $root_names = ['Culture', 'Sectors', 'Living'];
  $scope_ids = [];
  $filter_options = [];

  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $roots = $term_storage->loadByProperties(['vid' => 'topic', 'parent' => 0]);
  $by_name = [];
  foreach ($roots as $root) {
    $by_name[$root->getName()] = $root;
  }
  foreach ($root_names as $root_name) {
    if (!isset($by_name[$root_name])) {
      continue;
    }
    $root = $by_name[$root_name];
    $scope_ids = array_merge($scope_ids, _customsolent_get_term_with_descendants($root->id()));
    $filter_options[] = _customsolent_build_filter_option($root, $with_children);
  }

  return [
    'mode'           => 'all',
    'term'           => NULL,
    'scope_ids'      => $scope_ids,
    'filter_options' => $filter_options,
    'section_key'    => 'explore',
    'section_color'  => _customsolent_topic_section_colors()['Explore'] ?? NULL,
  ];
}

/**
 * TRUE when the context's topic navigates between pages and sits below
 * its section root, so the sidebar should show the whole section.
 */
function _customsolent_topic_nav_below_root(array $context): bool {
  return !empty($context['nav'])
    && ($context['mode'] ?? '') === 'term'
    && !empty($context['term']) && !empty($context['root'])
    && (int) $context['term']->id() !== (int) $context['root']->id();
}

/**
 * Whether a topic sidebar has anything to show for this context: the
 * term's own sub-topics, or — on a page below a navigating section's
 * root — the section's list, which exists even for a topic with no
 * sub-topics of its own (/culture/music lists all of Culture).
 */
function _customsolent_topic_sidebar_has_options(array $context): bool {
  return !empty($context['filter_options']) || _customsolent_topic_nav_below_root($context);
}

/**
 * Decorate $variables with the filter sidebar / mobile bar fields,
 * marking the option matching $active_filter_tid as active and computing
 * the All link + currently-selected label.
 */
function _customsolent_apply_filter_options_to_variables(array &$variables, array $context, $active_filter_tid) {
  // A page below the section root (/culture/art-design) lists the whole
  // section — the sidebar is the section's navigation, the same list on
  // every page of it — with this page's topic marked and its branch open
  // so its own sub-topics show beneath it. "All Topics" is then the
  // section's root page. A ?topic= in the address (an old link) still
  // marks that topic instead.
  $all_url = NULL;
  if (_customsolent_topic_nav_below_root($context)) {
    $root = $context['root'];
    $context = _customsolent_topic_context_for_term($root, TRUE) + ['page_term' => $context['term']];
    $active_filter_tid ??= (int) $context['page_term']->id();
    $all_url = _customsolent_topic_nav_url((int) $root->id());
  }
  $filter_options = $context['filter_options'];
  foreach ($filter_options as &$option) {
    $option_tid = (int) $option['tid'];
    $option['active'] = ($option_tid === (int) $active_filter_tid);

    // branch_active: TRUE when the active filter is this option's
    // term OR any of its descendants. Drives the auto-expand —
    // a branch reveals its children when the user has selected
    // anywhere inside it.
    if (isset($option['scope_tids']) && is_array($option['scope_tids'])) {
      $option['branch_active'] = $active_filter_tid !== NULL
        && in_array((int) $active_filter_tid, $option['scope_tids'], TRUE);
    }
    else {
      $option['branch_active'] = $option['active'];
    }

    // Mark child active state. The "All in <Section>" child carries
    // is_all = TRUE and points at the parent term, so it activates
    // when the parent term itself is the selected filter.
    if (!empty($option['children']) && is_array($option['children'])) {
      foreach ($option['children'] as &$child) {
        $child['active'] = ((int) $child['tid'] === (int) $active_filter_tid);
      }
      unset($child);
    }
  }
  unset($option);

  $variables['filter_options']     = $filter_options;
  $variables['filter_has_options'] = !empty($filter_options);
  // "All" link clears the topic param but preserves the rest (date,
  // future filters) so the user's other selections survive.
  $variables['filter_all_url']     = $all_url ?? _customsolent_build_filter_url(['topic' => NULL]);
  $variables['filter_all_active']  = ($active_filter_tid === NULL);

  $variables['filter_active_label'] = NULL;
  if ($active_filter_tid !== NULL) {
    /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $active = $term_storage->load((int) $active_filter_tid);
    if ($active) {
      $variables['filter_active_label'] = _customsolent_strip_term_prefix($active->getName());
    }
  }
}

/**
 * Build a URL that preserves the current request's query string while
 * setting or clearing specific parameters.
 *
 * @param array $params_to_set
 *   Keyed by query param name. A NULL value clears the param; any
 *   other value sets it. Other current query params are preserved
 *   verbatim so filters compose cleanly (e.g. topic + date_filter_id).
 *
 * @return string
 *   The current request path plus the merged query string. If the
 *   merged query is empty, just the path is returned.
 */
function _customsolent_build_filter_url(array $params_to_set) {
  $request = \Drupal::request();
  $query = $request->query->all();
  foreach ($params_to_set as $k => $v) {
    if ($v === NULL) {
      unset($query[$k]);
    }
    else {
      $query[$k] = $v;
    }
  }
  // Changing a filter always resets to the first page of results —
  // otherwise the user, paginated to page 3 of "all", would click a
  // filter and land on page 3 of the filtered (probably empty) set,
  // looking like the filter had no matches.
  unset($query['page']);
  $path = $request->getPathInfo();
  return $path . (empty($query) ? '' : '?' . http_build_query($query));
}

/**
 * Implements hook_preprocess_pager().
 *
 * Drupal's pager builds hrefs as `?page=N` only — it doesn't preserve
 * other query string params from the current request, so clicking
 * page 2 from /sectors?topic=88 navigates to /sectors?page=1 and the
 * topic filter is dropped.
 *
 * Merge the current request's query into every pager item's href so
 * pagination keeps the active filter context (topic, date_filter_id,
 * etc.) across page navigations.
 */
function customsolent_preprocess_pager(array &$variables) {
  $current = \Drupal::request()->query->all();
  // 'page' is owned by the pager itself; don't let our merge clobber it.
  unset($current['page']);
  if (empty($current)) {
    return;
  }

  $merge_into_href = function (string $href) use ($current): string {
    $parts = parse_url($href);
    $existing = [];
    if (!empty($parts['query'])) {
      parse_str($parts['query'], $existing);
    }
    // Existing pager-set params (notably 'page') take priority over
    // the current request's query — page=N from the link is what we
    // want to navigate to.
    $merged = $current + $existing;
    $path = $parts['path'] ?? '';
    return $path . (empty($merged) ? '' : '?' . http_build_query($merged));
  };

  foreach (['first', 'previous', 'next', 'last'] as $key) {
    if (isset($variables['items'][$key]['href'])) {
      $variables['items'][$key]['href'] = $merge_into_href($variables['items'][$key]['href']);
    }
  }
  if (!empty($variables['items']['pages']) && is_array($variables['items']['pages'])) {
    foreach ($variables['items']['pages'] as &$item) {
      if (isset($item['href'])) {
        $item['href'] = $merge_into_href($item['href']);
      }
    }
    unset($item);
  }
}

/**
 * TRUE when the host node has a section_filter paragraph anywhere in
 * its paragraph reference fields, including paragraphs nested inside
 * other paragraphs (e.g. a section_filter inside an enclosure). Used
 * by the View Display paragraph to suppress its own filter sidebar
 * when a dedicated filter paragraph is on the same page.
 */
function _customsolent_section_filter_exists_on_host($host) {
  return (bool) _customsolent_find_section_filter_on_host($host);
}

/**
 * Return the first section_filter paragraph attached anywhere on the
 * host node's paragraph reference fields (recursively, up to 4 levels
 * deep — see _customsolent_entity_contains_paragraph_bundle). Returns
 * NULL if none. Result is statically cached per host node.
 *
 * The section_filter is the canonical "topic anchor" for a page when
 * present; sibling View Display paragraphs defer to its resolved
 * topic scope when they don't carry their own field_topic.
 */
function _customsolent_find_section_filter_on_host($host) {
  $cache = &drupal_static(__FUNCTION__, []);
  if (!$host || $host->getEntityTypeId() !== 'node') {
    return NULL;
  }
  $key = $host->getEntityTypeId() . ':' . $host->id();
  if (array_key_exists($key, $cache)) {
    return $cache[$key];
  }
  $cache[$key] = _customsolent_find_paragraph_bundle_on_entity($host, 'section_filter', 4);
  return $cache[$key];
}

/**
 * Recursively walk an entity's paragraph reference fields and return
 * the first paragraph entity of the given bundle. Capped at $max_depth.
 */
function _customsolent_find_paragraph_bundle_on_entity($entity, $bundle, $max_depth) {
  if (!$entity || $max_depth <= 0) {
    return NULL;
  }
  foreach ($entity->getFields() as $field) {
    if ($field->isEmpty()) {
      continue;
    }
    $field_def = $field->getFieldDefinition();
    if ($field_def->getType() !== 'entity_reference_revisions') {
      continue;
    }
    if ($field_def->getSetting('target_type') !== 'paragraph') {
      continue;
    }
    foreach ($field as $item) {
      $p = $item->entity;
      if (!$p) {
        continue;
      }
      if ($p->bundle() === $bundle) {
        return $p;
      }
      $nested = _customsolent_find_paragraph_bundle_on_entity($p, $bundle, $max_depth - 1);
      if ($nested) {
        return $nested;
      }
    }
  }
  return NULL;
}

/**
 * Recursively walk an entity's paragraph reference fields looking for a
 * paragraph with the given bundle. Capped at $max_depth to avoid
 * runaway recursion if paragraphs ever form a cycle.
 */
function _customsolent_entity_contains_paragraph_bundle($entity, $bundle, $max_depth) {
  if (!$entity || $max_depth <= 0) {
    return FALSE;
  }
  foreach ($entity->getFields() as $field) {
    if ($field->isEmpty()) {
      continue;
    }
    $field_def = $field->getFieldDefinition();
    if ($field_def->getType() !== 'entity_reference_revisions') {
      continue;
    }
    if ($field_def->getSetting('target_type') !== 'paragraph') {
      continue;
    }
    foreach ($field as $item) {
      $p = $item->entity;
      if (!$p) {
        continue;
      }
      if ($p->bundle() === $bundle) {
        return TRUE;
      }
      if (_customsolent_entity_contains_paragraph_bundle($p, $bundle, $max_depth - 1)) {
        return TRUE;
      }
    }
  }
  return FALSE;
}

// customsolent_paragraph_view_alter() used to be here. Entity view-alter
// hooks are only invoked on modules, so it never ran in a theme. It now
// lives in customsolent_helpers.module as
// customsolent_helpers_paragraph_view_alter().

/**
 * Get a term ID and all its descendant term IDs.
 */
function _customsolent_get_term_with_descendants($tid) {
  $ids = [(int) $tid];
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tree = $term_storage->loadTree('topic', $tid, NULL, FALSE);
  foreach ($tree as $child) {
    $ids[] = (int) $child->tid;
  }
  return $ids;
}

/**
 * TRUE if $term equals $ancestor or is anywhere beneath it in the tree.
 */
function _customsolent_term_is_descendant_of($term, $ancestor) {
  if ((int) $term->id() === (int) $ancestor->id()) {
    return TRUE;
  }
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tree = $term_storage->loadTree($ancestor->bundle(), $ancestor->id(), NULL, FALSE);
  foreach ($tree as $row) {
    if ((int) $row->tid === (int) $term->id()) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Direct children of a Topic term, sorted by weight then by stripped name.
 *
 * Returns Term entities (not the loadTree row stdClass), so callers can
 * call ->getName() / ->id() directly.
 */
function _customsolent_load_topic_children_sorted($tid) {
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $children = $term_storage->loadChildren($tid);
  usort($children, function ($a, $b) {
    $wa = (int) $a->getWeight();
    $wb = (int) $b->getWeight();
    if ($wa !== $wb) {
      return $wa <=> $wb;
    }
    return strcasecmp(
      _customsolent_strip_term_prefix($a->getName()),
      _customsolent_strip_term_prefix($b->getName())
    );
  });
  return $children;
}

/**
 * Walk up to the top-level (root) Topic term for a given term.
 */
function _customsolent_topic_top_level($term) {
  $current = $term;
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  while ($current) {
    $parents = $term_storage->loadParents($current->id());
    if (empty($parents)) {
      return $current;
    }
    $current = reset($parents);
  }
  return NULL;
}

/**
 * Section colour hex for a term — uses the term's top-level (root)
 * parent to look up the section colour map. Returns slate (#475569)
 * when the top-level isn't one of the known content/structural roots.
 */
function _customsolent_get_section_color($term) {
  $top = _customsolent_topic_top_level($term);
  if (!$top) {
    return '#475569';
  }
  return _customsolent_topic_section_colors()[$top->getName()] ?? '#475569';
}

/**
 * Depth of a term in the Topic hierarchy. Root terms (Culture, Sectors,
 * Living, About, Explore) return 0; their direct children return 1; and
 * so on. Used by the "in" kicker to know how many ancestors to strip
 * so the kicker doesn't repeat what the current page already represents.
 */
function _customsolent_get_term_depth($term) {
  $depth = 0;
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $current = $term;
  while ($current) {
    $parents = $term_storage->loadParents($current->id());
    if (empty($parents)) {
      break;
    }
    $depth++;
    $current = reset($parents);
  }
  return $depth;
}

/**
 * TRUE when a published composite_page node exists with the given term
 * id as its field_primary_topic. Used by the "in"/"from" kickers to
 * conditionally link terms to their landing pages (links when a page
 * exists, plain text otherwise — graceful degradation as the editor
 * builds out the section tree).
 *
 * Statically cached per tid within the request — a listing page with
 * many items sharing the same sub-term only hits the DB once per
 * unique term.
 */
function _customsolent_term_has_landing_page($tid) {
  return _customsolent_term_landing_nid((int) $tid) !== NULL;
}

/**
 * The published composite_page whose field_primary_topic is the term —
 * the topic's own page — or NULL. Statically cached per term.
 */
function _customsolent_term_landing_nid(int $tid): ?int {
  $cache = &drupal_static(__FUNCTION__, []);
  if (array_key_exists($tid, $cache)) {
    return $cache[$tid];
  }
  $query = \Drupal::entityQuery('node')
    ->condition('type', 'composite_page')
    ->condition('field_primary_topic', $tid)
    ->condition('status', 1)
    ->range(0, 1)
    ->accessCheck(TRUE);
  $results = $query->execute();
  $cache[$tid] = $results ? (int) reset($results) : NULL;
  return $cache[$tid];
}

/**
 * Build a kicker display chain for a content item's topic term.
 *
 * Every caller now passes -1 (the whole chain from the section root):
 * since 3 Nov 2026 the "in", "also in" and "here in" kickers all name
 * the section, because a topic name alone is ambiguous when the same
 * word sits under two sections. Trimming is kept for any future use.
 *
 * @param \Drupal\taxonomy\TermInterface $content_term
 *   The content's primary topic term.
 * @param int $page_term_depth
 *   Depth of a term whose ancestors should be left out: 0 strips the
 *   root (Culture / Sectors / Living), 1 the root and its child, etc.
 *   -1 strips nothing and shows the full chain.
 *
 * @return array|null
 *   Array of {label, url, color} for each remaining term, or NULL when
 *   the content's term matches the page exactly (nothing to display).
 */
function _customsolent_build_in_kicker($content_term, $page_term_depth) {
  $chain = [];
  $current = $content_term;
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  while ($current) {
    array_unshift($chain, $current);
    $parents = $term_storage->loadParents($current->id());
    $current = !empty($parents) ? reset($parents) : NULL;
  }

  // page_term_depth = -1 means show full chain (no stripping).
  $display_from = $page_term_depth + 1;
  if ($display_from >= count($chain)) {
    return NULL;
  }

  $color = _customsolent_get_section_color($content_term);
  $items = [];
  for ($i = $display_from; $i < count($chain); $i++) {
    $term = $chain[$i];
    $items[] = [
      'label' => _customsolent_strip_term_prefix($term->getName()),
      'url'   => _customsolent_term_has_landing_page($term->id())
        ? _customsolent_build_term_url($chain, $i)
        : NULL,
      'color' => $color,
    ];
  }
  return $items;
}

/**
 * Build the "from" kicker ancestor chain for a content item appearing
 * on a page via field_related_topics (its primary topic is outside the
 * current page's tree). Returns the FULL chain from root to leaf with
 * each term conditionally linked.
 *
 * Example: a node with primary topic "Sectors / Arts" produces
 *   [ {label: SECTORS, url: /sectors, ...}, {label: ARTS, url: /sectors/arts, ...} ]
 */
function _customsolent_build_from_kicker($term) {
  $chain = [];
  $current = $term;
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  while ($current) {
    array_unshift($chain, $current);
    $parents = $term_storage->loadParents($current->id());
    $current = !empty($parents) ? reset($parents) : NULL;
  }
  $color = _customsolent_get_section_color($term);
  $items = [];
  foreach ($chain as $i => $node) {
    $items[] = [
      'label' => _customsolent_strip_term_prefix($node->getName()),
      'url'   => _customsolent_term_has_landing_page($node->id())
        ? _customsolent_build_term_url($chain, $i)
        : NULL,
      'color' => $color,
    ];
  }
  return $items;
}
/**
 * Implements hook_preprocess_item_list__search_results().
 *
 * Visiting /search/node with no keywords showed "Your search yielded no
 * results." — misleading when the visitor hasn't searched yet. Swap in an
 * invitation to search instead. A genuine empty result set (keys present)
 * keeps the core message.
 */
function customsolent_preprocess_item_list__search_results(array &$variables) {
  $keys = trim((string) \Drupal::request()->query->get('keys', ''));
  if ($keys === '' && !empty($variables['empty'])) {
    $variables['empty'] = [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#attributes' => ['class' => ['search-empty-prompt']],
      '#value' => t('Please enter search terms above to search the site.'),
    ];
  }
}

/**
 * Format and setting for cards and pages (issue 485).
 *
 * field_format (Format terms, several allowed) and field_setting (indoor,
 * outdoor, online, hybrid) are the second axis to Topic. They print as one
 * small line, "Workshop · Online", through components/format-line.html.twig;
 * nothing when neither is set. Formats come in vocabulary order so a card
 * reads "Festival · Market & Fair" the same way everywhere.
 */
function _customsolent_preprocess_format_extras($node, array &$variables): void {
  $variables['#cache']['contexts'][] = 'route';
  $variables['format_labels'] = [];
  $variables['setting_label'] = NULL;
  $variables['setting_key'] = NULL;
  if ($node->hasField('field_format') && !$node->get('field_format')->isEmpty()) {
    $terms = $node->get('field_format')->referencedEntities();
    usort($terms, static fn($a, $b) => [(int) $a->getWeight(), $a->label()] <=> [(int) $b->getWeight(), $b->label()]);
    // An organisation puts on many, so it reads in the plural ("Talks");
    // an event or series is one occasion ("Talk").
    $plural = $node->bundle() === 'organisation';
    // On a format's own landing page the cards leave that format out, as
    // the kicker leaves out the page's topic: the page already says it.
    $page_format = \Drupal::routeMatch()->getRouteName() === 'customsolent_helpers.format_listing'
      ? customsolent_helpers_active_format_tid() : NULL;
    foreach ($terms as $term) {
      if ($page_format && (int) $term->id() === $page_format) {
        $variables['#cache']['tags'][] = 'taxonomy_term:' . $term->id();
        continue;
      }
      $label = $term->label();
      if ($plural && $term->hasField('field_plural_label') && !$term->get('field_plural_label')->isEmpty()) {
        $label = (string) $term->get('field_plural_label')->value;
      }
      $variables['format_labels'][] = $label;
      $variables['#cache']['tags'][] = 'taxonomy_term:' . $term->id();
    }
  }
  // Cost and age group (issues 422, 463) follow on the same line, "Free",
  // "Ages 5 to 11"; nothing when unset, so a general adult event says
  // nothing about age.
  $variables['facet_labels'] = [];
  foreach (customsolent_helpers_facets() as $def) {
    if (!$node->hasField($def['field']) || $node->get($def['field'])->isEmpty()) {
      continue;
    }
    $terms = $node->get($def['field'])->referencedEntities();
    usort($terms, static fn($a, $b) => [(int) $a->getWeight(), $a->label()] <=> [(int) $b->getWeight(), $b->label()]);
    foreach ($terms as $term) {
      $variables['facet_labels'][] = $term->label();
      $variables['#cache']['tags'][] = 'taxonomy_term:' . $term->id();
    }
  }
  if ($node->hasField('field_setting') && !$node->get('field_setting')->isEmpty()) {
    $item = $node->get('field_setting')->first();
    $allowed = $item->getFieldDefinition()->getFieldStorageDefinition()->getSetting('allowed_values') ?? [];
    $variables['setting_key'] = (string) $item->value;
    $variables['setting_label'] = $allowed[$item->value] ?? ucfirst((string) $item->value);
  }
}

/**
 * The topics of a node, the primary first then the related ones, each as
 * its full chain, for the foot of its page (components/topics-list.html.twig).
 * The primary repeats the kicker on purpose: on a long page the kicker is
 * far above by the time the reader gets here, and Rob may drop the kicker
 * one day. A related term that repeats the primary is left out.
 *
 * Sets:
 *   - related_topic_chains — list of {chain: [{label, url, color}], primary,
 *     color} where color is the section colour of the chain's top term.
 */
function _customsolent_preprocess_related_topics($node, array &$variables): void {
  $variables['related_topic_chains'] = [];
  $seen = [];
  $add = function ($term, bool $primary) use (&$variables, &$seen): void {
    if (!$term || isset($seen[$term->id()])) {
      return;
    }
    $seen[$term->id()] = TRUE;
    $trail = _customsolent_build_topic_trail($term, FALSE);
    if (empty($trail['ancestors'])) {
      return;
    }
    $variables['related_topic_chains'][] = [
      'chain' => $trail['ancestors'],
      'primary' => $primary,
      'color' => $trail['ancestors'][0]['color'] ?? NULL,
    ];
    $variables['#cache']['tags'][] = 'taxonomy_term:' . $term->id();
  };
  if ($node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $add($node->get('field_primary_topic')->entity, TRUE);
  }
  if ($node->hasField('field_related_topics')) {
    foreach ($node->get('field_related_topics')->referencedEntities() as $term) {
      $add($term, FALSE);
    }
  }
}
