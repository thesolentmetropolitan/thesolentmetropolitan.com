<?php

declare(strict_types=1);

/**
 * @file
 * Functions to support theming in the customsolent theme.
 */

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function customsolent_preprocess_html(array &$variables): void {
  // Body class for the content type of the node being viewed, e.g.
  // page-node-type-composite-page. CSS uses it to give section pages and
  // the front page (all Composite Pages) the off-white page background
  // without touching the site-wide colour — see css/elements.css.
  $node = \Drupal::routeMatch()->getParameter('node');
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($node instanceof \Drupal\node\NodeInterface && $route_name === 'entity.node.canonical') {
    $variables['attributes']['class'][] = 'page-node-type-' . \Drupal\Component\Utility\Html::getClass($node->bundle());
  }
  // The automated /{topic}/{type} listing pages belong to the section they
  // list, so they share its off-white page background.
  if ($route_name === 'customsolent_helpers.topic_listing') {
    $variables['attributes']['class'][] = 'page-node-type-composite-page';
    $variables['attributes']['class'][] = 'page-topic-listing';
  }
  // Log in / reset password / 404 / 403: see _customsolent_system_page().
  if ($system_page = _customsolent_system_page()) {
    $variables['attributes']['class'][] = 'page-system';
    $variables['attributes']['class'][] = 'page-system--' . $system_page['key'];
  }
}

/**
 * Describes the current route if it is one of Drupal's own bare pages.
 *
 * These pages have no node, no banner and (in this theme) no page title
 * block, so they rendered as unstyled form fields or a lone sentence hard
 * against the header. page.html.twig gives them a heading, an intro and a
 * white box on the off-white ground; css/system-pages.css styles the forms
 * to match the contact form.
 *
 * @return array|null
 *   key, title, intro, links (label => path), replace_content (bool).
 */
function _customsolent_system_page(): ?array {
  $pages = [
    'user.login' => [
      'key' => 'login',
      'title' => t('Log in'),
      'intro' => t('For editors and contributors of The Solent Metropolitan.'),
      'links' => [(string) t('Forgotten your password?') => '/user/password'],
    ],
    'user.pass' => [
      'key' => 'password',
      'title' => t('Reset your password'),
      'intro' => t('Enter your username or email address and we will send you a link to set a new password.'),
      'links' => [(string) t('Back to log in') => '/user/login'],
    ],
    'system.404' => [
      'key' => '404',
      'title' => t('Page not found'),
      'intro' => t('Sorry, there is no page at this address. It may have moved, or the link may be out of date.'),
      'links' => [
        (string) t("What's on: events") => '/explore/events',
        (string) t('Articles') => '/explore/articles',
        (string) t('Organisations') => '/explore/organisations',
        (string) t('Culture') => '/culture',
        (string) t('Sectors') => '/sectors',
        (string) t('Living') => '/living',
        (string) t('Home') => '/',
      ],
      'replace_content' => TRUE,
    ],
    'system.403' => [
      'key' => '403',
      'title' => t('You need to log in to see this page'),
      'intro' => t('This page is not public. If you are an editor or contributor, log in and try again.'),
      'links' => [(string) t('Log in') => '/user/login', (string) t('Home') => '/'],
      'replace_content' => TRUE,
    ],
  ];
  $route = \Drupal::routeMatch()->getRouteName();
  return $pages[$route] ?? NULL;
}

/**
 * Implements hook_preprocess_HOOK() for slnt-topic-listing.html.twig.
 *
 * The automated listing page: topic trail (every term clickable, the last
 * one leading back to the section page), a plain h1, then the listing.
 */
function customsolent_preprocess_slnt_topic_listing(array &$variables): void {
  $node = $variables['node'];
  $variables['trail_ancestors'] = [];
  if ($node && $node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term) {
      $trail = _customsolent_build_topic_trail($term, FALSE);
      $variables['trail_ancestors'] = $trail['ancestors'];
      $top = _customsolent_topic_top_level($term);
      $variables['section_key'] = $top ? strtolower($top->getName()) : NULL;
    }
  }
  $variables['strip'] = $node ? _customsolent_build_section_strip($node, (string) $variables['listing_type']) : NULL;
  $variables['back_url'] = $node ? $node->toUrl()->toString() : NULL;
  $variables['back_label'] = $node ? $node->label() : NULL;
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function customsolent_preprocess_page(array &$variables): void {
  $variables['system_page'] = _customsolent_system_page();
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 *
 * Builds the topic trail (clickable ancestor terms + leaf term)
 * from the node's field_primary_topic. Composite pages use the
 * leaf term as the page h1; content pages (article, etc.) keep
 * the entire chain as a clickable kicker above their own title.
 *
 * Also exposes event-teaser-specific data (section_color,
 * field_url_external/href/text, where_name) so the event teaser
 * template can render the When/Where rows with icons and a
 * section-coloured CTA from field_url.
 */
function customsolent_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node) {
    return;
  }

  // Topic trail (any node with a primary topic).
  if ($node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term) {
      $is_composite = ($node->bundle() === 'composite_page');
      $trail = _customsolent_build_topic_trail($term, $is_composite);
      $variables['topic_trail_ancestors'] = $trail['ancestors'];
      $variables['topic_trail_current'] = $trail['current_label'];
      $variables['topic_trail_as_heading'] = $is_composite;
    }
  }

  // Event teaser extras.
  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'teaser') {
    _customsolent_preprocess_event_teaser_extras($node, $variables);
  }

  // Event compact (front-page card) extras.
  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'compact') {
    _customsolent_preprocess_event_compact_extras($node, $variables);
  }

  // Article compact (front-page card) extras.
  if ($node->bundle() === 'article' && ($variables['view_mode'] ?? '') === 'compact') {
    _customsolent_preprocess_article_compact_extras($node, $variables);
  }

  // Link / Organisation teaser — both render field_url as a primary
  // link with a trailing arrow-square-out icon for external URLs.
  // Same field_url meta extraction works for both.
  if (in_array($node->bundle(), ['link', 'organisation'], TRUE)
    && ($variables['view_mode'] ?? '') === 'teaser') {
    _customsolent_extract_field_url_meta($node, $variables);
  }

  // Link / Organisation compact card — one shared card design. Same
  // field_url extraction, plus a type label so the two content types can
  // share one list and still be told apart.
  if (in_array($node->bundle(), ['link', 'organisation'], TRUE)
    && ($variables['view_mode'] ?? '') === 'compact') {
    _customsolent_extract_field_url_meta($node, $variables);
    $variables['card_type_label'] = $node->bundle() === 'link' ? t('Link') : t('Organisation');
  }

  // Full node views for event / organisation / link (destination pages
  // reachable directly and from search). The template renders field_url as a
  // CTA button, so extract its href/text/external flag here; and for events,
  // flag whether the event has already finished (past-event badge).
  if (($variables['view_mode'] ?? '') === 'full'
    && in_array($node->bundle(), ['event', 'link', 'organisation'], TRUE)) {
    _customsolent_extract_field_url_meta($node, $variables);

    if ($node->bundle() === 'event'
      && $node->hasField('field_when') && !$node->get('field_when')->isEmpty()) {
      // Smart Date stores Unix timestamps in `value` (start) and `end_value`
      // (end). The event is "past" once its end time has elapsed.
      $item = $node->get('field_when')->first();
      $end = $item->end_value ?? $item->value;
      if ($end !== NULL && $end !== '') {
        $variables['is_past_event'] = ((int) $end < \Drupal::time()->getRequestTime());
      }
    }
  }

  // Full node views for content types (article, event, organisation, link):
  // expose the primary topic's menu path (e.g. "/culture/music") so the desktop
  // menu can indicate the topic's section rather than the URL path — content
  // lives at /articles, /events, /organisations, which don't match any menu
  // item. Read by js/menu-state.js via the data-primary-topic-path attribute.
  if (($variables['view_mode'] ?? '') === 'full'
    && in_array($node->bundle(), ['article', 'event', 'organisation', 'link'], TRUE)
    && $node->hasField('field_primary_topic')
    && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term) {
      // Build the root-to-leaf term chain, then the lowercase/hyphenated path
      // via the shared helper (e.g. "Culture / Music" => "/culture/music").
      $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
      $chain = [];
      $current = $term;
      while ($current) {
        array_unshift($chain, $current);
        $parents = $term_storage->loadParents($current->id());
        $current = !empty($parents) ? reset($parents) : NULL;
      }
      $variables['primary_topic_menu_path'] = _customsolent_build_term_url($chain, count($chain) - 1);
    }
  }

  // Topic kickers on teasers and compact cards. Rendered via
  // #lazy_builder placeholders so they're recomputed per request,
  // bypassing the teaser entity render cache (which is shared across
  // pages and would otherwise bake the wrong kicker into other
  // section pages — issue #279).
  //
  // The lazy-builder callbacks resolve the current page's topic
  // scope from the request URL — not from request attributes, which
  // may be overwritten by other paragraphs by the time the
  // placeholder is resolved.
  if (in_array(($variables['view_mode'] ?? ''), ['teaser', 'compact'], TRUE)
    && $node->hasField('field_primary_topic')
    && !$node->get('field_primary_topic')->isEmpty()) {
    $nid = (int) $node->id();
    $variables['in_kicker_lazy'] = [
      '#lazy_builder' => [
        'Drupal\customsolent_helpers\Render\KickerLazyBuilder::inKicker',
        [$nid],
      ],
      '#create_placeholder' => TRUE,
    ];
    $variables['from_kicker_lazy'] = [
      '#lazy_builder' => [
        'Drupal\customsolent_helpers\Render\KickerLazyBuilder::fromKicker',
        [$nid],
      ],
      '#create_placeholder' => TRUE,
    ];
    // Compact cards: the primary topic's full trail, dropped on that
    // topic's own page. White on the filled article card.
    $variables['trail_kicker_lazy'] = [
      '#lazy_builder' => [
        'Drupal\customsolent_helpers\Render\KickerLazyBuilder::trailKicker',
        [$nid, $node->bundle() === 'article' ? '#ffffff' : ''],
      ],
      '#create_placeholder' => TRUE,
    ];
  }
}

/**
 * Adds section colour, field_url metadata, and the plain Location
 * term name to event-teaser variables.
 */
function _customsolent_preprocess_event_teaser_extras($node, array &$variables): void {
  if ($node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term) {
      $top = _customsolent_topic_top_level($term);
      if ($top) {
        $variables['section_key'] = strtolower($top->getName());
        $variables['section_color'] = _customsolent_topic_section_colors()[$top->getName()] ?? NULL;
      }
    }
  }

  if ($node->hasField('field_where') && !$node->get('field_where')->isEmpty()) {
    $where = $node->get('field_where')->entity;
    if ($where) {
      $variables['where_name'] = $where->getName();
    }
  }

  _customsolent_extract_field_url_meta($node, $variables);
}

/**
 * Adds field_url metadata, the venue term name (where_name) and the
 * venue's parent term name (location_area) to the compact event card.
 *
 * The compact card lays venue and area on two lines, e.g.
 *   God's House Tower
 *   Southampton
 * If the venue term has no parent, location_area is left null and the
 * template renders only the venue name.
 */
function _customsolent_preprocess_event_compact_extras($node, array &$variables): void {
  // Section colour from the top-level Topic — drives the card's top
  // border and the kicker text colour.
  if ($node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term) {
      $top = _customsolent_topic_top_level($term);
      if ($top) {
        $variables['section_key'] = strtolower($top->getName());
        $variables['section_color'] = _customsolent_topic_section_colors()[$top->getName()] ?? NULL;
      }
    }
  }

  if ($node->hasField('field_where') && !$node->get('field_where')->isEmpty()) {
    $where = $node->get('field_where')->entity;
    if ($where) {
      $variables['where_name'] = $where->getName();
      /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
      $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
      $parents = $term_storage->loadParents($where->id());
      if (!empty($parents)) {
        $parent = reset($parents);
        $variables['location_area'] = $parent->getName();
      }
    }
  }

  _customsolent_extract_field_url_meta($node, $variables);
}

/**
 * Adds section key, topic tile and a one-line summary to the compact
 * article card.
 *
 * card_summary is the standfirst when one is written. Otherwise it is
 * the body with markup stripped, whitespace collapsed and truncated to
 * ~120 characters on a word boundary with an ellipsis. When both are
 * empty it is left unset so the template omits the paragraph.
 *
 * The fallback is computed here rather than in Twig so the truncation
 * is testable and field_body can stay hidden in the compact display
 * without ever being rendered in full.
 */
function _customsolent_preprocess_article_compact_extras($node, array &$variables): void {
  // Section key from the top-level Topic — drives the card's fill
  // colour (css/article-compact.css maps data-section to a colour that
  // passes AA contrast with white text). Also pick the hero tile SVG
  // for the article's own topic, falling back to the section's
  // "view all" tile, then to the generic articles tile.
  $tile_candidates = [];
  if ($node->hasField('field_primary_topic') && !$node->get('field_primary_topic')->isEmpty()) {
    $term = $node->get('field_primary_topic')->entity;
    if ($term) {
      $top = _customsolent_topic_top_level($term);
      if ($top) {
        $variables['section_key'] = strtolower($top->getName());
        $variables['section_color'] = _customsolent_topic_section_colors()[$top->getName()] ?? NULL;
        $slug = static fn(string $name): string => trim(preg_replace('/[^a-z0-9]+/', '_', strtolower($name)) ?? '', '_');
        // Topic term names carry their path ("Culture / Identity"), so
        // take the last segment for the tile filename.
        $name_parts = explode(' / ', $term->getName());
        $tile_candidates[] = $slug($top->getName()) . '_' . $slug(end($name_parts));
        $tile_candidates[] = $slug($top->getName()) . '_' . $slug($top->getName());
      }
    }
  }
  $tile_candidates[] = 'explore_articles';
  $tile_dir = \Drupal::service('extension.list.theme')->getPath('customsolent') . '/images/hero-tiles';
  foreach ($tile_candidates as $candidate) {
    $tile_file = DRUPAL_ROOT . "/$tile_dir/$candidate.svg";
    if (is_file($tile_file)) {
      // The file's mtime as a cache-buster: the tiles are served with a
      // ten-year cache lifetime, so a reworked tile would otherwise be
      // drawn from the browser's old copy.
      $variables['card_tile_url'] = \Drupal::service('file_url_generator')->generateString("$tile_dir/$candidate.svg")
        . '?v=' . filemtime($tile_file);
      // The card draws the tile at 70% of its hero size. Most tiles are
      // 120px wide, but a composite tile (every icon once, e.g.
      // culture_culture) is much wider, so read the width from the file
      // and pass it on; css/article-compact.css falls back to 84px.
      $head = (string) file_get_contents($tile_file, FALSE, NULL, 0, 300);
      if (preg_match('/<svg[^>]*\swidth="([\d.]+)"/', $head, $wm) && (float) $wm[1] > 0) {
        $variables['card_tile_width'] = round((float) $wm[1] * 0.7, 2);
      }
      break;
    }
  }

  // 1. Standfirst wins when written.
  if ($node->hasField('field_standfirst') && !$node->get('field_standfirst')->isEmpty()) {
    $standfirst = trim((string) $node->get('field_standfirst')->value);
    if ($standfirst !== '') {
      $variables['card_summary'] = $standfirst;
      return;
    }
  }

  // 2. Otherwise a trimmed plain-text excerpt of the body.
  if ($node->hasField('field_body') && !$node->get('field_body')->isEmpty()) {
    // Replace tags with a space before stripping so adjacent block
    // elements (</p><p>) don't run their words together.
    $text = preg_replace('/<[^>]+>/', ' ', (string) $node->get('field_body')->value) ?? '';
    $text = html_entity_decode($text, ENT_QUOTES | ENT_HTML5, 'UTF-8');
    $text = trim(preg_replace('/\s+/u', ' ', $text) ?? '');
    if ($text !== '') {
      $variables['card_summary'] = \Drupal\Component\Utility\Unicode::truncate($text, 120, TRUE, TRUE);
    }
  }
}

/**
 * Extracts field_url metadata into preprocess $variables.
 *
 * Sets field_url_href, field_url_text (link title or URL fallback),
 * and field_url_external on the variables array. Skips silently if
 * the URL is malformed or absent.
 */
function _customsolent_extract_field_url_meta($node, array &$variables): void {
  if (!$node->hasField('field_url') || $node->get('field_url')->isEmpty()) {
    return;
  }
  $item = $node->get('field_url')->first();
  try {
    $url = $item->getUrl();
    $variables['field_url_external'] = $url->isExternal();
    $variables['field_url_href'] = $url->toString();
    $variables['field_url_text'] = $item->title ?: $url->toString();
  }
  catch (\Throwable) {
    // Malformed URI — leave variables unset; template falls back.
  }
}



/**
 * Implements hook_preprocess_HOOK() for paragraph--link.html.twig.
 *
 * Sets link_context to the text of the nearest heading paragraph that
 * comes before this link in the same parent field. The template adds it
 * as visually-hidden text, so several "View more" links on one page are
 * distinguishable in a screen-reader's list of links.
 */
function customsolent_preprocess_paragraph__link(&$variables) {
  $paragraph = $variables['paragraph'];
  $parent = $paragraph->getParentEntity();
  $field_name = $paragraph->get('parent_field_name')->value;
  if (!$parent || !$field_name || !$parent->hasField($field_name)) {
    return;
  }
  $context = NULL;
  foreach ($parent->get($field_name)->referencedEntities() as $sibling) {
    if ((int) $sibling->id() === (int) $paragraph->id()) {
      break;
    }
    if ($sibling->bundle() === 'heading' && !$sibling->get('field_heading')->isEmpty()) {
      $context = trim(preg_replace('/\s+/', ' ', (string) $sibling->get('field_heading')->value));
    }
  }
  if ($context) {
    $variables['link_context'] = $context;
  }
  // A bare "View more" / "Read more" needs the heading to say more of what.
  // "View more Events" already says it; appending the heading would just be
  // noise for a screen-reader user.
  $title = trim((string) $paragraph->get('field_link')->title);
  $variables['link_needs_context'] = (bool) preg_match('/^(view|read|see|browse)\s+(more|all)$/i', $title);
}

function customsolent_preprocess_paragraph__hero_with_art_style(&$variables) {
  $paragraph = $variables['paragraph'];
  if ($paragraph->hasField('field_classy') && !$paragraph->get('field_classy')->isEmpty()) {
    $classy_style = $paragraph->get('field_classy')->entity;
    if ($classy_style) {
      $variables['attributes']['class'][] = $classy_style->get('classes');
    }
  }

  // Look up the parent composite_page node and pull its primary topic
  // so the hero can render the topic trail in place of the plain title.
  $parent = $paragraph->getParentEntity();

  // The front page has no topic, so its banner shows field_title - and
  // that title ("Welcome to The Solent Metropolitan") is the page's h1.
  $front = (string) \Drupal::config('system.site')->get('page.front');
  if ($parent && $parent->getEntityTypeId() === 'node' && $front === '/node/' . $parent->id()) {
    $variables['hero_title_tag'] = 'h1';
    $variables['#cache']['tags'][] = 'config:system.site';
  }
  if ($parent
    && $parent->getEntityTypeId() === 'node'
    && $parent->bundle() === 'composite_page'
    && $parent->hasField('field_primary_topic')
    && !$parent->get('field_primary_topic')->isEmpty()) {
    $term = $parent->get('field_primary_topic')->entity;
    if ($term) {
      $trail = _customsolent_build_topic_trail($term, TRUE);
      $variables['topic_trail_ancestors'] = $trail['ancestors'];
      $variables['topic_trail_current'] = $trail['current_label'];
      // On an automated listing page (/culture/music/events) the same
      // banner is shown, but that page's h1 is "Events": the topic name
      // renders as a span with the same look, so there is one h1.
      $variables['topic_trail_as_heading'] = (($variables['view_mode'] ?? '') !== 'listing_page');
    }
  }
}

/**
 * Section colour map — top-level Topic term name → hex colour.
 */
function _customsolent_topic_section_colors() {
  return [
    'Culture' => '#7C3AED',
    'Sectors' => '#2563EB',
    // Living and Explore were #059669 / #D97706 until 2026-09-19. Those
    // failed WCAG AA both as text on the page background (3.6 / 3.0:1)
    // and under white text (3.8 / 3.2:1). Deepened, same hue family.
    'Living'  => '#047857',
    'About'   => '#475569',
    'Explore' => '#BC4A08',
  ];
}

/**
 * Build a topic trail from a taxonomy term.
 *
 * @param \Drupal\taxonomy\TermInterface $term
 *   The primary topic term (the leaf).
 * @param bool $leaf_as_title
 *   TRUE on composite pages — leaf becomes current_label (h1) and is
 *   excluded from ancestors. FALSE on content pages — entire chain
 *   is returned as ancestors (kicker), current_label is null.
 *
 * @return array
 *   ['ancestors' => array<{label, url, color}>, 'current_label' => ?string]
 */
function _customsolent_build_topic_trail($term, $leaf_as_title = TRUE) {
  // Walk from the leaf up to the top-level parent.
  $chain = [];
  $current = $term;
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  while ($current) {
    array_unshift($chain, $current);
    $parents = $term_storage->loadParents($current->id());
    $current = !empty($parents) ? reset($parents) : NULL;
  }

  if (empty($chain)) {
    return ['ancestors' => [], 'current_label' => NULL];
  }

  $section_colors = _customsolent_topic_section_colors();
  $top_level_name = $chain[0]->getName();
  $color = $section_colors[$top_level_name] ?? '#475569';

  $ancestor_count = $leaf_as_title ? count($chain) - 1 : count($chain);
  $ancestors = [];
  for ($i = 0; $i < $ancestor_count; $i++) {
    $ancestors[] = [
      'label' => _customsolent_strip_term_prefix($chain[$i]->getName()),
      'url'   => _customsolent_build_term_url($chain, $i),
      'color' => $color,
    ];
  }

  $current_label = NULL;
  if ($leaf_as_title) {
    $leaf = end($chain);
    $current_label = _customsolent_strip_term_prefix($leaf->getName());
  }

  return [
    'ancestors' => $ancestors,
    'current_label' => $current_label,
  ];
}

/**
 * Strip the parent prefix from a Topic term name.
 *
 * Topic terms are stored as "Parent / Child" (e.g. "Culture / Screen").
 * Top-level terms have no slash so they pass through unchanged.
 */
function _customsolent_strip_term_prefix($name) {
  $parts = explode(' / ', $name);
  return end($parts);
}

/**
 * Build the composite-page URL path for a term in the chain.
 *
 * Uses the same lowercase / hyphenate convention the menu structure
 * follows (e.g. "Culture / Art & Design" → "/culture/art-design").
 * Verified against config/sync/structure_sync.data.yml.
 */
function _customsolent_build_term_url($chain, $index) {
  $path_parts = [];
  for ($i = 0; $i <= $index; $i++) {
    $part = _customsolent_strip_term_prefix($chain[$i]->getName());
    $path_parts[] = strtolower(str_replace([' & ', ' '], ['-', '-'], $part));
  }
  return '/' . implode('/', $path_parts);
}


/**
 * Implements hook_preprocess_HOOK() for paragraph--menu.html.twig.
 *
 * Builds the menu tree, filters out the search item, and passes
 * the remaining items to the template for rendering.
 */
function customsolent_preprocess_paragraph__menu(&$variables) {
  $paragraph = $variables['paragraph'];

  $menu_name = 'main';
  if ($paragraph->hasField('field_menu_name') && !$paragraph->get('field_menu_name')->isEmpty()) {
    $menu_name = $paragraph->get('field_menu_name')->value;
  }

  $menu_tree_service = \Drupal::menuTree();
  $parameters = new \Drupal\Core\Menu\MenuTreeParameters();
  $parameters->setMinDepth(1);
  $parameters->setMaxDepth(1);
  $tree = $menu_tree_service->load($menu_name, $parameters);

  $manipulators = [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ];
  $tree = $menu_tree_service->transform($tree, $manipulators);

  // Filter out the search menu item (identified by menu-link-attributes-search class).
  $filtered_items = [];
  foreach ($tree as $element) {
    $url = $element->link->getUrlObject();
    $options = $url->getOptions();
    $classes = $options['attributes']['class'] ?? [];
    if (in_array('menu-link-attributes-search', $classes)) {
      continue;
    }
    $filtered_items[] = [
      'title' => $element->link->getTitle(),
      'url' => $url,
    ];
  }

  $variables['menu_items'] = $filtered_items;
}

function customsolent_theme_suggestions_form_alter(array &$suggestions, array $variables) {
  if (isset($variables['element']['#form_id'])) {
    $suggestions[] = 'form__' . $variables['element']['#form_id'];
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for views_exposed_form.
 *
 * Relabels the grouped date-filter's "- Any -" option to "All" on every
 * exposed form for the events_listing View. Scoped to events_listing
 * via the storage view id so other Views' exposed forms elsewhere on
 * the site are untouched.
 *
 * Iterates every select element in the form rather than hard-coding
 * the date filter's identifier, so the same hook keeps working if the
 * editor renames the filter or adds further grouped filters with the
 * same "- Any -" empty-state label.
 *
 * Implemented as hook_form_BASE_FORM_ID_alter (not the generic
 * hook_form_alter) because Drupal's FormBuilder invokes the
 * base-form-id alter through the theme system reliably, whereas the
 * generic form_alter from a theme can be missed depending on alter
 * caching state.
 */
function customsolent_form_views_exposed_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $view = $form_state->getStorage()['view'] ?? NULL;
  if (!$view || $view->id() !== 'events_listing') {
    return;
  }
  foreach ($form as &$element) {
    if (!is_array($element)
      || !in_array(($element['#type'] ?? ''), ['select', 'radios', 'checkboxes'], TRUE)
      || empty($element['#options'])
      || !is_array($element['#options'])) {
      continue;
    }
    foreach ($element['#options'] as $opt_key => $opt_label) {
      if ((string) $opt_label === '- Any -') {
        $element['#options'][$opt_key] = t('all dates');
      }
    }
  }
  unset($element);

  // Preserve the current ?topic= across date-filter submissions so the
  // page-level topic filter and the events date filter compose cleanly
  // (e.g. /culture/music?topic=35&date_filter_id=4 stays intact when
  // the user clicks a date pill). Without this hidden field, the form
  // submits with only its own fields and the topic param is dropped.
  $topic = \Drupal::request()->query->get('topic');
  if ($topic !== NULL && $topic !== '' && !isset($form['topic'])) {
    $form['topic'] = [
      '#type'  => 'hidden',
      '#value' => $topic,
    ];
  }
}


/**
 * Implements hook_preprocess_HOOK() for paragraph--view-display.html.twig.
 *
 * Topic scoping:
 *  - Priority 1: field_topic on the paragraph itself.
 *  - Priority 2: host node's field_primary_topic.
 *  - Fallback (no term, or term under Explore/About): all content topics
 *    (Culture + Sectors + Living and their descendants), with Culture /
 *    Sectors / Living as the filter options.
 *
 * When ?topic=<tid> is set in the URL and that term is within the scope,
 * the View contextual argument is narrowed to that sub-tree.
 *
 * Filter UI rendering: the paragraph renders its own sidebar / mobile bar
 * only when (a) this is the primary-topic display and (b) the host page
 * does not contain a dedicated section_filter paragraph. When a
 * section_filter paragraph is present, it owns the filter UI for the page.
 *
 * Also stashes the effective topic IDs on the request so node-teaser
 * preprocess can render a primary-topic kicker on related content.
 */
function customsolent_preprocess_paragraph__view_display(&$variables) {
  $paragraph = $variables['paragraph'];

  $host = $paragraph->getParentEntity();
  while ($host && $host->getEntityTypeId() === 'paragraph') {
    $host = $host->getParentEntity();
  }

  // Topic-anchor inheritance: if the view_display paragraph has no
  // field_topic of its own AND the host page has a section_filter
  // paragraph, defer to the section_filter's resolution so they
  // agree on the page's topic scope. Editors set field_topic once
  // (on the section_filter) and the listings follow automatically.
  $anchor_paragraph = $paragraph;
  $has_own_topic = $paragraph->hasField('field_topic')
    && !$paragraph->get('field_topic')->isEmpty();
  if (!$has_own_topic && $host) {
    $sf = _customsolent_find_section_filter_on_host($host);
    if ($sf && $sf->id() !== $paragraph->id()) {
      $anchor_paragraph = $sf;
    }
  }

  // "Preview, all topics" ignores the page's topic anchor entirely: the
  // block is a window on the whole site, not on this page's subject. Doing
  // this here rather than in the listing-mode helper keeps primary_topic_tid,
  // the page_topic_tids request attribute and the card kickers consistent
  // with what the block actually shows.
  if (_customsolent_listing_mode($paragraph, $variables['view_mode'] ?? 'default') === 'preview_all') {
    $context = _customsolent_topic_context_all();
  }
  else {
    $context = _customsolent_resolve_topic_context($anchor_paragraph, $host);
  }

  $variables['section_key']   = $context['section_key'];
  $variables['section_color'] = $context['section_color'];

  // Expose view name + display id to the template (it handles the
  // virtual view_display_primary_and_related display by rendering both
  // underlying displays).
  $view_name  = '';
  $display_id = '';
  if (!$paragraph->get('field_view')->isEmpty()) {
    $view_name  = $paragraph->get('field_view')->target_id ?? '';
    $display_id = $paragraph->get('field_view')->display_id ?? '';
  }
  $variables['view_name']  = $view_name;
  $variables['display_id'] = $display_id;

  // Resolve effective scope IDs, narrowing to the ?topic= candidate
  // when it is valid (i.e. within the paragraph's topic scope).
  $effective_ids = $context['scope_ids'];
  $active_filter_tid = NULL;
  $query_topic = \Drupal::request()->query->get('topic');
  if ($query_topic !== NULL && is_numeric($query_topic) && (int) $query_topic > 0) {
    $candidate_tid = (int) $query_topic;
    if (in_array($candidate_tid, $context['scope_ids'], TRUE)) {
      $effective_ids = _customsolent_get_term_with_descendants($candidate_tid);
      $active_filter_tid = $candidate_tid;
    }
  }

  $variables['primary_topic_tid'] = implode('+', $effective_ids);

  // Stash the effective scope IDs so node-teaser preprocess can decide
  // whether to render the primary-topic kicker (content from outside
  // this scope shows the "from" kicker; in-scope content shows the
  // "in" kicker with ancestors stripped to the page's depth).
  \Drupal::request()->attributes->set('page_topic_tids', $effective_ids);

  // Depth of the page's resolved term in the Topic hierarchy. Used by
  // the "in" kicker to strip ancestors already represented by the
  // page itself (so on /culture, "Culture / Music" displays as
  // "MUSIC" not "CULTURE / MUSIC"). -1 in all-topics mode (e.g.
  // /explore/events landing): show the full ancestor chain.
  $page_term_depth = -1;
  $page_term_tid   = NULL;
  if (($context['mode'] ?? '') === 'term' && !empty($context['term'])) {
    $page_term_depth = _customsolent_get_term_depth($context['term']);
    $page_term_tid   = (int) $context['term']->id();
  }
  \Drupal::request()->attributes->set('page_term_depth', $page_term_depth);
  // Also stash the exact term tid so the teaser preprocess can do a
  // belt-and-braces exact-match check (no kicker when content's
  // primary topic IS the page's term) independently of the depth
  // arithmetic — defensive against any unexpected request-attribute
  // state.
  \Drupal::request()->attributes->set('page_term_tid', $page_term_tid);

  // Render this paragraph's own filter UI only when:
  //   (a) the display is the primary-topic display, AND
  //   (b) no section_filter paragraph exists on the host page.
  $is_primary_display = ($display_id === 'view_display_primary_topic');
  $has_section_filter = $host ? _customsolent_section_filter_exists_on_host($host) : FALSE;
  if ($is_primary_display && !$has_section_filter && !empty($context['filter_options'])) {
    _customsolent_apply_filter_options_to_variables($variables, $context, $active_filter_tid);
  }
  else {
    $variables['filter_has_options'] = FALSE;
  }

  // Preview / full-listing behaviour for the by-topic listings.
  _customsolent_preprocess_listing_mode($variables, $paragraph, $host, $context, $active_filter_tid);
}

/**
 * The three displays that list content by topic.
 */
function _customsolent_topic_listing_displays(): array {
  return ['view_display_primary_and_related', 'view_display_primary_topic', 'view_display_related_topics'];
}

/**
 * Listing views by topic => the URL word of their listing page.
 *
 * Organisations and links share one combined listing, so both map to
 * "organisations". These words are reserved: see
 * customsolent_helpers_reserved_listing_words().
 */
function _customsolent_topic_listing_types(): array {
  return [
    'events_listing' => 'events',
    'articles_listing' => 'articles',
    'organisations_listing' => 'organisations',
    'links_listing' => 'organisations',
  ];
}

/**
 * What each kind of by-topic listing needs, keyed by its URL word.
 *
 * - label:     the heading a preview falls back to, and the strip label.
 * - tags:      node_list cache tags — an empty block must reappear when
 *              the first item is tagged with the topic.
 * - grid:      the card grid class for a preview.
 * - full:      [view, display] rendered in Full mode (the listing page),
 *              and the grid class that goes with it. Events keep their
 *              date pills on a separate cards display; articles' by-topic
 *              display is already the card grid.
 * - stat:      the key in _customsolent_topic_scope_stats().
 */
function _customsolent_listing_kinds(): array {
  return [
    'events' => [
      'label' => t('Events'),
      'tags' => ['node_list:event'],
      'grid' => 'slnt-events-compact-grid',
      'full' => ['events_listing', 'view_display_listing_cards'],
      'full_grid' => 'slnt-events-compact-grid slnt-events-compact-grid--listing',
      'stat' => 'events',
    ],
    'articles' => [
      'label' => t('Articles'),
      'tags' => ['node_list:article'],
      'grid' => 'slnt-articles-compact-grid',
      'full' => ['articles_listing', 'view_display_primary_and_related'],
      'full_grid' => 'slnt-articles-compact-grid',
      'stat' => 'articles',
    ],
    'organisations' => [
      'label' => t('Organisations & links'),
      'tags' => ['node_list:organisation', 'node_list:link'],
      'grid' => 'slnt-directory-compact-grid slnt-directory-compact-grid--preview',
      'full' => ['directory_listing', 'view_display_primary_and_related'],
      'full_grid' => 'slnt-directory-compact-grid',
      'stat' => 'directory',
    ],
  ];
}

/**
 * Resolves how a View Display paragraph should behave.
 *
 * @return string
 *   - 'plain':   not a by-topic listing (front page grids etc.) — untouched.
 *   - 'full':    filter + pager on this page. The paragraph's Listing mode
 *                field says so, or it is being rendered on its automated
 *                listing page (paragraph view mode "listing_page").
 *   - 'preview': up to 8 cards and a "View more" link. Automatic for
 *                events; for organisations only when the editor picks it
 *                (a sponsors row, "who has joined the cause").
 *   - 'preview_all': as 'preview', but deliberately NOT scoped to the
 *                page's topic — the newest cards from across the whole
 *                site, with "View more" pointing at the site-wide
 *                listing page rather than this page's own sub-listing.
 *                For pages whose subject IS the content type (e.g.
 *                /culture/writing listing all articles).
 *   - 'signpost': a box with a count and a link to the full list, no
 *                cards. Automatic for organisations and links: the first
 *                eight of an A–Z list mean nothing, a count does.
 */
function _customsolent_listing_mode($paragraph, string $view_mode = 'default'): string {
  if ($paragraph->bundle() !== 'view_display' || $paragraph->get('field_view')->isEmpty()) {
    return 'plain';
  }
  $view = $paragraph->get('field_view')->target_id;
  $display = $paragraph->get('field_view')->display_id;
  if (!isset(_customsolent_topic_listing_types()[$view])
    || !in_array($display, _customsolent_topic_listing_displays(), TRUE)) {
    return 'plain';
  }
  if ($view_mode === 'listing_page') {
    return 'full';
  }
  $chosen = $paragraph->hasField('field_listing_mode') ? $paragraph->get('field_listing_mode')->value : NULL;
  if ($chosen === 'full') {
    return 'full';
  }
  // All-topics preview is an explicit editor choice for any listing type;
  // unlike 'preview' it is never inferred.
  if ($chosen === 'preview_all') {
    return 'preview_all';
  }
  $is_directory = (_customsolent_topic_listing_types()[$view] === 'organisations');
  if (!$is_directory) {
    return 'preview';
  }
  return $chosen === 'preview' ? 'preview' : 'signpost';
}

/**
 * TRUE for the two modes in which a listing renders its own heading row.
 */
function _customsolent_listing_owns_heading(string $mode): bool {
  return in_array($mode, ['preview', 'preview_all', 'signpost'], TRUE);
}

/**
 * Counts of what a topic scope holds, for the section strip and signpost.
 *
 * One query per kind, cached for the request.
 *
 * @param int[] $tids
 *   The topic scope: a term and all its descendants.
 *
 * @return array{events:int, articles:int, organisation:int, link:int, directory:int, directory_tids:array<int,int[]>}
 *   directory_tids maps topic tid => node ids tagged with it (primary or
 *   related), for working out which sub-topics have anything in them.
 */
function _customsolent_topic_scope_stats(array $tids): array {
  $cache = &drupal_static(__FUNCTION__, []);
  sort($tids);
  $key = implode(',', $tids);
  if (isset($cache[$key])) {
    return $cache[$key];
  }
  $stats = ['events' => 0, 'articles' => 0, 'organisation' => 0, 'link' => 0, 'directory' => 0, 'directory_tids' => []];
  if (!$tids) {
    return $cache[$key] = $stats;
  }
  $db = \Drupal::database();
  $tagged = function (array $types) use ($db, $tids) {
    $primary = $db->select('node__field_primary_topic', 'p');
    $primary->join('node_field_data', 'n', 'n.nid = p.entity_id AND n.status = 1');
    $primary->addField('n', 'nid'); $primary->addField('n', 'type');
    $primary->addField('p', 'field_primary_topic_target_id', 'tid');
    $primary->condition('n.type', $types, 'IN')->condition('p.field_primary_topic_target_id', $tids, 'IN');
    $related = $db->select('node__field_related_topics', 'r');
    $related->join('node_field_data', 'n', 'n.nid = r.entity_id AND n.status = 1');
    $related->addField('n', 'nid'); $related->addField('n', 'type');
    $related->addField('r', 'field_related_topics_target_id', 'tid');
    $related->condition('n.type', $types, 'IN')->condition('r.field_related_topics_target_id', $tids, 'IN');
    return array_merge($primary->execute()->fetchAll(), $related->execute()->fetchAll());
  };

  // Organisations + links.
  $seen = [];
  foreach ($tagged(['organisation', 'link']) as $row) {
    $stats['directory_tids'][(int) $row->tid][(int) $row->nid] = (int) $row->nid;
    if (!isset($seen[$row->nid])) {
      $seen[$row->nid] = TRUE;
      $stats[$row->type]++;
    }
  }
  $stats['directory'] = count($seen);

  // Events that have not ended — the same rule as the listing views.
  $event_nids = array_unique(array_map(fn($r) => (int) $r->nid, $tagged(['event'])));
  if ($event_nids) {
    $today = (new \DateTimeImmutable('today', new \DateTimeZone(date_default_timezone_get())))->getTimestamp();
    $stats['events'] = (int) $db->select('node__field_when', 'w')
      ->condition('w.entity_id', $event_nids, 'IN')
      ->condition('w.field_when_end_value', $today, '>=')
      ->distinct()->fields('w', ['entity_id'])->countQuery()->execute()->fetchField();
  }

  // Published articles tagged with the topic, primary or related.
  $stats['articles'] = count(array_unique(array_map(fn($r) => (int) $r->nid, $tagged(['article']))));
  return $cache[$key] = $stats;
}

/**
 * The topic scope a section page works in: term, scope ids, section key.
 *
 * Mirrors _customsolent_resolve_topic_context(): an explicit topic on the
 * page's section filter wins, otherwise the node's primary topic.
 */
function _customsolent_node_topic_context($node): ?array {
  if (!$node || !$node->hasField('field_primary_topic') || $node->get('field_primary_topic')->isEmpty()) {
    return NULL;
  }
  $term = NULL;
  $section_filter = _customsolent_find_section_filter_on_host($node);
  if ($section_filter && !$section_filter->get('field_topic')->isEmpty()) {
    $term = $section_filter->get('field_topic')->entity;
  }
  $term = $term ?: $node->get('field_primary_topic')->entity;
  return $term ? _customsolent_topic_context_for_term($term) : NULL;
}

/**
 * The section strip: Overview · Events 12 · Articles 3 · Organisations & links 38.
 *
 * Navigation between a topic's own page and its per-type listing pages —
 * real links to real addresses, with the current one marked; not an ARIA
 * tab widget. Shown on Culture, Sectors and Living section pages and on
 * their listing pages. A type with nothing in it is left out, and if only
 * "Overview" would remain there is no strip at all.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The section page.
 * @param string $current
 *   'overview', 'events', 'articles' or 'organisations'.
 */
function _customsolent_build_section_strip($node, string $current): ?array {
  if (!$node || $node->bundle() !== 'composite_page') {
    return NULL;
  }
  $context = _customsolent_node_topic_context($node);
  if (!$context || !in_array($context['section_key'], ['culture', 'sectors', 'living'], TRUE)) {
    return NULL;
  }
  $stats = _customsolent_topic_scope_stats($context['scope_ids']);
  $base = rtrim($node->toUrl()->toString(), '/');
  $items = [[
    'key' => 'overview',
    'label' => t('Overview'),
    'url' => $base,
    'count' => NULL,
  ]];
  $tags = $node->getCacheTags();
  // A kind whose placed listing is "Preview, all topics" (Writing's
  // articles) is a window on the whole site, so its strip item must say
  // the same thing: the site-wide count, linking to the site-wide page.
  $sitewide = _customsolent_sitewide_listing_kinds($node);
  $all_stats = $sitewide ? _customsolent_topic_scope_stats(_customsolent_topic_context_all()['scope_ids']) : [];
  foreach (_customsolent_listing_kinds() as $key => $kind) {
    $tags = array_merge($tags, $kind['tags']);
    if (isset($sitewide[$key])) {
      if ($all_stats[$kind['stat']] > 0 && ($url = _customsolent_sitewide_listing_url($key))) {
        $items[] = ['key' => $key, 'label' => $kind['label'], 'url' => $url, 'count' => $all_stats[$kind['stat']]];
      }
    }
    elseif ($stats[$kind['stat']] > 0) {
      $items[] = ['key' => $key, 'label' => $kind['label'], 'url' => $base . '/' . $key, 'count' => $stats[$kind['stat']]];
    }
  }
  if (count($items) < 2) {
    return NULL;
  }
  foreach ($items as &$item) {
    $item['current'] = ($item['key'] === $current);
  }
  unset($item);

  // The events count drops as dates pass: do not keep it beyond today.
  $midnight = (new \DateTimeImmutable('tomorrow', new \DateTimeZone(date_default_timezone_get())))->getTimestamp();
  return [
    '#theme' => 'slnt_section_strip',
    '#items' => $items,
    '#label' => t('@topic section', ['@topic' => $node->label()]),
    '#section_key' => $context['section_key'],
    '#cache' => [
      'tags' => $tags,
      'max-age' => max(60, $midnight - \Drupal::time()->getRequestTime()),
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for field.html.twig.
 *
 * Puts the section strip directly under the banner on section pages, with
 * no content edits: on a Composite Page's full view, if the first content
 * component is the hero, the strip becomes the second item.
 */
function customsolent_preprocess_field(array &$variables): void {
  $element = $variables['element'];
  if (($element['#field_name'] ?? '') !== 'field_content_component'
    || ($element['#entity_type'] ?? '') !== 'node'
    || ($element['#bundle'] ?? '') !== 'composite_page'
    || ($element['#view_mode'] ?? '') !== 'full') {
    return;
  }
  $node = $element['#object'];
  $first = $node->get('field_content_component')->first();
  if (!$first || !$first->entity || $first->entity->bundle() !== 'hero_with_art_style') {
    return;
  }
  $strip = _customsolent_build_section_strip($node, 'overview');
  if (!$strip) {
    return;
  }
  array_splice($variables['items'], 1, 0, [[
    'content' => $strip,
    'attributes' => new \Drupal\Core\Template\Attribute(['class' => ['field__item', 'field__item--section-strip']]),
  ]]);
}

/**
 * All by-topic listing paragraphs on a host node, in page order.
 */
function _customsolent_topic_listing_paragraphs($host): array {
  $cache = &drupal_static(__FUNCTION__, []);
  if (!$host || $host->getEntityTypeId() !== 'node') {
    return [];
  }
  if (!isset($cache[$host->id()])) {
    $found = [];
    $walk = function ($entity, int $depth) use (&$walk, &$found) {
      if ($depth <= 0) {
        return;
      }
      foreach ($entity->getFields(FALSE) as $field) {
        if ($field->getFieldDefinition()->getType() !== 'entity_reference_revisions') {
          continue;
        }
        foreach ($field->referencedEntities() as $p) {
          if (_customsolent_listing_mode($p) !== 'plain') {
            $found[] = $p;
          }
          $walk($p, $depth - 1);
        }
      }
    };
    $walk($host, 6);
    $cache[$host->id()] = $found;
  }
  return $cache[$host->id()];
}

/**
 * The listing kinds a section page shows site-wide, keyed by URL word.
 *
 * TRUE for each kind whose placed View Display paragraph is in the
 * "Preview, all topics" mode. The section strip and the automated listing
 * route both defer to this: the strip counts and links site-wide, the route
 * hands over to the site-wide page.
 *
 * @return array<string, true>
 */
function _customsolent_sitewide_listing_kinds($node): array {
  $kinds = [];
  foreach (_customsolent_topic_listing_paragraphs($node) as $paragraph) {
    if (_customsolent_listing_mode($paragraph) === 'preview_all') {
      $word = _customsolent_topic_listing_types()[$paragraph->get('field_view')->target_id] ?? NULL;
      if ($word) {
        $kinds[$word] = TRUE;
      }
    }
  }
  return $kinds;
}

/**
 * The heading paragraph immediately before $paragraph in its parent, if any.
 */
function _customsolent_preceding_heading_paragraph($paragraph) {
  $parent = $paragraph->getParentEntity();
  $field_name = $paragraph->get('parent_field_name')->value;
  if (!$parent || !$field_name || !$parent->hasField($field_name)) {
    return NULL;
  }
  $previous = NULL;
  foreach ($parent->get($field_name)->referencedEntities() as $sibling) {
    if ((int) $sibling->id() === (int) $paragraph->id()) {
      return ($previous && $previous->bundle() === 'heading') ? $previous : NULL;
    }
    $previous = $sibling;
  }
  return NULL;
}

/**
 * Preview / full-listing variables for paragraph--view-display.html.twig.
 *
 * Preview mode (section pages):
 *  - Renders the view's view_display_preview display: compact cards, no
 *    pager. That display fetches 9 rows; a 9th means there is more than the
 *    8 shown, which is what switches the "View more" link on.
 *  - Organisations and links are one combined list (view directory_listing).
 *    Where a page has both an organisations block and a links block, the
 *    first renders the combined preview and the later one renders nothing.
 *  - The block owns its heading: the editor's own field_heading, else the
 *    text of the heading paragraph just before it (which then does not
 *    render itself — see customsolent_preprocess_paragraph__heading). That
 *    is what lets "View more" sit on the heading's line without editing 74
 *    pages, and it means an empty block takes its heading away with it.
 *  - "View more" goes to {this page's path}/{events|organisations}, the
 *    automated listing page served by customsolent_helpers.
 *
 * Full mode swaps organisations/links to the combined view only on the
 * automated listing page; a page an editor has marked "Full listing" keeps
 * exactly the view they chose.
 */
function _customsolent_preprocess_listing_mode(array &$variables, $paragraph, $host, array $context, $active_filter_tid): void {
  $mode = _customsolent_listing_mode($paragraph, $variables['view_mode'] ?? 'default');
  $variables['listing_mode'] = $mode;
  if ($mode === 'plain') {
    return;
  }

  // Cache metadata that must bubble from EVERY branch below — including the
  // ones that render nothing. A block that is empty today must reappear
  // when an event is added (node_list tags), and must not be cached as
  // "empty" for a different ?topic= (contexts). The template prints this
  // in all branches; it renders as nothing.
  $view_name = $paragraph->get('field_view')->target_id;
  $type_word = _customsolent_topic_listing_types()[$view_name];
  $kind = _customsolent_listing_kinds()[$type_word];
  $is_directory = ($type_word === 'organisations');
  $variables['listing_cache'] = [
    '#cache' => [
      'contexts' => ['url.query_args:topic', 'url.query_args:date_filter_id'],
      'tags' => $kind['tags'],
    ],
  ];
  $is_listing_page = (($variables['view_mode'] ?? '') === 'listing_page');

  // Cards need their grid wherever they appear — no classy style to remember.
  $variables['listing_grid_class'] = NULL;
  if ($is_directory) {
    $variables['listing_grid_class'] = 'slnt-directory-compact-grid';
  }

  if ($mode === 'full') {
    // Full listings are card grids: events swap to view_display_listing_cards
    // (the front-page event card, date pills, one pager); the articles
    // by-topic display is already the card grid.
    if (!$is_directory) {
      [$variables['view_name'], $variables['display_id']] = $kind['full'];
      $variables['listing_grid_class'] = $kind['full_grid'];
    }
    if ($is_listing_page) {
      if ($is_directory) {
        $variables['view_name'] = 'directory_listing';
        $variables['display_id'] = 'view_display_primary_and_related';
      }
      // The listing page has no section_filter paragraph, so the listing
      // carries the topic filter itself; and the page supplies the h1.
      if (!empty($context['filter_options'])) {
        _customsolent_apply_filter_options_to_variables($variables, $context, $active_filter_tid);
      }
      $variables['listing_hide_heading'] = TRUE;
    }
    return;
  }

  // ── Preview ──
  $variables['filter_has_options'] = FALSE;
  $variables['listing_suppressed'] = FALSE;

  if ($is_directory) {
    foreach (_customsolent_topic_listing_paragraphs($host) as $other) {
      if ((int) $other->id() === (int) $paragraph->id()) {
        break;
      }
      if (_customsolent_topic_listing_types()[$other->get('field_view')->target_id] === 'organisations'
        && _customsolent_listing_owns_heading(_customsolent_listing_mode($other))) {
        // An earlier block on this page already shows the combined list.
        $variables['listing_suppressed'] = TRUE;
        return;
      }
    }
  }

  // ── Signpost: a count and a link, no cards ──
  if ($mode === 'signpost') {
    $scope = $variables['primary_topic_tid'] ?? '';
    $scope_tids = array_values(array_filter(array_map('intval', explode('+', (string) $scope))));
    $stats = _customsolent_topic_scope_stats($scope_tids);
    if ($stats['directory'] === 0) {
      $variables['listing_suppressed'] = TRUE;
      return;
    }
    $variables['listing_grid_class'] = NULL;
    $variables['signpost'] = [
      'heading' => t('Organisations & links'),
      'organisations' => $stats['organisation'],
      'links' => $stats['link'],
      'total' => $stats['directory'],
      'topic' => ($context['mode'] ?? '') === 'term' && !empty($context['term'])
        ? _customsolent_strip_term_prefix($context['term']->getName()) : NULL,
      'url' => NULL,
      'children' => [],
    ];
    if ($host && $host->getEntityTypeId() === 'node') {
      $base = rtrim($host->toUrl()->toString(), '/') . '/organisations';
      $variables['signpost']['url'] = $base . ($active_filter_tid ? '?topic=' . (int) $active_filter_tid : '');
      // "Browse by": sub-topics that actually hold something. Only where
      // the page has no section filter doing that job already.
      if (!_customsolent_section_filter_exists_on_host($host) && ($context['mode'] ?? '') === 'term' && !empty($context['term'])) {
        foreach (_customsolent_load_topic_children_sorted($context['term']->id()) as $child) {
          $nids = [];
          foreach (_customsolent_get_term_with_descendants($child->id()) as $tid) {
            $nids += $stats['directory_tids'][$tid] ?? [];
          }
          if ($nids) {
            $variables['signpost']['children'][] = [
              'label' => _customsolent_strip_term_prefix($child->getName()),
              'url' => $base . '?topic=' . (int) $child->id(),
              'count' => count($nids),
            ];
          }
        }
      }
    }
    return;
  }

  $preview_view = $is_directory ? 'directory_listing' : $view_name;
  $tids = $variables['primary_topic_tid'] ?? '';
  $build = NULL;
  $has_more = FALSE;
  $view = \Drupal\views\Views::getView($preview_view);
  if ($view && $tids !== '' && $view->access('view_display_preview')) {
    $view->setDisplay('view_display_preview');
    $view->setArguments([$tids, $tids]);
    $view->preExecute();
    $view->execute();
    if (count($view->result) > 8) {
      $has_more = TRUE;
      $view->result = array_slice($view->result, 0, 8);
    }
    if ($view->result) {
      $build = $view->render();
      $build['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($build['#cache']['tags'] ?? [], $kind['tags']);
    }
  }
  if (!$build && !$active_filter_tid) {
    // Nothing to show: no heading, no block.
    $variables['listing_suppressed'] = TRUE;
    return;
  }
  if (!$build) {
    // The visitor has chosen a topic filter and this block has no matches.
    // Keep the block and say so — a heading that silently disappears
    // right after a click looks like a fault.
    $build = [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#attributes' => ['class' => ['slnt-view-empty']],
      '#value' => t('Nothing here matches the current filter.'),
    ];
  }
  $variables['preview_build'] = $build;
  $variables['listing_grid_class'] = $kind['grid'];

  // Heading.
  $heading = '';
  if (!$paragraph->get('field_heading')->isEmpty()) {
    $heading = trim((string) $paragraph->get('field_heading')->value);
  }
  elseif ($sibling = _customsolent_preceding_heading_paragraph($paragraph)) {
    $heading = trim(preg_replace('/\s+/', ' ', (string) $sibling->get('field_heading')->value));
  }
  if ($is_directory && in_array(mb_strtolower($heading), ['organisations', 'links'], TRUE)) {
    $heading = '';
  }
  if ($heading === '') {
    $heading = (string) $kind['label'];
  }
  $variables['preview_heading'] = $heading;
  // "View more Events" rather than a bare "View more": several can share a
  // page, and the label should say what there is more of.
  $variables['more_label'] = t('View more @kind', ['@kind' => $kind['label']]);

  // View more.
  $variables['more_url'] = NULL;
  if ($mode === 'preview_all') {
    // Always linked, even with eight or fewer cards: the destination is a
    // richer page (filter, pager) rather than merely "the rest of them", so
    // the link earns its place whatever the count.
    $variables['more_url'] = _customsolent_sitewide_listing_url($type_word);
  }
  elseif ($has_more && $host && $host->getEntityTypeId() === 'node') {
    $base = rtrim($host->toUrl()->toString(), '/');
    $query = $active_filter_tid ? '?topic=' . (int) $active_filter_tid : '';
    $variables['more_url'] = $base . '/' . $type_word . $query;
  }
}

/**
 * The site-wide listing page for a content type, as used by the
 * "Preview, all topics" listing mode.
 *
 * The map itself lives in customsolent_helpers_sitewide_listing_url(), in
 * the module, because the listing route controller needs it too and a
 * controller cannot rely on the theme being loaded.
 */
function _customsolent_sitewide_listing_url(string $type_word): ?string {
  return customsolent_helpers_sitewide_listing_url($type_word);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--heading.html.twig.
 *
 * A heading paragraph that sits directly above a listing in Preview mode
 * hands its text to that listing, which renders heading + "View more" as
 * one row (and drops both when the listing is empty). So it must not also
 * render itself.
 */
function customsolent_preprocess_paragraph__heading(&$variables) {
  $paragraph = $variables['paragraph'];
  $variables['heading_handed_over'] = FALSE;
  $parent = $paragraph->getParentEntity();
  $field_name = $paragraph->get('parent_field_name')->value;
  if (!$parent || !$field_name || !$parent->hasField($field_name)) {
    return;
  }
  $take_next = FALSE;
  $variables['heading_url'] = NULL;
  foreach ($parent->get($field_name)->referencedEntities() as $sibling) {
    if ($take_next) {
      if (_customsolent_listing_owns_heading(_customsolent_listing_mode($sibling)) && $sibling->get('field_heading')->isEmpty()) {
        $variables['heading_handed_over'] = TRUE;
      }
      // A heading directly followed by a Link paragraph ("View more …")
      // is itself a link to the same place — the section heading and its
      // View more go together (Section Heading Row). No field needed: the
      // editor builds the pair, the heading follows the link.
      if ($sibling->bundle() === 'link' && !$sibling->get('field_link')->isEmpty()) {
        try {
          $variables['heading_url'] = $sibling->get('field_link')->first()->getUrl()->toString();
        }
        catch (\Throwable) {
          // Malformed link: leave the heading plain.
        }
      }
      // Re-render this heading when the listing below it is edited.
      $variables['content']['field_heading']['#cache']['tags'][] = 'paragraph:' . $sibling->id();
      return;
    }
    if ((int) $sibling->id() === (int) $paragraph->id()) {
      $take_next = TRUE;
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--section-filter.html.twig.
 *
 * Mirrors the topic-resolution logic in customsolent_preprocess_paragraph__view_display
 * but exposes only the filter sidebar / mobile bar data — there is no
 * embedded View. The paragraph is intended to sit once on a page above
 * the View Display paragraphs it filters.
 */
function customsolent_preprocess_paragraph__section_filter(&$variables) {
  $paragraph = $variables['paragraph'];

  $host = $paragraph->getParentEntity();
  while ($host && $host->getEntityTypeId() === 'paragraph') {
    $host = $host->getParentEntity();
  }

  // field_show_subterms (boolean) controls whether each top-level
  // option in the filter sidebar reveals its immediate sub-topics
  // inline when the active filter lies within that branch.
  $with_children = FALSE;
  if ($paragraph->hasField('field_show_subterms')
    && !$paragraph->get('field_show_subterms')->isEmpty()) {
    $with_children = (bool) $paragraph->get('field_show_subterms')->value;
  }

  $context = _customsolent_resolve_topic_context($paragraph, $host, $with_children);

  $active_filter_tid = NULL;
  $query_topic = \Drupal::request()->query->get('topic');
  if ($query_topic !== NULL && is_numeric($query_topic) && (int) $query_topic > 0) {
    $candidate_tid = (int) $query_topic;
    if (in_array($candidate_tid, $context['scope_ids'], TRUE)) {
      $active_filter_tid = $candidate_tid;
    }
  }

  $variables['section_key']   = $context['section_key'];
  $variables['section_color'] = $context['section_color'];
  $variables['has_children']  = $with_children;
  _customsolent_apply_filter_options_to_variables($variables, $context, $active_filter_tid);
}

/**
 * Resolve a paragraph's topic context (the term to filter on, plus the
 * sidebar filter options) by checking field_topic on the paragraph, then
 * field_primary_topic on the host node, then falling back to all content
 * topics. Returns scope_ids (the term + descendants, or all content
 * topics + descendants) for the View contextual argument.
 */
function _customsolent_resolve_topic_context($paragraph, $host, $with_children = FALSE) {
  // Priority 1: field_topic on the paragraph itself. An explicit
  // editor choice — use it unconditionally, even if its top-level
  // parent is Explore/About. This lets editors use Explore children
  // (e.g. "Explore / Data", "Explore / Opinion") as real content tags
  // for /explore/data, /explore/opinion etc.
  if ($paragraph->hasField('field_topic') && !$paragraph->get('field_topic')->isEmpty()) {
    $term = $paragraph->get('field_topic')->entity;
    if ($term) {
      return _customsolent_topic_context_for_term($term, $with_children);
    }
  }

  // Priority 2: host node's field_primary_topic. The Explore/About
  // guard still applies here — pages under those roots are typically
  // structural landings (e.g. /explore/events aggregates all events
  // across Culture/Sectors/Living), so we fall back to all-topics.
  // Editors who want term-scoped behaviour on an Explore landing
  // override via field_topic on the paragraph (handled above).
  if ($host && $host->getEntityTypeId() === 'node'
    && $host->hasField('field_primary_topic')
    && !$host->get('field_primary_topic')->isEmpty()) {
    $term = $host->get('field_primary_topic')->entity;
    if ($term) {
      $top = _customsolent_topic_top_level($term);
      $top_name = $top ? $top->getName() : '';
      if ($top && !in_array($top_name, ['Explore', 'About'], TRUE)) {
        return _customsolent_topic_context_for_term($term, $with_children);
      }
    }
  }

  return _customsolent_topic_context_all($with_children);
}

/**
 * Build a topic context for a specific term — scope is the term and its
 * descendants; filter options are the term's direct children. When
 * $with_children is TRUE, each child option also carries its own
 * grandchildren list (one level deeper) for the auto-expand pattern.
 */
function _customsolent_topic_context_for_term($term, $with_children = FALSE) {
  $scope_ids = _customsolent_get_term_with_descendants($term->id());
  $children = _customsolent_load_topic_children_sorted($term->id());
  $filter_options = [];
  foreach ($children as $child) {
    $option = _customsolent_build_filter_option($child, $with_children);
    $filter_options[] = $option;
  }
  $top = _customsolent_topic_top_level($term);
  $top_name = $top ? $top->getName() : '';
  return [
    'mode'           => 'term',
    'term'           => $term,
    'scope_ids'      => $scope_ids,
    'filter_options' => $filter_options,
    'section_key'    => $top_name !== '' ? strtolower($top_name) : NULL,
    'section_color'  => _customsolent_topic_section_colors()[$top_name] ?? NULL,
  ];
}

/**
 * Build one filter option for a term, optionally including its
 * immediate sub-topics (one level only) and the term-plus-descendants
 * scope so the template can determine "branch active" state.
 */
function _customsolent_build_filter_option($term, $with_children = FALSE) {
  $tid = (int) $term->id();
  $option = [
    'tid'   => $tid,
    'label' => _customsolent_strip_term_prefix($term->getName()),
    'url'   => _customsolent_build_filter_url(['topic' => $tid]),
  ];
  if ($with_children) {
    $option['scope_tids'] = _customsolent_get_term_with_descendants($tid);
    $option['children'] = _customsolent_build_filter_option_children($term);
  }
  return $option;
}

/**
 * Build the children list for an expanded filter option. The first entry
 * is "All in <Section>" pointing at the parent term itself, so users
 * can stay scoped to the parent without picking a leaf. The rest are
 * the parent term's direct children, alphabetical-by-weight as
 * _customsolent_load_topic_children_sorted defines.
 */
function _customsolent_build_filter_option_children($parent_term) {
  $parent_tid = (int) $parent_term->id();
  $parent_label = _customsolent_strip_term_prefix($parent_term->getName());

  $children = [];
  $children[] = [
    'tid'    => $parent_tid,
    'label'  => 'All in ' . $parent_label,
    'url'    => _customsolent_build_filter_url(['topic' => $parent_tid]),
    'is_all' => TRUE,
  ];
  foreach (_customsolent_load_topic_children_sorted($parent_tid) as $child) {
    $child_tid = (int) $child->id();
    $children[] = [
      'tid'   => $child_tid,
      'label' => _customsolent_strip_term_prefix($child->getName()),
      'url'   => _customsolent_build_filter_url(['topic' => $child_tid]),
    ];
  }
  return $children;
}

/**
 * Build the all-topics fallback context — scope is Culture + Sectors +
 * Living and their descendants; filter options are those three roots.
 *
 * Avoids needing an "All" parent term in the taxonomy (which would break
 * breadcrumbs, URL aliases, and menu-state detection).
 */
function _customsolent_topic_context_all($with_children = FALSE) {
  $root_names = ['Culture', 'Sectors', 'Living'];
  $scope_ids = [];
  $filter_options = [];

  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $roots = $term_storage->loadByProperties(['vid' => 'topic', 'parent' => 0]);
  $by_name = [];
  foreach ($roots as $root) {
    $by_name[$root->getName()] = $root;
  }
  foreach ($root_names as $root_name) {
    if (!isset($by_name[$root_name])) {
      continue;
    }
    $root = $by_name[$root_name];
    $scope_ids = array_merge($scope_ids, _customsolent_get_term_with_descendants($root->id()));
    $filter_options[] = _customsolent_build_filter_option($root, $with_children);
  }

  return [
    'mode'           => 'all',
    'term'           => NULL,
    'scope_ids'      => $scope_ids,
    'filter_options' => $filter_options,
    'section_key'    => 'explore',
    'section_color'  => _customsolent_topic_section_colors()['Explore'] ?? NULL,
  ];
}

/**
 * Decorate $variables with the filter sidebar / mobile bar fields,
 * marking the option matching $active_filter_tid as active and computing
 * the All link + currently-selected label.
 */
function _customsolent_apply_filter_options_to_variables(array &$variables, array $context, $active_filter_tid) {
  $filter_options = $context['filter_options'];
  foreach ($filter_options as &$option) {
    $option_tid = (int) $option['tid'];
    $option['active'] = ($option_tid === (int) $active_filter_tid);

    // branch_active: TRUE when the active filter is this option's
    // term OR any of its descendants. Drives the auto-expand —
    // a branch reveals its children when the user has selected
    // anywhere inside it.
    if (isset($option['scope_tids']) && is_array($option['scope_tids'])) {
      $option['branch_active'] = $active_filter_tid !== NULL
        && in_array((int) $active_filter_tid, $option['scope_tids'], TRUE);
    }
    else {
      $option['branch_active'] = $option['active'];
    }

    // Mark child active state. The "All in <Section>" child carries
    // is_all = TRUE and points at the parent term, so it activates
    // when the parent term itself is the selected filter.
    if (!empty($option['children']) && is_array($option['children'])) {
      foreach ($option['children'] as &$child) {
        $child['active'] = ((int) $child['tid'] === (int) $active_filter_tid);
      }
      unset($child);
    }
  }
  unset($option);

  $variables['filter_options']     = $filter_options;
  $variables['filter_has_options'] = !empty($filter_options);
  // "All" link clears the topic param but preserves the rest (date,
  // future filters) so the user's other selections survive.
  $variables['filter_all_url']     = _customsolent_build_filter_url(['topic' => NULL]);
  $variables['filter_all_active']  = ($active_filter_tid === NULL);

  $variables['filter_active_label'] = NULL;
  if ($active_filter_tid !== NULL) {
    /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $active = $term_storage->load((int) $active_filter_tid);
    if ($active) {
      $variables['filter_active_label'] = _customsolent_strip_term_prefix($active->getName());
    }
  }
}

/**
 * Build a URL that preserves the current request's query string while
 * setting or clearing specific parameters.
 *
 * @param array $params_to_set
 *   Keyed by query param name. A NULL value clears the param; any
 *   other value sets it. Other current query params are preserved
 *   verbatim so filters compose cleanly (e.g. topic + date_filter_id).
 *
 * @return string
 *   The current request path plus the merged query string. If the
 *   merged query is empty, just the path is returned.
 */
function _customsolent_build_filter_url(array $params_to_set) {
  $request = \Drupal::request();
  $query = $request->query->all();
  foreach ($params_to_set as $k => $v) {
    if ($v === NULL) {
      unset($query[$k]);
    }
    else {
      $query[$k] = $v;
    }
  }
  // Changing a filter always resets to the first page of results —
  // otherwise the user, paginated to page 3 of "all", would click a
  // filter and land on page 3 of the filtered (probably empty) set,
  // looking like the filter had no matches.
  unset($query['page']);
  $path = $request->getPathInfo();
  return $path . (empty($query) ? '' : '?' . http_build_query($query));
}

/**
 * Implements hook_preprocess_pager().
 *
 * Drupal's pager builds hrefs as `?page=N` only — it doesn't preserve
 * other query string params from the current request, so clicking
 * page 2 from /sectors?topic=88 navigates to /sectors?page=1 and the
 * topic filter is dropped.
 *
 * Merge the current request's query into every pager item's href so
 * pagination keeps the active filter context (topic, date_filter_id,
 * etc.) across page navigations.
 */
function customsolent_preprocess_pager(array &$variables) {
  $current = \Drupal::request()->query->all();
  // 'page' is owned by the pager itself; don't let our merge clobber it.
  unset($current['page']);
  if (empty($current)) {
    return;
  }

  $merge_into_href = function (string $href) use ($current): string {
    $parts = parse_url($href);
    $existing = [];
    if (!empty($parts['query'])) {
      parse_str($parts['query'], $existing);
    }
    // Existing pager-set params (notably 'page') take priority over
    // the current request's query — page=N from the link is what we
    // want to navigate to.
    $merged = $current + $existing;
    $path = $parts['path'] ?? '';
    return $path . (empty($merged) ? '' : '?' . http_build_query($merged));
  };

  foreach (['first', 'previous', 'next', 'last'] as $key) {
    if (isset($variables['items'][$key]['href'])) {
      $variables['items'][$key]['href'] = $merge_into_href($variables['items'][$key]['href']);
    }
  }
  if (!empty($variables['items']['pages']) && is_array($variables['items']['pages'])) {
    foreach ($variables['items']['pages'] as &$item) {
      if (isset($item['href'])) {
        $item['href'] = $merge_into_href($item['href']);
      }
    }
    unset($item);
  }
}

/**
 * TRUE when the host node has a section_filter paragraph anywhere in
 * its paragraph reference fields, including paragraphs nested inside
 * other paragraphs (e.g. a section_filter inside an enclosure). Used
 * by the View Display paragraph to suppress its own filter sidebar
 * when a dedicated filter paragraph is on the same page.
 */
function _customsolent_section_filter_exists_on_host($host) {
  return (bool) _customsolent_find_section_filter_on_host($host);
}

/**
 * Return the first section_filter paragraph attached anywhere on the
 * host node's paragraph reference fields (recursively, up to 4 levels
 * deep — see _customsolent_entity_contains_paragraph_bundle). Returns
 * NULL if none. Result is statically cached per host node.
 *
 * The section_filter is the canonical "topic anchor" for a page when
 * present; sibling View Display paragraphs defer to its resolved
 * topic scope when they don't carry their own field_topic.
 */
function _customsolent_find_section_filter_on_host($host) {
  $cache = &drupal_static(__FUNCTION__, []);
  if (!$host || $host->getEntityTypeId() !== 'node') {
    return NULL;
  }
  $key = $host->getEntityTypeId() . ':' . $host->id();
  if (array_key_exists($key, $cache)) {
    return $cache[$key];
  }
  $cache[$key] = _customsolent_find_paragraph_bundle_on_entity($host, 'section_filter', 4);
  return $cache[$key];
}

/**
 * Recursively walk an entity's paragraph reference fields and return
 * the first paragraph entity of the given bundle. Capped at $max_depth.
 */
function _customsolent_find_paragraph_bundle_on_entity($entity, $bundle, $max_depth) {
  if (!$entity || $max_depth <= 0) {
    return NULL;
  }
  foreach ($entity->getFields() as $field) {
    if ($field->isEmpty()) {
      continue;
    }
    $field_def = $field->getFieldDefinition();
    if ($field_def->getType() !== 'entity_reference_revisions') {
      continue;
    }
    if ($field_def->getSetting('target_type') !== 'paragraph') {
      continue;
    }
    foreach ($field as $item) {
      $p = $item->entity;
      if (!$p) {
        continue;
      }
      if ($p->bundle() === $bundle) {
        return $p;
      }
      $nested = _customsolent_find_paragraph_bundle_on_entity($p, $bundle, $max_depth - 1);
      if ($nested) {
        return $nested;
      }
    }
  }
  return NULL;
}

/**
 * Recursively walk an entity's paragraph reference fields looking for a
 * paragraph with the given bundle. Capped at $max_depth to avoid
 * runaway recursion if paragraphs ever form a cycle.
 */
function _customsolent_entity_contains_paragraph_bundle($entity, $bundle, $max_depth) {
  if (!$entity || $max_depth <= 0) {
    return FALSE;
  }
  foreach ($entity->getFields() as $field) {
    if ($field->isEmpty()) {
      continue;
    }
    $field_def = $field->getFieldDefinition();
    if ($field_def->getType() !== 'entity_reference_revisions') {
      continue;
    }
    if ($field_def->getSetting('target_type') !== 'paragraph') {
      continue;
    }
    foreach ($field as $item) {
      $p = $item->entity;
      if (!$p) {
        continue;
      }
      if ($p->bundle() === $bundle) {
        return TRUE;
      }
      if (_customsolent_entity_contains_paragraph_bundle($p, $bundle, $max_depth - 1)) {
        return TRUE;
      }
    }
  }
  return FALSE;
}

// customsolent_paragraph_view_alter() used to be here. Entity view-alter
// hooks are only invoked on modules, so it never ran in a theme. It now
// lives in customsolent_helpers.module as
// customsolent_helpers_paragraph_view_alter().

/**
 * Get a term ID and all its descendant term IDs.
 */
function _customsolent_get_term_with_descendants($tid) {
  $ids = [(int) $tid];
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tree = $term_storage->loadTree('topic', $tid, NULL, FALSE);
  foreach ($tree as $child) {
    $ids[] = (int) $child->tid;
  }
  return $ids;
}

/**
 * TRUE if $term equals $ancestor or is anywhere beneath it in the tree.
 */
function _customsolent_term_is_descendant_of($term, $ancestor) {
  if ((int) $term->id() === (int) $ancestor->id()) {
    return TRUE;
  }
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tree = $term_storage->loadTree($ancestor->bundle(), $ancestor->id(), NULL, FALSE);
  foreach ($tree as $row) {
    if ((int) $row->tid === (int) $term->id()) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Direct children of a Topic term, sorted by weight then by stripped name.
 *
 * Returns Term entities (not the loadTree row stdClass), so callers can
 * call ->getName() / ->id() directly.
 */
function _customsolent_load_topic_children_sorted($tid) {
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $children = $term_storage->loadChildren($tid);
  usort($children, function ($a, $b) {
    $wa = (int) $a->getWeight();
    $wb = (int) $b->getWeight();
    if ($wa !== $wb) {
      return $wa <=> $wb;
    }
    return strcasecmp(
      _customsolent_strip_term_prefix($a->getName()),
      _customsolent_strip_term_prefix($b->getName())
    );
  });
  return $children;
}

/**
 * Walk up to the top-level (root) Topic term for a given term.
 */
function _customsolent_topic_top_level($term) {
  $current = $term;
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  while ($current) {
    $parents = $term_storage->loadParents($current->id());
    if (empty($parents)) {
      return $current;
    }
    $current = reset($parents);
  }
  return NULL;
}

/**
 * Section colour hex for a term — uses the term's top-level (root)
 * parent to look up the section colour map. Returns slate (#475569)
 * when the top-level isn't one of the known content/structural roots.
 */
function _customsolent_get_section_color($term) {
  $top = _customsolent_topic_top_level($term);
  if (!$top) {
    return '#475569';
  }
  return _customsolent_topic_section_colors()[$top->getName()] ?? '#475569';
}

/**
 * Depth of a term in the Topic hierarchy. Root terms (Culture, Sectors,
 * Living, About, Explore) return 0; their direct children return 1; and
 * so on. Used by the "in" kicker to know how many ancestors to strip
 * so the kicker doesn't repeat what the current page already represents.
 */
function _customsolent_get_term_depth($term) {
  $depth = 0;
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $current = $term;
  while ($current) {
    $parents = $term_storage->loadParents($current->id());
    if (empty($parents)) {
      break;
    }
    $depth++;
    $current = reset($parents);
  }
  return $depth;
}

/**
 * TRUE when a published composite_page node exists with the given term
 * id as its field_primary_topic. Used by the "in"/"from" kickers to
 * conditionally link terms to their landing pages (links when a page
 * exists, plain text otherwise — graceful degradation as the editor
 * builds out the section tree).
 *
 * Statically cached per tid within the request — a listing page with
 * many items sharing the same sub-term only hits the DB once per
 * unique term.
 */
function _customsolent_term_has_landing_page($tid) {
  $cache = &drupal_static(__FUNCTION__, []);
  $tid = (int) $tid;
  if (array_key_exists($tid, $cache)) {
    return $cache[$tid];
  }
  $query = \Drupal::entityQuery('node')
    ->condition('type', 'composite_page')
    ->condition('field_primary_topic', $tid)
    ->condition('status', 1)
    ->range(0, 1)
    ->accessCheck(TRUE);
  $results = $query->execute();
  $cache[$tid] = !empty($results);
  return $cache[$tid];
}

/**
 * Build the "in" kicker display chain for a content item appearing on
 * a section page. Strips ancestors already represented by the page
 * (so on /culture, "Culture / Music" shows as "MUSIC" not
 * "CULTURE / MUSIC"; on /culture/music it shows nothing because it
 * matches the page exactly).
 *
 * @param \Drupal\taxonomy\TermInterface $content_term
 *   The content's primary topic term.
 * @param int $page_term_depth
 *   Depth of the page's resolved term. 0 = root (Culture / Sectors /
 *   Living), 1 = direct child, etc. -1 = no specific section (e.g.
 *   /explore/events all-topics fallback) — show the full chain.
 *
 * @return array|null
 *   Array of {label, url, color} for each remaining term, or NULL when
 *   the content's term matches the page exactly (nothing to display).
 */
function _customsolent_build_in_kicker($content_term, $page_term_depth) {
  $chain = [];
  $current = $content_term;
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  while ($current) {
    array_unshift($chain, $current);
    $parents = $term_storage->loadParents($current->id());
    $current = !empty($parents) ? reset($parents) : NULL;
  }

  // page_term_depth = -1 means show full chain (no stripping).
  $display_from = $page_term_depth + 1;
  if ($display_from >= count($chain)) {
    return NULL;
  }

  $color = _customsolent_get_section_color($content_term);
  $items = [];
  for ($i = $display_from; $i < count($chain); $i++) {
    $term = $chain[$i];
    $items[] = [
      'label' => _customsolent_strip_term_prefix($term->getName()),
      'url'   => _customsolent_term_has_landing_page($term->id())
        ? _customsolent_build_term_url($chain, $i)
        : NULL,
      'color' => $color,
    ];
  }
  return $items;
}

/**
 * Build the "from" kicker ancestor chain for a content item appearing
 * on a page via field_related_topics (its primary topic is outside the
 * current page's tree). Returns the FULL chain from root to leaf with
 * each term conditionally linked.
 *
 * Example: a node with primary topic "Sectors / Arts" produces
 *   [ {label: SECTORS, url: /sectors, ...}, {label: ARTS, url: /sectors/arts, ...} ]
 */
function _customsolent_build_from_kicker($term) {
  $chain = [];
  $current = $term;
  /** @var \Drupal\taxonomy\TermStorageInterface $term_storage */
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  while ($current) {
    array_unshift($chain, $current);
    $parents = $term_storage->loadParents($current->id());
    $current = !empty($parents) ? reset($parents) : NULL;
  }
  $color = _customsolent_get_section_color($term);
  $items = [];
  foreach ($chain as $i => $node) {
    $items[] = [
      'label' => _customsolent_strip_term_prefix($node->getName()),
      'url'   => _customsolent_term_has_landing_page($node->id())
        ? _customsolent_build_term_url($chain, $i)
        : NULL,
      'color' => $color,
    ];
  }
  return $items;
}
/**
 * Implements hook_preprocess_item_list__search_results().
 *
 * Visiting /search/node with no keywords showed "Your search yielded no
 * results." — misleading when the visitor hasn't searched yet. Swap in an
 * invitation to search instead. A genuine empty result set (keys present)
 * keeps the core message.
 */
function customsolent_preprocess_item_list__search_results(array &$variables) {
  $keys = trim((string) \Drupal::request()->query->get('keys', ''));
  if ($keys === '' && !empty($variables['empty'])) {
    $variables['empty'] = [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#attributes' => ['class' => ['search-empty-prompt']],
      '#value' => t('Please enter search terms above to search the site.'),
    ];
  }
}
