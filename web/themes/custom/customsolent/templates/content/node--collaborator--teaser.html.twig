{#
/**
 * @file
 * Collaborator — teaser: one row in a Collaboration's "Who" list.
 *
 * A collaborator is an organisation or a person plus how they take part.
 * The row links to THEIR page (the collaborator node itself redirects
 * there via Rabbit Hole), shows the role terms as small tags, and the
 * description.
 *
 * Variables from _customsolent_preprocess_collaborator_extras():
 *   who_label, who_url, who_kind ('organisation' | 'person'),
 *   who_types (list of strings), who_chip (render array: the Person chip
 *   when the collaborator is a person).
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'slnt-collaborator',
    who_kind ? 'slnt-collaborator--' ~ who_kind,
  ]
%}

<div{{ attributes.addClass(classes) }}>
  <div class="slnt-collaborator__head">
    {% if who_chip %}
      {{ who_chip }}
    {% elseif who_label %}
      <a href="{{ who_url }}" class="slnt-collaborator__who">{{ who_label }}</a>
    {% else %}
      <span class="slnt-collaborator__who">{{ label }}</span>
    {% endif %}

    {% if who_types is not empty %}
      <ul class="slnt-collaborator__types" aria-label="{{ 'Role'|t }}">
        {% for type in who_types %}
          <li class="slnt-collaborator__type">{{ type }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

  {% if content.field_description|render|striptags|trim %}
    <div class="slnt-collaborator__description">{{ content.field_description }}</div>
  {% endif %}
</div>

{{ content|without('field_collaborator', 'field_collaborator_type', 'field_description', 'links') }}
