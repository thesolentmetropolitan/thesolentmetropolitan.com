{#
/**
 * @file
 * Theme override for the "View Display" paragraph type.
 *
 * Renders the embedded View (selected by the editor via field_view, a
 * viewsreference field) with the page's primary topic + descendants
 * passed as the contextual filter argument.
 *
 * For displays with id "view_display_primary_topic" we also render a
 * topic filter — desktop sidebar + mobile sticky bar / slide-up panel.
 * Children of the page's primary topic are the filter options. The
 * "Related" display does not get a filter.
 *
 * Variables provided by customsolent_preprocess_paragraph__view_display:
 * - primary_topic_tid:    "+"-joined term IDs (or unset if no topic).
 * - section_key:          lowercased top-level Topic name (e.g. "culture").
 * - section_color:        hex colour for the top-level section.
 * - filter_has_options:   TRUE on primary-topic display when the page
 *                         term has children.
 * - filter_options:       array of {tid, label, url, active}.
 * - filter_all_url:       URL of the page with no ?topic= param.
 * - filter_all_active:    TRUE when no topic is currently selected.
 * - filter_active_label:  label of the active child term, or NULL.
 */
#}
{% macro topic_list(filter_options, filter_all_url, filter_all_active) %}
  <div class="slnt-filter-section">
    <a href="{{ filter_all_url }}" class="slnt-filter-item{{ filter_all_active ? ' is-active' : '' }}">All Topics</a>
    {% for option in filter_options %}
      <a href="{{ option.url }}" class="slnt-filter-item{{ option.active ? ' is-active' : '' }}">{{ option.label }}</a>
    {% endfor %}
  </div>
{% endmacro %}

{% import _self as filter %}

{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
    'slnt-view-display',
    'slnt-section-listing',
    filter_has_options ? 'slnt-section-listing--has-sidebar',
  ]
%}

{% set extra_classes = [] %}
{% if paragraph.hasField('field_classy') %}
  {% for item in paragraph.field_classy %}
    {% if item.entity.classes %}
      {% set extra_classes = extra_classes|merge([item.entity.classes]) %}
    {% endif %}
  {% endfor %}
{% endif %}

{% set wrapper_attributes = attributes.addClass(classes).addClass(extra_classes) %}
{# By-topic listings get their card grid automatically (set in preprocess),
   so a listing added by hand needs no classy style to look right. #}
{% if listing_grid_class %}
  {% set wrapper_attributes = wrapper_attributes.addClass(listing_grid_class|split(' ')) %}
{% endif %}
{% if section_key %}
  {% set wrapper_attributes = wrapper_attributes.setAttribute('data-section', section_key) %}
{% endif %}

{% block paragraph %}
{# Cache contexts/tags for by-topic listings; renders as nothing. #}
{{ listing_cache }}
{% if listing_suppressed %}
  {# Preview mode with nothing to show, or a links block on a page whose
     organisations block already shows the combined list: render nothing. #}
{% elseif listing_mode == 'signpost' %}
  {# ── Signpost: where a grid of organisations used to be. The first eight
     of an A–Z list mean nothing; a count says how much is behind the link.
     A white box in the same family as the front page intro box. ── #}
  <div{{ wrapper_attributes.addClass('slnt-signpost') }}>
    <div class="slnt-signpost__inner">
      <div class="slnt-signpost__text">
        <h2 class="slnt-listing__heading">{{ signpost.heading }}</h2>
        <p class="slnt-signpost__count">
          {%- if signpost.organisations and signpost.links -%}
            <b>{{ signpost.organisations }}</b> {{ signpost.organisations == 1 ? 'organisation'|t : 'organisations'|t }} {{ 'and'|t }} <b>{{ signpost.links }}</b> {{ signpost.links == 1 ? 'link'|t : 'links'|t }}
          {%- elseif signpost.organisations -%}
            <b>{{ signpost.organisations }}</b> {{ signpost.organisations == 1 ? 'organisation'|t : 'organisations'|t }}
          {%- else -%}
            <b>{{ signpost.links }}</b> {{ signpost.links == 1 ? 'link'|t : 'links'|t }}
          {%- endif -%}
          {%- if signpost.topic %} {{ 'for'|t }} {{ signpost.topic }}{% endif %} {{ 'in the Greater Solent.'|t }}
        </p>
        {% if signpost.children %}
          <div class="slnt-signpost__browse">
            <span class="slnt-signpost__browse-label">{{ 'Browse by'|t }}</span>
            {% for child in signpost.children %}
              <a class="slnt-signpost__chip" href="{{ child.url }}">{{ child.label }}<span class="visually-hidden">: {{ child.count }}</span></a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
      {% if signpost.url %}
        <div class="slnt-text-link-outer slnt-signpost__go">
          <a href="{{ signpost.url }}" class="slnt-text-link">
            <span class="slnt-text-link__text">{{ 'Browse all @n'|t({'@n': signpost.total}) }}<span class="visually-hidden"> {{ 'organisations and links'|t }}</span></span>
            <svg class="slnt-text-link__caret slnt-cta__chevron" role="presentation" focusable="false" aria-hidden="true"><use href="#tvip-down-triangle"></use></svg>
          </a>
        </div>
      {% endif %}
    </div>
  </div>
{% elseif listing_mode == 'preview' %}
  {# ── Preview: heading + "View more" on one row, up to 8 cards, and a
     second "View more" under the cards for narrow screens. A media query
     shows one link or the other (css/text-link.css); the hidden one is
     display:none, so assistive tech meets it once. ── #}
  <div{{ wrapper_attributes.addClass('slnt-listing-preview') }}>
    <div class="slnt-listing-preview__head">
      <h2 class="slnt-listing__heading">{{ preview_heading }}</h2>
      {% if more_url %}
        <div class="slnt-text-link-outer slnt-view-more slnt-view-more--wide">
          <a href="{{ more_url }}" class="slnt-text-link">
            <span class="slnt-text-link__text">{{ 'View more'|t }}<span class="visually-hidden">: {{ preview_heading }}</span></span>
            <svg class="slnt-text-link__caret slnt-cta__chevron" role="presentation" focusable="false" aria-hidden="true"><use href="#tvip-down-triangle"></use></svg>
          </a>
        </div>
      {% endif %}
    </div>
    {{ preview_build }}
    {% if more_url %}
      <div class="slnt-text-link-outer slnt-view-more slnt-view-more--narrow">
        <a href="{{ more_url }}" class="slnt-text-link">
          <span class="slnt-text-link__text">{{ 'View more'|t }}<span class="visually-hidden">: {{ preview_heading }}</span></span>
          <svg class="slnt-text-link__caret slnt-cta__chevron" role="presentation" focusable="false" aria-hidden="true"><use href="#tvip-down-triangle"></use></svg>
        </a>
      </div>
    {% endif %}
  </div>
{% else %}
  <div{{ wrapper_attributes }}>
    {% block content %}

      {# Editor-supplied heading for the listing — "Organisations",
         "Related reading", "Events", etc. Renders above sidebar +
         content so it spans the full block width. #}
      {% if not listing_hide_heading and content.field_heading|render|striptags|trim %}
        <h2 class="slnt-listing__heading">{{ content.field_heading }}</h2>
      {% endif %}

      {# Mobile sticky filter bar — shown only when filter options exist. #}
      {% if filter_has_options %}
        <div class="slnt-filter-bar">
          <div class="slnt-filter-bar__status">
            {% if filter_active_label %}
              Topic: <strong>{{ filter_active_label }}</strong>
            {% else %}
              All topics
            {% endif %}
          </div>
          <button type="button" class="slnt-filter-bar__button" data-filter-toggle aria-haspopup="dialog" aria-expanded="false">
            Filter
          </button>
        </div>
      {% endif %}

      <div class="slnt-section-listing__layout">
        {% if filter_has_options %}
          <aside class="slnt-section-listing__sidebar" aria-label="Topic filter">
            {{ filter.topic_list(filter_options, filter_all_url, filter_all_active) }}
          </aside>
        {% endif %}

        <div class="slnt-section-listing__content">
          {# view_name / display_id come from preprocess; fall back to
             reading the field directly so the editor's selection still
             renders if preprocess did not run. #}
          {% set vname = view_name|default(paragraph.field_view.0.target_id) %}
          {% set did = display_id|default(paragraph.field_view.0.display_id) %}
          {% if vname and did and primary_topic_tid is defined and primary_topic_tid %}
            {# Pass primary_topic_tid twice so the view_display_primary_and_related
               display (two contextual filters: field_primary_topic OR'd with
               field_related_topics) gets the same +-joined TID scope on both
               arguments. Single-contextual-filter displays silently ignore the
               extra arg. #}
            {{ drupal_view(vname, did, primary_topic_tid, primary_topic_tid) }}
          {% else %}
            {{ content.field_view }}
          {% endif %}
        </div>
      </div>

      {# Mobile slide-up filter panel — outside the layout flow. #}
      {% if filter_has_options %}
        <div class="slnt-filter-overlay" data-filter-overlay aria-hidden="true"></div>
        <div class="slnt-filter-panel" data-filter-panel role="dialog" aria-modal="true" aria-label="Filter">
          <div class="slnt-filter-panel__handle">
            <span class="slnt-filter-panel__handle-bar"></span>
          </div>
          <div class="slnt-filter-panel__header">
            <span class="slnt-filter-panel__title">Filter</span>
            <a href="{{ filter_all_url }}" class="slnt-filter-panel__clear">Clear</a>
          </div>
          <div class="slnt-filter-panel__body">
            {{ filter.topic_list(filter_options, filter_all_url, filter_all_active) }}
          </div>
        </div>
      {% endif %}

    {% endblock %}
  </div>
{% endif %}
{% endblock paragraph %}
