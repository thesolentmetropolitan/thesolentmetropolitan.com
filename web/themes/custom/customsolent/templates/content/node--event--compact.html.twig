{#
/**
 * @file
 * Theme override for an Event node in the "compact" view mode.
 *
 * Used by the events_listing View "view_display_front_page" display:
 * a small two-per-row card on the front page.
 *
 * Card structure:
 *   .slnt-event-compact-card             — outer wrapper, top border
 *                                          tinted to the section colour
 *     .slnt-topic-trail (kicker)         — outside the clickable link,
 *                                          parent topics linkable
 *     a.slnt-event-compact__link         — clickable area (external or
 *                                          node fallback). External arrow
 *                                          icon shown after the title
 *                                          when field_url is set.
 *       article.slnt-event-compact
 *         h3 (title)
 *         .slnt-event-compact__date      — calendar-dots icon + date
 *         .slnt-event-compact__where     — map-pin icon + venue / area
 *
 * Variables added by customsolent_preprocess_node:
 *   - topic_trail_ancestors      — clickable kicker terms
 *   - section_color, section_key — top-level Topic colour
 *   - field_url_href / field_url_external — extracted from field_url.
 *   - where_name      — plain Location term name.
 *   - location_area   — name of the Location term's parent (e.g. the
 *                       venue's town), or null if the venue has no
 *                       parent term.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'slnt-event-compact',
  ]
%}

{% set event_url = field_url_href ?: path('entity.node.canonical', {'node': node.id}) %}
{% set is_external = field_url_external ?? false %}

<div class="slnt-event-compact-card"
     {% if section_color %}style="border-top-color: {{ section_color }};"{% endif %}
     {% if section_key %}data-section="{{ section_key }}"{% endif %}>

  {# Kicker — outside the clickable link so the parent terms remain
     independently navigable. #}
  {% if topic_trail_ancestors is not empty %}
    {% include '@customsolent/components/topic-trail.html.twig' with {
      ancestors: topic_trail_ancestors,
      current_label: null,
      current_as_heading: false,
    } only %}
  {% endif %}

  <a href="{{ event_url }}"
     class="slnt-event-compact__link"
     {% if is_external %}target="_blank" rel="noopener noreferrer"{% endif %}>
    <article{{ attributes.addClass(classes) }}>

      <h3 class="slnt-event-compact__title">
        <span class="slnt-event-compact__title-text">{{ label }}</span>
        {% if is_external %}
          <svg class="slnt-event-compact__external-icon"
               viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5"
               stroke-linecap="round" stroke-linejoin="round"
               aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        {% endif %}
      </h3>

      {% if content.field_when|render|striptags|trim %}
        <div class="slnt-event-compact__row slnt-event-compact__date">
          <span class="slnt-event-compact__icon" aria-hidden="true">
            {# Phosphor calendar-dots — matches the event teaser. #}
            <svg viewBox="0 0 256 256" fill="currentColor"><path d="M208,28H188V24a12,12,0,0,0-24,0v4H92V24a12,12,0,0,0-24,0v4H48A20,20,0,0,0,28,48V208a20,20,0,0,0,20,20H208a20,20,0,0,0,20-20V48A20,20,0,0,0,208,28ZM68,52a12,12,0,0,0,24,0h72a12,12,0,0,0,24,0h16V76H52V52ZM52,204V100H204V204Zm92-76a16,16,0,1,1-16-16A16,16,0,0,1,144,128Zm48,0a16,16,0,1,1-16-16A16,16,0,0,1,192,128ZM96,176a16,16,0,1,1-16-16A16,16,0,0,1,96,176Zm48,0a16,16,0,1,1-16-16A16,16,0,0,1,144,176Zm48,0a16,16,0,1,1-16-16A16,16,0,0,1,192,176Z"/></svg>
          </span>
          <span class="slnt-event-compact__value">{{ content.field_when }}</span>
        </div>
      {% endif %}

      {% if where_name %}
        <div class="slnt-event-compact__row slnt-event-compact__where">
          <span class="slnt-event-compact__icon" aria-hidden="true">
            {# Phosphor map-pin — matches the event teaser. #}
            <svg viewBox="0 0 256 256" fill="currentColor"><path d="M128,60a44,44,0,1,0,44,44A44.05,44.05,0,0,0,128,60Zm0,64a20,20,0,1,1,20-20A20,20,0,0,1,128,124Zm0-112a92.1,92.1,0,0,0-92,92c0,77.36,81.64,135.4,85.12,137.83a12,12,0,0,0,13.76,0,259,259,0,0,0,42.18-39C205.15,170.57,220,136.37,220,104A92.1,92.1,0,0,0,128,12Zm31.3,174.71A249.35,249.35,0,0,1,128,216.89a249.35,249.35,0,0,1-31.3-30.18C80,167.37,60,137.31,60,104a68,68,0,0,1,136,0C196,137.31,176,167.37,159.3,186.71Z"/></svg>
          </span>
          <span class="slnt-event-compact__value">
            <span class="slnt-event-compact__where-venue">{{ where_name }}</span>
            {% if location_area %}
              <span class="slnt-event-compact__where-area">{{ location_area }}</span>
            {% endif %}
          </span>
        </div>
      {% endif %}

    </article>
  </a>

</div>

{# We render the fields manually above; suppress defaults so they
   don't appear a second time. #}
{{ content|without('field_when', 'field_where', 'field_image',
   'field_standfirst', 'field_url',
   'field_primary_topic', 'field_related_topics') }}
