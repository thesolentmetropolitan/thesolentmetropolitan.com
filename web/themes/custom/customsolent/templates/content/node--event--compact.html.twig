{#
/**
 * @file
 * Theme override for an Event node in the "compact" view mode.
 *
 * Used by the events_listing View "view_display_front_page" display:
 * a small two-per-row card on the front page.
 *
 * Card structure:
 *   .slnt-event-compact-card             — outer wrapper, 1px solent-blue
 *                                          top rule (not section-coloured:
 *                                          the kicker carries the colour)
 *     a.slnt-event-compact__link         — clickable area: the event's own
 *                                          page (was the external link until
 *                                          2026-10-18; the page now carries
 *                                          series, collaborations, organiser).
 *       article.slnt-event-compact
 *         h3 (title)
 *         .slnt-event-compact__date      — calendar-dots icon + date
 *         .slnt-event-compact__where     — map-pin icon + venue / area
 *         .slnt-event-compact__organiser — users icon + organiser name
 *                                          (plain text; linked on the page)
 *     .slnt-topic-trail (kicker)         — last; outside the clickable
 *                                          link, parent topics linkable
 *
 * Variables added by customsolent_preprocess_node:
 *   - trail_kicker_lazy          — the kicker: the primary topic's trail,
 *                                  resolved per request so it is left out
 *                                  on that topic's own page (KickerLazyBuilder)
 *   - section_color, section_key — top-level Topic colour
 *   - field_url_href / field_url_external — extracted from field_url.
 *   - where_name      — plain Location term name.
 *   - location_area   — name of the Location term's parent (e.g. the
 *                       venue's town), or null if the venue has no
 *                       parent term.
 *   - series_links / series_cache — the series this event is in (reverse
 *                       lookup; _customsolent_preprocess_series_membership)
 *   - series_specials — short labels of seasonal series now on ("Halloween
 *                       special"), printed under the date instead
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'slnt-event-compact',
  ]
%}

{# The card goes to the event's own page (since 2026-10-18); the outward
   link to the organiser's page lives on that page as the button. #}
{% set event_url = path('entity.node.canonical', {'node': node.id}) %}
{% set is_external = false %}

<div class="slnt-event-compact-card"
     {% if section_key %}data-section="{{ section_key }}"{% endif %}>

  <a href="{{ event_url }}"
     class="slnt-event-compact__link"
     {% if is_external %}target="_blank" rel="noopener noreferrer"{% endif %}>
    <article{{ attributes.addClass(classes) }}>

      {# Title row: the title wraps on the left, the "Regular event" badge
         keeps its place at the top right (it never drops below the title). #}
      <div class="slnt-event-compact__head">
        <h3 class="slnt-event-compact__title">
          <span class="slnt-event-compact__title-text">{{ label }}</span>
          {% if is_external %}
            <svg class="slnt-event-compact__external-icon"
                 viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          {% endif %}
        </h3>
        {% if event_is_recurring %}
          {# On phones the second word is dropped (CSS) so the title keeps
             room; the full page always says "Regular event". #}
          <span class="slnt-event-badge slnt-event-badge--regular">{{ 'Regular'|t }}<span class="slnt-event-badge__word"> {{ 'event'|t }}</span></span>
        {% endif %}
      </div>
      {{ event_when_cache }}

      {# Recurring event: "Every Monday, 7 - 8:30pm" and the next date,
         instead of the date list (one item per instance). #}
      {% if event_is_recurring %}
        <div class="slnt-event-compact__row slnt-event-compact__date slnt-event-compact__date--recurring">
          <span class="slnt-event-compact__icon" aria-hidden="true">
            {# Phosphor arrows-clockwise — "repeats". #}
            <svg viewBox="0 0 256 256" fill="currentColor"><path d="M224,48V96a8,8,0,0,1-8,8H168a8,8,0,0,1,0-16h28.69L182.06,73.37a79.56,79.56,0,0,0-56.13-23.43h-.45A79.52,79.52,0,0,0,69.59,72.71,8,8,0,0,1,58.41,61.27a96,96,0,0,1,135,.79L208,76.69V48a8,8,0,0,1,16,0ZM186.41,183.29a80,80,0,0,1-112.47-.66L59.31,168H88a8,8,0,0,0,0-16H40a8,8,0,0,0-8,8v48a8,8,0,0,0,16,0V179.31l14.63,14.63A95.43,95.43,0,0,0,130,222.06h.53a95.36,95.36,0,0,0,67.07-27.33,8,8,0,0,0-11.18-11.44Z"/></svg>
          </span>
          <span class="slnt-event-compact__value">
            <span class="slnt-event-compact__recurrence">{{ event_recurrence_text }}{% if event_recurrence_times %}, {{ event_recurrence_times }}{% endif %}</span>
            {% if event_next_dates is not empty %}
              <span class="slnt-event-compact__next">{{ 'Next'|t }}: {{ event_next_dates[0] }}</span>
            {% endif %}
            {# A seasonal series' short label, under the date it applies to
               (from _customsolent_preprocess_series_membership). #}
            {% for special in series_specials %}
              <span class="slnt-event-compact__special">{{ special }}</span>
            {% endfor %}
          </span>
        </div>
        {% set _when = content.field_when|render %}
      {% elseif content.field_when|render|striptags|trim %}
        <div class="slnt-event-compact__row slnt-event-compact__date">
          <span class="slnt-event-compact__icon" aria-hidden="true">
            {# Phosphor calendar-dots — matches the event teaser. #}
            <svg viewBox="0 0 256 256" fill="currentColor"><path d="M208,28H188V24a12,12,0,0,0-24,0v4H92V24a12,12,0,0,0-24,0v4H48A20,20,0,0,0,28,48V208a20,20,0,0,0,20,20H208a20,20,0,0,0,20-20V48A20,20,0,0,0,208,28ZM68,52a12,12,0,0,0,24,0h72a12,12,0,0,0,24,0h16V76H52V52ZM52,204V100H204V204Zm92-76a16,16,0,1,1-16-16A16,16,0,0,1,144,128Zm48,0a16,16,0,1,1-16-16A16,16,0,0,1,192,128ZM96,176a16,16,0,1,1-16-16A16,16,0,0,1,96,176Zm48,0a16,16,0,1,1-16-16A16,16,0,0,1,144,176Zm48,0a16,16,0,1,1-16-16A16,16,0,0,1,192,176Z"/></svg>
          </span>
          <span class="slnt-event-compact__value">
            {{ content.field_when }}
            {% for special in series_specials %}
              <span class="slnt-event-compact__special">{{ special }}</span>
            {% endfor %}
          </span>
        </div>
      {% endif %}

      {% if where_list is not empty %}
        <div class="slnt-event-compact__row slnt-event-compact__where">
          <span class="slnt-event-compact__icon" aria-hidden="true">
            {# Phosphor map-pin — matches the event teaser. #}
            <svg viewBox="0 0 256 256" fill="currentColor"><path d="M128,60a44,44,0,1,0,44,44A44.05,44.05,0,0,0,128,60Zm0,64a20,20,0,1,1,20-20A20,20,0,0,1,128,124Zm0-112a92.1,92.1,0,0,0-92,92c0,77.36,81.64,135.4,85.12,137.83a12,12,0,0,0,13.76,0,259,259,0,0,0,42.18-39C205.15,170.57,220,136.37,220,104A92.1,92.1,0,0,0,128,12Zm31.3,174.71A249.35,249.35,0,0,1,128,216.89a249.35,249.35,0,0,1-31.3-30.18C80,167.37,60,137.31,60,104a68,68,0,0,1,136,0C196,137.31,176,167.37,159.3,186.71Z"/></svg>
          </span>
          <span class="slnt-event-compact__value">
            {% if where_list|length == 1 %}
              <span class="slnt-event-compact__where-venue">{{ where_list[0].name }}</span>
              {% if where_list[0].area %}
                <span class="slnt-event-compact__where-area">{{ where_list[0].area }}</span>
              {% endif %}
            {% else %}
              {# Several venues at once: the count, then the towns. The full
                 page lists each venue. #}
              <span class="slnt-event-compact__where-venue">{{ '@count venues'|t({'@count': where_list|length}) }}</span>
              {% if where_areas %}
                <span class="slnt-event-compact__where-area">{{ where_areas }}</span>
              {% endif %}
            {% endif %}
          </span>
        </div>
      {% endif %}

      {# Organiser — plain text inside the card link (the organisation is
         linked on the event page). #}
      {% if organiser_label %}
        <div class="slnt-event-compact__row slnt-event-compact__organiser">
          <span class="slnt-event-compact__icon" aria-hidden="true">
            {# Feather "users" (MIT) — matches the teaser's organiser row. #}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span>
          <span class="slnt-event-compact__value"><span class="visually-hidden">{{ 'Organiser'|t }}: </span>{{ organiser_label }}</span>
        </div>
      {% endif %}

    </article>
  </a>

  {# "Part of the series …" — outside the card link (nested links are
     invalid HTML), before the kicker, so the series name is its own link. #}
  {% include '@customsolent/components/series-line.html.twig' with {
    series_links: series_links,
    series_cache: series_cache,
    variant: 'compact',
  } only %}

  {# Kicker — LAST, after the title and facts, so that a screen-reader
     user who jumps to the h3 hears everything belonging to this card
     and nothing about it sits before its heading. Still outside the
     clickable link so the parent terms remain independently navigable
     (nested links are invalid HTML). #}
  {{ trail_kicker_lazy }}

</div>

{# We render the fields manually above; suppress defaults so they
   don't appear a second time. #}
{{ content|without('field_when', 'field_where', 'field_image',
   'field_standfirst', 'field_url', 'field_organiser',
   'field_primary_topic', 'field_related_topics') }}
