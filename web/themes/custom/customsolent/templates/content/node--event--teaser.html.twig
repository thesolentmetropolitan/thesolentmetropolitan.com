{#
/**
 * @file
 * Theme override for an Event node in the teaser view mode.
 *
 * Renders fields manually so we can:
 *   - prefix the When and Where labels with phosphor icons
 *     (calendar-dots / map-pin),
 *   - render field_where as plain text (rabbit_hole disables event
 *     access; we also don't want a link to the Location term),
 *   - render field_urls as CTA buttons coloured to match the section
 *     (Culture purple, Sectors blue, Living green, About slate,
 *     Explore amber), one per link (node_links), each with the icon
 *     for its kind of address (ticket, platform logo, globe).
 *
 * Variables added by customsolent_preprocess_node:
 *   - section_color, section_key      — top-level Topic colour.
 *   - where_name                      — plain Location term name.
 *   - field_url_external/href/text    — for the CTA.
 *   - series_links / series_cache     — the series this event is in.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'slnt-event-teaser',
    content.field_image|render|striptags|trim ? 'slnt-event-teaser--has-image' : 'slnt-event-teaser--no-image',
  ]
%}

{% set teaser_attrs = attributes.addClass(classes) %}
{% if section_key %}
  {% set teaser_attrs = teaser_attrs.setAttribute('data-section', section_key) %}
{% endif %}

<article{{ teaser_attrs }}>

  {% if content.field_image|render|striptags|trim %}
    <div class="slnt-event-teaser__image">
      {{ content.field_image }}
    </div>
  {% endif %}

  <div class="slnt-event-teaser__text">
    {# Title row: title left (wraps), "Regular event" badge top right. #}
    <div class="slnt-event-teaser__head">
      <h2 class="slnt-event-teaser__title"><a href="{{ url }}" class="slnt-event-teaser__title-link">{{ label }}</a></h2>
      {% if event_is_recurring %}
        <span class="slnt-event-badge slnt-event-badge--regular">{{ 'Regular event'|t }}</span>
      {% endif %}
    </div>
    {{ in_kicker_lazy }}
    {{ from_kicker_lazy }}

    {% if content.field_standfirst|render|striptags|trim %}
      <div class="slnt-event-teaser__standfirst">{{ content.field_standfirst }}</div>
    {% endif %}
    {{ event_when_cache }}

    {# When — recurring: the rule(s) after a repeat icon and the next date
       on a "Next" row after a calendar icon; otherwise the Smart Date value. #}
    {% if event_is_recurring %}
      <div class="slnt-event-teaser__row slnt-event-teaser__when">
        {% include '@customsolent/components/when-icon.html.twig' with { icon: 'repeat', class: 'slnt-event-teaser__icon' } only %}
        <span class="slnt-event-teaser__label">{{ 'When'|t }}</span>
        <span class="slnt-event-teaser__value">{{ event_recurrence_lines|join(' · ') }}
          {% if event_next_dates is empty %}
            {% for special in series_specials %}<span class="slnt-event-teaser__special">{{ special }}</span>{% endfor %}
            {% if event_arrival %}<span class="slnt-event-teaser__arrival">{{ event_arrival }}</span>{% endif %}
          {% endif %}
        </span>
      </div>
      {% if event_next_dates is not empty %}
        <div class="slnt-event-teaser__row slnt-event-teaser__when slnt-event-teaser__when--next">
          {% include '@customsolent/components/when-icon.html.twig' with { icon: 'calendar', class: 'slnt-event-teaser__icon' } only %}
          <span class="slnt-event-teaser__label">{{ event_next_prefix ?: 'Next'|t }}</span>
          <span class="slnt-event-teaser__value">{{ event_next_dates[0] }}
            {% for special in series_specials %}<span class="slnt-event-teaser__special">{{ special }}</span>{% endfor %}
            {% if event_arrival %}<span class="slnt-event-teaser__arrival">{{ event_arrival }}</span>{% endif %}
          </span>
        </div>
      {% endif %}
      {% set _when = content.field_when|render %}
    {% elseif content.field_when|render|striptags|trim %}
      <div class="slnt-event-teaser__row slnt-event-teaser__when">
        {% include '@customsolent/components/when-icon.html.twig' with { icon: 'calendar', class: 'slnt-event-teaser__icon' } only %}
        <span class="slnt-event-teaser__label">When</span>
        <span class="slnt-event-teaser__value">{{ content.field_when[0] }}
          {% for special in series_specials %}<span class="slnt-event-teaser__special">{{ special }}</span>{% endfor %}
          {% if event_arrival %}<span class="slnt-event-teaser__arrival">{{ event_arrival }}</span>{% endif %}
        </span>
      </div>
    {% endif %}

    {# Where — map-pin icon + label + plain Location term name. #}
    {% if where_name %}
      <div class="slnt-event-teaser__row slnt-event-teaser__where">
        <span class="slnt-event-teaser__icon" aria-hidden="true">
          <svg viewBox="0 0 256 256" fill="currentColor"><path d="M128,60a44,44,0,1,0,44,44A44.05,44.05,0,0,0,128,60Zm0,64a20,20,0,1,1,20-20A20,20,0,0,1,128,124Zm0-112a92.1,92.1,0,0,0-92,92c0,77.36,81.64,135.4,85.12,137.83a12,12,0,0,0,13.76,0,259,259,0,0,0,42.18-39C205.15,170.57,220,136.37,220,104A92.1,92.1,0,0,0,128,12Zm31.3,174.71A249.35,249.35,0,0,1,128,216.89a249.35,249.35,0,0,1-31.3-30.18C80,167.37,60,137.31,60,104a68,68,0,0,1,136,0C196,137.31,176,167.37,159.3,186.71Z"/></svg>
        </span>
        <span class="slnt-event-teaser__label">Where</span>
        <span class="slnt-event-teaser__value">
          {%- if where_list|length > 1 -%}
            <ul class="slnt-event-teaser__venues">
              {% for venue in where_list %}
                <li>{{ venue.name }}{% if venue.area %}<span class="slnt-event-teaser__venue-area">, {{ venue.area }}</span>{% endif %}</li>
              {% endfor %}
            </ul>
          {%- else -%}
            {{ where_name }}
          {%- endif -%}
        </span>
      </div>
    {% endif %}

    {# Organiser — the organisation running it, linked. #}
    {% if organiser_label %}
      <div class="slnt-event-teaser__row slnt-event-teaser__organiser">
        <span class="slnt-event-teaser__icon" aria-hidden="true">
          {# Feather "users" (MIT). #}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        <span class="slnt-event-teaser__label">{{ organisers|length > 1 ? 'Organisers'|t : 'Organiser'|t }}</span>
        <span class="slnt-event-teaser__value">{% for org in organisers %}<a href="{{ org.url }}" class="slnt-event-teaser__organiser-link">{{ org.label }}</a>{% if not loop.last %}{{ loop.index == organisers|length - 1 ? ' ' ~ 'and'|t ~ ' ' : ', ' }}{% endif %}{% endfor %}</span>
      </div>
    {% endif %}

    {# "Part of the series …" — after the facts, before the CTA. #}
    {% include '@customsolent/components/series-line.html.twig' with {
      series_links: series_links,
      series_cache: series_cache,
      variant: 'teaser',
    } only %}

    {# CTA — one section-coloured button per link, each with the icon for
       its kind of address (ticket, platform logo, globe). Not once the
       event has passed: organisers take their event pages down. #}
    {% if node_links is not empty and not is_past_event %}
      <div class="slnt-event-teaser__cta-outer">
        {% for link in node_links %}
          <a class="slnt-cta slnt-event-teaser__cta slnt-event-teaser__cta--{{ link.kind }}"
             href="{{ link.href }}"
             {% if link.external %}rel="noopener noreferrer" target="_blank"{% endif %}
             {% if section_color %}style="background-color: {{ section_color }}; border-color: {{ section_color }}; color: #fff;"{% endif %}>
            {% include '@customsolent/components/link-icon.html.twig' with { icon: link.icon, class: 'slnt-cta__icon slnt-cta__icon--kind' } only %}
            {# Standard wording ("Event details" / "Tickets" / "Facebook",
               see _customsolent_node_link_buttons) so every button in a
               listing reads the same; the event title is hidden text so
               each button is announced distinctly. #}
            <span class="slnt-cta__text">{{ link.label }}<span class="visually-hidden">: {{ label }}{% if link.external %} ({{ 'opens in a new tab'|t }}){% endif %}</span></span>
            {% if link.external %}
              <svg class="slnt-cta__icon" viewBox="0 0 256 256" fill="currentColor" role="presentation" focusable="false"><path d="M228,104a12,12,0,0,1-24,0V69l-59.51,59.51a12,12,0,0,1-17-17L187,52H152a12,12,0,0,1,0-24h64a12,12,0,0,1,12,12Zm-44,24a12,12,0,0,0-12,12v64H52V84h64a12,12,0,0,0,0-24H48A20,20,0,0,0,28,80V208a20,20,0,0,0,20,20H176a20,20,0,0,0,20-20V140A12,12,0,0,0,184,128Z"/></svg>
            {% else %}
              <svg class="slnt-cta__chevron" role="presentation" focusable="false">
                <use href="#tvip-down-triangle"></use>
              </svg>
            {% endif %}
          </a>
        {% endfor %}
      </div>
    {% endif %}

  </div>

  {# Suppress defaults — we render these manually above. #}
  {{ content|without('field_image', 'field_standfirst', 'field_when', 'field_where', 'field_urls', 'field_organisers', 'field_arrival') }}

</article>
