{#
/**
 * @file
 * Theme override for the "Section Filter" paragraph type.
 *
 * Renders the page-level topic sidebar — sticky on desktop, a sticky bar
 * + slide-up panel on mobile. On Culture, Sectors and Living its items
 * are the section's pages (see components/topic-nav.html.twig); on
 * Explore pages they are ?topic= filters that the View Display paragraphs
 * below read to refilter their listings.
 *
 * When this paragraph is present on a page, the View Display paragraph
 * preprocess suppresses its own (per-paragraph) filter sidebar so the
 * page shows a single, page-level filter.
 *
 * Variables provided by customsolent_preprocess_paragraph__section_filter:
 *   - section_key          lowercased top-level Topic name (drives colour).
 *   - section_color        hex colour for the top-level section.
 *   - filter_has_options   TRUE when the resolved scope has filter options.
 *   - filter_options       array of {tid, label, url, active}.
 *   - filter_all_url       URL of the page with no ?topic= param.
 *   - filter_all_active    TRUE when no topic is currently selected.
 *   - filter_active_label  label of the active term, or NULL.
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
    'slnt-section-filter',
  ]
%}

{% set wrapper_attributes = attributes.addClass(classes) %}
{% if section_key %}
  {% set wrapper_attributes = wrapper_attributes.setAttribute('data-section', section_key) %}
{% endif %}

{% if filter_has_options %}
  {% block paragraph %}
    <div{{ wrapper_attributes }}>
      {% block content %}

        {# Desktop sidebar. #}
        <aside class="slnt-section-filter__sidebar" aria-label="Topics">
          {% include '@customsolent/components/topic-nav.html.twig' with { filter_options: filter_options, filter_all_url: filter_all_url, filter_all_active: filter_all_active } only %}
          {% include '@customsolent/components/format-nav.html.twig' with { format_options: format_options|default([]), format_all_url: format_all_url, format_all_active: format_all_active } only %}
          {% for group in facet_groups|default([]) %}
            {% include '@customsolent/components/facet-nav.html.twig' with { group: group } only %}
          {% endfor %}
        </aside>

        {# Mobile sticky bar — the panel below opens on tap. #}
        {% include '@customsolent/components/filter-bar.html.twig' with { filter_active_label: filter_active_label, format_has_options: format_has_options|default(false), format_active_label: format_active_label|default(null), facet_groups: facet_groups|default([]) } only %}

        {# Mobile slide-up panel — overlay outside the sticky flow. #}
        {% include '@customsolent/components/filter-sheets.html.twig' with { filter_options: filter_options, filter_all_url: filter_all_url, filter_all_active: filter_all_active, format_has_options: format_has_options|default(false), format_options: format_options|default([]), format_all_url: format_all_url|default(null), format_all_active: (format_all_active is defined ? format_all_active : true), facet_groups: facet_groups|default([]) } only %}

      {% endblock %}
    </div>
  {% endblock paragraph %}
{% endif %}
