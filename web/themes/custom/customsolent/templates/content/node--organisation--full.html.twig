{#
/**
 * @file
 * Organisation node — full view mode.
 *
 * Minimal, shareable and indexable destination page. Shares the
 * .slnt-node-full structure with the Event and Link full views (and aligns
 * with node--article--full.html.twig).
 *
 * Stacking order: topic trail, title (organisation name), where, standfirst,
 * link buttons (website, social pages), editor components, "Part of"
 * (parent organisations), "Includes" (subsidiaries), Coming up, collaborations.
 *
 * Field display (full view mode): hide the built-in node title (rendered here
 * via {{ label }}). field_standfirst uses its configured formatter; field_urls
 * is rendered manually below as one new-tab button per link (node_links, from
 * _customsolent_node_link_buttons(): globe for the website, the platform's
 * logo for a social page). parent_organisations / subsidiary_organisations
 * are directory cards (customsolent_preprocess_node).
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'slnt-node-full',
    'slnt-org-full',
  ]
%}

<article{{ attributes.addClass(classes) }}{% if primary_topic_menu_path is defined and primary_topic_menu_path %} data-primary-topic-path="{{ primary_topic_menu_path }}"{% endif %}>
  <div class="slnt-node-full__header">

    {# Topic trail kicker. #}
    {% if topic_trail_ancestors is not empty %}
      {% include '@customsolent/components/topic-trail.html.twig' with {
        ancestors: topic_trail_ancestors,
        current_label: null,
        current_as_heading: false,
      } only %}
    {% endif %}

    {# Title — organisation name. #}
    <h1 class="slnt-node-full__title">{{ label }}</h1>

    {# Where — the Location term(s) as plain text: "Southampton and
       Portsmouth" (organisation_where, from customsolent_preprocess_node). #}
    {% if organisation_where %}
      <div class="slnt-node-full__where">{{ organisation_where }}</div>
    {% endif %}

  </div>

  {# Standfirst — only if populated. #}
  {% if content.field_standfirst|render|striptags|trim %}
    <div class="slnt-node-full__standfirst">{{ content.field_standfirst }}</div>
  {% endif %}

  {# Links — website and social pages, one button each, with the icon for
     the kind of address (globe, platform logo). External links open in a
     new tab. #}
  {% if node_links is not empty %}
    <div class="slnt-node-full__cta slnt-node-full__cta--row">
      {% for link in node_links %}
        <a href="{{ link.href }}" class="slnt-node-full__cta-link slnt-node-full__cta-link--{{ link.kind }}"{% if link.external %} target="_blank" rel="noopener noreferrer"{% endif %}>
          {% include '@customsolent/components/link-icon.html.twig' with { icon: link.icon, class: 'slnt-node-full__cta-icon slnt-node-full__cta-icon--kind' } only %}
          <span>{{ link.label }}</span>
          {% if link.external %}
            <svg class="slnt-node-full__cta-icon slnt-node-full__cta-icon--external" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M228,104a12,12,0,0,1-24,0V69l-59.51,59.51a12,12,0,0,1-17-17L187,52H152a12,12,0,0,1,0-24h64a12,12,0,0,1,12,12Zm-44,24a12,12,0,0,0-12,12v64H52V84h64a12,12,0,0,0,0-24H48A20,20,0,0,0,28,80V208a20,20,0,0,0,20,20H176a20,20,0,0,0,20-20V140A12,12,0,0,0,184,128Z"/></svg>
            <span class="visually-hidden">({{ 'opens in a new tab'|t }})</span>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  {% endif %}

  {# Editor's content components (text, galleries, links, listings). #}
  {% if content.field_content_component|render|striptags|trim %}
    <div class="slnt-org-full__components">
      {{ content.field_content_component }}
    </div>
  {% endif %}

  {# The organisation(s) this one is part of (reverse lookup on the parent's
     field_subsidiary_organisations — there can be more than one), then the
     organisations and links that are part of this one. Directory cards. #}
  {% if parent_organisations is not empty %}
    <section class="slnt-series-items slnt-org-full__parents" aria-labelledby="org-parents-heading">
      <h2 id="org-parents-heading" class="slnt-series-items__heading">{{ 'Part of'|t }}</h2>
      <div class="slnt-series-items__grid slnt-series-items__grid--links">
        {% for item in parent_organisations %}
          <div class="slnt-series-items__cell">{{ item }}</div>
        {% endfor %}
      </div>
    </section>
  {% endif %}
  {% if subsidiary_organisations is not empty %}
    <section class="slnt-series-items slnt-org-full__subsidiaries" aria-labelledby="org-subsidiaries-heading">
      <h2 id="org-subsidiaries-heading" class="slnt-series-items__heading">
        {{ 'Includes'|t }}
        <span class="slnt-series-items__count">{{ subsidiary_organisations|length }}</span>
      </h2>
      <div class="slnt-series-items__grid slnt-series-items__grid--links">
        {% for item in subsidiary_organisations %}
          <div class="slnt-series-items__cell">{{ item }}</div>
        {% endfor %}
      </div>
    </section>
  {% endif %}
  {{ organisation_links_cache }}

  {# Events this organisation is running that have not finished (reverse
     lookup on field_organisers), as compact cards. #}
  {% if organiser_events is not empty %}
    <section class="slnt-series-items slnt-org-full__events" aria-labelledby="org-events-heading">
      <h2 id="org-events-heading" class="slnt-series-items__heading">
        {{ 'Coming up'|t }}
        <span class="slnt-series-items__count">{{ organiser_events|length }}</span>
      </h2>
      <div class="slnt-series-items__grid slnt-series-items__grid--events">
        {% for item in organiser_events %}
          <div class="slnt-series-items__cell">{{ item }}</div>
        {% endfor %}
      </div>
    </section>
  {% endif %}
  {{ organiser_events_cache }}

  {# Collaborations this organisation is part of (reverse lookup). #}
  {% include '@customsolent/components/collaborations-block.html.twig' with {
    collaboration_items: collaboration_items,
    collaborations_cache: collaborations_cache,
  } only %}

  {{ content|without('field_standfirst', 'field_urls', 'field_where', 'field_content_component',
     'field_subsidiary_organisations', 'field_primary_topic', 'field_related_topics', 'links') }}

</article>
