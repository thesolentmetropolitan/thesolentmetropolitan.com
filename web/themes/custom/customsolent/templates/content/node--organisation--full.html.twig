{#
/**
 * @file
 * Organisation node — full view mode.
 *
 * Minimal, shareable and indexable destination page. Shares the
 * .slnt-node-full structure with the Event and Link full views (and aligns
 * with node--article--full.html.twig).
 *
 * Stacking order: topic trail, title (organisation name), where, standfirst,
 * link buttons (website, social pages), editor components, "Part of"
 * (parent organisations), "Includes" (subsidiaries), Coming up, collaborations.
 *
 * Field display (full view mode): hide the built-in node title (rendered here
 * via {{ label }}). field_standfirst uses its configured formatter; field_urls
 * is rendered manually below as one new-tab button per link (node_links, from
 * _customsolent_node_link_buttons(): globe for the website, the platform's
 * logo for a social page). parent_organisations / subsidiary_organisations
 * are directory cards (customsolent_preprocess_node).
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'slnt-node-full',
    'slnt-org-full',
  ]
%}

<article{{ attributes.addClass(classes) }}{% if primary_topic_menu_path is defined and primary_topic_menu_path %} data-primary-topic-path="{{ primary_topic_menu_path }}"{% endif %}>
  <div class="slnt-node-full__header">

    {# Topic trail kicker. #}
    {% if topic_trail_ancestors is not empty %}
      {% include '@customsolent/components/topic-trail.html.twig' with {
        ancestors: topic_trail_ancestors,
        current_label: null,
        current_as_heading: false,
      } only %}
    {% endif %}

    {# Title — organisation name. #}
        <h1 class="slnt-node-full__title">{{ label }}</h1>

    {# A station: what it is and how to tune in (EPG). #}
    {% if station %}
      <div class="slnt-node-full__station">{{ station.kind_label }}{% if station.frequency %} <span class="slnt-node-full__station-frequency">· {{ station.frequency }}</span>{% endif %}</div>
    {% endif %}
    {# What it puts on, when that is the point of it (issue 485). #}
    {% include '@customsolent/components/format-line.html.twig' with { format_labels: format_labels, setting_label: setting_label, setting_key: setting_key, variant: 'full' } only %}

    {# Where — the Location term(s), each a link to its page (issue 440):
       "Southampton and Portsmouth" (organisation_places, from
       customsolent_preprocess_node), with the address of each place
       whose Location term has one. #}
        {{ where_cache }}
    {% if organisation_where %}
      <div class="slnt-node-full__where-row">
        <span class="slnt-node-full__where-icon" aria-hidden="true">
          {# Phosphor map-pin — the same pin as the event page and the cards. #}
          <svg viewBox="0 0 256 256" fill="currentColor"><path d="M128,60a44,44,0,1,0,44,44A44.05,44.05,0,0,0,128,60Zm0,64a20,20,0,1,1,20-20A20,20,0,0,1,128,124Zm0-112a92.1,92.1,0,0,0-92,92c0,77.36,81.64,135.4,85.12,137.83a12,12,0,0,0,13.76,0,259,259,0,0,0,42.18-39C205.15,170.57,220,136.37,220,104A92.1,92.1,0,0,0,128,12Zm31.3,174.71A249.35,249.35,0,0,1,128,216.89a249.35,249.35,0,0,1-31.3-30.18C80,167.37,60,137.31,60,104a68,68,0,0,1,136,0C196,137.31,176,167.37,159.3,186.71Z"/></svg>
        </span>
        <div class="slnt-node-full__where">
          {%- for place in organisation_places -%}
            {%- if not loop.first %}{{ loop.last ? ' ' ~ 'and'|t ~ ' ' : ', ' }}{% endif -%}
            {%- if place.url %}<a class="slnt-node-full__venue-link" href="{{ place.url }}">{{ place.name }}</a>{% else %}{{ place.name }}{% endif -%}
          {%- endfor -%}
          {% for place in organisation_places %}
            {% if place.line %}
              {% include '@customsolent/components/venue-address.html.twig' with { place: place, with_name: organisation_places|length > 1 } only %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}


  </div>

  {# Standfirst — only if populated. #}
  {% if content.field_standfirst|render|striptags|trim %}
    <div class="slnt-node-full__standfirst">{{ content.field_standfirst }}</div>
  {% endif %}

    {# Links — website and social pages, one button each, with the icon for
     the kind of address (globe, platform logo). External links open in a
     new tab. A station's Listen live / Watch live and Catch up come first
     (EPG). #}
  {% if node_links is not empty or (station and (station.live_url or station.catchup_url)) %}
    <div class="slnt-node-full__cta slnt-node-full__cta--row">
      {% if station and station.live_url %}
        <a href="{{ station.live_url }}" class="slnt-node-full__cta-link slnt-node-full__cta-link--live" target="_blank" rel="noopener noreferrer">
          {# Phosphor play-circle. #}
          <svg class="slnt-node-full__cta-icon slnt-node-full__cta-icon--kind" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M128,20A108,108,0,1,0,236,128,108.12,108.12,0,0,0,128,20Zm0,192a84,84,0,1,1,84-84A84.09,84.09,0,0,1,128,212Zm42.66-94L114.66,82a12,12,0,0,0-18.66,10v72a12,12,0,0,0,18.66,10l56-36a12,12,0,0,0,0-20ZM120,141.84V114.16L141.57,128Z"/></svg>
          <span>{{ station.live_label }}</span>
          <span class="visually-hidden">({{ 'opens in a new tab'|t }})</span>
        </a>
      {% endif %}
      {% if station and station.catchup_url %}
        <a href="{{ station.catchup_url }}" class="slnt-node-full__cta-link slnt-node-full__cta-link--catchup" target="_blank" rel="noopener noreferrer">
          {# Phosphor clock-counter-clockwise. #}
          <svg class="slnt-node-full__cta-icon slnt-node-full__cta-icon--kind" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M140,80v41.21l34.17,20.5a12,12,0,1,1-12.34,20.58l-40-24A12,12,0,0,1,116,128V80a12,12,0,0,1,24,0ZM128,28A99.38,99.38,0,0,0,57.24,57.34c-4.69,4.74-9,9.37-13.24,14V64a12,12,0,0,0-24,0v40a12,12,0,0,0,12,12H72a12,12,0,0,0,0-24H57.77C63,86,68.37,80.22,74.26,74.26a76,76,0,1,1,1.58,109,12,12,0,0,0-16.48,17.46A100,100,0,1,0,128,28Z"/></svg>
          <span>{{ 'Catch up'|t }}</span>
          <span class="visually-hidden">({{ 'opens in a new tab'|t }})</span>
        </a>
      {% endif %}
      {% for link in node_links %}
        <a href="{{ link.href }}" class="slnt-node-full__cta-link slnt-node-full__cta-link--{{ link.kind }}"{% if link.external %} target="_blank" rel="noopener noreferrer"{% endif %}>
          {% include '@customsolent/components/link-icon.html.twig' with { icon: link.icon, class: 'slnt-node-full__cta-icon slnt-node-full__cta-icon--kind' } only %}
          <span>{{ link.label }}</span>
          {% if link.external %}
            <svg class="slnt-node-full__cta-icon slnt-node-full__cta-icon--external" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M228,104a12,12,0,0,1-24,0V69l-59.51,59.51a12,12,0,0,1-17-17L187,52H152a12,12,0,0,1,0-24h64a12,12,0,0,1,12,12Zm-44,24a12,12,0,0,0-12,12v64H52V84h64a12,12,0,0,0,0-24H48A20,20,0,0,0,28,80V208a20,20,0,0,0,20,20H176a20,20,0,0,0,20-20V140A12,12,0,0,0,184,128Z"/></svg>
            <span class="visually-hidden">({{ 'opens in a new tab'|t }})</span>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  {% endif %}

  {# Editor's content components (text, galleries, links, listings). #}
  {% if content.field_content_component|render|striptags|trim %}
    <div class="slnt-org-full__components">
      {{ content.field_content_component }}
    </div>
  {% endif %}

  {# The organisation(s) this one is part of (reverse lookup on the parent's
     field_subsidiary_organisations — there can be more than one), then the
     organisations and links that are part of this one. Directory cards. #}
  {% if parent_organisations is not empty %}
    <section class="slnt-series-items slnt-org-full__parents" aria-labelledby="org-parents-heading">
      <h2 id="org-parents-heading" class="slnt-series-items__heading">{{ 'Part of'|t }}</h2>
      <div class="slnt-series-items__grid slnt-series-items__grid--links">
        {% for item in parent_organisations %}
          <div class="slnt-series-items__cell">{{ item }}</div>
        {% endfor %}
      </div>
    </section>
  {% endif %}
  {% if subsidiary_organisations is not empty %}
    <section class="slnt-series-items slnt-org-full__subsidiaries" aria-labelledby="org-subsidiaries-heading">
      <h2 id="org-subsidiaries-heading" class="slnt-series-items__heading">
        {{ 'Includes'|t }}
        <span class="slnt-series-items__count">{{ subsidiary_organisations|length }}</span>
      </h2>
      <div class="slnt-series-items__grid slnt-series-items__grid--links">
        {% for item in subsidiary_organisations %}
          <div class="slnt-series-items__cell">{{ item }}</div>
        {% endfor %}
      </div>
    </section>
  {% endif %}
  {{ organisation_links_cache }}

  {# Events this organisation is running that have not finished (reverse
     lookup on field_organisers), as compact cards. #}
  {# A station: today's programmes from the guide, each a link to its
     page, with the way to the whole schedule (EPG). #}
  {% if station %}
    <section class="slnt-series-items slnt-station-today" aria-labelledby="station-today-heading">
      <h2 id="station-today-heading" class="slnt-series-items__heading">{{ 'Today on @station'|t({'@station': node.label}) }}</h2>
      {% if station.today %}
        <ol class="slnt-station-today__list">
          {% for p in station.today %}
            <li class="slnt-station-today__item{% if p.is_now %} is-now{% endif %}">
              <span class="slnt-station-today__time">{{ p.times ?: p.time }}</span>
              <a href="{{ p.url }}">{{ p.title }}</a>
              {% if p.is_now %}<span class="slnt-station-today__now">{{ 'On now'|t }}</span>{% endif %}
            </li>
          {% endfor %}
        </ol>
      {% else %}
        <p class="slnt-station-today__none">{{ 'No programmes listed for today.'|t }}</p>
      {% endif %}
      <p class="slnt-station-today__more"><a href="{{ station.guide_url }}">{{ 'The local media schedule'|t }}</a>{% if station.schedule_url %} · <a href="{{ station.schedule_url }}" target="_blank" rel="noopener noreferrer">{{ 'The full schedule on the station\'s site'|t }}</a>{% endif %}</p>
    </section>
  {% endif %}

  {% if organiser_events is not empty %}
    <section class="slnt-series-items slnt-org-full__events" aria-labelledby="org-events-heading">
      <h2 id="org-events-heading" class="slnt-series-items__heading">
        {{ 'Coming up'|t }}
        <span class="slnt-series-items__count">{{ organiser_events|length }}</span>
      </h2>
      <div class="slnt-series-items__grid slnt-series-items__grid--events">
        {% for item in organiser_events %}
          <div class="slnt-series-items__cell">{{ item }}</div>
        {% endfor %}
      </div>
    </section>
  {% endif %}
  {{ organiser_events_cache }}

  {# Every topic, primary first, each as its full chain: why the item
     appears where it does. #}
  {% include '@customsolent/components/topics-list.html.twig' with { related_topic_chains: related_topic_chains|default([]) } only %}

  {# Collaborations this organisation is part of (reverse lookup). #}
  {% include '@customsolent/components/collaborations-block.html.twig' with {
    collaboration_items: collaboration_items,
    collaborations_cache: collaborations_cache,
  } only %}

  {{ content|without('field_standfirst', 'field_urls', 'field_where', 'field_content_component',
     'field_subsidiary_organisations', 'field_primary_topic', 'field_related_topics', 'links') }}

</article>
