{#
/**
 * @file
 * Series node — full view mode (/series/<title>-<year>).
 *
 * Same container and header grammar as node--event--full.html.twig
 * (.slnt-node-full): status badge, topic-trail kicker, h1, date range,
 * standfirst. Then the description in the article reading column, the
 * members grouped as Events / Articles / Links / Organisations (each
 * rendered as its own compact card), the related organisations (not
 * members, but relevant: a way on to other things around the site), and
 * the related topics as section-coloured links.
 *
 * Collaborations this series is an outcome of will be listed after the
 * members once the Collaboration type exists (see the 2026-10-18 brief).
 *
 * Variables from _customsolent_preprocess_series_extras():
 *   series_status, series_status_label, series_range, organiser_label /
 *   organiser_url (the curating organisation, or ''), series_groups
 *   ({key, label, items[], grid_class}), related_organisations (compact
 *   cards), related_topic_chains ({chain, color}), series_cache
 *   (print in every branch).
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'slnt-node-full',
    'slnt-series-full',
    series_status ? 'slnt-series-full--' ~ series_status,
  ]
%}

<article{{ attributes.addClass(classes) }}{% if primary_topic_menu_path is defined and primary_topic_menu_path %} data-primary-topic-path="{{ primary_topic_menu_path }}"{% endif %}>
  <div class="slnt-node-full__header">

    {# Kind-of-page kicker: "Series", linking back to /explore/series. (The
       status badge sat beside it until 17 Nov 2026; it now prefixes the
       dates below, which is what it is about.) #}
    <div class="slnt-node-full__type-kicker">
      <a href="{{ type_home_url }}" class="slnt-node-full__type-link">
        <span class="slnt-node-full__type-icon" aria-hidden="true">
          {# Feather "layers" (MIT) — the series icon on cards. #}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 12 12 17 22 12"/><polyline points="2 17 12 22 22 17"/></svg>
        </span>
        <span>{{ 'Series'|t }}<span class="visually-hidden">: {{ 'all series'|t }}</span></span>
      </a>
    </div>

    {# Topic trail kicker — clickable, section-coloured ancestor terms. #}
    {% if topic_trail_ancestors is not empty %}
      {% include '@customsolent/components/topic-trail.html.twig' with {
        ancestors: topic_trail_ancestors,
        current_label: null,
        current_as_heading: false,
      } only %}
    {% endif %}

    <h1 class="slnt-node-full__title">{{ label }}</h1>

    {# Format and setting, above the date range as on the cards (issue 485). #}
    {% include '@customsolent/components/format-line.html.twig' with { format_labels: format_labels, setting_label: setting_label, setting_key: setting_key, variant: 'full', show_indoor: true } only %}

    {% if series_range or series_status_label %}
      <div class="slnt-node-full__when slnt-series-full__dates">
        <span class="slnt-series-full__icon" aria-hidden="true">
          <svg viewBox="0 0 256 256" fill="currentColor"><path d="M208,28H188V24a12,12,0,0,0-24,0v4H92V24a12,12,0,0,0-24,0v4H48A20,20,0,0,0,28,48V208a20,20,0,0,0,20,20H208a20,20,0,0,0,20-20V48A20,20,0,0,0,208,28ZM68,52a12,12,0,0,0,24,0h72a12,12,0,0,0,24,0h16V76H52V52ZM52,204V100H204V204Zm92-76a16,16,0,1,1-16-16A16,16,0,0,1,144,128Zm48,0a16,16,0,1,1-16-16A16,16,0,0,1,192,128ZM96,176a16,16,0,1,1-16-16A16,16,0,0,1,96,176Zm48,0a16,16,0,1,1-16-16A16,16,0,0,1,144,176Zm48,0a16,16,0,1,1-16-16A16,16,0,0,1,192,176Z"/></svg>
        </span>
        <span>
          {%- if series_status_label %}<span class="slnt-series-full__status slnt-series-full__status--{{ series_status }}">{{ series_status_label }}</span> {% endif -%}
          {{ series_range }}
        </span>
      </div>
    {% endif %}

    {# Where — the series' home venue(s), when it has one (issue 435): the
       event page's line, each place a link to its page. #}
    {{ where_cache }}
    {% if where_list is not empty %}
      <div class="slnt-node-full__where-row">
        <span class="slnt-node-full__where-icon" aria-hidden="true">
          <svg viewBox="0 0 256 256" fill="currentColor"><path d="M128,60a44,44,0,1,0,44,44A44.05,44.05,0,0,0,128,60Zm0,64a20,20,0,1,1,20-20A20,20,0,0,1,128,124Zm0-112a92.1,92.1,0,0,0-92,92c0,77.36,81.64,135.4,85.12,137.83a12,12,0,0,0,13.76,0,259,259,0,0,0,42.18-39C205.15,170.57,220,136.37,220,104A92.1,92.1,0,0,0,128,12Zm31.3,174.71A249.35,249.35,0,0,1,128,216.89a249.35,249.35,0,0,1-31.3-30.18C80,167.37,60,137.31,60,104a68,68,0,0,1,136,0C196,137.31,176,167.37,159.3,186.71Z"/></svg>
        </span>
        {% if where_list|length > 1 %}
          <ul class="slnt-node-full__where slnt-node-full__venues">
            {% for venue in where_list %}
              <li>{% if venue.url %}<a class="slnt-node-full__venue-link" href="{{ venue.url }}">{{ venue.name }}</a>{% else %}{{ venue.name }}{% endif %}{% if venue.area %}<span class="slnt-node-full__venue-area">, {{ venue.area }}</span>{% endif %}
                {% include '@customsolent/components/venue-address.html.twig' with { place: venue } only %}</li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="slnt-node-full__where">{% if where_list[0].url %}<a class="slnt-node-full__venue-link" href="{{ where_list[0].url }}">{{ where_list[0].name }}</a>{% else %}{{ where_list[0].name }}{% endif %}{% if where_list[0].area %}<span class="slnt-node-full__venue-area">, {{ where_list[0].area }}</span>{% endif %}
            {% include '@customsolent/components/venue-address.html.twig' with { place: where_list[0] } only %}</div>
        {% endif %}
      </div>
    {% endif %}

    {# Organiser — the organisation curating the series; nothing when none
       is named (issue 436). Same line as the event page. #}
    {% if organisers is not empty %}
      <div class="slnt-node-full__organiser">{{ 'Organised by'|t }}
        {% for org in organisers %}<a href="{{ org.url }}">{{ org.label }}</a>{% if not loop.last %}{{ loop.index == organisers|length - 1 ? ' ' ~ 'and'|t ~ ' ' : ', ' }}{% endif %}{% endfor %}
      </div>
    {% endif %}

  </div>

  {% if content.field_standfirst|render|striptags|trim %}
    <div class="slnt-node-full__standfirst">{{ content.field_standfirst }}</div>
  {% endif %}

  {# Description — the article reading column (740px) so long text reads
     well; slnt-article__body supplies the paragraph, list and link styles. #}
  {% if content.field_description|render|striptags|trim %}
    <div class="slnt-article__body slnt-series-full__description">
      {{ content.field_description }}
    </div>
  {% endif %}

  {# Members, grouped by kind. Each item is its own compact card, so an
     event here looks exactly like an event on the front page. #}
  {% for group in series_groups %}
    <section class="slnt-series-items slnt-series-items--{{ group.key }}" aria-labelledby="series-items-{{ group.key }}">
      <h2 id="series-items-{{ group.key }}" class="slnt-series-items__heading">
        {{ group.label }}
        <span class="slnt-series-items__count">{{ group.items|length }}</span>
      </h2>
      <div class="slnt-series-items__grid {{ group.grid_class }}">
        {% for item in group.items %}
          <div class="slnt-series-items__cell">{{ item }}</div>
        {% endfor %}
      </div>
    </section>
  {% endfor %}

  {# Related organisations — field_related_organisations: not part of the
     series, so after the members and under their own heading. Same card
     and grid as the Organisations group, so they read as the same kind
     of thing one step removed. #}
  {% if related_organisations is not empty %}
    <section class="slnt-series-items slnt-series-items--related-organisations" aria-labelledby="series-related-organisations">
      <h2 id="series-related-organisations" class="slnt-series-items__heading">
        {{ 'Related organisations'|t }}
        <span class="slnt-series-items__count">{{ related_organisations|length }}</span>
      </h2>
      <div class="slnt-series-items__grid slnt-series-items__grid--links">
        {% for item in related_organisations %}
          <div class="slnt-series-items__cell">{{ item }}</div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {# Related topics, each as its full chain (the primary is the kicker). #}
  {% include '@customsolent/components/topics-list.html.twig' with { related_topic_chains: related_topic_chains|default([]) } only %}

  {{ series_cache }}

  {# Collaborations this series is part of (reverse lookup). #}
  {% include '@customsolent/components/collaborations-block.html.twig' with {
    collaboration_items: collaboration_items,
    collaborations_cache: collaborations_cache,
  } only %}

  {# Rendered by hand above; suppress the defaults. #}
  {{ content|without('field_standfirst', 'field_series_start', 'field_series_end',
     'field_description', 'field_series_items', 'field_related_organisations',
     'field_primary_topic', 'field_related_topics', 'field_organisers', 'links') }}

</article>
