{#
/**
 * @file
 * Topic breadcrumb trail component.
 *
 * A bespoke breadcrumb-style navigation derived from the
 * field_primary_topic taxonomy hierarchy. Parent terms are clickable
 * and section-coloured; the leaf term may be rendered as a heading or
 * omitted entirely (when the host template provides its own h1).
 *
 * Variables:
 *   - ancestors: array of { label, url, color } — clickable terms
 *   - current_label: string|null — the leaf/current term (omit on
 *     content pages where the node provides its own h1)
 *   - current_as_heading: bool — true wraps current_label in <h1>,
 *     false wraps it in <span>
 *   - current_url: string|null — when given, the current label is a link
 *     to that page (the topic's own page), styled as plain heading text.
 *     From a filtered or listing view it is the way back to the
 *     unfiltered page.
 *   - also_in: optional list of chains, each a list of { label, url|null,
 *     color, section_color? } — the related topics that put this card on
 *     the current page when its primary topic is elsewhere ("also in
 *     SECTORS / DEFENCE & MILITARY"), each chain from its section root.
 *     From KickerLazyBuilder::trailKicker; empty on content pages. Each
 *     chain is wrapped in .slnt-topic-trail__also-chain carrying its
 *     topic's own section colour as --slnt-chain-color, so a filled card
 *     can draw the chain as a tag in that colour even though its text is
 *     white (section_color is the colour before the card's override).
 *   - here_in: optional list of chains in the same shape — the page's own
 *     topic when it is what put the card here ("here in LIVING /
 *     WELLBEING"): the reader has arrived, so its last term is plain text.
 *     Printed before the "also in" chains, in the same row.
 */
#}
{% if ancestors is not empty or current_label %}
<nav class="slnt-topic-trail" aria-label="Topic breadcrumb">
  {% if ancestors is not empty %}
    <div class="slnt-topic-trail__ancestors">
      {% for ancestor in ancestors %}
        <a href="{{ ancestor.url }}" class="slnt-topic-trail__ancestor" style="color: {{ ancestor.color }};">{{ ancestor.label }}</a>
        {% if not loop.last %}
          <span class="slnt-topic-trail__separator" aria-hidden="true"> / </span>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
  {% set _groups = [
    { prefix: 'here in'|t, chains: here_in is defined ? here_in : [] },
    { prefix: 'also in'|t, chains: also_in is defined ? also_in : [] },
  ] %}
  {% if _groups[0].chains is not empty or _groups[1].chains is not empty %}
    <div class="slnt-topic-trail__also">
      {% for group in _groups %}
        {% if group.chains is not empty %}
          <span class="slnt-topic-trail__also-prefix">{{ group.prefix }}</span>
          {% for chain in group.chains %}
            <span class="slnt-topic-trail__also-chain" style="--slnt-chain-color: {{ chain[0].section_color ?? chain[0].color }};">
            {%- for item in chain -%}
              {%- if item.url -%}
                <a href="{{ item.url }}" class="slnt-topic-trail__ancestor" style="color: {{ item.color }};">{{ item.label }}</a>
              {%- else -%}
                <span class="slnt-topic-trail__ancestor slnt-topic-trail__ancestor--plain" style="color: {{ item.color }};">{{ item.label }}</span>
              {%- endif -%}
              {%- if not loop.last -%}<span class="slnt-topic-trail__separator" aria-hidden="true"> / </span>{%- endif -%}
            {%- endfor -%}
            </span>
            {%- if not loop.last -%}<span class="slnt-topic-trail__separator slnt-topic-trail__separator--chains" aria-hidden="true">, </span>{%- endif -%}
          {% endfor %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
  {% if current_label %}
    {% set _current %}
      {%- if current_url is defined and current_url -%}
        <a href="{{ current_url }}" class="slnt-topic-trail__current-link">{{ current_label }}</a>
      {%- else -%}
        {{- current_label -}}
      {%- endif -%}
    {% endset %}
    {% if current_as_heading %}
      <h1 class="slnt-topic-trail__current">{{ _current }}</h1>
    {% else %}
      <span class="slnt-topic-trail__current">{{ _current }}</span>
    {% endif %}
  {% endif %}
</nav>
{% endif %}
