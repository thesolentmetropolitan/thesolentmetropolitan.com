{#
/**
 * @file
 * "Workshop · Online": the format(s) and setting of an event, series or
 * organisation as one small line (issue 485). Plain text by design: a link
 * here would pull the eye from the event itself (Rob, 16 Nov 2026); the
 * sidebar's Format group and the landing pages do the navigating.
 *
 * Variables (from _customsolent_preprocess_format_extras()):
 *   - format_labels: format names in vocabulary order
 *   - setting_label / setting_key: Indoor, Outdoor, Online, Hybrid (or null)
 *   - variant:     a class hook for the host: teaser, compact, directory,
 *                  series, full
 *   - show_indoor: print "Indoor" too (the page does; cards leave it out,
 *                  since most events are indoors and the word adds nothing)
 */
#}
{% set _show_setting = setting_label and (show_indoor|default(false) or setting_key != 'indoor') %}
{% set _extra = extra_labels|default([]) %}
{% if format_labels is not empty or _show_setting or _extra is not empty %}
  <div class="slnt-format-line slnt-format-line--{{ variant|default('compact') }}">
    <span class="visually-hidden">{{ 'Format'|t }}: </span>
    {%- for f in format_labels -%}
      <span class="slnt-format-line__format">{{ f }}</span>{% if not loop.last %}<span class="slnt-format-line__sep" aria-hidden="true"> · </span>{% endif %}
    {%- endfor -%}
    {%- if _show_setting -%}
      {% if format_labels is not empty %}<span class="slnt-format-line__sep" aria-hidden="true"> · </span>{% endif %}
      <span class="slnt-format-line__setting slnt-format-line__setting--{{ setting_key }}">{{ setting_label }}</span>
    {%- endif -%}
    {%- for x in _extra -%}
      {% if format_labels is not empty or _show_setting or not loop.first %}<span class="slnt-format-line__sep" aria-hidden="true"> · </span>{% endif %}
      <span class="slnt-format-line__extra">{{ x }}</span>
    {%- endfor -%}
  </div>
{% endif %}
