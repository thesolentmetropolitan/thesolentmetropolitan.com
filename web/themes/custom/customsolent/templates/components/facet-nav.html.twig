{#
/**
 * @file
 * One sidebar group for a further facet, cost or age group (issues 422,
 * 463): the same shape as the Format group (format-nav.html.twig). In the
 * desktop sidebar it follows the Format group; in the mobile sheet it is
 * the sheet's body, where the title row already names it.
 *
 * Variables: group = {param, kind, label, all_label, options
 *   [{label, url, active}], all_url, all_active, active_label}
 */
#}
{% if group.options is not empty %}
  <div class="slnt-filter-section slnt-filter-section--formats slnt-filter-section--{{ group.kind }}">
    <div class="slnt-filter-section__title">{{ group.label }}</div>
    <a href="{{ group.all_url }}" class="slnt-filter-item{{ group.all_active ? ' is-active' : '' }}"{% if group.all_active %} aria-current="page"{% endif %}>{{ group.all_label }}</a>
    {% for option in group.options %}
      <a href="{{ option.url }}" class="slnt-filter-item{{ option.active ? ' is-active' : '' }}"{% if option.active %} aria-current="page"{% endif %}>{{ option.label }}</a>
    {% endfor %}
  </div>
{% endif %}
