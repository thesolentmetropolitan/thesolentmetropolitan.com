{#
/**
 * @file
 * The related topics of a page, after its content: each as its full chain
 * ("Sectors / Environment") so that "Culture / Technology" and "Sectors /
 * Technology" read as two topics, in its section's colour, the chains
 * separated by commas. The primary topic is the kicker at the top of the
 * page, so it is not repeated here. Each term is a link to its page.
 *
 * Variables (from _customsolent_preprocess_related_topics()):
 *   - related_topic_chains: list of {chain: [{label, url, color}], color}
 */
#}
{% if related_topic_chains is not empty %}
  <div class="slnt-node-full__topics">
    <span class="slnt-node-full__topics-label">{{ 'Related topics'|t }}</span>
    <ul class="slnt-node-full__topics-list">
      {%- for topic in related_topic_chains -%}
        <li class="slnt-topic-chain"{% if topic.color %} style="--slnt-chain-color: {{ topic.color }}"{% endif %}>
          {%- for term in topic.chain -%}
            <a href="{{ term.url }}" class="slnt-topic-chain__term">{{ term.label }}</a>
            {%- if not loop.last %}<span class="slnt-topic-chain__sep" aria-hidden="true"> / </span>{% endif -%}
          {%- endfor -%}
          {%- if not loop.last %}<span class="slnt-topic-chain__comma">, </span>{% endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{% endif %}
