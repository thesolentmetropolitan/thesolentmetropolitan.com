{#
/**
 * @file
 * Theme override to display a single Drupal page while offline.
 *
 * All available variables are mirrored in page.html.twig.
 * Some may be blank but they are provided for consistency.
 *
 * @see template_preprocess_maintenance_page()
 */
#}
{# A standalone page: no menu and no footer blocks are available while the
   site is in maintenance mode, so it carries its own header band. Styled in
   css/system-pages.css (.slnt-maintenance). The message itself is the one
   set at Configuration → Development → Maintenance mode. #}
<div class="slnt-maintenance">
  <header class="slnt-maintenance__header" role="banner">
    {% if logo %}
      <img src="{{ logo }}" alt="{{ site_name }}"/>
    {% elseif site_name %}
      <div class="slnt-maintenance__name">{{ site_name }}</div>
    {% endif %}
  </header>
  <main class="slnt-maintenance__main" role="main">
    <h1 class="slnt-maintenance__title">{{ title ?: 'Back shortly'|t }}</h1>
    <div class="slnt-maintenance__box">
      {{ page.highlighted }}
      {{ page.content }}
    </div>
  </main>
  <footer class="slnt-maintenance__footer" role="contentinfo">
    {{ site_name }}
  </footer>
</div>
