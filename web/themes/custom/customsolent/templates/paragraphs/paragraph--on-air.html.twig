{#
/**
 * @file
 * On air now (EPG): one small card per station with a programme on at
 * this moment, and the way to the Local radio guide. No fields: the
 * paragraph draws itself from the stations' schedules
 * (customsolent_preprocess_paragraph__on_air).
 *
 * Variables:
 *   - on_air: [{station: {label, url, stream, kind}, programme: {title,
 *     url, times, topics}}]
 *   - guide_url
 */
#}
<section{{ attributes.addClass('slnt-on-air') }} aria-labelledby="on-air-heading">
  <h2 id="on-air-heading" class="slnt-on-air__heading"><span class="slnt-on-air__heading-dot" aria-hidden="true"></span>{{ 'On air now'|t }}</h2>
  {% if on_air %}
    <ul class="slnt-on-air__list">
      {% for item in on_air %}
        <li class="slnt-on-air__item">
          <a class="slnt-on-air__station" href="{{ item.station.url }}">{{ item.station.label }}</a>
          <span class="slnt-on-air__programme"><a href="{{ item.programme.url }}">{{ item.programme.title }}</a></span>
          <span class="slnt-on-air__times">{{ item.programme.times ?: item.programme.time }}</span>
          {% if item.programme.topics %}<span class="slnt-on-air__topics">{{ item.programme.topics|join(' · ') }}</span>{% endif %}
          {% if item.station.stream %}<a class="slnt-on-air__live" href="{{ item.station.stream }}" target="_blank" rel="noopener noreferrer">{{ item.station.kind == 'tv' ? 'Watch live'|t : 'Listen live'|t }}<span class="visually-hidden"> ({{ 'opens in a new tab'|t }})</span></a>{% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="slnt-on-air__none">{{ 'Nothing is listed as on air at the moment.'|t }}</p>
  {% endif %}
  <p class="slnt-on-air__more"><a href="{{ guide_url }}">{{ 'The local radio guide: every station, all week'|t }}</a></p>
</section>
